alter proc [dbo].[sp_GetEmployeeList]     
(          
@EmployeeTypeID int =0,          
@SBranchID int          
)          
AS          
BEGIN          
 Declare @EmployeeTypes Table(EmployeeTypeID int,EmployeeTypeName nvarchar(500))          
 insert into @EmployeeTypes exec sp_GetEmployeeTypes  @SBranchID         
    
 declare @Designation nvarchar(500)          
 Select @Designation=EmployeeTypeName from @EmployeeTypes where EmployeeTypeID=@EmployeeTypeID    
    
 if(@EmployeeTypeID=0)          
 begin     

 -- Select top 1 @EmployeeTypeID=(EmployeeTypeID) from @EmployeeTypes     
 Select EM.[EmployeeID],EM.[EmployeeName],EM.Photo,EM.Gender,MobileNumber,VehicleRouteID,FatherHubName,    
  --@Designation as EmployeeTypeName,  
  (select EmployeeTypeID from EmployeeTypeMaster ETM where ETM.EmployeeTypeID=EM.EmployeeType and (ETM.SBranchID=0 or ETM.SBranchID=@SBranchID)) as EmployeeTypeID,          
 (select EmployeeTypeName from EmployeeTypeMaster ETM where ETM.EmployeeTypeID=EM.EmployeeType and (ETM.SBranchID=0 or ETM.SBranchID=@SBranchID)) as EmployeeTypeName,          
 (case when EmployeeType in (12,13) then 'TRA' else 'EMP' end)+RIGHT(REPLICATE('0',6)+CAST(EM.[EmployeeID] AS VARCHAR(6)),6) as [EmployeeSID],          
 DOB,DOJ,EmailID,BloodGroup,[AccessCardNo],AadharNumber,LicenceNumber ,status    
 from EmployeeMaster EM            
 where EM.SBranchID=@SBranchID and isnull(EM.isLeft,1)!=0         
 order by EM.status desc,EM.[EmployeeName] asc     
 end          
  else          
   begin       
 Select EM.[EmployeeID],EM.[EmployeeName],EM.Photo,EM.Gender,MobileNumber,VehicleRouteID,FatherHubName,          
 @Designation as EmployeeTypeName,          
 (case when EmployeeType in (12,13) then 'TRA' else 'EMP' end)+RIGHT(REPLICATE('0',6)+CAST(EM.[EmployeeID] AS VARCHAR(6)),6) as [EmployeeSID],          
 DOB,DOJ,EmailID,BloodGroup,[AccessCardNo],AadharNumber,LicenceNumber ,status         
 from EmployeeMaster EM            
 where EM.SBranchID=@SBranchID and EM.EmployeeType=@EmployeeTypeID  and isnull(EM.isLeft,1)!=0        
 order by EM.status desc,EM.[EmployeeName] asc         
   end       
 select * from @EmployeeTypes          
          
 select isnull(@EmployeeTypeID,0)          
END    