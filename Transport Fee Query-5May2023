alter Function [dbo].[fn_GetStudentTransportFeeAmount] --4,2019,785,0,0,1,0,19,1,5,2,50,50,4  
(  
@Month int,  
@Year int,  
@StudentID int,  
@TransportFeeMode int,  
@ClassID int,  
@GroupID int,  
@SBranchID int,  
@SessionID int=1   
)  
 Returns numeric(10,2)  
as  
begin  
  declare @MonthsYear as Table(month int,year int)  
  Insert into @MonthsYear select @Month,@Year  
  Declare @Amount decimal(18,2)=0,@ClassTransportFee numeric(18,2)  
  Declare @Quota int  
  declare @IsCustomFee int  
  select top 1 @IsCustomFee=isnull(IsCustomFee,0) from Student_Session where StudentID=@StudentID and SessionID=@SessionID  
  --select @Quota=QuotaID from Student_Session where StudentID=@StudentID and SessionID=@SessionID  
  --select * from [StudentFeeDetails]  
  if(@TransportFeeMode=1)  
  begin  
   select @ClassTransportFee=sum(isnull(isnull(SFD.FeeAmount,CFS.FeeAmount),0)) from ClassFeeStructureMaster CFS left outer join  
   [dbo].[StudentFeeDetails] SFD on SFD.FeeTypeID=CFS.FeeTypeID and SFD.StudentID=@StudentID and SFD.SessionID=(case when @IsCustomFee=1 then @SessionID else -1 end) and SFD.IsApplicable=1  
   where ClassID=@ClassID and GroupID=@GroupID and SBranchID=@SBranchID   
   and CFS.FeeTypeID in (select FeeTypeID from FeeTypeMaster where FeeTypeApplicable=5) and CFS.SessionID=@SessionID  
  end  
  if((select count(*) from TransportHostalAllocationDelocation where UserType=0 and ChangeType=0 and UserID=@StudentID)>0)  
  begin  
   declare @LMonth int  
   declare @LYear int  
   DECLARE cur_Months CURSOR  
   STATIC FOR select Month,Year from @MonthsYear  
   OPEN cur_Months   
   FETCH NEXT FROM cur_Months INTO @LMonth,@LYear  
   WHILE @@FETCH_STATUS = 0  
   Begin    
    Declare @MStartDate date=cast(cast(@LYear as nvarchar(5))+'-'+cast(@LMonth as nvarchar(3))+'-1' as date)  
    Declare @MEndDate date= EOMONTH(@MStartDate)  
     Select @Amount=isnull(@Amount,0)+ isnull(sum(Amount*(Days+1)/TotalDays),0) from (  
     select StartDate,EndDate,KeyID,ChangeType,DATEDIFF(DAY, StartDate,isnull(EndDate,@MEndDate)) as Days,datepart(day,@MEndDate) as TotalDays,  
     (case when @TransportFeeMode=1 then   
     (@ClassTransportFee) else   
      --(select isnull(Rate,0) from TransportRouteDetails TRM where TRM.StopID=KeyID) end) as Amount from 
	   (select isnull(Amount,0) from TransportFeeMaster TFM where TFM.StopID=KeyID and TFM.SessionID=@SessionID and TFM.Sbranchid=@SBranchID ) end) as Amount from   
     (select (case when  StartDate is null or StartDate<@MStartDate then @MStartDate else StartDate end) as StartDate,  
     (case when EndDate is null or EndDate>@MEndDate then @MEndDate else EndDate end) as EndDate  
     , KeyID,ChangeType  
     from TransportHostalAllocationDelocation where UserType=0 and ChangeType=0 and UserID=@StudentID and (StartDate<EndDate or EndDate is null)  
     and ((StartDate between @MStartDate and @MEndDate or StartDate<@MStartDate) and (isnull(EndDate,@MEndDate) between @MStartDate and @MEndDate or EndDate>@MEndDate))  
      )t)tt   
     
    FETCH NEXT FROM cur_Months INTO @LMonth,@LYear  
   end  
   close cur_Months   
   deallocate cur_Months   
  end  
  Return isnull(@Amount,0)  
end

go


alter proc [dbo].[spn_InsertUpdateTransportRouteStoppages]    
(    
@StopID int,    
@RouteID int,    
@CountryID int,    
@StateID int,    
@CityID int,    
@AreaID int,    
@Time time(7),    
@HaltDuration int,    
@SequenceNo int,    
@TimeR time(7),    
@HaltDurationR int,    
@SequenceNoR int,    
@UserID int,    
@OperationDate datetime,    
@OpType int,    
@Rate numeric(18,2)=0    
)    
AS    
  
BEGIN   
 declare @SessionID int  
 select @SessionID=SessionID from SessionMaster where SBranchID=@UserID and SessionStatus=1    
  
 if(@OpType=-1)    
 begin    
  select @SequenceNo=SequenceNo,@RouteID=RouteID from TransportRouteDetails where StopID=@StopID     
  Delete from TransportRouteDetails where StopID=@StopID    
  Update [dbo].[TransportRouteDetails] set [SequenceNo]= [SequenceNo]-1 where SequenceNo>@SequenceNo  and RouteID=@RouteID     
 end    
 else if(@StopID=0)    
 begin    
  if(@SequenceNo=0)    
  begin    
  Select @SequenceNo=isnull(max(SequenceNo),0)+1 from TransportRouteDetails where RouteID=@RouteID    
  end    
  else    
  Begin    
   Update [dbo].[TransportRouteDetails] set [SequenceNo]= SequenceNo+1 where (SequenceNo=@SequenceNo or SequenceNo>@SequenceNo) and RouteID=@RouteID    
   Update [dbo].[TransportRouteDetails] set [SequenceNoR]= SequenceNoR+1 where (SequenceNoR=@SequenceNoR or SequenceNoR>@SequenceNoR) and RouteID=@RouteID    
    
  end    
    
   Insert TransportRouteDetails (RouteID,CountryID,StateID,CityID,AreaID,[Time],HaltDuration,SequenceNo,[TimeR],HaltDurationR,SequenceNoR,UserID,CreatedDate,Rate)    
   values(@RouteID,@CountryID,@StateID,@CityID,@AreaID,@Time,@HaltDuration,@SequenceNo,@TimeR,@HaltDurationR,@SequenceNoR,@UserID,@OperationDate,@Rate)    
     
   declare @StID int  
      
    
    SET @StID = SCOPE_IDENTITY();  
   
        
   insert TransportFeeMaster (StopID,RouteID,CityID,AreaID,Amount,SbranchID,SessionID,CreatedDate)  
   values(@StID,@RouteID,@CityID,@AreaID,@Rate,@UserID,@SessionID,getdate())  
     
 end    
 else    
 begin    
  declare @OldSequence int    
  declare @OldSequenceR int    
  select @OldSequence=SequenceNo,@OldSequenceR=SequenceNoR from TransportRouteDetails where StopID= @StopID    
    
  if(@OldSequence>@SequenceNo)    
  begin    
  Update [dbo].[TransportRouteDetails] set [SequenceNo]= SequenceNo+1 where (SequenceNo=@SequenceNo or SequenceNo>@SequenceNo) and SequenceNo<@OldSequence and RouteID=@RouteID    
  end    
  else if(@OldSequence<@SequenceNo)    
  begin    
  Update [dbo].[TransportRouteDetails] set [SequenceNo]= [SequenceNo]-1 where (SequenceNo=@SequenceNo or SequenceNo<@SequenceNo) and (SequenceNo>@OldSequence or SequenceNo=@OldSequence ) and RouteID=@RouteID    
  end    
  if(@OldSequenceR>@SequenceNoR)    
  begin    
  Update [dbo].[TransportRouteDetails] set [SequenceNoR]= SequenceNoR+1 where (SequenceNoR=@SequenceNoR or SequenceNoR>@SequenceNoR) and SequenceNoR<@OldSequenceR and RouteID=@RouteID    
  end    
  else if(@OldSequenceR<@SequenceNoR)    
  begin    
  Update [dbo].[TransportRouteDetails] set [SequenceNoR]= [SequenceNoR]-1 where (SequenceNoR=@SequenceNoR or SequenceNoR<@SequenceNoR) and (SequenceNoR>@OldSequenceR or SequenceNoR=@OldSequenceR ) and RouteID=@RouteID    
  end    
    
    
  Update TransportRouteDetails Set RouteID=@RouteID, CountryID=@CountryID, StateID=@StateID, CityID=@CityID, AreaID=@AreaID,Rate=@Rate,    
   [Time]=@Time, HaltDuration=@HaltDuration, SequenceNo=@SequenceNo,[TimeR]=@TimeR, HaltDurationR=@HaltDurationR,     
   SequenceNoR=@SequenceNoR, UserID=@UserID, ModifiedDate=@OperationDate    
   where StopID=@StopID    
  
   Update TransportFeeMaster set Amount=@Rate,ModifiedDate=getdate()   
   where StopID=@StopID and RouteID=@RouteID and CityID=@CityID and AreaID=@AreaID  
   and Sbranchid=@UserID and sessionid=@SessionID  
  
 end    
    
 select @RouteID    
    
 exec dbo.spn_GetTransportRouteStoppages @RouteID    
    
END    

go