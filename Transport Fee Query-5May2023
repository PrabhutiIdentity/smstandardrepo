CREATE proc [dbo].[sp_GetFeeForTransport]      
(      
@RouteID int,    
@SBranchID int,      
@SessionID int=0      
)      
AS      
BEGIN      
 if(@RouteID=0)      
 begin      
 select @SessionID=SessionID from SessionMaster where SBranchID=@SBranchID and SessionStatus=1      
  select @RouteID=min(RouteID) from TransportRoutemaster where isapproved=1 and SBranchID=@SBranchID      
      
 end      
      
 Select TFM.StopID,TFM.RouteID,(Select RouteName from TransportRoutemaster TRM Where TRM.RouteID=TFM.RouteID) as RouteName,    
 TFM.CityID,(Select CityName from CityMaster CM Where CM.CityID=TFM.CityID) as CityName,    
 TFM.AreaID, (Select [AreaName] from AreaMaster AM Where AM.AreaID=TRD.AreaID) as AreaName,    
 Amount,SbranchID,SessionID    
  from TransportRouteDetails TRD inner join TransportFeeMaster TFM on TRD.Stopid=TFM.StopID     
where TFM.RouteID=@RouteID  and TFM.SbranchID=@SbranchID and TFM.SessionID=@SessionID    
   --   where TFM.RouteID=11  and TFM.SbranchID=3 and TFM.SessionID=4    
 order by TRD.SequenceNo       
    
  select isnull(@SessionID,0)       
     
    
 Select SessionID,SessionName,SessionStatus from SessionMaster where SBranchID=@SBranchID     
 Select RouteID,RouteName from TransportRoutemaster where isapproved=1 and SBranchID=@SBranchID     
 select isnull(@RouteID,0)     
     
END   
go

  alterproc [dbo].[spn_GetVehicleRouteStoppages]    
(          
 @VehicleRouteID int          
)          
AS          
BEGIN     
declare @SessionID int  
declare @SBranchID int  
  
 Select @SBranchID=SBranchID from Transport_Vehicle_Route where  VehicleRouteID=@VehicleRouteID     
  
 Select @SessionID=SessionID from SessionMaster where SessionStatus=1 and SBranchID=@SBranchID     
 Select StopID,VehicleRouteID,TRD.AreaID,  
TRD.Rate as Rate1,  
(select isnull(Amount,0) from TransportFeeMaster TFM  where TFM.RouteID=TRD.RouteID and TFM.StopID=TRD.StopID   and  TFM.SessionID=@SessionID and TFM.Sbranchid=@SBranchID )  as Rate,   
 AM.AreaName,AM.Latitude,AM.Longitude,        
 (case when SequenceNo=4 then 1 else case when SequenceNo<4 then  0 else 2 end end) as IsDone,          
 cast(DATEADD(MINUTE,  TVR.DelayFromRouteTime, [time]  ) as nvarchar(8))as [Time],HaltDuration,HaltDurationR,SequenceNo,SequenceNoR          
 ,cast(DATEADD(MINUTE,  TVR.DelayFromRouteTime, [timeR]  ) as nvarchar(8)) as [TimeR],          
 HaltDurationR,SequenceNoR from TransportRouteDetails TRD left outer join Transport_Vehicle_Route TVR on TVR.RouteID=TRD.RouteID          
 left outer join AreaMaster AM on AM.AreaID=TRD.AreaID          
 where tvr.VehicleRouteID=@VehicleRouteID           
 order by SequenceNo          
END      
  

go

alter proc [dbo].[spn_GetTransportRouteStoppages]    
(    
@RouteID int    
)    
AS    
BEGIN    
declare @SessionID int  
declare @SBranchID int  
  
 Select @SBranchID=SBranchID from Transport_Vehicle_Route where  RouteID=@RouteID     
  
 Select @SessionID=SessionID from SessionMaster where SessionStatus=1 and SBranchID=@SBranchID     
 Select StopID,RouteID,CountryID,StateID,CityID,AreaID,Rate as Rate1,   
 (select isnull(Amount,0) from TransportFeeMaster TFM  where TFM.RouteID=TRD.RouteID and TFM.AreaID=TRD.AreaID and  TFM.SessionID=@SessionID and TFM.Sbranchid=@SBranchID )  as Rate,   
  
 (Select [AreaName] from AreaMaster AM Where AM.AreaID=TRD.AreaID) as AreaName,    
 cast([Time] as nvarchar(8)) as [Time],HaltDuration,SequenceNo,SequenceNoR,cast([TimeR] as nvarchar(8)) as TimeR,HaltDurationR    
  from TransportRouteDetails TRD where RouteID=@RouteID    
 order by SequenceNo    
END    
