CREATE proc [dbo].[sp_UpdateTransportFee]  
(  
@TransportDetails ut_TransportFeeDetail READONLY,  
@SessionID int, 
@SBranchID int 
)  
AS  
BEGIN    
 Delete e   
 FROM  TransportFeeMaster e, @TransportDetails d   
 WHERE d.StopID=e.StopID and d.RouteID=e.RouteID and d.CityID=e.CityID and d.AreaID=e.AreaID  and d.SBranchID=@SBranchID and e.SessionID=@SessionID
  
 INSERT INTO TransportFeeMaster(StopID, RouteID, CityID,AreaID,Amount,SBranchID,SessionID,CreatedDate)  
 SELECT StopID, RouteID, CityID,AreaID,Amount,@SBranchID,@SessionID,CreatedDate  
 FROM @TransportDetails TD  
END  
