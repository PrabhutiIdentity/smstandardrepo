alter proc sp_GetSiblingStudentList
(
@SBranchID int,              
@SessionID int     
)
as
begin
  Declare @ParentListTable table (Parentid int)      
   insert into @ParentListTable
   
  select parentid from 
  studentmaster sm left join student_session ss 
  on sm.studentid=ss.studentid 
  where ss.status=1 and ss.SBranchID=@SBranchID and ss.SessionId=@SessionID
  group BY parentid
  HAVING COUNT(ParentID) > 1

 -- select * from @ParentListTable
   SELECT  SM.StudentID, 'STUD' + RIGHT(REPLICATE('0', 6) + CAST(SM.StudentID AS VARCHAR(6)), 6) AS StudentSID, SM.Name,SM.SchoolUID, SM.DOB,  
DATEDIFF(YY,SM.DOB,GETDATE()) as Age, SM.DOJ, 
(case when SM.Gender=0 then 'Male' when SM.Gender=1 then 'Female' else '' end) as Gender1,SM.Gender,       
 SM.Photo, SS.RollNo, SM.AccessCardNo,SM.AadharCardNo,  
ISNULL((SELECT ClassName FROM dbo.ClassMaster AS CM WHERE (ClassID = SS.ClassID)), 'NA') AS ClassName,       
ISNULL((SELECT Name FROM dbo.Class_Sections AS CS WHERE (ID = SS.SectionID)), 'NA') AS SectionName,      
isnull((Select Name from [HouseMaster] CM where CM.ID=SS.HouseID),'NA') as HouseName,   
'PAR' + RIGHT(REPLICATE('0', 6) + CAST(PM.ParentID AS VARCHAR(6)), 6) AS ParentSID,
PM.FatherName, PM.FatherMobileNo,PM.MotherName, PM.MotherMobileNo,
SM.MiniAddress,SM.MiniAddress2,      
SM.Gender, SS.ClassID, SS.SectionID,isnull(SM.StopID,0) StopID,
(select QuotaName from QuotaMaster QM where QM.QuotaID=SS.QuotaID) as QuotaName,      

(select AreaName from AreaMaster AM where AM.AreaID=(Select AreaID from TransportRouteDetails TRD where TRD.StopID=SM.StopID)) as StopName,      
isnull((Select VehicleNumber from [VehicleDetails] CM where CM.VehicleID=TVR.VehicleID),'NA') as BusNo  ,SM.HostelRoomID    
FROM dbo.StudentMaster AS SM LEFT OUTER JOIN      
 dbo.Student_Session AS SS ON SS.StudentID = SM.StudentID  LEFT OUTER JOIN      
 dbo.ParentMaster AS PM ON PM.ParentID = SM.ParentID  left outer join      
[Transport_Vehicle_Route] TVR on TVR.VehicleRouteID=SM.VehicleRouteID      
WHERE        (SM.SBranchID = @SBranchID) and  (SS.SessionID=@SessionID) 
and sm.ParentID in (select parentid from @ParentListTable)
order by sm.ParentID asc

Select SessionID as ID,SessionName as Name,SessionStatus as Extra1 from SessionMaster where SBranchID=@SBranchID      
select @SessionID      
  select * from Sbranchmaster where SBranchID=@SBranchID   
  end