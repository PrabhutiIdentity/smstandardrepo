@{
    ViewBag.Title = "Payment Failed";
}

<div style="max-width: 600px; margin: 50px auto; text-align: center;">

    <h2 style="color: red;">Payment Failed!</h2>

    <p>Unfortunately, your payment could not be processed.</p>

    <hr />

    <h4>Details:</h4>

    <table style="margin: 0 auto; text-align: left;">
        <tr>
            <td><strong>Status:</strong></td>
            <td>@ViewBag.Status</td>
        </tr>
        <tr>
            <td><strong>Transaction ID:</strong></td>
            <td>@ViewBag.TransactionId</td>
        </tr>
        <tr>
            <td><strong>PayU Payment ID:</strong></td>
            <td>@ViewBag.PaymentId</td>
        </tr>
        <tr>
            <td><strong>Error:</strong></td>
            <td>@ViewBag.Error</td>
        </tr>
    </table>

    <hr />

    <p>If any amount was deducted from your bank account, it will be refunded automatically within 5-7 working days.</p>

    <br />

    <a href="@Url.Action("FeeSummary", "Parent")" class="btn btn-primary">Try Again</a>

</div>
