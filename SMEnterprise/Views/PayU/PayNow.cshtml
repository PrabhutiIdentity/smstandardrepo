
@{
    ViewBag.Title = "Paymment Page";
    Layout = "~/Views/Shared/_ParentLayout.cshtml";
}


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>PayNow</title>
</head>
<body>

    <div class="row">
        <div class="col-sm-3 t-profile-left">
            <div class="teacher-contact">
                @*<img onerror="return OnImageError(this,2);" width="100" class="ImageReportLogo" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(Model.StudentID)_@Model.Photo" style="max-height:100px" />*@
            </div>
        </div>
        <div class="col-sm-9 t-profile-right">
            <div class="row all-corsess-wapper">
                <div class="col-sm-12">
                    <div class="all-courses">
                        <h3>Fee Payment Details</h3>
                        <div class="profile__courses__inner">
                            <ul class="profile__courses__list list-unstyled">
                                <li>Student Name: <b>@Model.FirstName</b></li>
                               
                                @*<li>DOB: <b>@Model.DOB.ToString("dd MMM yyyy")</b></li>
        <li>Class: <b>@Model.ClassName</b></li>
        <li>Father Name: <b>@Model.FatherName</b></li>
        <li>Mother Name: <b>@Model.MotherName</b></li>

                                *@
                                <li>Contact No: <b>@Model.Phone</b></li>
                                <li>Fee Month / Year: <b>@Model.FeeMonth / @Model.FeeYear </b></li>
                                <li>Amount(In Rupees): <b>@Model.Amount </b></li>
                            </ul>

                        </div>
                    </div>
                    <div class="form-group register-btn">
                        <form action="https://secure.payu.in/_payment" method="post">

                            <input type="hidden" name="key" value="@Model.MerchantKey" />
                            <input type="hidden" name="txnid" value="@Model.TransactionId" />
                            <input type="hidden" name="amount" value="@Model.Amount" />
                            <input type="hidden" name="productinfo" value="@Model.ProductInfo" />
                            <input type="hidden" name="firstname" value="@Model.FirstName" />
                            <input type="hidden" name="email" value="@Model.Email" />
                            <input type="hidden" name="phone" value="@Model.Phone" />
                            <input type="hidden" name="surl" value="@Model.SuccessUrl" />
                            <input type="hidden" name="furl" value="@Model.FailureUrl" />
                            <input type="hidden" name="hash" value="@Model.Hash" />
                            <input type="hidden" name="udf1" value="@Model.udf1" />
                            <input type="hidden" name="udf2" value="@Model.udf2" />
                            <input type="hidden" name="udf3" value="@Model.udf3" />
                            @*<input type="hidden" name="udf4" value="@Model.udf4" />
                            <input type="hidden" name="udf5" value="@Model.udf5" />
                            <input type="hidden" name="udf6" value="@Model.udf6" />*@

                            <button type="submit">Pay Now</button>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
