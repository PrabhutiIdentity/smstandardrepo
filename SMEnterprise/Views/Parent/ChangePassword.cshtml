@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_ParentLayout.cshtml";
}
@section IncludeCss
{
    <title>P-School | Dashboard</title>
<script src="@Url.Content("~/js/MD5.js")" type="text/javascript"></script>
}
<div class="">

    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2>Change Password</h2>
                   
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <br>
                   @using (Html.BeginForm("UpdatePassword", "Common", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "UpdatePassword", @class = "form-horizontal" }))
                   {
                        <div class="form-group">
                            <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtPassword">
                                Password <span class="required">*</span>
                            </label>
                            <div class="col-md-6 col-sm-6 col-xs-12">
                                <input type="hidden" name="ID" id="hdnPassword" value="" />
                                <input type="password" id="txtPassword" required="required" class="form-control col-md-7 col-xs-12">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtConfirmPassword">
                                Confirm Password <span class="required">*</span>
                            </label>
                            <div class="col-md-6 col-sm-6 col-xs-12">
                                <input type="password" id="txtConfirmPassword"  required="required" class="form-control col-md-7 col-xs-12">
                            </div>
                        </div>
                        
                        <div class="ln_solid"></div>
                        <div class="form-group">
                            <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                                <button type="submit" class="btn btn-success" onclick="return UpdatePassword();">Submit</button>
                            </div>
                        </div>
                   }
                </div>
            </div>
          
        </div>
    </div>
</div>
@section scripts
{
<script>
    function UpdatePassword() {
        if ($('#txtPassword').val() == '' || $('#txtConfirmPassword').val() == '')
        {
            $('#lblError').css('display', '');
            $('#lblError').text('Please Enter Password');
            return false;
        }
        else if ($('#txtPassword').val() != $('#txtConfirmPassword').val())
        {
            $('#lblError').css('display', '');
            $('#lblError').text('Password and Confirm Password do not Match');
            return false;
        }
        else
        {
            var id = $("#txtPassword").val();
            var id2 = hex_md5(String(id + 'd2f*jk#g&h'));
            $("#hdnPassword").val(id2);
            $("#txtPassword").val('******');
            $("#txtConfirmPassword").val('******');
            return true;
        }
    }
</script>
}
