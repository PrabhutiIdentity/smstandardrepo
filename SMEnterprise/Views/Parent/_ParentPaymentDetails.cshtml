<table id="tblCategory" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 5%">Sl.No.</th>
            <th style="width: 20%">Title</th>
            <th style="width: 15%">Amount</th>
            <th style="width: 15%">Disc %</th>
            <th style="width: 15%">Net Payble</th>
            <th style="width: 15%">Amt Recieved</th>
            <th style="width: 15%">Status</th>
        </tr>
    </thead>

    @{
        var count = 0;
        <tbody>

            @foreach (SMEnterprise.Models.PaymentDetailsModel c in Model)
            {
                count++;
                <tr>
                    <td>@count</td>

                    <td>
                        @c.FeeTypeName
                    </td>
                    <td>
                        @c.Amount
                    </td>
                    <td>
                        @c.DiscPer
                    </td>
                    <td>
                        @c.NetApplicablePayment
                    </td>
                    <td>
                        @c.PaymentRecieved
                    </td>

                    <td>
                        @if (c.NetApplicablePayment > c.PaymentRecieved)
                        {
                            <label class='badge bg-blue'>Partial</label>
                        }
                        else
                        {
                            <label class='badge bg-green'>Paid</label>
                        }
                    </td>
                </tr>
            }

        </tbody>
        <tfoot style="border-width: 2px;border-style: groove;">

        </tfoot>
    }
</table>

