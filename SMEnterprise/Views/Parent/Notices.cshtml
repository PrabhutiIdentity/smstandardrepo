@{
    ViewBag.Title = "MailBox";
    Layout = "~/Views/Shared/_ParentLayout.cshtml";
}
@section IncludeCss
{
    <title>P-School | Notices</title>
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">


}
<div class="">

    <div class="clearfix"></div>
    <div class="">
        
        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                <div class="x_panel">
                    <div class="x_title">
                        <h2>Notices</h2>

                        <div class="clearfix"></div>
                    </div>
                    <div class="x_content">

                        <!-- start project list -->
                        <ul class="list-unstyled timeline widget">
                            @{
                                var counter = 1;
                                foreach (SMEnterprise.Models.NoticeModel p in Model)
                                {

                                    <li>
                                        <div class="block">
                                            <div class="block_content">
                                                <h2 class="title">
                                                    <a href="javascript:void(0);" onclick="ViewNoticeDescription(this);" title="Click to View Details" class="Closed">@p.NoticeTitle (View Details)</a>
                                                </h2>
                                                <div class="byline">
                                                    <span>@p.NoticeStartDate.ToString("dd MMM,yyyy")</span> to <apan>@p.NoticeEndDate.ToString("dd MMM,yyyy")</apan>
                                                </div>
                                                <p class="excerpt" style="display:none;">
                                                    @p.NoticeDescription
                                                </p>
                                            </div>
                                        </div>
                                    </li>

                                    counter++;
                                }
                            }
                        </ul>
                        <!-- end project list -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script>
        function ViewNoticeDescription(sender)
        {
            if ($(sender).hasClass('Closed')) {
                $(sender).closest('li').find('.excerpt').css('display', '');
                $(sender).removeClass('Closed').addClass('Opened');
                $(sender).attr('title', 'Click to Hide Details');
                $(sender).html($(sender).html().replace('(View Details)', '(Hide Details)'));
            }
            else
            {
                $(sender).closest('li').find('.excerpt').css('display', 'none');
                $(sender).removeClass('Opened').addClass('Closed');
                $(sender).attr('title', 'Click to Show Details');
                $(sender).html($(sender).html().replace('(Hide Details)', '(View Details)'));
            }

        }
    </script>
}