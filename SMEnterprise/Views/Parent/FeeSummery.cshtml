@model SMEnterprise.Models.StudentSessionFeeStatusPageModel
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                <div class="x_panel">
                    <div class="x_title">
                        <h2>
                            Fee Summery
                        </h2><br />
                        <span class="pull-right">
                            Total Fee : @Model.MonthlySummery.Sum(c => c.ApplicableFee).ToString("0.00") Discounts : @Model.MonthlySummery.Sum(c => c.Discount).ToString("0.00")
                            Payments : @Model.MonthlySummery.Sum(c => c.PaymentRecieved).ToString("0.00") Net Due : @Model.MonthlySummery.Sum(c => c.ApplicableFee - c.Discount - c.PaymentRecieved).ToString("0.00")
                        </span>
                        <div class="clearfix"></div>
                    </div>
                    <div class="x_content">

                        <div class="accordion" id="accordion" role="tablist" aria-multiselectable="true">
                            @foreach (var mys in Model.MonthlySummery)
                            {
                                <div class="panel">
                                    <a class="panel-heading" role="tab" id="heading_@(mys.FeeYear)_@mys.FeeMonth" data-toggle="collapse" data-parent="#accordion" href="#collapse_@(mys.FeeYear)_@mys.FeeMonth" aria-expanded="true" aria-controls="collapse_@(mys.FeeYear)_@mys.FeeMonth">
                                        <table style="width:100%">
                                            <tr>
                                                <td style="width:20%">
                                                    @((new DateTime(mys.FeeYear, mys.FeeMonth, 1)).ToString("MMMM, yyyy"))
                                                </td>
                                                <td style="width:20%">
                                                    Applicable Fee : @mys.ApplicableFee.ToString("0.00")
                                                </td>
                                                <td style="width:20%">
                                                    Discount : @mys.Discount.ToString("0.00")
                                                </td>
                                                <td style="width:20%">
                                                    Paid : @mys.PaymentRecieved.ToString("0.00")
                                                </td>
                                                <td style="width:20%">
                                                    Amount Due: @((mys.ApplicableFee - mys.Discount - mys.PaymentRecieved).ToString("0.00"))
                                                </td>
                                            </tr>
                                        </table>
                                    </a>
                                    <div id="collapse_@(mys.FeeYear)_@mys.FeeMonth" class="panel-collapse collapse" role="tabpanel" aria-labelledby="heading_@(mys.FeeYear)_@mys.FeeMonth">
                                        <div class="panel-body">
                                            <table class="table table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>#</th>
                                                        <th>Fee Head</th>
                                                        <th>Fee Amount</th>
                                                        <th>Discount</th>
                                                        <th>Paid</th>
                                                        <th>Net Due</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{
                                                        var ctr = 1;
                                                        foreach (var f in Model.FeeWiseDetails.Where(c => c.FeeMonth == mys.FeeMonth && c.FeeYear == mys.FeeYear))
                                                        {
                                                            <tr>
                                                                <td>@ctr</td>
                                                                <td>@f.FeeTypeName</td>
                                                                <td>@f.ApplicableFee.ToString("0.00")</td>
                                                                <td>@f.RDiscount.ToString("0.00")</td>
                                                                <td>@f.PaidAmount.ToString("0.00")</td>
                                                                <td>@((f.ApplicableFee-f.RDiscount-f.PaidAmount).ToString("0.00"))</td>
                                                            </tr>
                                                            ctr = ctr + 1;
                                                        }
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr>
                                                        <td colspan="2" style="text-align:right"><b>Total</b></td>
                                                        <td>@Model.FeeWiseDetails.Where(c => c.FeeMonth == mys.FeeMonth && c.FeeYear == mys.FeeYear).Sum(x => x.ApplicableFee).ToString("0.00")</td>
                                                        <td>@Model.FeeWiseDetails.Where(c => c.FeeMonth == mys.FeeMonth && c.FeeYear == mys.FeeYear).Sum(x => x.RDiscount).ToString("0.00")</td>
                                                        <td>@Model.FeeWiseDetails.Where(c => c.FeeMonth == mys.FeeMonth && c.FeeYear == mys.FeeYear).Sum(x => x.PaidAmount).ToString("0.00")</td>
                                                        <td>@Model.FeeWiseDetails.Where(c => c.FeeMonth == mys.FeeMonth && c.FeeYear == mys.FeeYear).Sum(x => x.ApplicableFee - x.RDiscount - x.PaidAmount).ToString("0.00")</td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="5" style="text-align:right">
                                                            @using (Html.BeginForm("Index", "Payment", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "UpdatePassword", @class = "form-horizontal" }))
                                                            {
                                                                <input type="hidden" name="StudentID" value="@Model.StudentID" />
                                                                <input type="hidden" id="feemonth" name="FeeMonth" value="@mys.FeeMonth" />
                                                                <input type="hidden" name="FeeYear" value="@mys.FeeYear" />
                                                                @*<input type="hidden" name="ApplicableFee" value="@mys.ApplicableFee" />*@
                                                                <input type="hidden" name="ApplicableFee" id="totalApplicableFee" value="@Model.FeeWiseDetails.Where(c => c.FeeMonth == mys.FeeMonth && c.FeeYear == mys.FeeYear).Sum(x => x.ApplicableFee - x.RDiscount - x.PaidAmount).ToString("0.00")" />
                                                                <button type="submit" class="btn btn-link">Pay Now</button>
                                                                @*<h5><a href="/Payment/Index/@Model.FeeWiseDetails.Where(c => c.FeeMonth == mys.FeeMonth && c.FeeYear == mys.FeeYear).Sum(x => x.ApplicableFee-x.RDiscount-x.PaidAmount).ToString("0")" class="">Pay Now</a></h5>*@
                                                            }
                                                        </td>

                                                        <td>@Model.FeeWiseDetails.Where(c => c.FeeMonth == mys.FeeMonth && c.FeeYear == mys.FeeYear).Sum(x => x.ApplicableFee - x.RDiscount - x.PaidAmount).ToString("0.00")</td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
