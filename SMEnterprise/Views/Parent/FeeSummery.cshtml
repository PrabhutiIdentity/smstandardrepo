    <script>
        $(document).ready(function () {

            /* ────────────────────────────────────────────────
               HELPERS
            ──────────────────────────────────────────────── */

            // Return all pending (unpaid) months sorted oldest → newest
            function getPendingMonths() {
                var list = [];
                $('.fee-checkbox').each(function () {
                    list.push({
                        month: parseInt($(this).data('month')),
                        year: parseInt($(this).data('year')),
                        amount: parseFloat($(this).data('amount')),
                        el: this
                    });
                });
                list.sort(function (a, b) {
                    return (a.year * 12 + a.month) - (b.year * 12 + b.month);
                });
                return list;
            }

            // Pending months BEFORE the given month that are NOT checked
            function getUncheckedPriorMonths(month, year) {
                var seq = year * 12 + month;
                return getPendingMonths().filter(function (m) {
                    return (m.year * 12 + m.month) < seq && !$(m.el).is(':checked');
                });
            }

            // Checked months AFTER the given month
            function getCheckedLaterMonths(month, year) {
                var seq = year * 12 + month;
                return getPendingMonths().filter(function (m) {
                    return (m.year * 12 + m.month) > seq && $(m.el).is(':checked');
                });
            }

            // Format month name
            function monthLabel(m, y) {
                return new Date(y, m - 1, 1)
                    .toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
            }

            /* ────────────────────────────────────────────────
               TOAST
            ──────────────────────────────────────────────── */
            var toastTimer;

            function showToast(title, detail, missingChips, autoChips) {
                clearTimeout(toastTimer);

                var chipsHtml = '';
                (missingChips || []).forEach(function (m) {
                    chipsHtml += '<span class="toast-month-chip">' + monthLabel(m.month, m.year) + '</span>';
                });
                (autoChips || []).forEach(function (m) {
                    chipsHtml += '<span class="toast-month-chip auto-added">'
                        + '<i class="fa fa-plus-circle"></i> '
                        + monthLabel(m.month, m.year) + '</span>';
                });

                $('#toast-msg .toast-title').text(title);
                $('#toast-msg .toast-detail').html(detail);
                $('#toast-msg .toast-months').html(chipsHtml);
                $('#toast-msg').addClass('show');

                toastTimer = setTimeout(function () {
                    $('#toast-msg').removeClass('show');
                }, 5500);
            }

            /* ────────────────────────────────────────────────
               CHECKBOX — prevent click bubbling to collapse
            ──────────────────────────────────────────────── */
            $('.fee-checkbox-wrapper').on('click', function (e) {
                e.stopPropagation();
            });

            /* ────────────────────────────────────────────────
               CHECKBOX — change handler
            ──────────────────────────────────────────────── */
            $('.fee-checkbox').on('change', function () {
                var $cb = $(this);
                var month = parseInt($cb.data('month'));
                var year = parseInt($cb.data('year'));

                if ($cb.is(':checked')) {

                    /* ── User checked a month ── */
                    var prior = getUncheckedPriorMonths(month, year);

                    if (prior.length > 0) {
                        // Auto-select all prior unpaid months
                        prior.forEach(function (m) {
                            $(m.el).prop('checked', true);
                            $(m.el).closest('.panel')
                                .addClass('selected-row auto-added-row');
                        });

                        showToast(
                            'Previous Months Added Automatically',
                            'These overdue months were <b>automatically selected</b> because they must be paid first:',
                            null,       // no "missing" chips
                            prior       // show auto-added chips (green)
                        );
                    }

                    $cb.closest('.panel').addClass('selected-row').removeClass('auto-added-row');

                } else {

                    /* ── User unchecked a month ── */
                    var later = getCheckedLaterMonths(month, year);

                    if (later.length > 0) {
                        // Block the uncheck — re-check and shake
                        $cb.prop('checked', true);
                        $cb.closest('.panel').addClass('selected-row');

                        var $wrapper = $cb.closest('.fee-checkbox-wrapper');
                        $wrapper.addClass('shake');
                        setTimeout(function () { $wrapper.removeClass('shake'); }, 450);

                        showToast(
                            'Cannot Deselect This Month',
                            'Deselect the later months first before removing this one:',
                            later,   // show blocked later months (yellow)
                            null
                        );
                        return; // stop — do not update UI
                    }

                    $cb.closest('.panel').removeClass('selected-row auto-added-row');
                }

                updateFloatingBar();
            });

            /* ────────────────────────────────────────────────
               UPDATE FLOATING BAR
            ──────────────────────────────────────────────── */
            function updateFloatingBar() {
                var total = 0, count = 0;

                $('.fee-checkbox:checked').each(function () {
                    total += parseFloat($(this).data('amount'));
                    count++;
                    $(this).closest('.panel').addClass('selected-row');
                });

                $('.fee-checkbox:not(:checked)').each(function () {
                    var $panel = $(this).closest('.panel');
                    if (!$panel.hasClass('auto-added-row')) {
                        $panel.removeClass('selected-row');
                    }
                });

                $('#selected-total').text(total.toFixed(2));
                $('#selected-count').text(count);
                $('#month-plural').text(count === 1 ? '' : 's');

                if (count > 0) {
                    $('#floating-pay-bar').fadeIn(300);
                } else {
                    $('#floating-pay-bar').fadeOut(300);
                }
            }

            /* ────────────────────────────────────────────────
               PAY NOW
            ──────────────────────────────────────────────── */
            $('#btnPaySelected').on('click', function () {
                var selectedData = [];
                var names = [];

                // Collect checked months
                $('.fee-checkbox:checked').each(function () {
                    var m = parseInt($(this).data('month'));
                    var y = parseInt($(this).data('year'));
                    var a = parseFloat($(this).data('amount'));
                    selectedData.push({ Month: m, Year: y, Amount: a });
                    names.push(monthLabel(m, y));
                });

                if (selectedData.length === 0) {
                    alert('Please select at least one month to proceed with payment.');
                    return;
                }

                // Sort oldest first before submitting
                selectedData.sort(function (a, b) {
                    return (a.Year * 12 + a.Month) - (b.Year * 12 + b.Month);
                });

                var total = $('#selected-total').text();
                var msg = 'You are about to pay for:\n\n'
                    + '• ' + names.join('\n• ')
                    + '\n\nTotal Amount: ₹' + total
                    + '\n\nProceed with payment?';

                if (confirm(msg)) {
                    $('#loadingOverlay').addClass('active');
                    $('#SelectedMonthsJson').val(JSON.stringify(selectedData));
                    $('#bulkPaymentForm').submit();
                }
            });

            // Init
            updateFloatingBar();
        });
    </script>
}
