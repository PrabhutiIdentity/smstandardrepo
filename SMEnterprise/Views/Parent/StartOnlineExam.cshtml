<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="x_title">
            <h2>Start Online Test</h2>
            <h2> <small style="color:red">*Do not press back button or refresh browser, the answers will not be saved, and remember to submit your test by cliking the submit button located at the bottom.</small></h2>
            <h2> <small style="color:red">*Please note that any submission after exam end time will not be considered.</small></h2>
            @*<ul class="nav navbar-right panel_toolbox">
                    <li>
                        @using (Html.BeginForm("OnlineExams", "Parent", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @style = "display:inline-table" }))
