@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>P-School | Report Card</title>
    <!-- Bootstrap -->
  
    <script src="@Url.Content("~/js/jquery.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/js/MD5.js")" type="text/javascript"></script>
    <link href="@Url.Content("~/css/bootstrap.min.css")" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="@Url.Content("~/css/font-awesome.min.css")" rel="stylesheet">
   
    <link href="@Url.Content("~/css/local.css")" rel="stylesheet" />
   
</head>
<body class="login-bgone">
    <div class="loginpage-head">
        <div class="container">
            <div class="row">
                <div class="col-md-2"></div>
                <div class="col-md-8">
                    <div class="row login-bgwh">
                        <div class="col-md-12" style="padding: 0;">
                            <div class="bor-righ">
                                <div class="login-imgone">
                                    <img src="@Url.Content("~/images/logo.png")" alt="pschool-logo" class="img-responsive" />
                                </div>
                                <div class="login_content">
                                    <a class="hiddenanchor" id="signup"></a>
                                    <a class="hiddenanchor" id="signin"></a>

                                    @using (Html.BeginForm("StudentReportCard", "Home", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "LoginForm" }))
                                    {
                                        <h1>Fill Student Details</h1>
                                        if (TempData["Message"] != null)
                                        {
                                            <div style="color:red;">@TempData["Message"].ToString()</div>
                                        }
                                        <div>
                                            <label>Student DOB <small>(mm/dd/yyyy)</small></label>
                                            <input type="date" id="txtDOB" class="form-control" placeholder="DOB" required="" name="DOB" />
                                        </div>
                                        <div>
                                            <label>Student ID / School SR. No.</label>
                                            <input type="text" id="txtStudentSID" class="form-control" name="StudentSID" placeholder="StudentSID" required="" />
                                        </div>
                                        <div>
                                            <button type="submit" class="btn btn-default submit btnone"><span><i class="fa fa-lock" aria-hidden="true"></i></span> Get Result</button>
                                          
                                        </div>
                                        <div class="clearfix"></div>
                                        <div class="separator">

                                           
                                        </div>
                                    }

                                </div>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2"></div>
            </div>
        </div>
    </div>
    <script src="@Url.Content("~/js/local.js")"></script>
</body>
</html>