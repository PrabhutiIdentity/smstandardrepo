    <script>
        function EncLogin() {
            if ($("#txtpassword").val() != "") {
                var id = $("#txtpassword").val();
                var salt = '@ViewBag.Salt';
                var id2 = hex_md5(String(id + 'd2f*jk#g&h'));
                var id3 = hex_md5(String(id2 + salt));
                $("#txtpassword").val(id3);
                return true;
            } else {
                return false;
            }
        }
        function GetEncLogin() {
            if ($("#txtpassword").val() != "") {
                var id = $("#txtpassword").val();
                var id2 = hex_md5(String(id + 'd2f*jk#g&h'));
                $("#txtpassword").val(id2);
                return true;
            } else {
                return false;
            }
        }
        var DynamicSalt = '';
        var UUID = '860848030107289_0';
        function EncLogin2() {
            if ($("#txtpassword").val() != "") {
                var id = '030pschool030';
                var salt = 'IROQBXXXZU';
                var id2 = hex_md5(String(id + 'd2f*jk#g&h'));
                var id3 = hex_md5(String(id2 + salt));
                $("#txtpassword").val(id3);
            }
        }
        function ClearIndex() {
            $.ajax({ url: '/api/CommonApi/ClearLuceneIndex', type: 'get', dataType: 'json', data: { UUID: UUID },
                success: function (data) {}, error: function (xhr, t, e) { console.log(t); } });
        }
        function GetDynamicSalt() {
            $.ajax({ url: '/api/CommonApi/GetLoginDynamicSalt', type: 'get', dataType: 'json', data: { UUID: UUID },
                success: function (data) { DynamicSalt = data; }, error: function (xhr, t, e) { console.log(t); } });
        }
        function GetListForAttandance(pass) {
            $.ajax({ url: '/api/ParentApi/GetStudentTransportMap', type: 'Post', dataType: 'json', data: { UUID: UUID, ID: 14 },
                success: function (data) { console.log(JSON.stringify(data)); }, error: function (xhr, t, e) { console.log(t); } });
        }
        function ApiLogin(pass) {
            var Password = 'GAUR0101';
            var id2 = hex_md5(String(Password + 'd2f*jk#g&h'));
            var id3 = hex_md5(String(id2 + DynamicSalt));
            $.ajax({ url: '/api/CommonApi/Login', type: 'Post', dataType: 'json',
                data: { UUID: UUID, username: 'EMP000002', deviceType: 'EMP000002', deviceToken: 'EMP000002', password: id3 },
                success: function (data) { console.log(JSON.stringify(data)); }, error: function (xhr, t, e) { console.log(t); } });
        }
        function ApiParentLogin(pass) {
            var Password = '030prabhuti030';
            var id2 = hex_md5(String(Password + 'd2f*jk#g&h'));
            var id3 = hex_md5(String(id2 + 'GBUCDBUKSR'));
            console.log(id3);
        }
        function GetLuceneDataList() {
            $.ajax({ url: '/api/CommonApi/GetLuceneData', type: 'Post', dataType: 'json', data: { UUID: 1, ID: 14 },
                success: function (data) { console.log(JSON.stringify(data)); }, error: function (xhr, t, e) { console.log(t); } });
        }
        function GenerateJSON() {
            var dates = ['2020-03-28', '2020-03-29', '2020-03-30'];
            var jsonObj = "{";
            for (var i = 0; i < dates.length; i++) {
                var jsitem = "";
                if (jsonObj != "{") { jsonObj = jsonObj + ','; }
                jsitem = "\"'" + dates[i] + "'\":{";
                jsitem = jsitem + "\"customStyles\":{";
                jsitem = jsitem + "\"container\": {";
                jsitem = jsitem + "\"backgroundColor\": \"green\"";
                jsitem = jsitem + "},";
                jsitem = jsitem + "\"text\": {";
                jsitem = jsitem + "\"color\": \"black\",";
                jsitem = jsitem + "\"fontWeight\": \"bold\"";
                jsitem = jsitem + "}";
                jsitem = jsitem + "}";
                jsitem = jsitem + "}";
                jsonObj = jsonObj + jsitem;
            }
            jsonObj = jsonObj + "}";
            console.log(JSON.parse(jsonObj));
        }
    </script>
</head>

