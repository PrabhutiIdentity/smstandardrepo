﻿@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>P-School | Login</title>

    <script src="@Url.Content("~/js/jquery.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/js/MD5.js")" type="text/javascript"></script>
    <link href="@Url.Content("~/css/bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/font-awesome.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/local.css")" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

    <script>
        function EncLogin() {
            if ($("#txtpassword").val() != "") {
                var id = $("#txtpassword").val();
                var salt = '@ViewBag.Salt';
                var id2 = hex_md5(String(id + 'd2f*jk#g&h'));
                var id3 = hex_md5(String(id2 + salt));
                $("#txtpassword").val(id3);
                return true;
            } else {
                return false;
            }
        }
        function GetEncLogin() {
            if ($("#txtpassword").val() != "") {
                var id = $("#txtpassword").val();
                var id2 = hex_md5(String(id + 'd2f*jk#g&h'));
                $("#txtpassword").val(id2);
                return true;
            } else {
                return false;
            }
        }
        var DynamicSalt = '';
        var UUID = '860848030107289_0';
        function EncLogin2() {
            if ($("#txtpassword").val() != "") {
                var id = '030pschool030';
                var salt = 'IROQBXXXZU';
                var id2 = hex_md5(String(id + 'd2f*jk#g&h'));
                var id3 = hex_md5(String(id2 + salt));
                $("#txtpassword").val(id3);
            }
        }
        function ClearIndex() {
            $.ajax({ url: '/api/CommonApi/ClearLuceneIndex', type: 'get', dataType: 'json', data: { UUID: UUID },
                success: function (data) {}, error: function (xhr, t, e) { console.log(t); } });
        }
        function GetDynamicSalt() {
            $.ajax({ url: '/api/CommonApi/GetLoginDynamicSalt', type: 'get', dataType: 'json', data: { UUID: UUID },
                success: function (data) { DynamicSalt = data; }, error: function (xhr, t, e) { console.log(t); } });
        }
        function GetListForAttandance(pass) {
            $.ajax({ url: '/api/ParentApi/GetStudentTransportMap', type: 'Post', dataType: 'json', data: { UUID: UUID, ID: 14 },
                success: function (data) { console.log(JSON.stringify(data)); }, error: function (xhr, t, e) { console.log(t); } });
        }
        function ApiLogin(pass) {
            var Password = 'GAUR0101';
            var id2 = hex_md5(String(Password + 'd2f*jk#g&h'));
            var id3 = hex_md5(String(id2 + DynamicSalt));
            $.ajax({ url: '/api/CommonApi/Login', type: 'Post', dataType: 'json',
                data: { UUID: UUID, username: 'EMP000002', deviceType: 'EMP000002', deviceToken: 'EMP000002', password: id3 },
                success: function (data) { console.log(JSON.stringify(data)); }, error: function (xhr, t, e) { console.log(t); } });
        }
        function ApiParentLogin(pass) {
            var Password = '030prabhuti030';
            var id2 = hex_md5(String(Password + 'd2f*jk#g&h'));
            var id3 = hex_md5(String(id2 + 'GBUCDBUKSR'));
            console.log(id3);
        }
        function GetLuceneDataList() {
            $.ajax({ url: '/api/CommonApi/GetLuceneData', type: 'Post', dataType: 'json', data: { UUID: 1, ID: 14 },
                success: function (data) { console.log(JSON.stringify(data)); }, error: function (xhr, t, e) { console.log(t); } });
        }
        function GenerateJSON() {
            var dates = ['2020-03-28', '2020-03-29', '2020-03-30'];
            var jsonObj = "{";
            for (var i = 0; i < dates.length; i++) {
                var jsitem = "";
                if (jsonObj != "{") { jsonObj = jsonObj + ','; }
                jsitem = "\"'" + dates[i] + "'\":{";
                jsitem = jsitem + "\"customStyles\":{";
                jsitem = jsitem + "\"container\": {";
                jsitem = jsitem + "\"backgroundColor\": \"green\"";
                jsitem = jsitem + "},";
                jsitem = jsitem + "\"text\": {";
                jsitem = jsitem + "\"color\": \"black\",";
                jsitem = jsitem + "\"fontWeight\": \"bold\"";
                jsitem = jsitem + "}";
                jsitem = jsitem + "}";
                jsitem = jsitem + "}";
                jsonObj = jsonObj + jsitem;
            }
            jsonObj = jsonObj + "}";
            console.log(JSON.parse(jsonObj));
        }
    </script>
</head>

<body class="login-bgone">
    <main class="login-page">
        <section class="login-card" aria-label="P-School login">
            <div class="login-form-panel">
                <div class="user-mark">
                    <img src="@Url.Content("~/images/logo.png")" alt="P-School" />
                </div>

                @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "LoginForm" }))
                {
                    @Html.AntiForgeryToken()

                    if (ViewBag.LoginError != null)
                    {
                        <div class="login-error-box">
                            <i class="fa fa-exclamation-circle"></i>
                            @ViewBag.LoginError
                        </div>
                    }

                    <div class="line-field">
                        <i class="fa fa-envelope-o" aria-hidden="true"></i>
                        <label class="sr-only" for="txtUserName">Email ID or username</label>
                        <input type="text" id="txtUserName" placeholder="Email ID"
                               required name="username" autocomplete="username" />
                    </div>

                    <div class="line-field">
                        <i class="fa fa-lock" aria-hidden="true"></i>
                        <label class="sr-only" for="txtpassword">Password</label>
                        <input type="password" id="txtpassword" name="Password"
                               placeholder="Password" required autocomplete="current-password" />
                    </div>

                    <input type="hidden" name="salt" value="@ViewBag.Salt" />

                    <button type="submit" class="btn-login" onclick="return EncLogin();">LOGIN</button>

                    <div class="debug-links-hidden">
                        <a href="/Home/StartSchedule">Send SMS?</a>
                        <a href="javascript:void(0);" onclick="GenerateJSON();">Generate JSON</a>
                        <a href="javascript:void(0);" onclick="GetListForAttandance('asas');">GetStudentList</a>
                        <a href="javascript:void(0);" onclick="ApiLogin();">Login</a>
                        <a href="javascript:void(0);" onclick="ApiParentLogin();">PLogin</a>
                        <a href="javascript:void(0);" onclick="GetDynamicSalt();">DynamicSalt</a>
                        <a href="javascript:void(0);" onclick="ClearIndex();">ClearIndex</a>
                        <a href="javascript:void(0);" onclick="EncLogin2();">GetAllIndexed</a>
                        <ul>
                            @foreach (var d in SMEnterprise.Repository.CommonUsage.ConnectionStrings)
                            {
                                <li>@d.Key -> @d.Value</li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <div class="login-info-panel">
                <div class="brand-row">
                    <span class="brand-mark">P</span>
                    <strong>P-School</strong>
                </div>

                <span class="platform-badge">Smart school platform</span>
                <h1>Solution at a glance</h1>
                <p class="info-desc">
                    A web-based school management platform that streamlines operations and keeps every stakeholder connected in real time.
                </p>

                <div class="feature-block">
                    <div class="feature-heading">
                        <i class="fa fa-file-text-o" aria-hidden="true"></i>
                        <strong>Exam management</strong>
                    </div>
                    <ul>
                        <li>Schedule and grade exams</li>
                        <li>Automatic report cards</li>
                        <li>Parent-accessible result portal</li>
                    </ul>
                </div>

                <div class="feature-block">
                    <div class="feature-heading">
                        <i class="fa fa-money" aria-hidden="true"></i>
                        <strong>Fee management</strong>
                    </div>
                    <ul>
                        <li>Online and offline collection</li>
                        <li>Late fee and discount handling</li>
                        <li>Defaulter and dues reports</li>
                    </ul>
                </div>

                <div class="alert-feature">
                    <i class="fa fa-bell-o" aria-hidden="true"></i>
                    <span>Real-time SMS alerts for teachers and parents</span>
                </div>

                <div class="stats-row">
                    <div class="stat-box"><strong>500+</strong><span>Schools</span></div>
                    <div class="stat-box"><strong>15+</strong><span>Modules</span></div>
                    <div class="stat-box"><strong>99%</strong><span>Uptime</span></div>
                </div>

                <a class="website-link" href="https://pschoolonline.in/" target="_blank" rel="noopener noreferrer">
                    Visit P-School Website <i class="fa fa-external-link" aria-hidden="true"></i>
                </a>
            </div>
        </section>
    </main>

    <script src="@Url.Content("~/js/local.js")"></script>
</body>
</html>
