@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    ViewBag.Title = "Submission Details";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}
@section IncludeCss
{
    <title>Submission Details</title>
    <style>
        .tab-bx {
            padding-left: 10px;
            padding-right: 10px;
        }
    </style>
}
@model SMEnterprise.Models.AssignmentSubmissionModel
<div class="x_panel">

    <div class="x_content">

        <div class="">

            <div class="clearfix"></div>
            <div class="row">
                <div class="col-md-12">
                    <div class="row" id="StudentDetail">
                        <input type="hidden" name="AssResponseID" value="@Model.AssResponseID" id="hdnAssResponseID" />
                        <div class="form-group form-box">
                            <div class="row">
                                <label class="col-md-2">Status : </label>
                                <div class="col-md-5">
                                    <label class="radio-inline">
                                        <input name="Status" value="0" id="rbStatusincomplete" @(Model.Status == 0 ? "checked" : "") type="radio">Incomplete
                                    </label>
                                    <label class="radio-inline">
                                        <input name="Status" value="1" id="rbStatusPartial" @(Model.Status == 1 ? "checked" : "") type="radio">Partial
                                    </label>
                                    <label class="radio-inline">
                                        <input name="Status" value="2" id="rbStatusComplete" @(Model.Status == 2 ? "checked" : "") type="radio">Complete
                                    </label>
                                    <label class="radio-inline">
                                        <input name="Status" value="3" id="rbStatusReviewed" type="radio" @(Model.Status == 3 ? "checked" : "")>Reviewed
                                    </label>
                                </div>
                                <div class="col-md-2">
                                    Grade :
                                </div>
                                <div class="col-md-3">
                                    <select id="ddlGrade" name="Grade" class="form-control">
                                        <option value="-" @(Model.Grade == "-" ? "selected" : "")>-</option>
                                        <option value="A+" @(Model.Grade == "A+" ? "selected" : "")>A+</option>
                                        <option value="A" @(Model.Grade == "A" ? "selected" : "")>A</option>
                                        <option value="B+" @(Model.Grade == "B+" ? "selected" : "")>B+</option>
                                        <option value="B" @(Model.Grade == "B" ? "selected" : "")>B</option>
                                        <option value="C+" @(Model.Grade == "C+" ? "selected" : "")>C+</option>
                                        <option value="C" @(Model.Grade == "C" ? "selected" : "")>C</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <ul class="nav nav-tabs responsive  hidden-xs hidden-sm" id="myTab">
                            <li class="active"><a id="tab1" href="#resp-tab1" data-toggle="tab" aria-expanded="true">Submission Details</a></li>
                            <li><a id="tab2" href="#resp-tab2" data-toggle="tab" aria-expanded="true"><i class="fa fa-paperclip" style="color: #266386;"></i>Attachments </a></li>
                            @*<li><a id="tab3" href="#resp-tab3" data-toggle="tab" aria-expanded="true">Comments </a></li>*@
                        </ul>
                        <div class="tab-content responsive  hidden-xs hidden-sm">
                            <div class="tab-pane active" id="resp-tab1">
                                <div class="row tab-bx animated fadeIn">
                                    <div class="col-md-12">

                                        <div class="form-group form-box">
                                            <div class="row">
                                                <label class="col-md-2">Description : </label>
                                                <div class="col-md-10">
                                                    <div id="txtDescription" style="width: 100%;"> @Model.Description</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group form-box">
                                            <div class="row">
                                                <label class="col-md-2">Reason : </label>
                                                <div class="col-md-10">
                                                    <div id="txtReason" style="width: 100%;">@Model.Reason</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="tab-pane" id="resp-tab2">
                                <div class="row tab-bx animated fadeIn">
                                    <div class="box-body">
                                        <br />
                                        <table id="tblAttachments" class="table table-bordered table-striped">
                                            <thead>
                                                <tr style="color: White; background-color: rgb(68, 88, 97)!important; font-weight: bold;" role="row">
                                                    <th>Attachment Name</th>
                                                    <th>Download </th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbdAttachments">
                                                @{
                                                    if (Model.Attachments != null)
                                                    {
                                                        var arrAttachments = Model.Attachments.Split(";".ToCharArray());
                                                        foreach (string att in arrAttachments)
                                                        {
                                                            <tr>
                                                                <td>att</td>
                                                                <td><a href="javascript:void(0);" onclick="DownloadAttachment(@Model.AssResponseID,'@att');"><i class="fa fa-download"></i></a></td>
                                                            </tr>
                                                        }
                                                    }
                                                }
                                            </tbody>
                                            <tfoot>
                                            </tfoot>
                                        </table>
                                    </div>

                                    <!-- Right Section Ends  -->

                                </div>

                            </div>
                            <div class="tab-pane" id="resp-tab3">
                                <div class="row tab-bx animated fadeIn">
                                    <div class="box-body">
                                        @Model.Comments
                                        @*<ul class="messages" id="ulCommentLayout">
                                            @{
                                                if (Model.Comments != null)
                                                {
                                                    string[] spliterArray = { "<[EndRec]>" };
                                                    var arrComments = Model.Comments.Split(spliterArray, StringSplitOptions.None);
                                                    foreach (var comd in arrComments)
                                                    {
                                                        string[] spliterPropArray = { "<[EndProp]>" };
                                                        var com = comd.Split(spliterPropArray, StringSplitOptions.None);
                                                        var usr = "Me";
                                                        if (com[0].Trim() == "0")
                                                        {
                                                            usr = "Me";
                                                        }
                                                        else
                                                        {
                                                            usr = "Student";
                                                        }
                                                        <li>

                                                            <div class="message_wrapper" @(usr == "Me" ? "style=margin-left:0px;" : "")>
                                                                <h4 class="heading"><ss id="txtUser">@usr</ss> :<ss id="txtTime">@com[1].Trim()</ss></h4>
                                                                <blockquote class="message" id="txtComment">@com[2].Trim()</blockquote>
                                                            </div>
                                                        </li>
                                                    }
                                                }
                                            }
                                        </ul>*@
                                    </div>
                                    @*<div class="form-group form-box">
                                        <div class="row">
                                            <label class="col-md-2" style="padding-right: 0px;">Comment : </label>
                                            <div class="col-md-12">

                                                <textarea id="txtNewComment" rows="5" style="width: 100%;resize:none;"></textarea>

                                            </div>

                                        </div>

                                    </div>*@
                                    <!-- Right Section Ends  -->
                                    <div class="col-md-12">
                                        <div class="pre-nxt-btn">
                                            <a class="btn btn-primary pull-right" onclick="return UpdateSubmissionStatus();" id="btnSave">Save</a>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <!-- Right Section Ends  -->

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="hdnCurrentTime" value="@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("MM-dd-yyyy HH:mm")" />
@section scripts
{
    <script src="@Url.Content("~/js/jquery.min.js")"></script>

    <script>
        function DownloadAttachment(ID, AttName) {
            var curUrl = window.location.href;
            var ind = curUrl.indexOf("Teacher");
            var BaseUrl = curUrl.substring(0, ind);
            var link = BaseUrl + 'Attachments/AssignmentSubmissions/' + ID + '_' + AttName;
            var a = $("<a>")
            .attr("href", link)
             .attr("download", AttName)
            .appendTo("body");

            a[0].click();

            a.remove();
        }
       
        function UpdateSubmissionStatus()
        {
            var Status=0;
            if($('#rbStatusPartial').is(":checked"))
            {
                Status=1;
            }
            else if($('#rbStatusComplete').is(":checked"))
            {
                Status=2;
            }
            else if($('#rbStatusReviewed').is(":checked"))
            {
                Status=3;
            }
            var comments = "";
            $('#ulCommentLayout').find('li').each(function () {
                if (comments != "") {
                    comments = comments + "<[EndRec]>";
                }
                var User = $(this).find('#txtUser').html() == 'Me' ? 0 : 1;
                var cmntTime = $(this).find('#txtTime').html();
                var cmntDesc = $(this).find('#txtComment').html();
                comments = comments + User + '<[EndProp]>' + cmntTime + '<[EndProp]>' + cmntDesc;
            });
            if ($('#txtNewComment').val() != "")
            {
                comments = comments + "<[EndRec]>0" + '<[EndProp]>' + $('#hdnCurrentTime').val() + '<[EndProp]>' + $('#txtNewComment').val();
            }
            $.ajax({
                url: "@Url.Action("UpdateAssignmentTeacherResponse", "Teacher")",
                type: 'POST',
            data: JSON.stringify({
                AssResponseID:$('#hdnAssResponseID').val(),
                Grade:$('#ddlGrade').val(),
                Status:Status,
                Comments:comments
            }),
            contentType: 'application/json; charset=utf-8',
            success: function (id) {
                if ($('#txtNewComment').val() != "")
                {
                    var comnt='<li><div class="message_wrapper" style="margin-left:0px;"><h4 class="heading"><ss id="txtUser">Me</ss> :<ss id="txtTime">'+$("#hdnCurrentTime").val()+'</ss></h4>'+
                    '<blockquote class="message" id="txtComment">' + $('#txtNewComment').val() + '</blockquote></div></li>'
                    $('#ulCommentLayout').append(comnt);
                }
                $('#txtNewComment').val('');
                ShowNotification('Saved', 'Your Response Saved Successfully!!!!', 'success');
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
            },
            async: true,
            processData: false
        });
        }
        $(function () {

        });
    </script>
    <!-- datepicker -->
    <script type="text/javascript">
       

        $(document).ready(function () {

        });
    </script>
}
