@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    var SectionID = 0;
    var SubjectID = 0;
}
@model SMEnterprise.Models.BBBOnlineClassListModel
@section IncludeCss
{
    <title>Online Classes</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">
}
<style>
    .frame-area {
        width: 100%; /* RESPONSIVE WIDTH */
        height: 100%;
        overflow: hidden !important; /* EDIT TO hidden FOR NO SCROLLBAR */
        margin: 0px;
        padding: 0px;
    }

    .Undone .slider-bar {
        background-color: rgba(255, 0, 0, 0.52) !important;
    }

    .Leave .slider-bar {
        background-color: rgba(96, 109, 115, 0.61) !important;
    }

    .holiday .slider-bar {
        background-color: rgba(255, 102, 0, 0.69) !important;
    }

    .normal .slider-bar {
        background-color: rgba(219, 199, 180, 0.68) !important;
    }

    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }


    .slider-bar.transition-enabled {
    }

    .radios-to-slider {
        margin-bottom: 40px !important;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("OnlineClasses", "Teacher", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @style = "width:100%" }))
                {
                    <div class="col-md-3">
                        <h3 class="box-title">Online Classes </h3>
                    </div>
                    <div class="row std-mng-head col-md-9">

                        <div class="col-md-12 class-section">
                            <div class="row">
                                <div class="col-md-6 padding">
                                    <label class="col-md-4 text-right" style="padding-right: 0px;">Class :</label>
                                    <div class="col-md-8">
                                        <input type="date" class="form-control col-md-8" id="txtStartDate" name="ClassDate" value="@Model.ClassDate.ToString("yyyy-MM-dd")" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <a href="javascript:void(0);" class="btn btn-info" onclick="$('#frmGetStudents').submit();">Search</a>
                                </div>
                                <div class="col-md-3">
                                    <a href="javascript:void(0);" class="btn btn-success" onclick="ScheduleClass(this, 0);">Add New</a>
                                </div>

                            </div>
                        </div>
                    </div>
                }
                <div class="x_panel">

                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 5%">#</th>
                                <th>Class / Section </th>
                                <th>Subject</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Recordings</th>
                                <th>Option</th>
                            </tr>
                        </thead>
                        @{
                            int count = 0;
                            foreach (var c in Model.Classes)
                            {
                                <tr>
                                    <td>@(count + 1)</td>
                                    <td>
                                        @c.ClassSection
                                    </td>
                                    <td>
                                        @c.SubjectName
                                    </td>

                                    <td>
                                        @(SMEnterprise.Repository.CommonUsage.ConvertToDateTime("2020-08-01 " + c.StartTime).ToString("hh:mm tt"))
                                    </td>
                                    <td>
                                        @(SMEnterprise.Repository.CommonUsage.ConvertToDateTime("2020-08-01 " + c.EndTime).ToString("hh:mm tt"))
                                    </td>
                                    <td>
                                        @c.Recordings.Count()
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-outline bg-slate-600 text-slate-600 border-slate dropdown-toggle" data-toggle="dropdown">Options</button>
                                            <ul class="dropdown-menu dropdown-menu-right">
                                                @if (c.Status == 0)
                                                {
                                                    <li>
                                                        <a href="/Teacher/JoinClass/@c.OCID" target="_blank" class="dropdown-item"><i class="icon-pencil4"></i> Start Class</a>
                                                    </li>
                                                }
                                                else if (c.Status == 1)
                                                {
                                                    <li>
                                                        <a href="/Teacher/JoinClass/@c.OCID" target="_blank" class="dropdown-item"><i class="icon-pencil4"></i> Rejoin Class</a>
                                                    </li>
                                                }
                                                else
                                                {
                                                    var ctr = 1;
                                                    foreach (var r in c.Recordings)
                                                    {
                                                        <li>
                                                            <form action="PlayRecording" method="post">
                                                                <input type="hidden" name="url" value="@r.PlaybackURL" />
                                                                <a href="Javascript:void(0);" onclick="$(this).closest('form').submit();" class="dropdown-item"><i class="icon-pencil4"></i> Play Recording @ctr</a>
                                                            </form>
                                                        </li>
                                                        ctr++;
                                                    }
                                                    <li>
                                                        <a href="Javascript:void(0);" onclick="ViewDetails(this,@c.OCID)" class="dropdown-item"><i class="icon-pencil4"></i> View Attendees</a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section pageBottom{
    <div id="mdlOnlineClassRecording" class="modal fade" role="dialog">
        <div class="modal-dialog" style="width:95%;">
            <!-- Modal content-->
            <div class="modal-content" style="min-height: 100vh;">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" onclick="removeRecordingPopup(this)">&times;</button>
                </div>
                <div class="modal-body">
                </div>
            </div>
        </div>
    </div>
    <div id="mdlAddOnlineClass" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Add Class for Date @Model.ClassDate.ToString("dd MMM,yyyy")</h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    @using (Html.BeginForm("UpdateOnlineClass", "Teacher", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @style = "width:100%" }))
                    {
                        <div class="row">
                            <div class="form-group col-md-12">
                                <label>Session</label>
                                <select class="form-control" name="SessionID">
                                    @foreach (var c in Model.Sessions)
                                    {
                                        <option value="@c.ID" @(c.Extra1 == "1" ? "selected" : "")>
                                            @c.Name
                                        </option>

                                    }
                                </select>
                            </div>
                            <div class="form-group col-md-12">
                                <label>Class</label>
                                <select class="form-control" name="SectionID" onchange="SectionChanged(this);">
                                    @foreach (var c in Model.ClassList)
                                    {
                                        if (SectionID == 0)
                                        {
                                            <option value="@c.ID" selected>
                                                @c.Name
                                            </option>
                                            SectionID = c.ID;
                                        }
                                        else
                                        {
                                            <option value="@c.ID">@c.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="form-group col-md-12">
                                <label>Subject</label>
                                <select class="form-control" name="SubjectID" id="ddlSubjects">
                                    @foreach (var c in Model.SubjectList)
                                    {
                                        if (SubjectID == 0 && c.Extra1 == SectionID.ToString())
                                        {
                                            <option secID="@c.Extra1" value="@c.ID" selected>@c.Name</option>
                                            SubjectID = c.ID;
                                        }
                                        else if (c.Extra1 == SectionID.ToString())
                                        {
                                            <option secID="@c.Extra1" value="@c.ID">@c.Name</option>
                                        }
                                        else
                                        {
                                            <option secID="@c.Extra1" value="@c.ID" style="display:none;">@c.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="form-group col-md-4">
                                <label>Start Time</label>
                                <input class="form-control" type="date" id="txtEClassDate" name="ClassDate" value="@Model.ClassDate.ToString("yyyy-MM-dd")">
                            </div>
                            <div class="form-group col-md-4">
                                <label>Start Time</label>
                                <input class="form-control" type="time" name="StartTime" value="@Model.ClassDate.ToString("HH:mm")">
                            </div>
                            <div class="form-group col-md-4">
                                <label>End Time</label>
                                <input class="form-control" type="time" name="EndTime" value="@Model.ClassDate.AddMinutes(30).ToString("HH:mm")">
                            </div>
                            <div class="col-md-12">
                                <button type="button" data-dismiss="modal" class="btn btn-primary pull-left">Cancel</button>
                                <button type="submit" onclick="return SubmitOnlineClassAddition(this)" class="btn btn-success btn-ladda btn-ladda-spinner" id="btnSaveResult" style="float:right;" data-spinner-color="#333" data-style="slide-down">
                                    <span class="ladda-label">Save</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
    <div style="display:none;" id="divBBBContainer">
        <div class="card">
            <!--<ul class="fab-menu fab-menu-absolute fab-menu-top-left" data-fab-toggle="hover" id="fab-menu-affixed-demo-right" style="top: 0.5rem;right:0.5rem">-->
            @*right:0.5rem*@
            <!--<li>
                    <a href="javascript:void(0);" onclick="EndClass();" class="fab-menu-btn btn btn-danger btn-float rounded-round btn-icon legitRipple">
                        <i class="icon-phone-slash"></i>
                    </a>
                </li>
            </ul>-->
            <div class="card-body" style="padding:0">


            </div>
            <input type="hidden" id="hdnClassJoinURL" />
        </div>
    </div>

    <div style="display:none;" id="divBBBRecordingContainer">
        <div class="card">
            <ul class="fab-menu fab-menu-absolute fab-menu-top-left" data-fab-toggle="hover" id="fab-menu-affixed-demo-right" style="top: 0.5rem;right:0.5rem">
                @*right:0.5rem*@
                <li>
                    <a href="javascript:void(0);" onclick="CloseSidePanel();" class="fab-menu-btn btn btn-danger btn-float legitRipple">
                        Close Recording
                    </a>
                </li>
            </ul>
            <div class="card-body" style="padding:0">
            </div>
        </div>
    </div>
}
@section scripts
{
    <script src="@Url.Content("~/js/Admin/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/js/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.radios-to-slider.min.js")"></script>

    <script>
        function removeRecordingPopup(sender) {

        }

        var connection = new signalR.HubConnectionBuilder()
        .withUrl("/OnlineClassHub")
        .build();

    connection.on("OnlineClassEnded", function (message) {
        ShowNotification('Class Ended', 'Thank you for presenting Online Class', 'info');
        CloseSidePanel();
    });

    connection.start();
    async function TestEndMeeting(Group, MeetingID) {
        await connection.invoke("OnlineClassEnded", "OClass-" + Group, MeetingID);
    }

    var pMeetingID = '';
    var MOCID = 0;
    var secid =@SectionID;
    var subID =@SubjectID;
    function SectionChanged(sender) {
        var secid = $(sender).val();
        subID = 0;
        $("#ddlSubjects > option").each(function () {
            var osecid = $(this).attr('secID');
            if (osecid == secid) {
                if (subID == 0) {
                    subID = this.value;
                }
                $(this).css('display', '');
            }
            else {
                $(this).css('display', 'none');
            }
        });
        $("#ddlSubjects").val(subID);
    }
    function ScheduleClass(sender, ID) {
        $('#mdlAddOnlineClass').modal('toggle');

    }
    function ReJoinClass(sender, OCID) {
        MOCID = OCID;
        BlockUI();
        if ($('#hdnClassJoinURL').val() == "") {
            $.ajax({
                url: "/Teacher/JoinClass/" + OCID,
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                success: function (URL) {
                    var iframe = ' <embed  id="meetingFrame" src="' + URL + '" style="width: 100%;height:100%" allowfullscreen="" allow="camera *; microphone *; fullscreen *;" frameborder="0">' +
                        '</embed>';
                    $('#divEdit').html($('#divBBBContainer').html());
                    $('#divEdit').find('.card-body').html(iframe);
                    $('#panel').css('-webkit-transform', 'scaleX(1)');
                    $('#panel').css('padding', '0');
                    $('#hdnClassJoinURL').val(URL);
                    UnBlockUI();
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
                },
                async: true,
                processData: false
            });
        }
        else {
            var URL = $('#hdnClassJoinURL').val();
            $('#panel').css('-webkit-transform', 'scaleX(1)');
            UnBlockUI();
        }
    }
    function TestSlider() {
        $('#divEdit').html($('#divBBBContainer').html());
        $('#panel').css('-webkit-transform', 'scaleX(1)');
    }
    function StartClass(sender, OCID,MeetingID) {
        MOCID = OCID;
        pMeetingID = MeetingID;
            BlockUI();
                $.ajax({
                    url: "/Teacher/JoinClass/" + OCID,
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    success: async function (URL) {
                        await connection.invoke("AddToGroup", "OClass-" + MeetingID);
                        var iframe = ' <iframe id="meetingFrame" src="' + URL + '" style="width: 100%;height:100%" allowfullscreen="" allow="camera *; microphone *; fullscreen *;" frameborder="0">' +
                            '</iframe >';
                        $('#divEdit').html($('#divBBBContainer').html());
                        $('#divEdit').find('.card-body').html(iframe);
                        $('#panel').css('-webkit-transform', 'scaleX(1)');
                        $('#panel').css('padding', '0');
                        $('#hdnClassJoinURL').val(URL);
                        UnBlockUI();
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
                    },
                    async: true,
                    processData: false
                });

    }
    function EndClass() {
        BlockUI();
        $.ajax({
            url: "/Teacher/EndClass/" + MOCID,
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            success: function (URL) {
                CloseSidePanel();
                window.location.reload();
                $('#hdnClassJoinURL').val('');
                UnBlockUI();
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
            },
            async: true,
            processData: false
        });

    }

    function PlayRecording(URL) {
        $('#mdlOnlineClassRecording').find('.modal-body').html('');
        var iframe = ' <iframe id="meetingFrame" class="frame-area" src="' + URL + '" style="width: 100%;min-height: 100vh;" frameborder="0">' +
            '</iframe >';
        //$('#divEdit').html($('#divBBBRecordingContainer').html());
        $('#mdlOnlineClassRecording').find('.modal-body').html(iframe);
        $('#mdlOnlineClassRecording').modal('show')
    }
    $(function () {
        var startpicker = $('#txtStartDate').pickadate();
        var EClassDate = $('#txtEClassDate').pickadate();

        Ladda.bind('.btn-ladda-spinner', {
            dataSpinnerSize: 16
        });
    });
    function ViewDetails(sender, OCID) {
        MOCID = OCID;
        BlockUI();
            $.ajax({
                url: "/Teacher/GetOnlineClassDetails/" + OCID,
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                success: function (html) {
                    $('#divEdit').html(html);
                    $('#panel').css('-webkit-transform', 'scaleX(1)');
                    UnBlockUI();
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
                },
                async: true,
                processData: false
            });
    }
    </script>
}
<!-- /.content -->
