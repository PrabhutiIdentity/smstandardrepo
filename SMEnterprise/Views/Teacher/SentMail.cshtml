@{
    ViewBag.Title = "MailBox";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}
@model SMEnterprise.Models.MailBoxModel
@section IncludeCss
{
    <title>P-School | Mailbox</title>

    <link src="@Url.Content("~/css/prettify.min.css")" rel="stylesheet">
    <link src="@Url.Content("~/css/select2.min.css")" rel="stylesheet">
    <style>
        .mail_list_column {
            overflow: auto;
            height: 500px;
        }

            .mail_list_column::-webkit-scrollbar-thumb {
                background-color: #000000;
            }

            .mail_list_column::-webkit-scrollbar {
                width: 7px;
            }

            .mail_list_column::-webkit-scrollbar-track {
                -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
            }

            .mail_list_column::-webkit-scrollbar-thumb {
                background-color: darkgrey;
                outline: 1px solid slategrey;
            }
    </style>
}
<div class="">

    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2>Sent Mail<small>School Mail</small></h2>
                    <ul class="nav navbar-right panel_toolbox"></ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <div class="row">
                        <div class="col-sm-3 mail_list_column" style="height: 500px;overflow: auto;">
                            <button id="compose" class="btn btn-sm btn-success btn-block" type="button">COMPOSE</button>
                            @if (Model.Mails.Count > 0)
                            {
                                foreach (var m in Model.Mails)
                                {
                                    <a href="javascript:void(0);" onclick="ShowMail(@m.MessageID,this);">
                                        <div class="mail_list">
                                            <div class="left">
                                                @if (m.IsRead == 1)
                                                {

                                                    <i class="fa fa-circle-o"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-circle"></i>
                                                }
                                            </div>
                                            <div class="right">
                                                <h3>@m.Name <small>@m.SendDate.ToString("dd MMM")</small></h3>
                                                <p>@m.MessageTitle</p>
                                            </div>
                                        </div>
                                    </a>
                                }
                            }
                            else
                            {
                                <a href="#">
                                    <div class="mail_list">
                                        <div class="left">
                                            <i class="fa fa-circle"></i>
                                        </div>
                                        <div class="right">

                                            <p>--No Messages--</p>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                        <!-- /MAIL LIST -->
                        <!-- CONTENT MAIL -->
                        <div class="col-sm-9 mail_view" style="height: 500px;overflow: auto;" id="messageshowcontainer">
                            @if (Model.Mail != null)
                            {
                                @Html.Partial("_MailViewPartial", Model.Mail);
                            }
                        </div>
                        <!-- /CONTENT MAIL -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="compose col-md-6 col-xs-12">
    @using (Html.BeginForm("SendMessage", "Message", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
    {
        <div class="compose-header">
            New Message
            <button type="button" class="close compose-close">
                <span>×</span>
            </button>
        </div>
        <div class="compose-body">
            <div id="alerts"></div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-addon">
                                <span>Type</span>
                            </div>

                            <input type="hidden" name="SenderID" value="@Model.Mail.CurrUserID" />
                            <input type="hidden" name="SenderType" value="@Model.Mail.CurrUserType" />
                            <input type="hidden" name="MainMailThreadID" id="hdnCMainMailThreadID" value="0" />
                            <input type="hidden" name="ParentMessageID" id="hdnCParentMessageID" value="0" />
                            <input type="hidden" name="SenderUrl" value="/Teacher/SentMail" />
                            <select class="form-control" id="ddlRecieverType" name="RecieverType" onchange="RecieverTypeChanged(this);">
                                <option value="4">Parent</option>
                                <option value="6">Student</option>
                                <option value="2">Account</option>
                                <option value="0">Principal</option>
                            </select>
                            <div class="input-group-addon">
                                <span>Reciever</span>
                            </div>
                            <select class="RecieverSelect form-control" name="RecieverID" id="ddlReciever">
                                @foreach (var rl in Model.RecieverList)
                                {
                                    <option value="@rl.ID">@rl.Name</option>

                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-addon">
                                <span>Subject</span>
                            </div>
                            <input type="text" id="txtMailSubject" name="MessageTitle" class="form-control" placeholder="Subject" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="btn-toolbar editor" data-role="editor-toolbar" data-target="#editor">
                <div class="btn-group" style="display:none;">
                    <a class="btn dropdown-toggle" data-toggle="dropdown" title="Font"><i class="fa fa-font"></i><b class="caret"></b></a>
                    <ul class="dropdown-menu"></ul>
                </div>
                <div class="btn-group">
                    <a class="btn dropdown-toggle" data-toggle="dropdown" title="Font Size"><i class="fa fa-text-height"></i>&nbsp;<b class="caret"></b></a>
                    <ul class="dropdown-menu">
                        <li>
                            <a data-edit="fontSize 5">
                                <p style="font-size:17px">Huge</p>
                            </a>
                        </li>
                        <li>
                            <a data-edit="fontSize 3">
                                <p style="font-size:14px">Normal</p>
                            </a>
                        </li>
                        <li>
                            <a data-edit="fontSize 1">
                                <p style="font-size:11px">Small</p>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="btn-group">
                    <a class="btn" data-edit="bold" title="Bold (Ctrl/Cmd+B)"><i class="fa fa-bold"></i></a>
                    <a class="btn" data-edit="italic" title="Italic (Ctrl/Cmd+I)"><i class="fa fa-italic"></i></a>
                    <a class="btn" data-edit="strikethrough" title="Strikethrough"><i class="fa fa-strikethrough"></i></a>
                    <a class="btn" data-edit="underline" title="Underline (Ctrl/Cmd+U)"><i class="fa fa-underline"></i></a>
                </div>
                <div class="btn-group">
                    <a class="btn" data-edit="insertunorderedlist" title="Bullet list"><i class="fa fa-list-ul"></i></a>
                    <a class="btn" data-edit="insertorderedlist" title="Number list"><i class="fa fa-list-ol"></i></a>
                    <a class="btn" data-edit="outdent" title="Reduce indent (Shift+Tab)"><i class="fa fa-dedent"></i></a>
                    <a class="btn" data-edit="indent" title="Indent (Tab)"><i class="fa fa-indent"></i></a>
                </div>
                <div class="btn-group">
                    <a class="btn" data-edit="justifyleft" title="Align Left (Ctrl/Cmd+L)"><i class="fa fa-align-left"></i></a>
                    <a class="btn" data-edit="justifycenter" title="Center (Ctrl/Cmd+E)"><i class="fa fa-align-center"></i></a>
                    <a class="btn" data-edit="justifyright" title="Align Right (Ctrl/Cmd+R)"><i class="fa fa-align-right"></i></a>
                    <a class="btn" data-edit="justifyfull" title="Justify (Ctrl/Cmd+J)"><i class="fa fa-align-justify"></i></a>
                </div>
                <div class="btn-group" style="display:none;">
                    <a class="btn dropdown-toggle" data-toggle="dropdown" title="Hyperlink"><i class="fa fa-link"></i></a>
                    <div class="dropdown-menu input-append">
                        <input class="span2" placeholder="URL" type="text" data-edit="createLink" />
                        <button class="btn" type="button">Add</button>
                    </div>
                    <a class="btn" data-edit="unlink" title="Remove Hyperlink"><i class="fa fa-cut"></i></a>
                </div>
                <div class="btn-group" style="display:none;">
                    <a class="btn" title="Insert picture (or just drag & drop)" id="pictureBtn"><i class="fa fa-picture-o"></i></a>
                    <input type="file" data-role="magic-overlay" data-target="#pictureBtn" data-edit="insertImage" />
                </div>
                <div class="btn-group">
                    <a class="btn" data-edit="undo" title="Undo (Ctrl/Cmd+Z)"><i class="fa fa-undo"></i></a>
                    <a class="btn" data-edit="redo" title="Redo (Ctrl/Cmd+Y)"><i class="fa fa-repeat"></i></a>
                </div>
            </div>
            <div id="editor" class="editor-wrapper" style="height:400px!important;"></div>
            <textarea type="text" name="MessageBody" id="txtMessageBody" style="display:none;"></textarea>
        </div>
        <div class="compose-footer">
            <button id="send" class="btn btn-sm btn-success" type="submit" onclick="return SaveMessage();">Send</button>
            <a onclick="$('#fuMailAttachment').click();" id="uploadAttachment" class="btn btn-sm btn-success">Attachment</a>
            <input type="file" id="fuMailAttachment" onchange="FileUploadSelected(this);" name="Attachment" style="display:none;" data-edit="insertImage" />
            <span id="sAttanchment"></span>
            <input type="hidden" id="hdnAttachments" name="Attachments" />
        </div>
    }
</div>
@section scripts
{
    <!-- FastClick -->
    <script src="@Url.Content("~/js/fastclick.js")"></script>
    <!-- NProgress -->
    <script src="@Url.Content("~/js/nprogress.js")"></script>
    <!-- bootstrap-wysiwyg -->
    <script src="@Url.Content("~/js/bootstrap-wysiwyg.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.hotkeys.js")"></script>
    <script src="@Url.Content("~/js/prettify.js")"></script>
    <script src="@Url.Content("~/js/select2.full.min.js")"></script>

    <script>
        $(document).ready(function () {
            function initToolbarBootstrapBindings() {
                var fonts = ['Serif', 'Sans', 'Arial', 'Arial Black', 'Courier',
                    'Courier New', 'Comic Sans MS', 'Helvetica', 'Impact', 'Lucida Grande', 'Lucida Sans', 'Tahoma', 'Times',
                    'Times New Roman', 'Verdana'
                ],
                  fontTarget = $('[title=Font]').siblings('.dropdown-menu');
                $.each(fonts, function (idx, fontName) {
                    fontTarget.append($('<li><a data-edit="fontName ' + fontName + '" style="font-family:\'' + fontName + '\'">' + fontName + '</a></li>'));
                });
                $('a[title]').tooltip({
                    container: 'body'
                });
                $('.dropdown-menu input').click(function () {
                    return false;
                })
                  .change(function () {
                      $(this).parent('.dropdown-menu').siblings('.dropdown-toggle').dropdown('toggle');
                  })
                  .keydown('esc', function () {
                      this.value = '';
                      $(this).change();
                  });

                $('[data-role=magic-overlay]').each(function () {
                    var overlay = $(this),
                      target = $(overlay.data('target'));
                    overlay.css('opacity', 0).css('position', 'absolute').offset(target.offset()).width(target.outerWidth()).height(target.outerHeight());
                });

                if ("onwebkitspeechchange" in document.createElement("input")) {
                    var editorOffset = $('#editor').offset();

                    $('.voiceBtn').css('position', 'absolute').offset({
                        top: editorOffset.top,
                        left: editorOffset.left + $('#editor').innerWidth() - 35
                    });
                } else {
                    $('.voiceBtn').hide();
                }
            }

            function showErrorAlert(reason, detail) {
                var msg = '';
                if (reason === 'unsupported-file-type') {
                    msg = "Unsupported format " + detail;
                } else {
                    console.log("error uploading file", reason, detail);
                }
                $('<div class="alert"> <button type="button" class="close" data-dismiss="alert">&times;</button>' +
                  '<strong>File upload error</strong> ' + msg + ' </div>').prependTo('#alerts');
            }

            initToolbarBootstrapBindings();

            $('#editor').wysiwyg({
                fileUploadError: showErrorAlert
            });

            prettyPrint();
        });
    </script>
    <!-- /bootstrap-wysiwyg -->
    <!-- compose -->
    <script>
        function DownloadAttachment(AttName) {
            var curUrl = window.location.href;
            var ind = curUrl.indexOf("Parent");
            var BaseUrl = curUrl.substring(0, ind);
            var link = BaseUrl + 'MailAttachments/' + AttName;
            var a = $("<a>")
            .attr("href", link)
             .attr("download", AttName)
            .appendTo("body");

            a[0].click();

            a.remove();
        }
        function SaveMessage() {
            $('#txtMessageBody').text($('#editor').html());
            $('#hdnAttachments').val($('#sAttanchment').html().trim());
            return true;
        }
        $('#compose, .compose-close').click(function () {
            $('#hdnCMailThreadID').val('0');
            $('#hdnCParentMessageID').val('0');
            $('#ddlRecieverType').val('3');
            $('#ddlReciever').val(0);
            $('#txtMailSubject').val('');

            $('#editor').html('')
            $('.compose').slideToggle();
        });
        function ReplyToMail(sender) {
            $('#hdnCMailThreadID').val($('#hdnMainMailThreadID').val());
            $('#hdnCParentMessageID').val($('#hdnMessageID').val());
            $('#ddlRecieverType').val($('#hdnRecieverType').val());
            $('#ddlReciever').val($('#hdnRecieverID').val());
            $('#txtMailSubject').val('Re: ' + $('#hMessageTitle').text().trim());
            var ReplyMailBody = '<br/><br/><br/>----------------------------------------<br/>' +
                'From : ' + $('#hdnSenderName').val() + '<br/> To : ' + $('#hdnRecieverName').val() + '<br/>' +
                'Date : ' + $('#pMessageDate').html().trim() + '<br/> Subject :' + $('#hMessageTitle').html().trim() + '<br/>'
            'Following Message --<br/>' + $('#divMessageBody').html().trim();
            $('#editor').html(ReplyMailBody)
            $('.compose').slideToggle();
        }
        function ForwardMail(sender) {
            $('#hdnCMailThreadID').val($('#hdnMainMailThreadID').val());
            $('#hdnCParentMessageID').val($('#hdnMessageID').val());
            $('#txtMailSubject').val('Fwd: ' + $('#hMessageTitle').text().trim());
            var ReplyMailBody = '<br/><br/><br/>----------------------------------------<br/>' +
                'From : ' + $('#hdnSenderName').val() + '<br/> To : ' + $('#hdnRecieverName').val() + '<br/>' +
                'Date : ' + $('#pMessageDate').html().trim() + '<br/> Subject :' + $('#hMessageTitle').html().trim() + '<br/>'
            'Following Message --<br/>' + $('#divMessageBody').html().trim();
            $('#editor').html(ReplyMailBody)
            $('.compose').slideToggle();
        }
        function ShowMail(id, sender) {
            $.ajax(
    {
        type: "POST",
        url: "/Teacher/GetMessageDetail/" + id + "/1",
        cache: false,
        processData: false,
        contentType: false,
        success: function (html) {
            $('#messageshowcontainer').html(html);
          
        },
        error: function (e) {
            alert("errorn");
        }
    });
        }
        function RecieverTypeChanged(sender) {
            if ($(sender).val() == "4" || $(sender).val() == "6") {
                $.ajax(
        {
            type: "POST",
            url: "/Teacher/GetRecieverListOptions/" + $(sender).val(),
            cache: false,
            processData: false,
            contentType: false,
            success: function (html) {
                $('#ddlReciever').html(html);
            },
            error: function (e) {
                alert("errorn");
            }
        });
            }
            else if ($(sender).val() == "2") {
                $('#ddlReciever').html('<option value="0">Account</option>');
            }
            else {
                $('#ddlReciever').html('<option value="0">Principal</option>');
            }
        }
    </script>>
    <!-- /compose -->
}