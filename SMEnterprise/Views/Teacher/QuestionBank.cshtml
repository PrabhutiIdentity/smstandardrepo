@using SMEnterprise.Models;
@using System.Web.Mvc;
@using Newtonsoft.Json;
@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    var MyID = ViewBag.UserID;
    TempData["QuestionBank"] = null;
}
@model SMEnterprise.Models.TeacherQuestionBankModel
@section IncludeCss
{
    <title>Question Bank</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">

    @*<link href="@Url.Content("~/css/prettify.min.css")" rel="stylesheet">
        <link href="@Url.Content("~/css/select2.min.css")" rel="stylesheet">*@

    <!-- include libraries(jQuery, bootstrap) -->
    <!-- include summernote css/js -->
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>

    <!-- KaTeX -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.9.0/katex.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.9.0/katex.min.js"></script>

    <script src="@Url.Content("~/js/Editor/summernote-math.js")"></script>

    <!--https://rawgit.com/tylerecouture/summernote-math/master/Example/example.html-->
}


<style>

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }


    .slider-bar.transition-enabled {
    }

    .radios-to-slider {
        margin-bottom: 40px !important;
    }

    .smallfont {
        font-size: 11px;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("QuestionBank", "Teacher", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
                {

                    <div class="row std-mng-head col-md-12">

                        <div class="col-md-12 class-section">
                            <div class="row">
                                <div class="col-md-3 padding">
                                    <label class="col-md-6 text-right" style="padding-right: 0px;">Questions by?</label>
                                    <div class="col-md-6">
                                        <select class="form-control smallfont" name="QuestionsBy" onchange="$('#frmGetStudents').submit();">

                                            <option value="0" @(0 == Model.QuestionsBy ? "selected" : "")>Me</option>
                                            <option value="1" @(1 == Model.QuestionsBy ? "selected" : "")>Other Teachers As Well</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3 padding">
                                    <label class="col-md-6 text-right" style="padding-right: 0px;">Class</label>
                                    <div class="col-md-6">
                                        <select class="form-control smallfont" name="ClassID" id="ddlClass" onchange="$('#frmGetStudents').submit();">
                                            @foreach (NameIDModel el in Model.Classes)
                                            {
                                                <option value="@el.ID" @(el.ID == Model.ClassID ? "selected" : "")>@el.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                @*<div class="col-md-3 padding">
                                    <label class="col-md-6 text-right" style="padding-right: 0px;">Class</label>
                                    <div class="col-md-6">
                                        <select class="form-control smallfont" name="ClassID" id="ddlClass" onchange="$('#frmGetStudents').submit();">
                                            @foreach (NameIDModel el in Model.Subjects)
                                            {
                                                <option value="@el.ID" @(el.ID == Model.ClassID ? "selected" : "")>@el.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>*@
                                <div class="col-md-3 padding">
                                    <div class="row">
                                        <label class="col-md-3 text-right padding-R" style="padding-left: 10px;">Search List : </label>
                                        <div class="col-md-7 padding-L" style="padding-left: 10px;">
                                            <input type="text" class="form-control" id="txtsearch" placeholder="Search Text" onkeyup="Search(this);" />
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <div class="x_panel">
                    <div class="x_content">
                        <ul class="messages">
                            @{
                                var ctr = 1;
                                foreach (var q in Model.Questions)
                                {
                                    <li class="queli">
                                        <div class="message_wrapper" style="margin-left: 0;">
                                                                        <h4 class="heading searchable">@(ctr). @Html.Raw(q.QuestionText) @*@q.QuestionText*@</h4>
                                            @if (q.QuestionType != 2)
                                            {
                                        <blockquote class="message col-md-6" style="font-size: 12px;">A. @Html.Raw(q.Option1)@*@q.Option1*@</blockquote>
                                        <blockquote class="message col-md-6" style="font-size: 12px;">B. @Html.Raw(q.Option2)@*@q.Option2*@</blockquote>
                                        <blockquote class="message col-md-6" style="font-size: 12px;">C. @Html.Raw(q.Option3)@*@q.Option3*@</blockquote>
                                        <blockquote class="message col-md-6" style="font-size: 12px;">D. @Html.Raw(q.Option4)@*@q.Option4*@</blockquote>
                                            }
                                            <br />
                                            <p class="url">
                                                Answer :  @Html.Raw(q.Answer)@*@q.Answer*@
                                            </p>
                                            <p class="url">
                                                Explaination :  @Html.Raw(q.Explaination)@*@q.Explaination*@
                                            </p>
                                            @if (q.TeacherID == MyID)
                                            {
                                                <div class="row">
                                                    <div class="col-md-7">
                                                        <label class="badge bg-green">@q.SubjectName</label>

                                                        <label class="badge bg-@(q.Complexity==0?"yellow":q.Complexity==1?"blue": "red")">@(q.Complexity==0?"Easy":q.Complexity==1?"Medium": "Difficult")</label>
                                                        <label class="badge bg-blue-gradient">Created on :@q.CreatedDate.ToString("dd MMM, yyyy")</label>
                                                    </div>
                                                    <div class="col-md-5" style="text-align: right;">
                                                        <a href="javascript:void(0);" onclick="EditQuestion(this,1,'@HttpUtility.JavaScriptStringEncode(JsonConvert.SerializeObject(q))');" class="btn btn-sm btn-primary">Edit</a> |
                                                        @using (Html.BeginForm("UpdateQuestionBank", "Teacher", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @style = "display:inline" }))
                                                        {
                                                            <input type="hidden" name="OpType" value="-1" />
                                                            <input type="hidden" name="QuestionID" value="@q.QuestionID" />
                                                            <button type="submit" href="javascript:void(0);" onclick="EditQuestion(this,-1,@q.QuestionID);" class="btn btn-sm btn-danger">Delete</button>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {

                                                <p class="url">
                                                    <div>
                                                        <label class="badge bg-green">@q.SubjectName</label>
                                                        <label class="badge bg-@(q.Complexity==0?"yellow":q.Complexity==1?"blue": "red")">@(q.Complexity==0?"Easy":q.Complexity==1?"Medium": "Difficult")</label>
                                                        <label class="badge bg-blue">@q.TeacherName</label>
                                                        <label class="badge bg-blue-gradient">Created on :@q.CreatedDate.ToString("dd MMM, yyyy")</label>
                                                    </div>
                                                </p>
                                            }
                                        </div>
                                    </li>
                                    ctr++;
                                }
                                <li class="queli">
                                    <a href="javascript:void(0);" onclick="EditQuestion(this,0,'');" class="btn btn-sm btn-primary">Add Question</a>
                                </li>
                            }
                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="mdlQuestion" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("UpdateQuestionBank", "Teacher", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
            {
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Update Question</h5>
                    <button type="submit" class="glyphicon glyphicon-floppy-saved" onclick="return SaveQuestion();" aria-label="Save changes"></button>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>

                </div>
                <div class="modal-body">

                    <div class="row">
                        <input type="hidden" name="QuestionID" id="hdnQuestionID" />
                        <input type="hidden" name="QuestionsBy" value="@Model.QuestionsBy" />
                        <div class="form-group col-md-3">
                            <label>Question Type</label>
                            <select class="form-control" name="QuestionType" id="ddlQuestionType" onchange="QuestionTypeChanged();">
                                <option value="0">Single Choice</option>
                                <option value="1">Multiple Choice</option>
                                <option value="2">Subjective</option>
                            </select>
                        </div>
                        <div class="form-group col-md-3">
                            <label>Question Complexity</label>
                            <select class="form-control" name="Complexity" id="ddlComplexity">
                                <option value="0">Easy</option>
                                <option value="1">Medium</option>
                                <option value="2">Difficult</option>
                            </select>
                        </div>
                        <div class="form-group col-md-3">
                            <label>Class</label>
                            <select class="form-control" name="ClassID" id="ddlClassID" onchange="ClassChanged();">
                                @foreach (NameIDModel el in Model.Classes)
                                {
                                    <option value="@el.ID" @(el.ID == Model.ClassID ? "selected" : "")>@el.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-md-3">
                            <label>Subjects</label>
                            <select class="form-control" name="SubjectID" id="ddlSubjects">
                                @foreach (NameIDModel el in Model.Subjects)
                                {
                                    <option value="@el.ID" classid="@el.Extra1">@el.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-md-12">
                            <label>Question</label>
                            
                            <textarea class="form-control" rows="3" style="resize:none;" name="QuestionText" id="txtQuestionText"></textarea>
                        </div>
                        <div class="form-group col-md-6 qoptions">
                            <label>Option 1</label>
                            @*<input type="text" class="form-control" name="Option1" id="txtOption1" />*@
                            <textarea class="form-control" rows="3" style="resize:none;" name="Option1" id="txtOption1"></textarea>
                        </div>
                        <div class="form-group col-md-6 qoptions">
                            <label>Option 2</label>
                            @*<input type="text" class="form-control" name="Option2" id="txtOption2" />*@
                            <textarea class="form-control" rows="3" style="resize:none;" name="Option2" id="txtOption2"></textarea>
                        </div>
                        <div class="form-group col-md-6 qoptions">
                            <label>Option 3</label>
                            @*<input type="text" class="form-control" name="Option3" id="txtOption3" />*@
                            <textarea class="form-control" rows="3" style="resize:none;" name="Option3" id="txtOption3"></textarea>
                        </div>
                        <div class="form-group col-md-6 qoptions">
                            <label>Option 4</label>
                            @*<input type="text" class="form-control" name="Option4" id="txtOption4" />*@
                            <textarea class="form-control" rows="3" style="resize:none;" name="Option4" id="txtOption4"></textarea>
                        </div>
                        <div class="form-group col-md-6 qoptions">
                            <label>Correct Answer</label>
                            <select class="form-control" name="AnswerOp" id="ddlAnswerOp">
                                <option value="A">Option 1</option>
                                <option value="B">Option 2</option>
                                <option value="C">Option 3</option>
                                <option value="D">Option 4</option>
                            </select>
                        </div>
                        <div class="form-group col-md-12 qsubjective">
                            <label>Answer</label>
                            <textarea class="form-control" rows="3" style="resize:none;" name="AnswerSub" id="txtSubjectiveAnswer"></textarea>
                        </div>
                        <input type="hidden" name="Answer" id="hdnAnswer" />
                        <div class="form-group col-md-12">
                            <label>Explaination</label>
                            <textarea class="form-control" rows="3" style="resize:none;" name="Explaination" id="txtExplaination"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary" onclick="return SaveQuestion();">Save changes</button>
                </div>
            }
        </div>
    </div>
</div>
<input type="hidden" id="hdnCurrDate" value="@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("yyy-MM-dd")" />

@section scripts
{
    <script>
    
            $(document).ready(function () {
                $('#txtQuestionText').summernote({
                  
                    height: 100,
                    toolbar: [
                        ['style', ['bold', 'italic', 'underline', 'clear']],
                        ['insert', ['picture', 'link', 'math']],
                        ['para', ['paragraph']],
                        ['misc', ['codeview']]
                    ],
                });
                $('#txtOption1').summernote({

                    height: 50,
                    toolbar: [
                        ['style', ['bold', 'italic', 'underline', 'clear']],
                        ['insert', ['picture', 'link', 'math']],
                        ['para', ['paragraph']],
                        ['misc', ['codeview']]
                    ],
                });
                $('#txtOption2').summernote({

                    height: 50,
                    toolbar: [
                        ['style', ['bold', 'italic', 'underline', 'clear']],
                        ['insert', ['picture', 'link', 'math']],
                        ['para', ['paragraph']],
                        ['misc', ['codeview']]
                    ],
                });
                $('#txtOption3').summernote({

                    height: 50,
                    toolbar: [
                        ['style', ['bold', 'italic', 'underline', 'clear']],
                        ['insert', ['picture', 'link', 'math']],
                        ['para', ['paragraph']],
                        ['misc', ['codeview']]
                    ],
                });
                $('#txtOption4').summernote({

                    height: 50,
                    toolbar: [
                        ['style', ['bold', 'italic', 'underline', 'clear']],
                        ['insert', ['picture', 'link', 'math']],
                        ['para', ['paragraph']],
                        ['misc', ['codeview']]
                    ],
                });
                $('#txtExplaination').summernote({

                    height: 100,
                    toolbar: [
                        ['style', ['bold', 'italic', 'underline', 'clear']],
                        ['insert', ['picture', 'link', 'math']],
                        ['para', ['paragraph']],
                        ['misc', ['codeview']]
                    ],
                });
                $('#txtSubjectiveAnswer').summernote({

                    height: 100,
                    toolbar: [
                        ['style', ['bold', 'italic', 'underline', 'clear']],
                        ['insert', ['picture', 'link', 'math']],
                        ['para', ['paragraph']],
                        ['misc', ['codeview']]
                    ],
                });
           

            //$('#txtQuestionText').summernote();
            //$('#txtOption1').summernote();
            //$('#txtOption2').summernote();
            //$('#txtOption3').summernote();
            //$('#txtOption4').summernote();
        });
    </script>
    <script>

        function SaveQuestion() {
            if ($('#ddlQuestionType').val() == 0) {
                $('#hdnAnswer').val($('#ddlAnswerOp').val())
            }
            else if ($('#ddlQuestionType').val() == 1) {
                $('#hdnAnswer').val($('#ddlAnswerOp').val())
            }
            else {
                $('#hdnAnswer').val($('#txtSubjectiveAnswer').val())
            }
        }
        var subjectid = 0;
        function ClassChanged() {
            var clsID = $('#ddlClassID').val();
            $("#ddlSubjects option").each(function () {
                if ($(this).attr('classid') == clsID) {
                    if (subjectid == 0) {
                        subjectid = this.value;
                    }
                    $(this).css('display', '');
                }
                else {
                    $(this).css('display', 'none');
                }
            });
            $('#ddlSubjects').val(subjectid);
        }
        function QuestionTypeChanged() {
            if ($('#ddlQuestionType').val() == 0) {
                $('.qsubjective').css('display', 'none');
                $('.qoptions').css('display', '');
                $('#ddlAnswerOp').removeAttr('multiple');
            }
            else if ($('#ddlQuestionType').val() == 1) {
                $('.qsubjective').css('display', 'none');
                $('.qoptions').css('display', '');
                $('#ddlAnswerOp').attr('multiple', 'multiple');
            }
            else {
                $('.qsubjective').css('display', '');
                $('.qoptions').css('display', 'none');
            }
        }
        function EditQuestion(sender, Type, Detail) {
            if (Type == 1) {
                var data = JSON.parse(Detail);
                $('#ddlQuestionType').val(data.QuestionType);
                QuestionTypeChanged();
                $('#ddlComplexity').val(data.Complexity);
                $('#ddlClassID').val(data.ClassID);
                subjectid = data.SubjectID;

                $('#txtQuestionText').summernote('code', data.QuestionText);
                $('#txtOption1').summernote('code', data.Option1);
                $('#txtOption2').summernote('code', data.Option2);
                $('#txtOption3').summernote('code', data.Option3);
                $('#txtOption4').summernote('code', data.Option4);
                //$('#txtQuestionText').val(data.QuestionText);
                //$('#txtOption1').val(data.Option1);
                //$('#txtOption2').val(data.Option2);
                //$('#txtOption3').val(data.Option3);
                //$('#txtOption4').val(data.Option4);
              

                if (data.Answer == null) {
                    data.Answer = "";
                }
                $('#ddlAnswerOp').val(data.Answer.split(','));
                //$('#txtSubjectiveAnswer').val(data.Answer);
                //$('#txtExplaination').val(data.Explaination);
                $('#txtSubjectiveAnswer').summernote('code',data.Answer);
                $('#txtExplaination').summernote('code',data.Explaination);
                $('#hdnQuestionID').val(data.QuestionID);
                ClassChanged();
                $('#mdlQuestion').modal('toggle');
            }
            else if (Type == 0) {
                $('#hdnQuestionID').val(0);
                $('#ddlQuestionType').val(0);
                $('#ddlComplexity').val(0);
                $('#ddlClassID').val($('#ddlClass').val());
                $('#ddlSubjects').val(0);
                //$('#txtQuestionText').val('');
                $('#txtQuestionText').summernote('code', '');
                subjectid = 0;
                //$('#txtOption1').val('');
                //$('#txtOption2').val('');
                //$('#txtOption3').val('');
                //$('#txtOption4').val('');
                $('#txtOption1').summernote('code', '');
                $('#txtOption2').summernote('code', '');
                $('#txtOption3').summernote('code', '');
                $('#txtOption4').summernote('code', '');
                $('#ddlAnswerOp').val('');
                $('#txtSubjectiveAnswer').val('');
                $('#txtExplaination').val('');
                QuestionTypeChanged();
                ClassChanged();
                $('#mdlQuestion').modal('toggle');
            }
            else {
                return confirm('Do you really want to delete this Question?');
            }
        }
        function Search(sender) {
            var sText = $(sender).val().split(',');
            if (sText[0] == "") {
                $('.queli').css('display', '');
            }
            else {
                $(".queli").each(function () {
                    var isExist = false;

                    $(this).find(".searchable").each(function () {
                        $srch = $(this);
                        $.each(sText, function (index, value) {
                            if ($srch.html().toLowerCase().includes(value.toLowerCase()) == true) {
                                isExist = true;
                            }
                        });

                    });
                    if (isExist == true) {
                        $(this).css('display', '');
                    }
                    else {
                        $(this).css('display', 'none');
                    }
                });
            }
        }

    </script>
}
<!-- /.content -->
