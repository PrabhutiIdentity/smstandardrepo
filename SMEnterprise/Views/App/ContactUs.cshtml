
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml"; 
}
@model SMEnterprise.Models.SBranchModel
<div class="banner1">
    <h3>Contact @Model.BranchSchoolName</h3>
</div>
<!-- //banner -->
<!-- contact -->
<div class="contact">
    <div class="agileits_mail_grids">
        <div class="col-md-4 agileits_mail_grid_right">
            
            <div class="agileits_mail_grid_right_grid">
                <h4>Contact Info</h4>
                <ul class="contact_info">
                    <li><i class="glyphicon glyphicon-map-marker" aria-hidden="true"></i>@Model.Address</li>
                    <li><i class="glyphicon glyphicon-envelope" aria-hidden="true"></i><a href="mailto:@Model.EmailID">@Model.EmailID</a></li>
                    <li><i class="glyphicon glyphicon-earphone" aria-hidden="true"></i>@Model.ContactNo</li>
                </ul>
            </div>
        </div>
        <div class="clearfix"> </div>
    </div>
</div>
<div class="map">
 
</div>