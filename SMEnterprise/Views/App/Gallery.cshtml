
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
@model List<SMEnterprise.Models.GalleryModel>
<style>
    .agile_gallery_grid_w3 p {
        background: #00000045;
        position: relative;
        top: -40px;
        color: white;
    }

        .agile_gallery_grid_w3 p a {
            color: white;
        }
</style>
<div class="gallery">
    <h3>Our Photo Gallery</h3>
    <div class="gallery_grids">
        @foreach (var g in Model)
            {
            <div class="agile_gallery_grid">
                <div class="agile_gallery_grid_w3" id="Gal_@g.GalleryID">
                    <a href="/App/GalleryImages/@g.GalleryID">
                        <img src='@Url.Content("~/images/GalleryImages/Thumb/")@g.FeatureImage' alt=" " />
                        <p style=''>@g.EventDate.ToString("dd MMM, yyyy")<br />@g.Title</p>
                    </a>
                </div>
            </div>
        }
        <div class="clearfix"> </div>

    </div>
</div>