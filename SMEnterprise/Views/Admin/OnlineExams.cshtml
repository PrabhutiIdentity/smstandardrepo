@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    TempData["OnlineExams"] = null;
}
@model SMEnterprise.Models.OnlineExamPageModel
@section IncludeCss
{
    <title>Online Exams</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">

}
<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }


    .slider-bar.transition-enabled {
    }

    .radios-to-slider {
        margin-bottom: 40px !important;
    }

    .smallfont {
        font-size: 11px;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">


                <div class="row std-mng-head col-md-12">

                    <div class="col-md-12 class-section">
                        <div class="row">
                            <div class="col-md-10">
                                <div class="row">
                                    @using (Html.BeginForm("OnlineExams", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetExams" }))
                                    {
                                        <input type="hidden" name="GroupID" value="@Model.GroupID" />
                                        <div class="col-md-3 padding">
                                            <label class="col-md-4 text-right" style="padding-right: 0px;">Session</label>
                                            <div class="col-md-8">
                                                <select class="form-control smallfont" name="SessionID" id="ddlSessions" onchange="$('#frmGetExams').submit();">
                                                    @foreach (NameIDModel el in Model.Sessions)
                                                    {
                                                        <option value="@el.ID" @(el.ID == Model.SessionID ? "selected" : "")>@el.Name @(el.Extra1 == "1" ? "(Active)" : "")</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-3 padding">
                                            <label class="col-md-4 text-right" style="padding-right: 0px;">Class</label>
                                            <div class="col-md-8">
                                                <select class="form-control smallfont" name="ClassID" id="ddlClass" onchange="ClassChanged();">
                                                    @foreach (NameIDModel el in Model.Classes)
                                                    {
                                                        <option value="@el.ID" @(el.ID == Model.ClassID ? "selected" : "")>@el.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        @*<div class="col-md-3 padding">
                                            <label class="col-md-4 text-right">Section</label>
                                            <div class="col-md-8">
                                                <select name="SectionID" class="form-control padding smallfont" id="ddlSection" onchange="SectionChanged();">
                                                     <option value="0">--Select--</option>
                                                    @foreach (NameIDModel el in Model.Sections)
                                                    {
                                                        <option value="@el.ID" classid="@el.Extra1" @(el.ID == Model.SectionID ? "selected" : "")>@el.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>*@
                                        <div class="col-md-3 padding">
                                            <label class="col-md-4 text-right">Subject</label>
                                            <div class="col-md-8">
                                                <select name="SubjectID" class="form-control smallfont" id="ddlSubjects" onchange="$('#frmGetExams').submit();">
                                                    <option value="0">--Select Subject--</option>
                                                    @foreach (NameIDModel el in Model.Subjects)
                                                    {
                                                        <option value="@el.ID" classid="@el.Extra1" sectionid="@el.Extra2" @(el.ID == Model.SubjectID ? "selected" : "")>@el.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-2 padding">
                                <a href="javascript:void(0);" onclick="$('#frmGetExams').submit();"><i class="fa fa-search"></i></a>
                                @using (Html.BeginForm("OnlineExamDetails", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @style = "display:inline-table" }))
                                {
                                    <input type="hidden" name="OExamID" value="0" />
                                    <input type="hidden" name="ClassID" value="@Model.ClassID" />
                                    <input type="hidden" name="SectionID" value="@Model.SectionID" />
                                    <input type="hidden" name="SubjectID" value="@Model.SubjectID" />
                                    <input type="hidden" name="SessionID" value="@Model.SessionID" />
                                    <input type="hidden" name="GroupID" value="@Model.GroupID" />
                                    <input type="hidden" name="TeacherID" value="@Model.TeacherID" />
                                    <button type="submit" href="javascript:void(0);" class="btn btn-sm btn-primary">Add New Exam</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="x_panel">

                    <div class="x_content">

                        <ul class="messages" style=" margin-top: 65px;">
                            @{
                                var ctr = 1;
                                foreach (var q in Model.Exams)
                                {
                                    <li class="queli">
                                        <div class="message_wrapper" style="margin-left: 0;">
                                            <h4 class="heading searchable"> <label title="number of exam submissions" class="badge bg-@(q.SubmissionCount==0?"red": "green")">@q.SubmissionCount</label> @(ctr). @q.ExamTitle</h4>
                                            <blockquote class="message" style="font-size: 12px;">@q.ExamDescription</blockquote>
                                            <br />
                                            <div class="row">
                                                <div class="col-md-10">
                                                    <label class="badge bg-@(q.Status==0?"red": "green")">@(q.Status == 0 ? "Inactive" : "Active")</label>
                                                    <label class="badge badge-info"> from @q.OExamStartDate.ToString("dd MMM, yyyy hh:mm tt") to  @q.OExamEndDate.ToString("dd MMM, yyyy hh:mm tt")</label>
                                                    <label class="badge badge-@(q.ExamPriority==0?"secondary":q.ExamPriority==1?"success": "danger")">@(q.ExamPriority == 0 ? "Low" : q.ExamPriority == 1 ? "Medium" : "High")</label>
                                                    <label class="badge bg-green">#Questions : @q.QuestionCount</label><label class="badge bg-green">#Total Marks : @q.TotalMarks</label>
                                                    <label class="badge bg-blue-gradient">Created on :@q.CreatedDate.ToString("dd MMM, yyyy")</label>
                                                </div>
                                                @if (q.SubmissionCount == 0)
                                                {
                                                    <div class="col-md-2" style="text-align: right;">

                                                        @using (Html.BeginForm("OnlineExamDetails", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @style = "display:inline-table" }))
                                                        {
                                                            <input type="hidden" name="OExamID" value="@q.OExamID" />@*@q.OExamID*@
                                                            <input type="hidden" name="ClassID" value="@Model.ClassID" />
                                                            <input type="hidden" name="SectionID" value="@Model.SectionID" />
                                                            <input type="hidden" name="SubjectID" value="@Model.SubjectID" />
                                                            <input type="hidden" name="SessionID" value="@Model.SessionID" />
                                                            <input type="hidden" name="GroupID" value="@Model.GroupID" />
                                                            <button type="submit" href="javascript:void(0);" class="btn btn-sm btn-primary">Edit</button>
                                                        } |

                                                        @using (Html.BeginForm("DeleteOnlineExam", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @style = "display:inline" }))
                                                        {
                                                            <input type="hidden" name="OpType" value="-1" />
                                                            <input type="hidden" name="OExamID" value="@q.OExamID" />
                                                            <button type="submit" href="javascript:void(0);" onclick="DeleteOnlineExam(this);" class="btn btn-sm btn-danger">Delete</button>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="col-md-2" style="text-align: right;">
                                                        <button type="button" onclick="OpenSubmissions(this,@q.OExamID)" class="btn btn-sm btn-primary">View Submissions</button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </li>
                                    ctr++;
                                }
                            }
                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="hdnCurrDate" value="@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("yyy-MM-dd")" />
<div class="modal fade" id="mdlSubmissions" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-body">

            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script src="@Url.Content("~/js/Admin/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/js/dataTables.bootstrap.min.js")"></script>

    <script>
        function OpenSubmissions(sender, ID) {
            $.ajax(
                {
                    type: "POST",
                    url: "/Teacher/GetOnlineExamSubmissions/" + ID,
                    cache: false,
                    processData: false,
                    contentType: false,
                    success: function (html) {
                        $('#mdlSubmissions').find('.modal-body').html(html);
                        $('#mdlSubmissions').modal('toggle');
                    },
                    error: function (e) {
                        alert("errorn");
                    }
                });
        }
        function DeleteOnlineExam() {
            return confirm('Do you really want to delete this exam?');
        }
        function ClassChanged() {
            var sectionid = 0;
            var clsID = $('#ddlClass').val();

            $("#ddlSection option").each(function () {
                if ($(this).attr('classid') == clsID) {
                    if (sectionid == 0) {
                        sectionid = this.value;
                    }
                    $(this).css('display', '');
                }
                else {
                    $(this).css('display', 'none');
                }
            });
            $('#ddlSection').val(sectionid);
            SectionChanged();
        }
        function SectionChanged() {
            var subjectid = 0;
            var secid = $('#ddlSection').val();
            $("#ddlSubjects option").each(function () {
                if ($(this).attr('sectionid') == secid) {
                    if (subjectid == 0) {
                        subjectid = this.value;
                    }
                    $(this).css('display', '');
                }
                else {
                    $(this).css('display', 'none');
                }
            });
            $('#ddlSubjects').val(subjectid);
            $('#frmGetExams').submit();
        }
        $(function () {

            $('#tblCategory').DataTable({
                "columnDefs": [{
                    "targets": 7,
                    "orderable": false
                }]
            });

        });

    </script>
}
<!-- /.content -->
