@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    ViewBag.Title = "You Tube Videos";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <title>You Tube Videos Management</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
}
@model SMEnterprise.Models.YouTubeAdminPageModel
<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    .thumbImage {
        max-width: 235px;
        max-height: 250px;
    }

    *html .thumbImage {
        width: expression((this.width/this.height)>=1?250:'auto');
        height: expression((this.width/this.height)<1?250:'auto');
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Youtube Video Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Youtube Video Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    @using (Html.BeginForm("YouTubeVideos", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
    {
    <div class="row">
        <div class="col-md-3 form-group">
            <label>Teacher</label>
            <select class="form-control" name="TeacherID">
                <option value="0" @(0 == Model.TeacherID ? "selected" : "")>All Teacher</option>
                @foreach (var s in Model.Teachers)
                {
                    <option value="@s.ID" @(s.ID == Model.TeacherID ? "selected" : "")>@s.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3 form-group">
            <label>Date</label>
            <input type="date" name="UploadDate" class="form-control" value="@Model.UploadDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3 form-group">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
        <a href="/Admin/EditYouTubeVideo/" class="btn btn-success">Add Video</a>
    </div>
    }
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 5%">Sl.</th>
                                <th style="width: 15%">Image</th>
                                <th style="width: 70%">Details</th>
                                <th style="width: 10%">Date</th>
                                <th style="width: 5%">View</th>
                            </tr>
                        </thead>
                        @{
                            int count = 0;
                            foreach (var c in Model.Videos)
                            {
                                <tr>
                                    <td>@(count + 1)</td>
                                    <td>
                                        <input type="hidden" id="hdnYouTubeLink" value="https://www.youtube.com/embed/@c.YVideoID?autoplay=1" />
                                        <input type="hidden" id="hdnTitle" value="@c.Title" />
                                        <img id="imgPhoto" class="thumbImageGrid" alt="Photo" src="https://img.youtube.com/vi/@c.YVideoID/0.jpg" />
                                    </td>
                                    <td>
                                        <b>@c.TeacherName @c.SubjectName @c.ClassName @c.SectionName</b>
                                        <p> @c.Title</p>
                                    </td>

                                    <td>
                                        @c.UploadDate.ToString("dd MMM,yyyy")

                                    </td>
                                    <td>
                                        
                                        <a href="javascript:void(0);" onclick="ShowVideo(this);">Show</a>

                                        <a href="/Admin/EditYouTubeVideo/@c.VideoID" target="_blank">Edit</a>
                                    </td>
                                </tr>

                                count++;
                            }

                        }
                    </table>

                </div>
            </div>
        </div>
    </div>



</section>
@section pageBottom{
    <div id="mdlVideo" class="modal fade" role="dialog">
        <div class="modal-dialog">

            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Video</h4>
                </div>
                <div class="modal-body">
                    <div class="row" id="mbImages">
                        <div class="col-md-12">
                            <iframe id="videosrc" width="100%" height="315">
                              
                            </iframe>
                            <p id="pTitle"></p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
}
<script>
    function ClassChanged(sender) {
        $('.se-pre-con').css('display', '');
        $.ajax(
            {
                type: "POST",
                url: "/Admin/GetSectionOnClass/" + $(sender).val(),
                cache: false,
                processData: false,
                contentType: false,
                success: function (html) {
                    $('#ddlSection').html('');
                    $('#ddlSection').html('<option value="0">--Select--</option>');
                    $('#ddlSection').append(html);

                    $('.se-pre-con').css('display', 'none');
                },
                error: function (e) {
                    alert("errorn");
                }
            });
    }

   $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });
    });
   
    function ShowVideo(sender) {

        var video = $(sender).closest('tr').find('#hdnYouTubeLink').val();
        var title = $(sender).closest('tr').find('#hdnTitle').val();
        $('#videosrc').attr('src', video);
        $('#pTitle').html(title);
        $('#mdlVideo').modal('toggle');
        
    }
</script>
<!-- /.content -->