                cache: false,
                processData: false,
                contentType: false,
                success: function (data) {
                    $('#hdnIsUserNameOk').val(data);
                    if (data == 1) {
                        $(sender).addClass('errorClass');
                    }
                    else {
                        $(sender).removeClass('errorClass');
                    }
                },
                error: function (e) {
                    alert("errorn");
                }
            });
