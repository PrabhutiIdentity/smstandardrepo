@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    ViewBag.Title = "Blog Categories";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <title>Branch Management</title>
    <script src="@Url.Content("~/js/MD5.js")" type="text/javascript"></script>
}
@model List<SMEnterprise.Models.SBranchModel>
@functions {
    private string GetBranchValue(object branch, string propertyName)
    {
        if (branch == null)
        {
            return "";
        }

        var property = branch.GetType().GetProperty(propertyName);
        if (property == null)
        {
            return "";
        }

        var value = property.GetValue(branch, null);
        return value == null ? "" : value.ToString();
    }
}
<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
