                $('#divEditFormDetails').find('#txtPlayStoreLink').val($(sender).closest('tr').find('#hdnPlayStoreLink').val());
                $('#divEditFormDetails').find('#txtAffiliationNo').val($(sender).closest('tr').find('#hdnAffiliationNo').val());
                $('#divEditFormDetails').find('#txtAffiliatedTo').val($(sender).closest('tr').find('#hdnAffiliatedTo').val());
                $('#divEditFormDetails').find('#txtWebsiteLink').val($(sender).closest('tr').find('#hdnWebsiteLink').val());
                $('#divEditFormDetails').find('#txtBranchAccountName').val($(sender).closest('tr').find('#hdnSBranchAccountName').val());
                $('#divEditFormDetails').find('#imgSignaturePhoto').prop('src', $(sender).closest('tr').find('#hdnPrincipalSignatureURL').val());

                //var imagepath = '../Images/VehicleImages/' + $(sender).closest('tr').find('#hdnVehicleID').val() + '_' + $(sender).closest('tr').find('#hdnImage').val();
                //$('#divEditFormDetails').find('#imgMainPhoto').attr('src', imagepath);hdnPrincipalSignature

                $('#divEditFormDetails').find('#txtUDise').val($(sender).closest('tr').find('#hdnUDise').val());
                $('#divEditFormDetails').find('#txtSchoolCode').val($(sender).closest('tr').find('#hdnSchoolCode').val());
            }



        }
        else {
            $(sender).removeClass("EditSectionOpen");
            $(sender).addClass("EditSectionClose");
            if ($(sender).text() == 'Cancel New') {
                $(sender).text('Add New');
            }
            else {
                $(sender).text('Edit');
            }
            $(sender).closest("tr").next().remove();

        }

        $('.se-pre-con').css('display', 'none');
    }
    function PhotoChanged(fileBox, type) {

        if (type == 0) {
            if (fileBox.files && fileBox.files[0]) {
                if (fileBox.files[0].size / 1024 < 500) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $(fileBox).closest('.col-md-12').find('#imgMainPhoto').prop('src', e.target.result);
                    }
                    reader.readAsDataURL(fileBox.files[0]);
                }
                else {

                    ShowNotification('Large Image', 'Kindly Upload Image of Size less the 500KB', 'error');
                }
            }
        }
        else {
            {
                if (fileBox.files && fileBox.files[0]) {
                    if (fileBox.files[0].size / 1024 < 500) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            $(fileBox).closest('.col-md-12').find('#imgSignaturePhoto').prop('src', e.target.result);
                        }
                        reader.readAsDataURL(fileBox.files[0]);
                    }
                    else {

                        ShowNotification('Large Image', 'Kindly Upload Image of Size less the 500KB', 'error');
                    }
                }
            }
        }
    }
</script>
