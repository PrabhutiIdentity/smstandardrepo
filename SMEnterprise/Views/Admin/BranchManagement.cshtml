            max-width: 100%;
        }

            #divEditFormDetails input[type="file"]::file-selector-button {
                background: #fff;
                border: 1px solid #b8c2d1;
                border-radius: 3px;
                color: #1f2d3d;
                margin-right: 8px;
                padding: 4px 8px;
            }

        #divEditFormDetails .col-md-8 {
            padding-left: 22px;
        }

            #divEditFormDetails .col-md-8 > .col-md-12 {
                padding-left: 0;
                padding-right: 0;
            }

        #divEditFormDetails .form-group {
