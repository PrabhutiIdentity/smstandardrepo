    function EditBranch(sender) {
        $('.se-pre-con').css('display', '');
        if ($(sender).hasClass("EditSectionClose")) {
            var ele = document.getElementsByClassName("EditSectionOpen");
            if (ele.length > 0) {
                $(ele[0]).click();
                if ($(ele[0]).text() == 'Cancel New') {
                    $(ele[0]).text('Add New');
                }
                else {
                    $(sender).text('Edit');
                }
            }
            $(sender).removeClass("EditSectionClose");
            $(sender).addClass("EditSectionOpen");

            if ($(sender).text() == 'Add New') {
                $(sender).text('Cancel New');
                $(sender)
                    .closest("tr")
                    .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + $('#divEditForm').html() + "</td></tr>");

                $('#divEditFormDetails').find('#hdnSBranchID').val(0);
                $('#divEditFormDetails').find('#hdnImageName').val('');
                $('#divEditFormDetails').find('#txtBranchName').val('');
                $('#divEditFormDetails').find('#txtContactNo').val('');
                $('#divEditFormDetails').find('#txtEmailID').val('');
                $('#divEditFormDetails').find('#txtPrincipalName').val('');
                $('#divEditFormDetails').find('#txtNotificationServerKey').val('');
                $('#divEditFormDetails').find('#txtPlayStoreLink').val('');
                $('#divEditFormDetails').find('#txtPrincipalMobile').val('');
                $('#divEditFormDetails').find('#txtPrincipalEmail').val('');
                $('#divEditFormDetails').find('#txtBranchSchoolName').val('');
                $('#divEditFormDetails').find('#txtAffiliationNo').val('');
                $('#divEditFormDetails').find('#txtAffiliatedTo').val('');
                $('#divEditFormDetails').find('#txtWebsiteLink').val('');
                $('#divEditFormDetails').find('#txtAddress').text('');
                $('#divEditFormDetails').find('#txtBranchAccountPassword').val('#PlacePass');
                $('#divEditFormDetails').find('#txtBranchAccountName').val('');
                $('#divEditFormDetails').find('#ddlGSTStates').val(9);
                var imagepath = '';
                $('#divEditFormDetails').find('#imgMainPhoto').attr('src', imagepath);
                $('#divEditFormDetails').find('#imgSignaturePhoto').attr('src', imagepath);

                $('#divEditFormDetails').find('#txtUDise').val('');
                $('#divEditFormDetails').find('#txtSchoolCode').val('');



            }
            else {
                $(sender).text('Cancel');
                $(sender)
                    .closest("tr")
                    .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + $('#divEditForm').html() + "</td></tr>");

                $('#divEditFormDetails').find('#hdnSBranchID').val($(sender).closest('tr').find('#hdnSBranchID').val());
                $('#divEditFormDetails').find('#hdnImageName').val($(sender).closest('tr').find('#hdnSBranchLogo').val());
                $('#divEditFormDetails').find('#imgMainPhoto').prop('src', $(sender).closest('tr').find('#imgPhoto').prop('src'));
                $('#divEditFormDetails').find('#txtBranchName').val($(sender).closest('tr').find('#tdSBranchName').text().trim());
                $('#divEditFormDetails').find('#txtContactNo').val($(sender).closest('tr').find('#pContactNo').text().trim());
                $('#divEditFormDetails').find('#txtEmailID').val($(sender).closest('tr').find('#pEmailID').text().trim());
                $('#divEditFormDetails').find('#txtPrincipalName').val($(sender).closest('tr').find('#pPrincipalName').text().trim());
                $('#divEditFormDetails').find('#txtPrincipalMobile').val($(sender).closest('tr').find('#pPrincipalMobile').text().trim());
                $('#divEditFormDetails').find('#txtPrincipalEmail').val($(sender).closest('tr').find('#pPrincipalEmail').text().trim());
                $('#divEditFormDetails').find('#txtBranchSchoolName').val($(sender).closest('tr').find('#pBranchSchoolName').text().trim());
                $('#divEditFormDetails').find('#txtAddress').val($(sender).closest('tr').find('#pBranchAddress').text().trim());
