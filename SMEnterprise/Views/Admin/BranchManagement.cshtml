        }

        #divEditFormDetails .btn-info {
            background-color: #3c8dbc;
            border-color: #367fa9;
            border-radius: 4px;
            font-weight: 600;
            padding: 6px 14px;
        }

    @@media (max-width: 991px) {
        #divEditFormDetails .col-md-8 {
            padding-left: 15px;
        }
    }

</style>
<!-- Content Header (Page header) -->
