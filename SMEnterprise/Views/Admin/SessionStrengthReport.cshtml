@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model SessionStrengthReport
@section IncludeCss
{
    <title>Session / Class Strength Matrix</title>
}
<style>
    .btn {
        padding: 3px 6px;
    }

    #divMainContainer .row {
        padding-top: 5px;
        padding-bottom: 5px;
    }

    #divMainContainer thead tr {
        background-color: #2a3f54;
        color: aliceblue;
    }

    #divMainContainer table tr h3 {
        font-size: 3em;
        color: #73879c;
    }

    .majorCell {
        vertical-align: middle !important;
        background-color: #2a3f54;
        color: aliceblue;
        text-align: center;
    }

    td {
        border: 1px solid #aeb6bd !important;
    }

    h3 {
        font-family: inherit;
        font-weight: 500;
        line-height: 1.1;
        color: #7d8a96;
        font-size: 3em;
    }

    .compDetail {
        color: #73879c;
        font-family: "Helvetica Neue", Roboto, Arial, "Droid Sans", sans-serif;
        font-weight: 400;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Session / Class Strength Matrix
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Session / Class Strength Matrix</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">

                </div>
                <div class="box-body fixed-th-table-wrapper">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <td style="width:@(100 / (Model.Sessions.Count + 1))%" class="majorCell">
                                    <h4> Classes</h4>
                                </td>
                                @foreach (SchoolSessionModel s in Model.Sessions)
                                {
                                    <td style="width:@(100 / (Model.Sessions.Count + 1))%;" class="majorCell">
                                        <h4>
                                            @s.SessionName <br />

                                        </h4>
                                        <small>  @s.SessionStartDate.ToString("MMM, yyyy") to @s.SessionEndDate.ToString("MMM, yyyy")</small>
                                    </td>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{

                                foreach (ClassModel c in Model.Classes)
                                {
                                    var PreviousCount = 0;
                                    <tr>
                                        <td style="width:@(100 / (Model.Sessions.Count + 1))%;background-color:#7d8a96;" class="majorCell">
                                            <h4>  @c.ClassName</h4>
                                        </td>
                                        @foreach (SchoolSessionModel s in Model.Sessions)
                                        {
                                            var isFound = false;
                                            foreach (SessionStrengthModel ss in Model.Strength)
                                            {
                                                if (ss.SessionID == s.SessionID && ss.ClassID == c.ClassID)
                                                {
                                                    string[] Details = ss.ComparativeData.Split("-".ToCharArray());
                                                    ss.TotalStrength = (SMEnterprise.Repository.CommonUsage.ConvertToInt(Details[1]) + SMEnterprise.Repository.CommonUsage.ConvertToInt(Details[2]));
                                                    <td style="width:@(100 / (Model.Sessions.Count + 1))%;text-align: center;">
                                                        <div class="row">
                                                            <div class="col-md-4">
                                                                <h3>@ss.TotalStrength</h3>
                                                            </div>
                                                            <div class="col-md-8">
                                                                <div class="col-md-12">
                                                                    @if (ss.TotalStrength < PreviousCount)
                                                                    {
                                                                        <i class='fa fa-arrow-down' aria-hidden='true' style="color:red;">@(ss.TotalStrength == 0 ? "100" : (((PreviousCount - ss.TotalStrength) * 100 / ss.TotalStrength)).ToString("00")) %</i>
                                                                    }
                                                                    else if (ss.TotalStrength > PreviousCount)
                                                                    {
                                                                        <i class='fa fa-arrow-up' aria-hidden='true' style="color:green;">@(PreviousCount == 0 ? "100" : (((ss.TotalStrength - PreviousCount) * 100 / PreviousCount)).ToString("00")) %</i>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="fa fa-arrows-v" aria-hidden="true" style="color:blue;">0%</i>
                                                                    }
                                                                </div>
                                                                <div class="col-md-12 compDetail" title="Number of Students Continued from First Session" style="display:none;">
                                                                    FS : @Details[0]
                                                                </div>
                                                                <div class="col-md-12 compDetail" title="Number of Students Continued from Previous Session">
                                                                    PS :  @Details[1]
                                                                </div>
                                                                <div class="col-md-12 compDetail" title="New Admissions">
                                                                    NA :  @Details[2]
                                                                </div>
                                                            </div>
                                                        </div>



                                                    </td>
                                                    isFound = true;
                                                    PreviousCount = ss.TotalStrength;
                                                    break;
                                                }
                                            }
                                            if (!isFound)
                                            {
                                                <td style="width:@(100 / (Model.Sessions.Count + 1))%">
                                                    <div class="row">
                                                        <div class="col-md-4">
                                                            <h3>0</h3>
                                                        </div>
                                                    </div>
                                                </td>
                                                PreviousCount = 0;
                                            }
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>

</section>
@section scripts
{
    <script>
       
        $(function () {

            $('#liSessionClassStrength').closest('ul').closest('li').addClass('active');
            $('#liSessionClassStrength').addClass('active');
        });

        
    </script>
}
<!-- /.content -->