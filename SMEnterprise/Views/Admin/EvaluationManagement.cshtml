@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <title>Evaluation Management</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
}
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Evaluation Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Evaluation Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    @using (Html.BeginForm("EvaluationManagement", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetExams" }))
                    {
                        <div class="row std-mng-head">

                            <div class="col-md-12 class-section">
                                <div class="row">
                                    <div class="col-md-4 padding">
                                        <label class="col-md-5 text-right" style="padding-right: 0px;">Session :</label>
                                        <div class="col-md-7">
                                            <select class="form-control" name="ID" ID="ddlSessions" onchange="SessionChanged(this);">
                                                @foreach (SchoolSessionModel e in Model.Sessions)
                                                {
                                                    <option value="@e.SessionID" @(e.SessionID == Model.SessionID ? "Selected" : "")>@e.SessionName @(e.SessionStatus == 1 ? "(Active)" : "")</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 padding">
                                        <label class="col-md-5 text-right" style="padding-right: 0px;">Scheme :</label>
                                        <div class="col-md-7">
                                            <select class="form-control" name="ID2" ID="ddlSchemes">
                                                @foreach (EvaluationSchemeModel e in Model.Schemes)
                                                {
                                                    <option value="@e.EvaluationSchemeID" @(e.EvaluationSchemeID == Model.EvaluationSchemeID ? "Selected" : "")>@e.EvaluationSchemeName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 padding">
                                        <div class="row">

                                            <div class="col-md-2">
                                                <a onclick="$('#frmGetExams').submit();" ID="lbGetList"><i class="fa fa-search"></i></a>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    }
                </div>
                @{

                    if (Model.Sessions.Count == 0)
                    {
                        <div class="box-body">
                            <div class="row">
                                <div class="col-md-12" style="text-align:center">
                                    <a href="/Admin/SessionManagement" class="btn btn-link">Current Session Not Added, Please Add.</a>
                                </div>
                            </div>
                        </div>
                    }
                    else if (Model.Schemes.Count == 0)
                    {
                        <div class="box-body">
                            <div class="row">
                                <div class="col-md-12" style="text-align:center">
                                    <a href="/Admin/EvaluationSchemeManagement">No Evaluation Scheme Added, Please Add one.</a>
                                </div>
                            </div>
                        </div>
                    }
                    @*else if (Model.Count == 0)
                    {
                        <div class="box-body">
                            <div class="row">
                                <div class="col-md-12" style="text-align:center">
                                    <a href="/Admin/EvaluationSchemeManagement">No Evaluation Scheme Added, Please Add one.</a>
                                </div>
                            </div>
                        </div>
                    }*@
                    else
                    {
                        <div class="box-body">
                            <table id="tblCategory" class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 10%">Sl. No.</th>
                                        <th style="width: 35%">Title</th>
                                        <th style="width: 10%">Weightage</th>
                                        <th style="width: 15%">Sub Evaluations</th>
                                        <th style="width: 15%">Result Date</th>
                                        <th style="width: 15%">Edit/Delete</th>
                                    </tr>
                                </thead>
                                @{
                                    int count = 0;
                                    decimal TotalWeightage = 0;
                                    <tbody>
                                        @foreach (EvaluationModel c in Model.Evaluations)
                                        {
                                            TotalWeightage = TotalWeightage + c.Weightage;
                                            <tr>

                                                <td>
                                                    @(count + 1)
                                                    <input type="hidden" name="EvaluationID" id="hdnEvaluationID" value="@c.EvaluationID" />
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnEvaluationName").val($(this).val())' id="txtEvaluationName" name="EvaluationName" value="@c.EvaluationName" />

                                                </td>
                                                <td>
                                                    <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnEvaluationWeightage").val($(this).val())' id="txtWeightage" name="Weightage" value="@c.Weightage" />
                                                </td>
                                                <td>
                                                    <input type="hidden" id="hdnSubEvalCount" value="@c.SubEvals" />
                                                    @c.SubEvals
                                                    <ss>(<a href="javascript:void(0);" onclick="ToggleDetails(this);" id="@c.EvaluationID" class="SubEvalClosed Poll-Options">Manage</a>)</ss>
                                                </td>
                                                <td>
                                                    <input type="date" class="form-control" onchange='$(this).closest("tr").find("#hdnResultDate").val($(this).val())' id="txtResultDate" name="ResultDate" value="@c.ResultDate.ToString("yyyy-MM-dd")" />
                                                </td>
                                                <td>
                                                    <div class="btn-group">
                                                        @using (Html.BeginForm("UpdateEvaluation", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                        {
                                                            <input type="hidden" name="EvaluationID" id="hdnEvaluationID" value="@c.EvaluationID" />
                                                            <input type="hidden" id="hdnEvaluationName" name="EvaluationName" value="@c.EvaluationName" />
                                                            <input type="hidden" name="EvaluationSchemeID" id="hdnEvaluationSchemeID" value="@c.EvaluationSchemeID" />
                                                            <input type="hidden" name="ResultDate" id="hdnResultDate" value="@c.ResultDate" />
                                                            <input type="hidden" id="hdnEvaluationMonth" name="EvaluationMonth" value="@c.EvaluationMonth" />
                                                            <input type="hidden" id="hdnEvaluationWeightage" name="Weightage" value="@c.Weightage" />
                                                            <input type="submit" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Save" />
                                                        }
                                                        @using (Html.BeginForm("UpdateEvaluation", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                        {
                                                            <input type="hidden" name="OpType" value="-1" />
                                                            <input type="hidden" name="EvaluationSchemeID" id="hdnEvaluationSchemeID" value="@c.EvaluationSchemeID" />
                                                            <input type="hidden" name="EvaluationID" value="@c.EvaluationID" />
                                                            <button onclick="return EvaluationDelete(this);" style="background-color: red;color: white;" class="btn btn-default" value="Edit">Delete</button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                            count++;
                                        }
                                        <tr>

                                            <td>
                                                @(count + 1)
                                                <input type="hidden" name="EvaluationID" id="hdnEvaluationID" value="0" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnEvaluationName").val($(this).val())' id="txtEvaluationName" name="EvaluationName" value="" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnEvaluationWeightage").val($(this).val())' id="txtWeightage" name="Weightage" value="0" />
                                            </td>
                                            <td>
                                                0
                                            </td>
                                            <td>

                                                <input type="date" class="form-control" onchange='$(this).closest("tr").find("#hdnResultDate").val($(this).val())' id="txtResultDate" name="ResultDate" value="@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("yyyy-MM-dd")" />
                                            </td>
                                            <td>
                                                <div class="btn-group">
                                                    @using (Html.BeginForm("UpdateEvaluation", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                    {
                                                        <input type="hidden" name="ID" id="hdnEvaluationID" value="0" />
                                                        <input type="hidden" id="hdnEvaluationName" name="EvaluationName" value="" />
                                                        <input type="hidden" name="EvaluationSchemeID" id="hdnEvaluationSchemeID" value="@Model.EvaluationSchemeID" />
                                                        <input type="hidden" name="ResultDate" id="hdnResultDate" value="@SMEnterprise.Repository.CommonUsage.GetCurrentDate()" />
                                                        <input type="hidden" id="hdnSessionID" name="SessionID" value="@Model.SessionID" />
                                                        <input type="hidden" id="hdnEvaluationMonth" name="EvaluationMonth" value="1" />
                                                        <input type="hidden" id="hdnEvaluationWeightage" name="Weightage" value="0" />
                                                        <input type="submit" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Add New" />
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td>#</td>
                                            <td>Final</td>
                                            <td>@TotalWeightage</td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>
<script>
    function SessionChanged(sender) {
        $('#ddlSchemes').html('<option value="-1">Loading....</option>');
        $.ajax(
            {
                type: "POST",
                url: "/Admin/GetEvaluationSchemes/" + $(sender).val(),
                cache: false,
                processData: false,
                contentType: false,
                success: function (data) {
                    $('#ddlSchemes').html('');
                    if (data.length > 0) {
                        for (var i = 0; i < data.length; i++) {
                            $('#ddlSchemes').append('<option value="' + data[i].EvaluationSchemeID + '">' + data[i].EvaluationSchemeName + '</option>');
                        }
                    }
                    else {
                        $('#ddlSchemes').append('<option value="-1">No Scheme Added</option>');
                    }
                },
                error: function (e) {
                    alert("errorn");
                }
            });
    }
    function ToggleDetails(sender) {

        if ($(sender).hasClass("SubEvalClosed")) {
            var notice = ShowNotification('Loading', 'Please wait while we load the required details....', 'info');
            $(sender)
          .closest("tr")
          .after("<tr><td style='background-color: rgba(123, 100, 165, 0.48);'></td><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>Loading....</td></tr>");

            $.ajax(
            {
                type: "POST",
                url: "/Admin/GetSubEvaluations/" + $(sender).attr('id'),
                cache: false,
                processData: false,
                contentType: false,
                success: function (html) {
                    notice.remove();
                    // fill the div with the html returned by action
                    $(sender).closest("tr").next().remove();
                    $(sender)
                        .closest("tr")
                        .after("<tr><td style='background-color: rgba(123, 100, 165, 0.48);'></td><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + html + "</td></tr>");
                    var ele = document.getElementsByClassName("SubEvalOpen");
                    if (ele.length > 0) {
                        $(ele[0]).click();
                    }

                    $(sender).removeClass("SubEvalClosed");
                    $(sender).addClass("SubEvalOpen");
                    $(sender).text("Close");
                },
                error: function (e) {
                    alert("errorn");
                }
            });
        }
        else {
            $(sender).removeClass("SubEvalOpen");
            $(sender).addClass("SubEvalClosed");
            $(sender).closest("tr").next().remove();
            $(sender).text("Manage");
        }

    }
 
    function EvaluationDelete(sender) {
        if ($(sender).closest('tr').find('#hdnSubEvalCount').val() == 0) {
            if (confirm('Are you sure you wish to delete this Evaluation?')) {

                return true;
            }
            else {
                return false;
            }
        }
        else
        {
            ShowClosingNotification('Error', 'Sub-Evaluations are added in this Evaluation, so It can\'t be deleted!!!!', 'error');
            return false;
        }
    }
    function SaveSubEvaluation(sender, OpType) {

        var isProcess = true;
        if (OpType == -1)
        {
            if ($(sender).closest('tr').find('#hdnEvCountUsed').val() == 0) {
                confirm('Are you sure you wish to delete this Sub Evaluation?');

            //    if (confirm('Are you sure you wish to delete this Sub Evaluation?')) {

            //        return true;
            //    }
            //    else {
            //        return false;
            //    }
            }
            else {
                ShowClosingNotification('Error', 'Sub-Evaluations are used in Exam Management, so It can\'t be deleted!!!!', 'error');
                return false;
            }

            //hdnEvCountUsed
            //isProcess = confirm('Do you really want to delete this Evaluation????');
        }
        if (isProcess) {
            $.ajax({
                url: "@Url.Action("UpdateSubEvaluations", "Admin")",
                type: 'POST',
                data: JSON.stringify({
                    OpType: OpType,
                    MasterID: $(sender).closest('tr').find('#hdnMasterID').val(),
                    EvaluationID: $(sender).closest('tr').find('#hdnEvaluationID').val(),
                    EvaluationType: $(sender).closest('tr').find('#ddlTypes').val(),
                    EvaluationName: $(sender).closest('tr').find('#txtEvaluationName').val(),
                    Weightage: $(sender).closest('tr').find('#txtWeightage').val(),
                    EvaluationMonth: $(sender).closest('tr').find('#ddlMonth').val()
                }),
                contentType: 'application/json; charset=utf-8',
                success: function (html) {
                    ShowClosingNotification('Success', 'Changes updated successfully', 'info');
                    $(sender).closest('table').closest('td').html(html);
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
                },
                async: true,
                processData: false
            });
        }
        $(function () {
            $("#tblCategory").DataTable({
                "ordering": false
            });
            $('#liEvaluationManagement').closest('ul').closest('li').addClass('active');
            $('#liEvaluationManagement').addClass('active');
        });
    }
</script>
<!-- /.content -->