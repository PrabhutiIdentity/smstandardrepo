<form id="frmSalaryDetails">

    <input type="hidden" value="@Model.EmployeeTypeID" name="EmployeeTypeID" />
    <table id="tblCategory" class="table table-bordered table-hover">
        <thead>
            <tr>
                <th style="width: 5%">#</th>
                <th style="width: 20%">Category Name</th>
                <th style="width: 20%">Occurance</th>
                <th style="width: 20%">Type</th>
                <th style="width: 20%">Amount</th>
            </tr>
        </thead>
        <tbody id="tbdSalaryCategories">
            @{
                var Counter = 0;
                foreach (var e in Model.Salaries)
                {
                    <tr>
                        <td>
                            <input type="hidden" value="@e.ETypeSTypeID" name="Salaries[@Counter].ETypeSTypeID" />
                            <input type="hidden" value="@e.TypeID" name="Salaries[@Counter].TypeID" />
                            <input type="hidden" value="@Model.EmployeeTypeID" name="Salaries[@Counter].EmployeeTypeID" />
                            <input type="hidden" value="@Model.SBranchID" name="Salaries[@Counter].SBranchID" />
                            <input type="hidden" value="@e.TypeApplicable" id="hdnSalaryTypeApplicable" name="Salaries[@Counter].TypeApplicable" />
                            @(Counter + 1)
                        </td>
                        <td>
                            @e.TypeName
                        </td>
                        <td>
                            @e.TypeApplicableName
                            <input type="hidden" id="hdnSalaryMonths" value="@e.Months" />
                            <small id="spnMonthNames"></small>
                        </td>
                        <td>@(e.IsDeduction==0?"Payble":"Deduction")</td>
                        <td>
                            <input type="number" class="form-control" name="Salaries[@Counter].Amount" value="@e.Amount" />
                        </td>
                    </tr>
                    Counter++;
                }
            }
        </tbody>
    </table>
    <div>
        <a href="javascript:void(0);" onclick="SaveSalaryStructure(this);" class="btn btn-block btn-info pull-right">Save</a>
    </div>
</form>

<script>
    var monthList = ['Jan', 'Feb', 'March', 'April', 'May', 'June', 'July', 'Aug', 'Sept', 'Oct', 'Nov', 'Dec'];
    $('#tbdSalaryCategories').find('tr').each(function () {
        if ($(this).find('#hdnSalaryTypeApplicable').val() == 9) {
            var months = '';
            var cls = $(this).find('#hdnSalaryMonths').val().split(",");
            $.each(cls, function (i, month) {
                if (months != '') {
                    months = months + ',';
                }
                months = months + monthList[month - 1];
            });
            $(this).find('#spnMonthNames').html(' (' + months + ')');
        }
    });
</script>