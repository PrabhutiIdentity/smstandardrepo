@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <link rel="stylesheet" href="@Url.Content("~/Admin/plugins/select2/select2.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/Admin/plugins/iCheck/all.css")">
    <title>Website News Management</title>
}
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        News Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">News Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 4%">Sl.</th>
                                <th style="width: 49%">News</th>
                                <th style="width: 10%">Date</th>
                                <th style="width: 10%">Attachement</th>
                                <th style="width: 7%">Status</th>
                                <th style="width: 15%"><a href="javascript:void(0);" class="btn btn-link EditSectionClose" onclick="EditNews(this);">Add New</a></th>
                            </tr>
                        </thead>
                        @{
                            int count = 0;
                            foreach (NewsModel c in Model)
                            {
                                <tr>
                                    <td>
                                        @(count + 1)

                                        <input type="hidden" name="NewsID" id="hdnNewsID" value="@c.NewsID" />
                                    </td>
                                    <td>
                                        <b id="tdTitle"> @c.Title</b><br />
                                        <ss id="tdDescription">@c.Description</ss>
                                    </td>
                                    <td>
                                        <input type="hidden" id="hdnNewsActiveDate" value="@Convert.ToDateTime(c.ActiveDate).ToString("yyyy-MM-dd")" />

                                        @Convert.ToDateTime(c.ActiveDate).ToString("dd MMM, yyyy")
                                    </td>
                                    <td>
                                        @c.Attachment
                                        <input type="hidden" id="hdnAttachmentFileName" value="@c.Attachment" />
                                    </td>
                                 
                                    <td>
                                        <input type="hidden" name="Status" id="hdnNewsStatus" value="@c.Status" />
                                        @if (c.Status == 1)
                                        {
                                            <label class='badge bg-green'>Active</label>
                                        }
                                        else
                                        {
                                            <label class='badge bg-red'>Inactive</label>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <input type="hidden" name="OpType" id="hdnOpType" value="0" />
                                            <a href="javascript:void(0);" style="background-color: cornflowerblue;color: white;" onclick="EditNews(this);" class="btn btn-default EditSectionClose" value="Edit">Edit</a>

                                            @using (Html.BeginForm("UpdateNews", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" name="OpType" value="-1" />
                                                <input type="hidden" name="NewsID" value="@c.NewsID" />
                                                <button onclick="return NewsDelete(this);" style="background-color: red;color: white;" class="btn btn-default" value="Edit">Delete</button>
                                            }
                                           

                                        </div>
                                    </td>
                                </tr>

                                count++;
                            }

                        }
                    </table>

                </div>
            </div>
        </div>
    </div>
    <div id="divEditForm" style="display:none;">
        <input type="hidden" id="hdnCurDate" value="@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("yyyy-MM-dd")" />
        @using (Html.BeginForm("UpdateNews", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "UpdateNews" }))
        {
            <div class="box box-danger" id="divEditFormDetails">
                <div class="box-header">
                    <h3 class="box-title">News Details</h3>

                </div>
                <div class="box-body">
                    <input type="hidden" id="hdnNewsID" name="NewsID" value="" />

                    <div class="row">

                        <div class="form-group col-md-4">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span>Start Date</span>
                                </div>
                                <input type="date" id="txtStartDate" name="ActiveDate" class="form-control" value="" />
                            </div>
                        </div>

                        <div class="form-group col-md-2">
                            <div class="input-group" style="border: 1px solid #ddd;">
                                <div class="input-group-addon">
                                    <span>Status</span>
                                </div>
                                <label class="switch switch-green" style="padding-top: 3px;">

                                    <input type="checkbox" id="chkNewsStatus" class="switch-input">

                                    <span class="switch-label" onclick='$(this).closest("label").find("#hdnNewsEditStatus").val($(this).closest("tr").find("#hdnNewsEditStatus").val() == "0" ? "1" : "0");' data-on="Active" data-off="Inactive"></span>
                                    <span class="switch-handle" id="shTranding"></span>
                                    <input type="hidden" id="hdnNewsEditStatus" name="Status" value="1" />
                                </label>
                            </div>
                        </div>
                       
                    </div>

                    <div class="row" style="margin-left:0px;margin-right:0px;">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span>Title</span>
                                </div>
                                <input type="text" class="form-control" name="Title" id="txtNewsTitle" value="">
                               
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <textarea rows="5" class="form-control" id="txtNewsDescription" style="resize: none;" name="Description"></textarea>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <a href="" target="_blank" id="aAttachement"></a>
                            <input type="file" name="AttachmentFile" />
                            <input type="hidden" name="Attachment" id="hdnAttachmentFileName" value="" />
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-12">
                            <button href="javascript:void(0);" class="btn btn-info pull-right" onclick="return BeforeSaveNews(this);">Save</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
@section scripts
{
    <script src="@Url.Content("~/js/select2.full.min.js")"></script>
    <script src="@Url.Content("~/Admin/plugins/iCheck/icheck.min.js")"></script>

}
<script>
    var FolderPath='@Url.Content("~/Attachments/News/")';
    $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });
        $('#liNewsManagement').closest('ul').closest('li').addClass('active');
        $('#liNewsManagement').addClass('active');

    });
   
    function NewsDelete(sender) {
        return confirm('Do you really want to delete News!!!!');
    }
  
    function EditNews(sender) {
        if ($(sender).hasClass("EditSectionClose")) {
            var ele = document.getElementsByClassName("EditSectionOpen");
            if (ele.length > 0) {
                $(ele[0]).click();
                if ($(ele[0]).text() == 'Cancel New') {
                    $(ele[0]).text('Add New');
                }
                else {
                    $(sender).text('Close');
                }
            }
            $(sender).removeClass("EditSectionClose");
            $(sender).addClass("EditSectionOpen");

            if ($(sender).text() == 'Add New') {
                $(sender).text('Cancel New');
                $(sender)
               .closest("tr")
               .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + $('#divEditForm').html() + "</td></tr>");
 
                $('#divEditFormDetails').find('#hdnNewsID').val(0);
                $('#divEditFormDetails').find('#txtNewsTitle').val('');
                $('#divEditFormDetails').find('#txtNewsDescription').val('');
                $('#divEditFormDetails').find('#txtStartDate').val($('#hdnCurDate').val());
                $('#divEditFormDetails').find('#chkNewsStatus').prop('checked', 'checked');
                $('#divEditFormDetails').find('#hdnAttachmentFileName').val('');
                $('#divEditFormDetails').find('#aAttachement').attr('href','').text('');

               
            }
            else {
                $(sender).text('Close');
                $(sender)
                .closest("tr")
                .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + $('#divEditForm').html() + "</td></tr>");
                //alert($(sender).closest('tr').find('#hdnClassesIncludedIDs').val());
                $('#divEditFormDetails').find('#hdnNewsID').val($(sender).closest('tr').find('#hdnNewsID').val());
                $('#divEditFormDetails').find('#hdnNewsEditStatus').val($(sender).closest('tr').find('#hdnNewsStatus').val());
                $('#divEditFormDetails').find('#txtStartDate').val($(sender).closest('tr').find('#hdnNewsActiveDate').val());
                $('#divEditFormDetails').find('#txtNewsTitle').val($(sender).closest('tr').find('#tdTitle').text().trim());
                $('#divEditFormDetails').find('#txtNewsDescription').val($(sender).closest('tr').find('#tdDescription').text().trim().replace('<br>', '\n'));
                $('#divEditFormDetails').find('#hdnAttachmentFileName').val($(sender).closest('tr').find('#hdnAttachmentFileName').val());
                $('#divEditFormDetails').find('#aAttachement').attr('href', FolderPath+$(sender).closest('tr').find('#hdnNewsID').val() + '_' + $(sender).closest('tr').find('#hdnAttachmentFileName').val()).text($(sender).closest('tr').find('#hdnAttachmentFileName').val());
                if ($(sender).closest('tr').find('#hdnNewsStatus').val() == 1) {
                    $('#divEditFormDetails').find('#chkNewsStatus').prop('checked', 'checked');
                }
            }



        }
        else {
            $(sender).removeClass("EditSectionOpen");
            $(sender).addClass("EditSectionClose");
            if ($(sender).text() == 'Cancel New') {
                $(sender).text('Add New');
            }
            else {
                $(sender).text('Edit');
            }
            $(sender).closest("tr").next().remove();

        }

    }
    function BeforeSaveNews(sender) {
        if ($('#txtStartDate').val() == '' || $('#txtStartDate').val() == '') {
            alert('Please Enter Valid Dates');
            return false;

        }
        else {
           
            return true;
        }
    }
</script>

<!-- /.content -->