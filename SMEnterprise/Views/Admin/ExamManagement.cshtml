@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model ExamPageModel
@section IncludeCss
{
    <title>Exam Management</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
}
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Exam Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Exam Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    @using (Html.BeginForm("ExamManagement", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetExams" }))
                    {
                        <div class="row std-mng-head">

                            <div class="col-md-12 class-section">
                                <div class="row">
                                    <div class="col-md-3 padding">
                                        <label class="col-md-4 text-right">Session</label>
                                        <div class="col-md-8">
                                            <select class="form-control" ID="ddlSessions" name="SessionID" onchange="$('#ddlMainClass').change();">
                                                @foreach (SchoolSessionModel e in Model.Sessions)
                                                {
                                                    <option value="@e.SessionID" @(e.SessionID == Model.SessionID ? "Selected" : "")>@e.SessionName @(e.SessionStatus == 1 ? "(Active)" : "")</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-2 padding">
                                        <label class="col-md-4 text-right">Class</label>
                                        <div class="col-md-8">
                                            <select class="form-control" ID="ddlMainClass" name="ClassID" onchange="ClassMainChanged(this);">
                                                @foreach (ClassModel e in Model.Classes)
                                                {
                                                    <option value="@e.ClassID" @(e.ClassID == Model.ClassID ? "Selected" : "")>@e.ClassName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 padding">
                                        <label class="col-md-3 text-right" style="padding-right: 0px;">Evaluations</label>
                                        <div class="col-md-9">
                                            <select class="form-control" name="EvaluationID" ID="ddlEvaluations">
                                                @foreach (EvaluationModel e in Model.Evaluations)
                                                {
                                                    <option value="@e.EvaluationID" @(e.EvaluationID == Model.EvaluationID ? "Selected" : "")>@e.EvaluationName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 padding">
                                        <div class="row">
                                            <label class="col-md-3 text-right padding-R">Groups</label>
                                            <div class="col-md-7 padding-L" style="padding-left: 10px;">

                                                <select class="form-control" name="GroupID" ID="ddlGroups">
                                                    @foreach (GroupModel e in Model.Groups)
                                                    {
                                                        <option value="@e.GroupID" @(e.GroupID == Model.GroupID ? "Selected" : "")>@e.GroupName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-2" style="padding-left: 0px;">
                                                <a onclick="$('#frmGetExams').submit();" ID="lbGetList"><i class="fa fa-search"></i></a>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    }
                </div>
                @if (Model.Evaluations.Count() == 0)
                {
                    <div class="box-body">
                        <div class="row">
                            <div class="col-md-12" style="text-align:center">
                                <a href="/Admin/EvaluationManagement">No Evaluation Added, Please Add one.</a>
                            </div>
                        </div>
                    </div>
                }
                else if (Model.Classes.Count() == 0)
                {
                    <div class="box-body">
                        <div class="row">
                            <div class="col-md-12" style="text-align:center">
                                <a href="/Admin/ClassSectionManagement">No Class Added, Please Add one.</a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="box-body">
                        @using (Html.BeginForm("UpdateExams", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetExams" }))
                        {
                            <input type="hidden" value="@Model.ClassID" name="ClassID" />
                            <input type="hidden" value="@Model.GroupID" name="GroupID" />
                            <input type="hidden" value="@Model.EvaluationID" name="EvaluationID" />
                            <input type="hidden" value="@Model.SBranchID" name="SBranchID" />
                            <table id="tblCategory" class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 5%">#</th>
                                        <th style="width: 20%">Subject</th>
                                        <th style="width: 20%">Exam Date <sa style="color: cadetblue;">(MM/DD/YYYY)</sa></th>
                                        <th style="width: 10%">Start Time</th>
                                        <th style="width: 10%">End Time</th>
                                        <th style="width: 7%">Marking Scheme</th>
                                        <th style="width: 11%">Max Marks</th>
                                        <th style="width: 12%">Pass Marks</th>
                                        <th style="width: 6%">Applicable</th>
                                        <th style="width: 6%">Lock Result</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var Counter = 0;
                                        decimal MxMarks = 0;
                                        decimal MnMarks = 0;
                                        foreach (ExamModel e in Model.Exams)
                                        {
                                            <tr @(e.ExamID == 0 ? "style=color:red" : "")>
                                                <td>
                                                    <input type="hidden" name="Exams[@Counter].SubjectID" value="@e.SubjectID" />
                                                    <input type="hidden" value="@Model.ClassID" name="Exams[@Counter].ClassID" />
                                                    <input type="hidden" value="@e.ExamID" name="Exams[@Counter].ExamID" />
                                                    <input type="hidden" value="@Model.GroupID" name="Exams[@Counter].GroupID" />
                                                    <input type="hidden" value="@Model.EvaluationID" name="Exams[@Counter].EvaluationID" />
                                                    <input type="hidden" value="@Model.SBranchID" name="Exams[@Counter].SBranchID" />
                                                    <input type="hidden" value="@Model.UserID" name="Exams[@Counter].UserID" />
                                                    <input type="hidden" value="@e.CreatedDate" name="Exams[@Counter].CreatedDate" />
                                                    <input type="hidden" value="@Model.CurrentDate" name="Exams[@Counter].ModifiedDate" />
                                                    @(Counter + 1)
                                                </td>


                                                <td>

                                                    @e.SubjectName
                                                </td>


                                                <td>
                                                    @*<input type="date" class="form-control ExamDate" name="Exams[@Counter].ExamDate" value="@e.ExamDate.ToString("yyyy-MM-dd")" />*@
                                                    <input type="date" class="form-control" name="Exams[@Counter].ExamDate" value="@e.ExamDate.ToString("yyyy-MM-dd")" />
                                                </td>
                                                <td>
                                                    @*<input type="time" class="form-control StartTime" name="Exams[@Counter].StartTime" value="@e.StartTime" />*@
                                                    <input type="time" class="form-control" name="Exams[@Counter].StartTime" value="@e.StartTime" />
                                                </td>
                                                <td>
                                                    @*<input type="time" class="form-control EndTime" name="Exams[@Counter].EndTime" value="@e.EndTime" />*@
                                                    <input type="time" class="form-control" name="Exams[@Counter].EndTime" value="@e.EndTime" />
                                                </td>


                                                <td style="vertical-align:middle;">
                                                    <label class="switch switch-green" style="padding-top: 3px;">
                                                        <input type="checkbox" id="chkMarkingScheme" @(e.MarkingScheme == 0 ? "checked" : "") class="switch-input MScheme">

                                                        <span class="switch-label" onclick='$(this).closest("label").find("#hdnMarkingScheme").val($(this).closest("tr").find("#hdnMarkingScheme").val() == "0" ? "1" : "0");' data-on="Marks" data-off="Grade"></span>
                                                        <span class="switch-handle" id="shTranding"></span>
                                                        <input type="hidden" id="hdnMarkingScheme" name="Exams[@Counter].MarkingScheme" value="@e.MarkingScheme" />
                                                    </label>
                                                </td>


                                                @if (@e.MarkingScheme == 0)
                                                {
                                                    MxMarks = @e.MaxMarks;
                                                    MnMarks = @e.PassMarks;

                                                }
                                                else
                                                {
                                                    MxMarks = 0;
                                                    MnMarks = 0;
                                                }
                                                <td>
                                                    <input type="number" id="inMxMarks" step="0.01" class="form-control maxMarks" name="Exams[@Counter].MaxMarks" value="@MxMarks" />
                                                </td>
                                                <td>
                                                    <input type="number" id="inMxMarks" step="0.01" class="form-control passMarks" name="Exams[@Counter].PassMarks" value="@MnMarks" />
                                                </td>

                                                <td style="vertical-align:middle;">
                                                    <label class="switch switch-green" style="padding-top: 3px;">
                                                        <input type="checkbox" id="chkEmailSettingSSL" @(e.IsApplicable == 1 ? "checked" : "") class="switch-input">
                                                        <span class="switch-label" onclick='$(this).closest("label").find("#hdnIsApplicable").val($(this).closest("tr").find("#hdnIsApplicable").val() == "0" ? "1" : "0");' data-on="Yes" data-off="No"></span>
                                                        <span class="switch-handle" id="shTranding"></span>
                                                        <input type="hidden" id="hdnIsApplicable" name="Exams[@Counter].IsApplicable" value="@e.IsApplicable" />
                                                    </label>
                                                </td>

                                                <td style="vertical-align:middle;">
                                                    <label class="switch switch-green" style="padding-top: 3px;">
                                                        <input type="checkbox" id="chkIsLocked" @(e.IsLocked == 1 ? "checked" : "") class="switch-input">
                                                        <span class="switch-label" onclick='$(this).closest("label").find("#hdnIsLocked").val($(this).closest("tr").find("#hdnIsLocked").val() == "0" ? "1" : "0");' data-on="Yes" data-off="No"></span>
                                                        <span class="switch-handle" id="shLocked"></span>
                                                        <input type="hidden" id="hdnIsLocked" name="Exams[@Counter].IsLocked" value="@e.IsLocked" />
                                                    </label>
                                                </td>
                                            </tr>
                                            Counter++;
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    @*<tr>
                                            <td colspan="2">Set Date, Time and Max Marks and Passing Marks for all subjects at once.</td>
                                            <td>
                                                <input type="date" class="form-control" value="" onchange="UpdateAllExamDate(this);" />
                                            </td>
                                            <td>
                                                <input type="time" class="form-control" value="" onchange="UpdateAllStartTime(this);" />
                                            </td>
                                            <td>
                                                <input type="time" class="form-control" value="" onchange="UpdateAllEndTime(this);" />
                                            </td>

                                            <td>
                                                <input type="number" step="0.01" class="form-control" value="" onchange="UpdateAllMaxMarks(this);" />
                                            </td>
                                            <td>
                                                <input type="number" step="0.01" class="form-control" value="" onchange="UpdateAllPassMarks(this);" />
                                            </td>
                                            <td></td>
                                            <td></td>
                                        </tr>*@
                                    <tr>
                                        <td colspan="5">Set Max Marks and Passing Marks for all subjects at once.</td>

                                        <td>
                                            <input type="number" step="0.01" class="form-control" value="" onchange="UpdateAllMaxMarks(this);" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" class="form-control" value="" onchange="UpdateAllPassMarks(this);" />
                                        </td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                            <div>
                                <button type="submit" class="btn btn-block btn-info pull-right">Save</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

</section>
<script>
    $(document).ready(function () {
        if ($('.MScheme').val() == 1) {
            $(this).parents("tr:eq(0)").find(".maxMarks").prop("disabled", true);
            $(this).parents("tr:eq(0)").find(".maxMarks").val(0);

            $(this).parents("tr:eq(0)").find(".passMarks").prop("disabled", true);
            $(this).parents("tr:eq(0)").find(".passMarks").val(0);
            alert('Test');
        }
    })

    $('.MScheme').change(function () {
        var isChecked = this.checked;
        if (!isChecked) {
            $(this).parents("tr:eq(0)").find(".maxMarks").prop("disabled", true);
            $(this).parents("tr:eq(0)").find(".maxMarks").val(0);

            $(this).parents("tr:eq(0)").find(".passMarks").prop("disabled", true);
            $(this).parents("tr:eq(0)").find(".passMarks").val(0);

        } else {
            $(this).parents("tr:eq(0)").find(".maxMarks").prop('disabled', false);
            $(this).parents("tr:eq(0)").find(".maxMarks").val(100);

            $(this).parents("tr:eq(0)").find(".passMarks").prop('disabled', false);
            $(this).parents("tr:eq(0)").find(".passMarks").val(35);
        }

    });
    //function UpdateAllExamDate(sender) {
    //    var val = $(sender).val();
    //    $('.ExamDate').val(val);
    //}
    //function UpdateAllStartTime(sender) {
    //    var val = $(sender).val();
    //    $('.StartTime').val(val);
    //}

    function UpdateAllEndTime(sender) {
        var val = $(sender).val();
        $('.EndTime').val(val);
    }
    function UpdateAllMaxMarks(sender) {
        var val = $(sender).val();
        $('.maxMarks').val(val);
    }
    function UpdateAllPassMarks(sender) {
        var val = $(sender).val();
        $('.passMarks').val(val);
    }
    $(function () {

        $('#liExamManagement').closest('ul').closest('li').addClass('active');
        $('#liExamManagement').addClass('active');
    });

    function ClassMainChanged(sender) {

        $('#ddlGroups').html('<option value="0">Loading....</option>');
        $('#ddlEvaluations').html('<option value="0">Loading....</option>');
        $.ajax(
            {
                type: "POST",
                url: "/Admin/GetClassGroups/" + $(sender).val() + "/" + $('#ddlSessions').val(),
                cache: false,
                processData: false,
                contentType: false,
                success: function (data) {
                    $('#ddlGroups').html('');
                    $('#ddlEvaluations').html('');

                    for (var i = 0; i < data.Groups.length; i++) {
                        $('#ddlGroups').append('<option value="' + data.Groups[i].GroupID + '">' + data.Groups[i].GroupName + '</option>');
                    }
                    for (var i = 0; i < data.Evaluations.length; i++) {
                        $('#ddlEvaluations').append('<option value="' + data.Evaluations[i].EvaluationID + '">' + data.Evaluations[i].EvaluationName + '</option>');
                    }
                },
                error: function (e) {
                    alert("errorn");
                }
            });
    }
</script>
<!-- /.content -->