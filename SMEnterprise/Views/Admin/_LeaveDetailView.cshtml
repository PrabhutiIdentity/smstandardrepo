@model SMEnterprise.Models.LeaveEditModel
<div class="box box-danger">
    <div class="box-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h3 class="box-title">Leave Details</h3>
    </div>
    <div class="box-body" style="margin-left: 20px;">
        <div class="row">
            <div class="col-md-4">@(Model.Leave.LeaveType == 0 ? "Full Day" : Model.Leave.LeaveType == 1 ? "First Half" : "Second Half")</div>
            <div class="col-md-8" style="text-align: right;">@Model.Leave.StartDate.ToString("dd MMM yyyy")-@Model.Leave.EndDate.ToString("dd MMM yyyy")</div>
            <label class="col-md-12">@Model.Leave.ApplicantName</label>
        </div>
        <div class="row">
            @foreach (var le in Model.LeaveDetails)
            {
                <div class="col-md-4">@le.LeaveTypeName Applied: <label> @le.Applied</label></div>
            }
        </div>
        <div class="row">
            <label class="col-md-12">
                Leave Reason
            </label>
            <div class="col-md-12">
                @Model.Leave.LeaveReason
            </div>
        </div>
        <div class="row">
            @using (Html.BeginForm("UpdateLeaveStatus", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
            {
                <div class="col-md-6">
                    <input type="hidden" id="hdnLeaveID" name="LeaveID" value="@Model.Leave.LeaveID" />
                </div>
                <div class="col-md-4" style="text-align: right;">
                    <label class="switch switch-green" style="padding-top: 3px;">
                        @if (Model.Leave.IsApproved == 1)
                        {
                            <input type="checkbox" class="switch-input" Checked>
                        }
                        else
                        {
                            Model.Leave.IsApproved = 0;
                            <input type="checkbox" class="switch-input">
                        }
                        <span class="switch-label" onclick='$(this).closest("label").find("#hdnLeaveEditStatus").val($(this).closest("label").find("#hdnLeaveEditStatus").val() == "0" ? "1" : "0");' data-on="Approve" data-off="Reject"></span>
                        <span class="switch-handle" onclick='$(this).closest("label").find("#hdnLeaveEditStatus").val($(this).closest("label").find("#hdnLeaveEditStatus").val() == "0" ? "1" : "0");' id="shTranding"></span>
                        <input type="hidden" id="hdnLeaveEditStatus" name="IsApproved" value="@Model.Leave.IsApproved" />
                    </label>

                </div>
                <div class="col-md-2">
                    @if (Model.Leave.IsApproved != 1)
                    {
                        <button type="submit" class="btn btn-primary">Submit</button>
                    }
                </div>
            }
        </div>
    </div>
</div>
