@using SMEnterprise.Models;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model SMEnterprise.Models.AdminDashboardModel

@section IncludeCss
{
    <link href="@Url.Content("~/css/ExtraCss.css")" rel="stylesheet" />
    <title>P-School | Dashboard</title>

    <style>
        .table td {
            padding: 0px !important;
        }

        .tile_count {
            margin-bottom: 5px;
        }

            .tile_count div:first-child .left {
                border: 0;
            }

            .tile_count .tile_stats_count {
                border-left: 0px solid #333;
                padding-bottom: 8px;
                padding-top: 5px;
                background-color: white;
            }

        .tile_stats_count .left {
            width: 15%;
            float: left;
            height: 65px;
            border-left: 2px solid #ADB2B5;
            margin-top: 10px;
        }

        .tile_stats_count .right {
            padding-left: 10px;
            height: 100%;
            text-overflow: ellipsis;
            overflow: hidden;
        }

            .tile_stats_count .right span {
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .tile_stats_count .count {
            font-size: 40px;
            line-height: 47px;
            font-weight: 600;
        }

            .tile_stats_count .count small {
                font-size: 20px;
                line-height: 20px;
                font-weight: 600;
            }

        .count_bottom i {
            width: 12px;
        }

        .dashboard_graph {
            background: #fff;
            padding: 7px 10px;
        }

            .dashboard_graph .col-md-9,
            .dashboard_graph .col-md-3 {
                padding: 0;
            }

        .panel_toolbox {
            float: right;
            min-width: 70px;
        }

            .panel_toolbox > li {
                float: left;
            }

                .panel_toolbox > li > a {
                    padding: 5px;
                    color: #C5C7CB;
                    font-size: 14px;
                }

                    .panel_toolbox > li > a:hover {
                        background: #F5F7FA;
                    }

        .list {
            max-height: 208px;
            overflow-y: auto;
        }

            .list::-webkit-scrollbar-thumb {
                background-color: #000000;
            }

            .list::-webkit-scrollbar {
                width: 7px;
            }

            .list::-webkit-scrollbar-track {
                -webkit-box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
            }

            .list::-webkit-scrollbar-thumb {
                background-color: darkgrey;
                outline: 1px solid slategrey;
            }

        .small-box h3, .small-box p {
            text-align: center;
            font-weight: bold;
        }

        .small-box .icon {
            top: 20px !important;
            right: 110px !important;
        }

        .collection .col-lg-3 {
            padding-right: 5px;
            padding-left: 5px;
        }

        .dropdown-menu li {
            border-radius: 5px;
            background-color: beige;
            margin: 2px;
            border: 0.15em solid #f5e4dc;
        }

        .takeBackup a {
            color: #4fa55b;
        }

            .takeBackup a:hover {
                color: #615db0;
            }

        .hidden {
            display: none;
        }
    </style>
}
<style>
    .thumbImageGrid {
        max-width: 35px;
        max-height: 35px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?35:'auto');
        height: expression((this.width/this.height)<1?35:'auto');
    }
</style>
<section class="content" style="min-height: 0px;padding-top: 0px;">
    <div class="row tile_count" style="background-color: #F7F7F7;padding-top: 10px;">
        Active Session : @Model.SessionName
    </div>
</section>
<!-- Main content -->
<section class="content" style="min-height: 0px;padding-top: 0px;">
    <div class="row tile_count" style="background-color: #F7F7F7;padding-top: 10px;">
        <div class="animated flipInY col-md-2 col-sm-4 col-xs-4 tile_stats_count" style="color: #73879c;">
            <div class="left"></div>
            <div class="right">
                <span class="count_top"><i class="fa fa-user"></i> Total Students</span>
                <div class="count">
                    @Model.StudentsCount
                </div>

            </div>
        </div>
        <div class="animated flipInY col-md-2 col-sm-4 col-xs-4 tile_stats_count" style="color: #73879c;">
            <div class="left"></div>
            <div class="right">
                <span class="count_top"><i class="fa fa-user"></i> Total Teachers</span>
                <div class="count">
                    @Model.TeacherCount
                </div>

            </div>
        </div>
