            <div class="left"></div>

            <a href="javascript:;" class="dropdown-toggle info-number" data-toggle="dropdown" aria-expanded="false">
                <div class="right">
                    <span class="count_top"><i class="fa fa-user"></i> Absent Teachers</span>
                    <div class="count red">
                        @Model.AbsentTeachers <small>Today</small>
                    </div>

                </div>
            </a>
            <ul class="dropdown-menu list-unstyled msg_list animated fadeInDown list" role="menu" style="color: #73879c;width: 285px;">
                @foreach (EmployeeModel ae in Model.AbsentTeacherList)
                {
                    <li>
                        <a target="_blank" href="/Admin/TeacherTimeTableManagement/@ae.EmployeeID" title="Click to Manage Time Table">
                            <span class="image"><img onerror="return OnImageError(this,@(ae.Gender));" src="@Url.Content("~/Images/EmployeeImage/" + ae.Photo)" class="thumbImageGrid" alt="Profile Image" /></span>
                            <span style="margin-left: 10px;position: absolute;color: #1a2226;text-transform: capitalize;"> @ae.EmployeeName</span>
                            <span style="margin-left: 10px;position: absolute;margin-top: 15px;"> @ae.EmployeeSID (@ae.MobileNumber)</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="animated flipInY col-md-3 col-sm-4 col-xs-4 tile_stats_count" style="color: #73879c;">
            <div class="left"></div>
            <div class="right">
                <span class="count_top"><i class="fa fa-user"></i> Month Collections</span>
                <div class="count" style="font-size: 24px;">
                    @((Model.MonthlyCollection / 1000).ToString("N2")) K
                </div>

            </div>
        </div>
        <div class="animated flipInY col-md-3 col-sm-4 col-xs-4 tile_stats_count" style="color: #73879c;">
            <div class="left"></div>
            <div class="right">
                <span class="count_top"><i class="fa fa-user"></i> Monthly Expence</span>
                <div class="count" style="font-size: 24px;">
                    @((Model.MonthlyExpence / 1000).ToString("N2")) K
                </div>

            </div>
        </div>
        @*<div class="animated flipInY col-md-2 col-sm-4 col-xs-4 tile_stats_count" style="color: #73879c;">
                <div class="left"></div>
                <div style="margin-top: 12px;">
                    <div class="count takeBackup" style="font-size: 28px;">
                        <span class="count_top" id="spnTakeBackup"><a href="javascript:void(0);" onclick="GenerateBackup();"> <i class="fa fa-database"></i> Backup</a></span>
                    </div>
                    <div class="count downloadBackup hidden" style="font-size: 22px;">
                        <span class="count_top" id="spnTakeBackup"><a href="javascript:void(0);" onclick="DownloadBackup(this);"> <i class="fa fa-download"></i> Download</a></span>
                    </div>
                    <span class="count_top backupProgress hidden"><i class="fa fa-database"></i> Backup in Process</span>
                    <div class="indicator backupProgress hidden">
                        <svg width="16px" height="12px">
                            <polyline id="back" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
                            <polyline id="front" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
                        </svg>
                    </div>
                </div>
            </div>*@
    </div>
    <div class="row collection">
