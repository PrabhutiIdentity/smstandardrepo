</section>
<!-- /.content -->
@section scripts
{
    <script src="@Url.Content("~/js/Chart.min.js")"></script>
    <script>
        function GenerateBackup()
        {
            $('.takeBackup').addClass('hidden');
            $('.backupProgress').removeClass('hidden');
            $.ajax(
                   {
                       type: "POST",
                       url: "/Admin/TakeBackup/",
                       cache: false,
                       processData: false,
                       contentType: false,
                       success: function (filename) {
                           $('.downloadBackup').removeClass('hidden');
                           $('.downloadBackup').find('a').attr('FileName',filename);
                           $('.backupProgress').addClass('hidden');
                       },
                       error: function (e) {
                           alert("errorn");
                       }
                   });
        }
        function DownloadBackup(sender)
        {
            var curUrl = window.location.href;
            var ind = curUrl.indexOf("Admin");
            var BaseUrl = curUrl.substring(0, ind);
            var link = BaseUrl + 'Backup/Database/'+$(sender).attr('FileName');
            var a = $("<a>")
            .attr("href", link)
             .attr("download", $(sender).attr('FileName'))
            .appendTo("body");

            a[0].click();

            a.remove();
        }
        var ClassChart;
        var EmpAttChart;
        $(function () {
            ClassChart = @Html.Raw(Json.Encode(Model.ClassSection));
            EmpAttChart = @Html.Raw(Json.Encode(Model.EmployeeAttandanceChart));
            new Chart(document.getElementById("canvas_dahs"), {
                type: 'line',
                data: ClassChart
            });
            new Chart(document.getElementById("canvas_EmpAttandance"), {
                type: 'line',
                data: EmpAttChart
            });
        });
    </script>
}
