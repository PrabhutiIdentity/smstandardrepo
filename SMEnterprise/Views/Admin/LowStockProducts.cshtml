@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
                /**/

                ViewBag.Title = "App Banner Management";
                Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <title>Products Management</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
}
@model List<SMEnterprise.Models.ProductModel>
<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    .thumbImage {
        max-width: 235px;
        max-height: 250px;
    }

    a.btn-danger {
        color: #fff;
    }

    *html .thumbImage {
        width: expression((this.width/this.height)>=1?250:'auto');
        height: expression((this.width/this.height)<1?250:'auto');
    }

    .fa-remove {
        color: red;
    }

    .RedText {
        color: red;
    }

    .fileContainer {
        overflow: hidden;
        position: relative;
    }

        .fileContainer [type=file] {
            cursor: inherit;
            display: block;
            font-size: 999px;
            filter: alpha(opacity=0);
            min-height: 100%;
            min-width: 100%;
            opacity: 0;
            position: absolute;
            right: 0;
            text-align: right;
            top: 0;
        }

    .BillImageBox {
        padding: 10px 5px 5px 5px;
        background-color: white;
        margin-left: 5px;
        border-radius: 5px;
        margin-top: 5px;
        margin-bottom: 5px;
        border: 1px solid #0087dd;
    }

    .BillImageBoxAdd {
        padding: 10px 5px 5px 5px;
        background-color: white;
        height: 292px;
        margin-left: 5px;
        border-radius: 5px;
        margin-top: 5px;
        margin-bottom: 5px;
        border: 1px solid #0087dd;
    }

    .GalImages {
        border: 1px solid #605ca8;
        margin: 0px;
        border-radius: 5px;
    }

        .GalImages .col-md-3 {
            width: 24.4% !important;
        }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Products Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Products Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
               
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 10%">Photo</th>
                                <th style="width: 40">Product</th>
                                <th style="width: 13%">Available Qty</th>
                                <th style="width: 13%">MinQty</th>
                            </tr>
                        </thead>
                        @{
                            int count = 0;
                            foreach (ProductModel c in Model)
                            {
                                <tr>

                                    <td>
                                        <img id="imgPhoto" onerror="return OnImageError(this,3);" class="thumbImageGrid" alt="Photo" src="@Url.Content("~/Images/Products/")@(c.ProductID)_@c.Photo" />
                                    </td>
                                    <td>
                                        @c.Name
                                    </td>

                                    <td>
                                        @c.Quantity.ToString("0.0")
                                    </td>
                                    <td>
                                        @c.MinQty.ToString("0.0")
                                    </td>
                                </tr>

                                count++;
                            }

                        }
                    </table>

                </div>
            </div>
        </div>
    </div>



</section>
<script>

    function PhotoChanged(fileBox) {
        console.log("asasas");
        if (fileBox.files && fileBox.files[0]) {
            if (fileBox.files[0].size / 1024 < 500) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $(fileBox).closest('.col-md-12').find('img').attr('src', e.target.result);
                }
                reader.readAsDataURL(fileBox.files[0]);
            }
            else {
                ShowNotification('Large Image', 'Kindly Upload Image of Size less the 500kb', 'error');
                clearFileInput(fileBox);
            }
        }
    }
    function clearFileInput(ctrl) {
        try {
            ctrl.value = null;
        } catch (ex) { }
        if (ctrl.value) {
            ctrl.parentNode.replaceChild(ctrl.cloneNode(true), ctrl);
        }
    }
    $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });
        $('#liLSProducts').closest('ul').closest('li').addClass('active');
        $('#liLSProducts').addClass('active');
    });
    function DeleteProduct(sender) {
        return confirm('Do you really want to delete App Banner!!!!');
    }
    function PhotoChanged(fileBox) {

        if (fileBox.files && fileBox.files[0]) {
            if (fileBox.files[0].size / 1024 < 500) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $(fileBox).closest('.col-md-6').find('#imgMainPhoto').attr('src', e.target.result);
                }
                reader.readAsDataURL(fileBox.files[0]);
            }
            else {

                ShowNotification('Large Image', 'Kindly Upload Image of Size less the 500KB', 'error');
            }
        }
    }
    function EditProduct(sender, ProductID) {


        if ($(sender).hasClass("EditSectionClose")) {
            $(sender)
                .closest("tr")
                .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>Loading, Please Wait....</td></tr>");
            $.ajax(
                {
                    type: "POST",
                    url: "/Admin/GetProductDetails/" + ProductID,
                    cache: false,
                    processData: false,
                    contentType: false,
                    success: function (html) {
                        // fill the div with the html returned by action
                        $(sender).closest("tr").next().remove();

                        var ele = document.getElementsByClassName("EditSectionOpen");
                        if (ele.length > 0) {
                            $(ele[0]).click();
                            if ($(ele[0]).text() == 'Cancel') {
                                $(ele[0]).text('Add New');
                            }
                            else {
                                $(sender).html('Edit');
                            }
                        }
                        if ($(sender).html() == 'Add New') {
                            $(sender).html('Cancel');
                        }
                        else {

                            $(sender).html('Close');
                        }
                        $(sender).removeClass("EditSectionClose");
                        $(sender).addClass("EditSectionOpen");
                        $(sender)
                            .closest("tr")
                            .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + html + "</td></tr>");

                    },
                    error: function (e) {
                        alert("errorn");
                    }
                });
        }
        else {
            $(sender).removeClass("EditSectionOpen");
            $(sender).addClass("EditSectionClose");
            if ($(sender).text() == 'Cancel') {
                $(sender).text('Add New');
            }
            else {
                $(sender).text('Edit');
            }
            $(sender).closest("tr").next().remove();

        }

    }
</script>
<!-- /.content -->