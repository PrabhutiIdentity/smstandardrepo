<table id="tblCategory" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 5%">Sl.No.</th>
            <th style="width: 20%">Room</th>
            <th style="width: 30%">Room Type</th>
            <th style="width: 10%">Room No.</th>
            <th style="width: 10%">#Occupants</th>
            <th style="width: 10%">Status</th>
            <th style="width: 15%"><a class="sbtn" href="javascript:void(0);" onclick="OpenAddNewCopy(this)">Add New</a></th>
        </tr>
    </thead>

    @{
        var count = 0;
        <tbody>

            @foreach (SMEnterprise.Models.HostalRoomModel c in Model.Rooms)
            {
                count++;
                <tr>
                    <td>@count</td>

                    <td>
                        <span class="ViewCopy visible">@c.Name</span>
                        <input type="hidden" id="hdnFloorID" name="FloorID" value="@Model.ID" />
                        <input type="hidden" id="hdnRoomID" name="ID" value="@c.ID" />
                        <input type="text" class="form-control editCopy hidden" name="Name" id="txtRoomName" value="@c.Name" />
                    </td>
                    <td>
                        @foreach (SMEnterprise.Models.HostalRoomTypeModel r in Model.RoomTypes)
                        {
                            if (c.RoomTypeID == r.ID)
                            {
                                <span class="ViewCopy visible">@r.RoomTypeName (@r.Capacity) @r.Rate Rs</span>
                            }
                        }
                        <select id="ddlRoomType" class="form-control editCopy hidden">
                            @foreach (SMEnterprise.Models.HostalRoomTypeModel r in Model.RoomTypes)
                            {
                                <option value="@r.ID" @(c.RoomTypeID == r.ID ? "selected" : "")>@r.RoomTypeName (@r.Capacity) @r.Rate Rs</option>
                            }
                        </select>
                    </td>
                    <td>
                        <span class="ViewCopy visible">@c.RoomNo</span>
                        <input type="text" class="form-control editCopy hidden" name="Name" id="txtRoomNo" value="@c.RoomNo" />
                    </td>
                    <td>
                        <input type="hidden" id="hdnRoomOccupants" value="@c.Occupents" />
                        @c.Occupents
                    </td>
                    <td>
                        <span class="ViewCopy visible"><label class='badge bg-@(c.Status == 0 ? "red" : "green")'>@(c.Status == 0 ? "Inactive" : "Active")</label></span>

                        <label class="switch switch-green editCopy hidden" style="padding-top: 3px;">
                            @if (c.Status == 1)
                            {
                                <input id="chkType" type="checkbox" class="switch-input" checked>
                            }
                            else
                            {
                                <input id="chkType" type="checkbox" class="switch-input">
                            }
                            <span class="switch-label" onclick='$(this).closest("tr").find("#hdnIsApproved").val($(this).closest("tr").find("#hdnIsApproved").val() == "0" ? "1" : "0");' data-on="Active" data-off="Inactive"></span>
                            <span class="switch-handle" id="shTranding"></span>
                            <input id="hdnIsApproved" type="hidden" value="@c.Status" />
                        </label>
                    </td>

                    <td>
                        <div class="row" style="margin-right: 0px;">
                            <div class="col-md-6">
                                <a href="javascript:void(0);" class="sbtn" onclick="EditCopy(this);">Edit</a>
                            </div>
                            <div class="col-md-6">
                                <input type="submit" class="btn btn-link sbtn editCopy hidden" value="Save" onclick="SaveHostelFloorRoom(this, 1);" />
                                <input type="submit" class="btn btn-link sbtn ViewCopy visible" value="Delete" onclick="return DeleteHostelFloorRoom(this, -1);" />
                            </div>
                        </div>
                    </td>



                </tr>
            }

        </tbody>
        <tfoot style="border-width: 2px;border-style: groove;display:none;">
            <tr>
                <td>@count</td>

                <td>
                    <input type="hidden" id="hdnFloorID" name="FloorID" value="@Model.ID" />
                    <input type="hidden" id="hdnRoomID" name="ID" value="0" />
                    <input type="text" class="form-control" name="Name" id="txtRoomName" value="" />
                </td>
                <td>
                    <select id="ddlRoomType" class="form-control">
                        @foreach (SMEnterprise.Models.HostalRoomTypeModel r in Model.RoomTypes)
                        {
                            <option value="@r.ID">@r.RoomTypeName (@r.Capacity) @r.Rate Rs</option>
                        }
                    </select>
                </td>
                <td>
                    <input type="text" class="form-control" name="Name" id="txtRoomNo" value="" />
                </td>
                <td>
                    <input type="hidden" id="hdnRoomOccupants" value="0" />
                    0
                </td>
                <td>
                    <label class="switch switch-green" style="padding-top: 3px;">

                        <input id="chkType" type="checkbox" class="switch-input" checked>

                        <span class="switch-label" onclick='$(this).closest("tr").find("#hdnIsApproved").val($(this).closest("tr").find("#hdnIsApproved").val() == "0" ? "1" : "0");' data-on="Active" data-off="Inactive"></span>
                        <span class="switch-handle" id="shTranding"></span>
                        <input id="hdnIsApproved" type="hidden" value="1" />
                    </label>
                </td>

                <td>
                    <div class="row" style="margin-right: 0px;">
                        <div class="col-md-12">
                            <input type="submit" class="btn btn-link" value="Add New" onclick="SaveHostelFloorRoom(this, 1);" />
                        </div>

                    </div>
                </td>



            </tr>
        </tfoot>
    }
</table>
