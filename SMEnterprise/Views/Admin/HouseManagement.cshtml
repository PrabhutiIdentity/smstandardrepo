@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    ViewBag.Title = "Blog Categories";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <link rel="stylesheet" href="@Url.Content("~/css/Admin/bootstrap-colorpicker.min.css")">
    <title>House Management</title>
}
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        House Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">House Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 10%">Sl. No.</th>
                                <th style="width: 30%">House Name</th>
                                <th style="width: 20%">House Color</th>
                                <th style="width: 10%">#Students</th>
                                <th style="width: 10%">Edit/Delete</th>
                            </tr>
                        </thead>
                        @{
                            int count = 0;
                            foreach (var c in Model)
                            {
                                <tr>

                                    <td>
                                        @(count+1)
                                        <input type="hidden" name="ID" id="hdnHouseID" value="@c.ID" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnHouseName").val($(this).val())' id="txtHouseName" name="Name" value="@c.Name" />
                                    </td>

                                    <td>
                                        <div class="input-group my-colorpicker2">
                                            <input type="text" class="form-control" id="txtHouseColor" onchange='$(this).closest("tr").find("#hdnHouseColor").val($(this).val())' value="@c.HouseColor">
                                            <div class="input-group-addon">
                                                <i style="background-color: @c.HouseColor;"></i>
                                            </div>
                                        </div>
                                        
                                    </td>
                                    <td>
                                        <input type="hidden" id="hdnStudentCount" value="@c.StudentCount" />
                                        @c.StudentCount
                                    </td>
                                    
                                    <td>
                                        <div class="btn-group">
                                            @using (Html.BeginForm("UpdateHouse", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" name="ID" id="hdnHouseID" value="@c.ID" />
                                                        <input type="hidden" id="hdnHouseName" name="Name" value="@c.Name" />
                                                        <input type="hidden" id="hdnHouseColor" name="HouseColor" value="@c.HouseColor" />
                                                        <input type="submit" onclick="return BeforeHouseUpdate(this);" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Save" />
                                            }
                                             @using (Html.BeginForm("UpdateHouse", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" name="OpType" value="-1" />
                                                <input type="hidden" name="ID" value="@c.ID" />
                                                <button onclick="return HouseDelete(this);" style="background-color: red;color: white;" class="btn btn-default" value="Edit">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>

                                count++;
                            }
                            <tr>

                                <td>
                                    @(count+1)
                                    <input type="hidden" name="ID" id="hdnHouseID" value="0" />
                                </td>
                                <td>
                                    <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnHouseName").val($(this).val())' id="txtHouseName" name="Name" value="" />
                                </td>

                                <td>
                                    <div class="input-group my-colorpicker2">
                                        <input type="text" class="form-control" id="txtHouseColor" onchange='$(this).closest("tr").find("#hdnHouseColor").val($(this).val())' value="">
                                        <div class="input-group-addon">
                                            <i></i>
                                        </div>
                                    </div>

                                </td>
                                <td>
                                    0
                                </td>

                                <td>
                                    <div class="btn-group">
                                        @using (Html.BeginForm("UpdateHouse", "Admin", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                        {
                                            <input type="hidden" name="ID" id="hdnHouseID" value="0" />
                                                <input type="hidden" id="hdnHouseName" name="Name" value="" />
                                                        <input type="hidden" id="hdnHouseColor" name="HouseColor" value="" />
                                                        <input type="submit" onclick="return BeforeHouseUpdate(this);" class="btn btn-default" style="background-color: #605ca8;color: white;"  value="Add New" />
                                        }
                                       
                                    </div>
                                </td>
                            </tr>
                        }
                    </table>
                    
                </div>
            </div>
        </div>
    </div>

</section>
@section scripts
{
    <script src="@Url.Content("~/js/Admin/bootstrap-colorpicker.min.js")"></script>
<script>
    $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });
        $('#liHouseManagement').closest('ul').closest('li').addClass('active');
        $('#liHouseManagement').addClass('active');
        $(".my-colorpicker2").colorpicker();
    });
    function HouseDelete(sender) {
        var StuCount = $(sender).closest('tr').find('#hdnStudentCount').val();       
        if (StuCount != 0) {
            ShowClosingNotification('Error', 'House Has Students, So it can not be deleted!!!!', 'error');
            return false;
        }
        else {
            if (confirm('Are you sure you wish to delete this House?')) {

                return true;
            }
            else {
                return false;
            }
        }
    }
    function BeforeHouseUpdate(sender)
    {
        if ($(sender).closest('tr').find('#txtHouseName').val() == "" || $(sender).closest('tr').find('#txtHouseColor').val() == "") {
            ShowClosingNotification('Error', 'Plese Fill Required Details!!!!', 'error');
            return false;
        }
        else {
            $(sender).closest('td').find('#hdnHouseColor').val($(sender).closest('tr').find('#txtHouseColor').val());
            return true;
        }
    }
</script>
}
<!-- /.content -->