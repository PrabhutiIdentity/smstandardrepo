@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    var smsController = ViewContext.RouteData.Values["controller"].ToString();
    Layout = smsController.Equals("Account", StringComparison.OrdinalIgnoreCase)
        ? "~/Views/Shared/_AccountLayout.cshtml"
        : "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <title>SMS History</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <script>
        function UpdateSendingStatus(SMSSendingID, CompletedCount, TotalCount) {
            $('#tr_' + SMSSendingID).find('.progress-bar').css('width', (CompletedCount * 100 / TotalCount)+'%');
            $('#tr_' + SMSSendingID).find('.tdPer').html((CompletedCount * 100 / TotalCount).toFixed(0) + '%');
        }
    </script>
    @if (smsController.Equals("Account", StringComparison.OrdinalIgnoreCase))
    {
        <style>
            /* Account layout defines div.box as a 100px scrolling table widget.
               SMS History needs a full-height page container. */
            .sms-history-page div.box {
                height: auto;
                min-height: 0;
                padding: 10px;
                overflow: visible;
                border: 0;
                background-color: #fff;
            }

            .sms-history-page .fixed-th-table-wrapper {
                overflow-x: auto;
                overflow-y: visible;
            }
        </style>
    }
}
<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }
</style>

<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        SMS History
        <small>SMS panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Dashboard", smsController)"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">SMS History</li>
    </ol>
</section>

<!-- Main content -->
<section class="content sms-history-page">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">

                </div>
                <div class="box-body fixed-th-table-wrapper">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 15%">Title</th>
                                <th style="width: 30%">SMS Text</th>
                                <th style="width: 10%">Date</th>
                                <th style="width: 10%">List</th>
                                <th style="width: 25%">Status</th>
                                <th style="width: 10%">Detail</th>
                            </tr>
                        </thead>
                        @{

                            <tbody>
                                @foreach (SMSSendTaskModel c in Model)
                                {
                                    <tr id="tr_@c.SMSSendingID">


                                        <td>
                                            @c.Title
                                        </td>

                                        <td>
                                            @c.TemplateText

                                        </td>
                                        <td>@c.SMSSendDate.ToString("dd MMM,yyyy HH:mm")</td>
                                        <td>@c.RecieverList</td>
                                        <td>
                                            <table class="table">
                                                @if (c.Pending == 0)
                                                {
                                                    <tr>
                                                        <td style="width:25%">
                                                            <label class='badge bg-green aSuc' title="Success">@c.Success</label>
                                                        </td>
                                                        <td style="width:25%">

                                                            <label class='badge bg-orange aPen' title="Pending">@c.Pending</label>
                                                        </td>
                                                        <td style="width:25%">
                                                            <label class='badge bg-red aFail' title="Failed">@c.Failed</label>
                                                        </td>
                                                        <td style="width:25%">
                                                            <label class='badge bg-blue aFail' title="Total">@c.Total</label>
                                                        </td>
                                                    </tr>
                                                }
                                                <tr>
                                                    <td colspan="3" style="width:75%">
                                                        <label> Progress:</label>
                                                        <div class="progress progress_sm" style="height: 5px !important;margin-bottom: 5px;">
                                                            <div class="progress-bar bg-red" role="progressbar" style="width:@((c.Total-c.Pending)*100/c.Total)%;"></div>
                                                        </div>
                                                    </td>
                                                    <td class="tdPer" style="width:25%">
                                                        @(((c.Total - c.Pending) * 100 / c.Total).ToString("##"))%
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                        <td>
                                            <a class="btn btn-success" href="@Url.Action("SendSMS", smsController, new { id = c.SMSSendingID })">Details</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>

</section>
@section scripts
{
    <script src="@Url.Content("~/Parent/vendors/datatables.net/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Parent/vendors/datatables.net-bs/js/dataTables.bootstrap.min.js")"></script>
    <script>

        $(function () {
            $("#tblCategory").DataTable({
                "bSort": false
            });
        });
    </script>
}
<!-- /.content -->
