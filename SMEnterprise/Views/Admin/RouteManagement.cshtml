        $(sender).closest("tr").css('background-color', 'rgba(123, 100, 165, 0.48)');
        var ele = document.getElementsByClassName("RouteVehicleTimingOpen");
        if (ele.length > 0) {
            $(ele[0]).click();
            $(ele[0]).closest("tr").css('background-color', 'white');
        }

        $(sender).text('Close');
        $(sender).removeClass("RouteVehicleTimingClose");
        $(sender).addClass("RouteVehicleTimingOpen");
    },
    error: function (e) {
        alert("errorn");
    }
});
        }
        else {
            $(sender).text('ViewRoute');
            $(sender).removeClass("RouteVehicleTimingOpen");
            $(sender).closest("tr").css('background-color', 'white');
            $(sender).addClass("RouteVehicleTimingClose");
            $(sender).closest("tr").next().remove();

        }
    }
    function DeleteRouteVehicle(sender, OpType) {
        if ($(sender).closest('tr').find('#hdnPassengerCount').val() != "0") {
            ShowClosingNotification('Error', 'This Vehicle have Passengers, so it can\'t be Deleted!!!!', 'error');
        }
        else {
            if (confirm("Do you really want to delete this Vehicle!!!!")) {
                SaveRouteVehicle(sender, -1);
            }
        }
    }
    function SaveRouteVehicle(sender, OpType) {

        $.ajax({
            url: "@Url.Action("UpdateRouteVehicle", "Admin")",
            type: 'POST',
            data: JSON.stringify({
                OpType: OpType,
                VehicleRouteID: $(sender).closest('tr').find('#hdnVehicleRouteID').val(),
                VehicleID: $(sender).closest('tr').find('#ddlVehicles').val(),
                RouteID: $(sender).closest('tr').find('#hdnRouteID').val(),
                DelayFromRouteTime: $(sender).closest('tr').find('#txtDelayFromRouteTime').val()
            }),
            contentType: 'application/json; charset=utf-8',
            success: function (html) {
                ShowClosingNotification('Success', 'Changes updated successfully', 'info');
                $(sender).closest('table').closest('td').html(html);
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
            },
            async: true,
            processData: false
        });
    }
</script>
<script>
    function LocationChanged(sender, type) {

        $.ajax(
{
    type: "POST",
    url: "/Admin/GetLocationLists/" + $(sender).val() + "/" + type,
    cache: false,
    processData: false,
    contentType: false,
    success: function (html) {
        if (type == 0) {
            $(sender).closest('tr').find('#ddlRouteStoppageState').html(html);
            $(sender).closest('tr').find('#ddlRouteStoppageCity').html('<Option value="0">--Select--</option>');
            $(sender).closest('tr').find('#ddlRouteStoppageArea').html('<Option value="0">--Select--</option>');
        }
        else if (type == 1) {
            $(sender).closest('tr').find('#ddlRouteStoppageCity').html(html);
            $(sender).closest('tr').find('#ddlRouteStoppageArea').html('<Option value="0">--Select--</option>');
        }
        else {
            $(sender).closest('tr').find('#ddlRouteStoppageArea').html(html);
        }
    },
    error: function (e) {
        alert("errorn");
    }
});

    }
</script>
<style>
    .table thead tr th {
        text-align: center !important;
        vertical-align: middle !important;
        background-color: rgba(57, 221, 183, 0.72);
        color: white;
    }

    #tblCategory table thead tr th a {
        color: #b26c33;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Route Management

    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Route Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                @if (((StartupModel)Session["StartupModel"]).TransportFeeMode == -1)
                                {
                                    <th style="width: 25%">Route Name</th>
                                    <th style="width: 15%">Route Fee</th>
                                }
                                else
                                {
                                    <th style="width: 40%">Route Name</th>
                                }
                                <th style="width: 15%">#Stoppages</th>
                                <th style="width: 15%">#Vehicles</th>
                                <th style="width: 15%">Status</th>
                                <th style="width: 15%"><a class="sbtn" href="javascript:void(0);" onclick="OpenAddNewCopy(this)">Add New</a></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                foreach (RouteModel c in Model)
                                {
                                    <tr>

                                        <td>
                                            <input type="hidden" name="ID" value="@c.RouteID" />
                                            <span class="ViewCopy visible">@c.RouteName</span>
                                            <input class="form-control editCopy hidden" type="text" onchange='$(this).closest("tr").find("#hdnRouteName").val($(this).val())' name="RouteName" value="@c.RouteName" />
                                        </td>
                                        @if (((StartupModel)Session["StartupModel"]).TransportFeeMode == -1)
                                        {
                                            <td>
                                                <span class="ViewCopy visible">@c.TwoWayFees</span>
                                                <input class="form-control editCopy hidden" type="number" onchange='$(this).closest("tr").find("#hdnTwoWayFees").val($(this).val())' name="TwoWayFees" value="@c.TwoWayFees" />
                                            </td>
                                        }
                                        <td style="text-align:center">
                                            @c.Stoppages
                                            (<a href="javascript:void(0);" onclick="ToggleDetails(this);" id="@c.RouteID" class="StopsClosed">Manage</a>)
                                            <input type="hidden" id="hdnStoppages" value="@c.Stoppages" />
                                        </td>

                                        <td style="text-align:center">
                                            <b>@c.VehicleCount</b>  (<a href="javascript:void(0);" onclick="ViewVehicles(this);" id="@c.RouteID" class="RouteVehicleClose">Manage</a>)
                                        </td>
                                        <td>
                                            <span class="ViewCopy visible"><label class='badge bg-@(c.IsApproved == 0 ? "red" : "green")'>@(c.IsApproved == 0 ? "Inactive" : "Active")</label></span>

                                            <label class="switch switch-green editCopy hidden" style="padding-top: 3px;">
                                                @if (c.IsApproved == 1)
                                                {
                                                    <input id="chkType" type="checkbox" class="switch-input" checked>
                                                }
                                                else
                                                {
                                                    <input id="chkType" type="checkbox" class="switch-input">
                                                }
                                                <span class="switch-label" onclick='$(this).closest("tr").find("#hdnIsApproved").val($(this).closest("tr").find("#hdnIsApproved").val() == "0" ? "1" : "0");' data-on="Active" data-off="Inactive"></span>
                                                <span class="switch-handle" id="shTranding"></span>
                                            </label>
                                        </td>
                                        <td>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <a href="javascript:void(0);" class="sbtn" onclick="EditCopy(this);">Edit</a>
                                                </div>
                                                <div class="col-md-6">
                                                    @using (Html.BeginForm("UpdateRoute", "Admin", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                    {
                                                        <input type="hidden" id="hdnIsApproved" name="IsApproved" value="@c.IsApproved" />
                                                        <input type="hidden" id="hdnRouteName" name="RouteName" value="@c.RouteName" />
                                                        <input type="hidden" id="hdnRouteID" name="RouteID" value="@c.RouteID" />
                                                        <input type="hidden" id="hdnOneWayFees" name="OneWayFees" value="@c.OneWayFees" />
                                                        <input type="hidden" id="hdnTwoWayFees" name="TwoWayFees" value="@c.TwoWayFees" />
                                                        <input type="submit" class="btn btn-link sbtn editCopy hidden" value="Save" />
                                                    }
                                                    @using (Html.BeginForm("UpdateRoute", "Admin", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                    {
                                                        <input type="hidden" id="hdnRouteID" name="RouteID" value="@c.RouteID" />
                                                        <input type="hidden" name="OpType" id="hdnOpType" value="-1" />

                                                        <input type="submit" class="btn btn-link sbtn ViewCopy visible" value="Delete" onclick="return DeleteRoute(this);" />
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot style="border-width: 2px;border-style: groove;">
                            <tr>
                                <td>
                                    <input type="hidden" name="ID" value="0" />
                                    <input class="form-control" type="text" onchange='$(this).closest("tr").find("#hdnRouteName").val($(this).val())' name="RouteName" value="" />
                                </td>
                                @if (((StartupModel)Session["StartupModel"]).TransportFeeMode == -1)
                                {
                                    <td>
                                        <input class="form-control" type="number" onchange='$(this).closest("tr").find("#hdnTwoWayFees").val($(this).val())' name="TwoWayFees" value="0" />
                                    </td>
                                }
                                <td>0

                                <td>
                                    0
                                </td>
                                <td>
                                    <label class="switch switch-green" style="padding-top: 3px;">

                                        <input id="chkType" type="checkbox" class="switch-input" checked>

                                        <span class="switch-label" onclick='$(this).closest("tr").find("#hdnIsApproved").val($(this).closest("tr").find("#hdnIsApproved").val() == "0" ? "1" : "0");' data-on="Active" data-off="Inactive"></span>
                                        <span class="switch-handle" id="shTranding"></span>
                                    </label>
                                </td>
                                <td>
                                    <div class="row">
                                        <div class="col-md-6">
                                            @using (Html.BeginForm("UpdateRoute", "Admin", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" id="hdnIsApproved" name="IsApproved" value="1" />
                                                <input type="hidden" id="hdnRouteName" name="RouteName" value="" />
                                                <input type="hidden" id="hdnRouteID" name="RouteID" value="0" />
                                                <input type="hidden" id="hdnOneWayFees" name="OneWayFees" value="0" />
                                                <input type="hidden" id="hdnTwoWayFees" name="TwoWayFees" value="0" />
                                                <input type="submit" class="btn btn-link" value="Add New" />
                                            }

                                        </div>

                                    </div>
                                </td>
                            </tr>







                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

</section>
<script>
    $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });

        $('#liRouteManagement').closest('ul').closest('li').addClass('active');
        $('#liRouteManagement').addClass('active');
    });

</script>

<!-- /.content -->