@using SMEnterprise.Models;
@using System.Web.Mvc;
@using SMEnterprise.Repository
@{
    ViewBag.Title = "Education Level/Period Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <title>Route Management</title>
}
<script>
    function DeleteRoute(sender, type) {
        if ($(sender).closest('tr').find('#hdnStoppages').val() != "0") {
            ShowClosingNotification('Error', 'This Route has Stoppages, So it can\'t be Deleted!!!!', 'error');
            return false;
        }
        else {
            return confirm("Do you Really Want to Delete this Section????");

        }
    }
    function DeleteStop(sender) {
        if (confirm('Do you Really want to delete this stop!!!!')) {
            $.ajax({
                url: "@Url.Action("UpdateStop", "Admin")",
                type: 'POST',
            data: JSON.stringify({
                OpType: -1,
                StopID: $(sender).closest('tr').find('#hdnStopID').val()
            }),
            contentType: 'application/json; charset=utf-8',
            success: function (html) {
                ShowClosingNotification('Success', 'Changes updated successfully', 'info');
                $(sender).closest('table').closest('td').html(html);
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
            },
            async: true,
            processData: false
        });
        }
    }
    function SaveStop(sender, OpType) {

        $.ajax({
            url: "@Url.Action("UpdateStop", "Admin")",
            type: 'POST',
            data: JSON.stringify({
                OpType: OpType,
                StopID: $(sender).closest('.box-body').find('#hdnStopID').val(),
                RouteID: $(sender).closest('.box-body').find('#hdnRouteID').val(),
                CountryID: $(sender).closest('.box-body').find('#ddlRouteStoppageCountry').val(),
                StateID: $(sender).closest('.box-body').find('#ddlRouteStoppageState').val(),
                CityID: $(sender).closest('.box-body').find('#ddlRouteStoppageCity').val(),
                AreaID: $(sender).closest('.box-body').find('#ddlRouteStoppageArea').val(),
                Time: $(sender).closest('.box-body').find('#txtRouteStoppageTime').val(),
                HaltDuration: $(sender).closest('.box-body').find('#txtRouteStoppageHalt').val(),
                SequenceNo: $(sender).closest('.box-body').find('#txtRouteStoppageSequence').val(),
                TimeR: $(sender).closest('.box-body').find('#txtRouteStoppageTimeR').val(),
                HaltDurationR: $(sender).closest('.box-body').find('#txtRouteStoppageHaltR').val(),
                SequenceNoR: $(sender).closest('.box-body').find('#txtRouteStoppageSequenceR').val(),
                Rate: $(sender).closest('.box-body').find('#txtRate').val()
            }),
            contentType: 'application/json; charset=utf-8',
            success: function (html) {
                ShowClosingNotification('Success', 'Changes updated successfully', 'info');
                $(sender).closest('table').closest('td').html(html);
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
            },
            async: true,
            processData: false
        });
    }
    function EditStop(sender) {


        if ($(sender).hasClass("EditSectionClose")) {
            var notice = ShowNotification('Loading', 'Please wait while we load the required details....', 'info');
            $.ajax(
{
    type: "POST",
    url: "/Admin/EditTransportRouteStop/" + $(sender).attr('id') + "/" + $(sender).closest('tr').find('#hdnRouteID').val(),
    cache: false,
    processData: false,
    contentType: false,
    success: function (html) {
        notice.remove();
        // fill the div with the html returned by action
        html = html.replace('id="hdnRouteID"', 'id="hdnRouteID" value="' + $(sender).closest("tr").find('#hdnRouteID').val() + '"');
        if ($(sender).text().trim() == "Add New Stop") {
            $(sender)
                .closest("thead")
                .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + html + "</td></tr>");

        }
        else {
            $(sender)
                .closest("tr")
                .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + html + "</td></tr>");

        }
        var ele = document.getElementsByClassName("EditSectionOpen");
        if (ele.length > 0) {
            $(ele[0]).click();
            if ($(ele[0]).text() == 'Cancel') {
                $(ele[0]).text('Add New Stop');
            }
            else {
                $(ele[0]).text('Edit');
            }
        }
        if ($(sender).text() == 'Add New Stop') {
            $(sender).text('Cancel');
        }
        else {

            $(sender).text('Close');
        }
        $(sender).removeClass("EditSectionClose");
        $(sender).addClass("EditSectionOpen");
    },
    error: function (e) {
        alert("errorn");
    }
});
        }
        else {
            $(sender).removeClass("EditSectionOpen");
            $(sender).addClass("EditSectionClose");
            if ($(sender).text() == 'Cancel') {
                $(sender).text('Add New Stop');
                $(sender).closest("thead").next().remove();
            }
            else {
                $(sender).text('Edit');
                $(sender).closest("tr").next().remove();
            }


        }

    }
</script>
<script>
    function ToggleDetails(sender) {


        if ($(sender).hasClass("StopsClosed")) {
            var notice = ShowNotification('Loading', 'Please wait while we load the required details....', 'info');
            $.ajax(
{
    type: "POST",
    url: "/Admin/GetTransportRouteStops/" + $(sender).attr('id'),
    cache: false,
    processData: false,
    contentType: false,
    success: function (html) {
        notice.remove();
        // fill the div with the html returned by action
        $(sender)
            .closest("tr")
            .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + html + "</td></tr>");
        $(sender).closest("tr").css('background-color', 'rgba(123, 100, 165, 0.48)');
        var ele = document.getElementsByClassName("StopsOpen");
        if (ele.length > 0) {
            $(ele[0]).click();
            $(ele[0]).closest("tr").css('background-color', 'white');
        }

        $(sender).text("Close");
        $(sender).removeClass("StopsClosed");
        $(sender).addClass("StopsOpen");
    },
    error: function (e) {
        alert("errorn");
    }
});
        }
        else {
            $(sender).text("Manage");
            $(sender).removeClass("StopsOpen");
            $(sender).closest("tr").css('background-color', 'white');
            $(sender).addClass("StopsClosed");
            $(sender).closest("tr").next().remove();

        }

    }
    function DeleteEducationLevel(sender) {
        return confirm("Do you Really Want to Delete this Section????");

    }
</script>
