@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model EditTransportFeeModel
@section IncludeCss
{
    <title> Transport Fee Management</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
}
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Transport Fee Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active"> Transport Fee Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    @using (Html.BeginForm("TransportFeeManagement", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetExams" }))
                    {
                        <div class="row std-mng-head">

                            <div class="col-md-12 class-section">
                                <div class="row">

                                    <div class="col-md-4 padding">
                                        <label class="col-md-4 text-right">Session :</label>
                                        <div class="col-md-8">
                                            <select class="form-control" ID="ddlMainSessions" name="SessionID">
                                                @foreach (SchoolSessionModel e in Model.Sessions)
                                                {
                                                    <option value="@e.SessionID" @(e.SessionID == Model.SessionID ? "Selected" : "")>@e.SessionName @(e.SessionStatus == 1 ? "(Active)" : "")</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 padding">
                                        <label class="col-md-4 text-right">Route :</label>
                                        <div class="col-md-8">
                                            <select class="form-control" ID="ddlMainRouteID" name="RouteID">
                                                @foreach (RoteStopModel e in Model.Routes)
                                                {
                                                    <option value="@e.RouteID" @(e.RouteID == Model.RouteID ? "Selected" : "")>@e.RouteName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 padding">
                                        <div class="row">
                                            <label class="col-md-3 text-right padding-R"></label>
                                            <div class="col-md-7 padding-L" style="padding-left: 10px;">

                                                @*<select class="form-control" name="GroupID" ID="ddlGroups">
                                                        @foreach (GroupModel e in Model.Groups)
                                                        {
                                                            <option value="@e.GroupID" @(e.GroupID == Model.GroupID ? "Selected" : "")>@e.GroupName</option>
                                                        }
                                                    </select>*@
                                            </div>
                                            <div class="col-md-2">
                                                <a onclick="$('#frmGetExams').submit();" ID="lbGetList"><i class="fa fa-search"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-1">
                                        <a href="javascript:void(0);" title="Print Time Table" onclick="printTimeTable();"><i class="fa fa-print"></i></a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    }
                </div>
                <div class="box-body">

                    @using (Html.BeginForm("UpdateTransportRouteFee", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetExams" }))
                    {
                        <input type="hidden" value="@Model.RouteID" name="RouteID" />
                        <input type="hidden" value="@Model.StopID" name="StopID" />
                        <input type="hidden" value="@Model.SBranchID" name="SBranchID" />
                        <input type="hidden" value="@Model.SessionID" name="SessionID" />
                        <table id="tblTransport" class="table table-bordered table-hover">
                            
                            <thead>
                                <tr>
                                    <th style="width: 10%">#</th>
                                    <th style="width: 20%">Route Name</th>
                                    <th style="width: 20%">City Name</th>
                                    <th style="width: 20%">Stop Name</th>
                                    <th style="width: 30%">Amount</th>
                                </tr>
                            </thead>
                            <tbody id="tbdFeeCategories">
                                @{
                                    var Counter = 0;
                                    foreach (TransportFeeModel e in Model.TransportFee)
                                    {

                                        <tr>
                                            <td>
                                                <input type="hidden" value="@e.ID" name="TransportFee[@Counter].ID" />
                                                <input type="hidden" value="@e.StopID" name="TransportFee[@Counter].StopID" />

                                                <input type="hidden" value="@e.RouteID" name="TransportFee[@Counter].RouteID" />
                                                <input type="hidden" value="@e.CityID" name="TransportFee[@Counter].CityID" />
                                                <input type="hidden" value="@e.AreaID" name="TransportFee[@Counter].AreaID" />
                                                <input type="hidden" value="@e.SBranchID" name="TransportFee[@Counter].SBranchID" />
                                                <input type="hidden" value="@e.SessionID" name="TransportFee[@Counter].SessionID" />

                                                <input type="hidden" value="@Model.OperationDate" name="TransportFee[@Counter].CreatedDate" />
                                                <input type="hidden" value="@Model.OperationDate" name="TransportFee[@Counter].ModifiedDate" />
                                                @*<input type="hidden" value="@e.FeeTypeApplicable" id="hdnFeeTypeApplicable" />
                            <input type="hidden" value="@e.Months" id="hdnMonths" />*@
                                                @(Counter + 1)
                                            </td>
                                            @*<td>  @(Counter + 1)</td>*@
                                            <td>
                                                @e.RouteName
                                            </td>
                                            <td>
                                                @e.CityName <br />
                                            </td>
                                            <td>
                                                @e.AreaName <br />
                                            </td>
                                            @*   <td>
                        <label class="switch switch-green">
                           @if (e.Status == 1)
                                {
                                    <input type="checkbox" class="switch-input" Checked>
                                }
                                else
                                {
                                    <input type="checkbox" class="switch-input">
                                }
                                <span class="switch-label" onclick='$(this).closest("tr").find("#hdnFeeStatus").val($(this).closest("tr").find("#hdnFeeStatus").val() == "0" ? "1" : "0");' data-on="Yes" data-off="No"></span>
                                <span class="switch-handle" id="shTranding"></span>
                                <input type="hidden" name="FeeStructure[@Counter].Status" id="hdnFeeStatus" value="@e.Status" />
                                                                            </label>
                                                                            </td>*@
                                            <td>
                                                <input type="number" class="form-control" name="TransportFee[@Counter].Amount" value="@e.Amount" />

                                            </td>

                                        </tr>
                                        Counter++;
                                    }
                                }

                            </tbody>
                        </table>
                        <div>
                            <button type="submit" class="btn btn-block btn-info pull-right">Save</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</section>

<script>
    $(function () {


        $('#liTransportFeeManagement').closest('ul').closest('li').addClass('active');
        $('#liTransportFeeManagement').addClass('active');
    });
      function printTimeTable()
    {
          var className = $('#ddlMainSessions option:selected').text();
          var sectionName = $('#ddlMainRouteID option:selected').text();
          var contents = $("#tblTransport").html();
        var frame1 = $('<iframe />');
        frame1[0].name = "frame1";
        frame1.css({ "position": "absolute", "top": "-1000000px" });
        $("body").append(frame1);
        var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
        frameDoc.document.open();
        //Create a new HTML document.
        frameDoc.document.write('<html><head><title>Time Table For ' + className + '/' + sectionName + '</title>');
        frameDoc.document.write('</head><body>');
        //Append the external CSS file.
        frameDoc.document.write('<link href="@Url.Content("~/css/studentStyle.css")" rel="stylesheet" type="text/css" />');
        frameDoc.document.write('<link href="@Url.Content("~/css/TimeTableStyle.css")" rel="stylesheet" type="text/css" />');
        //Append the DIV contents.
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            frame1.remove();
        }, 500);
    }
</script>
<!-- /.content -->