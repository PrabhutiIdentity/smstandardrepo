@section scripts
{

    <script src="@Url.Content("~/js/moment.min.js")"></script>
    <script src="@Url.Content("~/js/fullcalendar.min.js")"></script>
    <script src="@Url.Content("~/js/select2.full.min.js")"></script>


    <script>
        function StartDateChanged(sender)
        {
            //$('#txtEventEnd').val($(sender).val());
        }
        var EventModel;
        var Holidays;
        var arrHolidays = [];
        var CalYear = 2015;
        var CalHMonth = 0;
        var CalHYear = 0;
        var IsFirstTimeLoad = true;
        $(function () {
            $('#liEventManagement').closest('ul').closest('li').addClass('active');
            $('#liEventManagement').addClass('active');
            EventModel = @Html.Raw(Json.Encode(Model.Events));
            Holidays = @Html.Raw(Json.Encode(Model.Holidays));
            LoadCalendar();
        });
        function RenderDays(date, cell) {
            var arr = [];
            for (var hi = 0; hi < Holidays.length; hi++) {
                var startDate = new Date(Holidays[hi].StartDate.match(/\d+/)[0] * 1);
                var endDate = new Date(Holidays[hi].EndDate.match(/\d+/)[0] * 1);
                var curDate = Date.parse(date.format());
                var dDate = new Date(date);
                var hStartDate = Date.parse(new Date(startDate).toLocaleDateString());
                var hEndDate = Date.parse(new Date(endDate).toLocaleDateString()) + 86400000;
                //alert(startDate + " : " + curDate + " : " + hStartDate);
                if (curDate >= hStartDate && curDate < hEndDate) {
                    arr.push({
                        hTitle: Holidays[hi].Title,
                        hstart: moment(Holidays[hi].StartDate).format("MMM Do YY"),//startDate.getFullYear().padLeft() + '-' + (startDate.getMonth() + 1).padLeft() + '-' + startDate.getDate().padLeft(),
                        hend: moment(Holidays[hi].EndDate).format("MMM Do YY"),// endDate.getFullYear().padLeft() + '-' + (endDate.getMonth() + 1).padLeft() + '-' + endDate.getDate().padLeft(),
                        hType: Holidays[hi].HolidayTypeName,
                        hClasses: Holidays[hi].Classes == 0 ? 'All Classes' : Holidays[hi].Classes
                    });
                    //if ($.inArray(date, holidays) >= 0) {


                    //}
                }
                else if(dDate.getDay()==0)
                {
                    cell.attr('style', 'background-color:rgba(247, 5, 27, 0.28) !important');
                    var cl = cell.attr('class').replace(" holiday", "").replace("fc-day", "fc-day-number");
                    var theads = document.getElementsByClassName(cl);
                    for (var e = 0; e < theads.length; e++) {

                        if (theads[e].getAttribute('data-date') == cell.attr('data-date')) {

                            theads[e].setAttribute('style', 'color:white !important;');
                        }
                    }
                }
            }
            if (arr.length > 0) {
                arrHolidays.push({ h: arr });

                // if you aren't using ui theme, just remove this line
                $(cell).removeClass('ui-widget-content');
                $(cell).addClass('holiday');

                cell.attr('onmouseover', 'javascript:DayMouseOver(' + (arrHolidays.length) + ');');
                cell.attr('onmouseout', 'javascript:DayMouseOut();');
                cell.attr('style', 'background-color:rgba(247, 5, 27, 0.28) !important');
                var cl = cell.attr('class').replace(" holiday", "").replace("fc-day", "fc-day-number");
                var theads = document.getElementsByClassName(cl);
                for (var e = 0; e < theads.length; e++) {

                    if (theads[e].getAttribute('data-date') == cell.attr('data-date')) {
                        theads[e].setAttribute('onmouseover', 'javascript:DayMouseOver(' + (arrHolidays.length) + ');');
                        theads[e].setAttribute('onmouseout', 'javascript:DayMouseOut();');
                        theads[e].setAttribute('style', 'color:white !important;');
                    }
                }
            }
            return 0;
        }
        function DayMouseOver(ind) {
            var arrH = arrHolidays[ind - 1].h;
            var ttD = '<div class="tool_box" style="position:absolute;z-index:10001; background-color:#fff!important;border: 1px solid rgba(243, 22, 42, 1);">';
            for (var hi = 0; hi < arrH.length; hi++) {

                ttD = ttD + ' <h4 style="background-color:rgba(243, 22, 42, 0.7);!important;border: 1px solid rgba(243, 22, 42, 1);' + '">' + arrH[hi].hTitle + '</h4><div class="row date-time-row" style="margin-right: 0px; margin-left: 0px;background-color:rgba(243, 22, 42, 0.4);!important;"><h5>' + arrH[hi].hstart + '</h5><h5>' + arrH[hi].hend + '</h5></div>' +
                    '<div class="row date-time-row" style="margin-right: 0px; margin-left: 0px;background-color:rgba(243, 22, 42, 0.4);!important;">' + arrH[hi].hClasses + '</div>' +
                    '<div class="row date-time-row" style="margin-right: 0px; margin-left: 0px;background-color:rgba(243, 22, 42, 0.4);!important;">' + arrH[hi].hType + '</div>';
            }
            ttD = ttD + '</div>'
            tooltipDay = ttD;
            $("body").append(tooltipDay);
            $(this).mouseover(function (e) {
                $(this).css('z-index', 10000);
                $('.tool_box').fadeIn('500');
                $('.tool_box').fadeTo('10', 1.9);
            }).mousemove(function (e) {
                $('.tool_box').css('top', e.pageY + 10);
                $('.tool_box').css('left', e.pageX - 260);
            });
        }
        function DayMouseOut() {
            $('.tool_box').remove();
        }


        function showAlert(event) {
            // bootbox.alert("Title of Event is: " + event.title + " and ID is : " + event.ClassesIncluded);
            ShowNotification('Event', "Title of Event is: " + event.title + " and ID is : " + event.ClassesIncluded, 'info');
        }

        var Notifyer;

        function LoadCalendar() {

            Notifyer=ShowNotification('Wait...', "Please wait the calender is being refreshed", 'info');
            $('#calendar').fullCalendar({
                header: {
                    left: 'prev,next',
                    center: 'title',
                    right: 'month,agendaWeek,agendaDay'
                },
                fixedWeekCount: false,
                height: 550,
                themeButtonIcons: false,
                theme: true,
                defaultDate: new Date(),
                selectable: true,
                selectHelper: true,
                eventClick: function (event) {
                    AddEditEvent(event);
                    return false;
                }, // this allows things to be dropped onto the calendar
                eventDrop: function (event, delta, revertFunc) {

                    //alert(event.title + " was dropped on " + event.start.format() + " : " + event.end.format());

                    if (!confirm("Are you sure about this change?")) {
                        revertFunc();
                    }
                    else {
                        UpdateEventFinal(event);
                    }
                    return false;
                },

                dayRender: function (date, cell) {
                    var res = RenderDays(date, cell);


                },
                viewRender: function (view, element) {
                    var currentdate = new Date(view.intervalStart);
                    CalYear = currentdate.getFullYear();
                    CalMonth = currentdate.getMonth() + 1;

                    //alert(currentdate);
                    //$('#datepicker').datepicker().datepicker('setDate', new Date(currentdate));
                },
                eventDragStart: function (event, jsEvent, ui, view) {
                    try {
                        //      alert(event.title + " was dragged from " + event.start.format());
                    }
                    catch (ex)
                    { }
                },
                //eventResizeStart: function (event, jsEvent, ui, view) {
                //    try {
                //        UpdateEventFinal(event);
                //    }
                //    catch (ex)
                //    { }
                //},
                eventResize: function (event, delta, revertFunc, jsEvent, ui, view) {

                    UpdateEventFinal(event);
                    // alert(event.title + " was Resized to " + event.end.format());
                },
                eventMouseover: function (calEvent, jsEvent) {
                    //var tooltip = '<div class="tooltipevent" style="width:200px;height:200px;background:#ccc;position:absolute;z-index:10001;">' + calEvent.title + '<br/>' + calEvent.end + '<br/>' + calEvent.description + '</div>';
                    var ind = calEvent.backgroundColor.lastIndexOf(",");
                    var col = calEvent.backgroundColor.substr(0, ind);
                    // var d = new Date(calEvent.start);
                    dStartformat = moment(calEvent.start).format("MMM Do YY HH:mm");//[(d.getMonth() + 1).padLeft(), d.getDate().padLeft(), d.getFullYear()].join('/') + ' ' + [d.getHours().padLeft(), d.getMinutes().padLeft(), d.getSeconds().padLeft()].join(':');
                    //var d = new Date(calEvent.end);
                    dEndformat = moment(calEvent.end).format("MMM Do YY HH:mm");//[(d.getMonth() + 1).padLeft(), d.getDate().padLeft(), d.getFullYear()].join('/') + ' ' + [d.getHours().padLeft(), d.getMinutes().padLeft(), d.getSeconds().padLeft()].join(':');

                    var tooltip = '<div class="tool_box" style="position:absolute;z-index:10001; background-color:#fff' + '!important;border: 1px solid ' + col + ',1)' + ';"><h4 style="background-color:' + col + ',0.7)' + '!important;border: 1px solid ' + col + ',1)' + '">' + calEvent.title + '</h4><div class="row date-time-row" style="background-color:' + col + ',0.4)!important;"><h5>' + dStartformat + '</h5><h5>' + dEndformat + '</h5></div>' +
                        '<div class="content" style="background-color:' + col + ',0.4)!important;min-height:20px;">'
                         + '<p>' + calEvent.description + '</p></div></div>';
                    $("body").append(tooltip);
                    $(this).mouseover(function (e) {
                        $(this).css('z-index', 10000);
                        $('.tool_box').fadeIn('500');
                        $('.tool_box').fadeTo('10', 1.9);
                    }).mousemove(function (e) {
                        $('.tool_box').css('top', e.pageY + 10);
                        $('.tool_box').css('left', e.pageX - 340);
                    });
                },

                eventMouseout: function (calEvent, jsEvent) {
                    $(this).css('z-index', 8);
                    $('.tool_box').remove();
                },
                select: function (start, end) {
                    var eventData;
                    eventData = {
                        start: start,
                        end: end,
                        title: '',
                        description: '',
                        eventTypeID: 1,
                        ClassesIncludedIDs: '0',
                        ClassNames: '',
                        backgroundColor: '',
                        textColor: '',
                        id: 0,
                        IsApproved:1
                    };
                    AddEditEvent(eventData);
                },
                editable: true,
                eventLimit: false, // allow "more" link when too many events
                events: function (start, end, timezone, callback) {
                    $.ajax(
                        {
                            type: "POST",
                            url: "/Admin/GetEventCalender/" + CalMonth+"/"+CalYear,
                            cache: false,
                            processData: false,
                            contentType: false,
                            success: function (data) {

                                Holidays=data.Holidays;
                                var events = [];
                                for (var i = 0; i < data.Events.length; i++) {

                                    events.push({
                                        title: data.Events[i].title,
                                        description: data.Events[i].Description,
                                        end: data.Events[i].EndDate+'+05:30',
                                        start: data.Events[i].StartDate+'+05:30',
                                        eventTypeID: data.Events[i].EventTypeID,
                                        ClassesIncludedIDs: data.Events[i].ClassesIncludedIDs,
                                        ClassNames: data.Events[i].ClassNames,
                                        backgroundColor: data.Events[i].backgroundColor,
                                        textColor: data.Events[i].textColor,
                                        id: data.Events[i].EventID,
                                        IsApproved: data.Events[i].IsApproved
                                    });
                                }
                                callback(events);
                            },
                            error: function (e) {
                                alert("errorn");
                            }
                        });
                }
            });
            Notifyer.remove();
        }

        Number.prototype.padLeft = function (base, chr) {
            var len = (String(base || 10).length - String(this).length) + 1;
            return len > 0 ? new Array(len).join(chr || '0') + this : this;
        }
        function AddEditEvent(eventData) {

            ClearEditEventForm();
            document.getElementById('txtEventTitle').value = eventData.title;
            document.getElementById('hdnEventID').value = eventData.id;
            document.getElementById('ddlEventTypes').value = eventData.eventTypeID;
            document.getElementById('chkApproved').checked = eventData.IsApproved == 1 ? true : false;


            var d = new Date(eventData.start);
            var startTime =[(d.getHours()).padLeft(),d.getMinutes().padLeft()].join(':');
            if(eventData.id==0)
            {
                startTime =[(9).padLeft(),(0).padLeft()].join(':');
            }
            else
            {                
                d = new Date(new Date(eventData.start) - 6*60*60*1000+30*60*1000 );
            }
            dformat = [d.getFullYear(),(d.getMonth()+1).padLeft(),d.getDate().padLeft()].join('-') + 'T' +startTime;

            document.getElementById('txtEventStart').value = dformat;
            var endTime='';
            d = new Date(eventData.end);
            if(eventData.id!=0)
            {               
                endTime =[(d.getHours()).padLeft(),d.getMinutes().padLeft()].join(':');
            }
            else
            { 
                d = new Date(new Date(eventData.end) - 6*60*60*1000-30*60*1000);
                endTime =[(18).padLeft(),(0).padLeft()].join(':');
            }
            dformat = [d.getFullYear(),(d.getMonth()+1).padLeft(),d.getDate().padLeft()].join('-') + 'T' +endTime;

            document.getElementById('txtEventEnd').value = dformat;

            document.getElementById('txtEventTitle').value = eventData.title;
            document.getElementById('txtEventDesc').value = eventData.description;
            if(eventData.ClassesIncludedIDs==null)
            {
                eventData.ClassesIncludedIDs='';
            }
            var selectedGroups = eventData.ClassesIncludedIDs.split(","); //i saved those preselected items in a hiddenfield
            $("#lstClasses").select2();
            $('#lstClasses').val(selectedGroups).change();
            $('#modelEditEvent').modal('show');


        }
        function ClearEditEventForm() {
            document.getElementById('txtEventTitle').value = '';
            document.getElementById('hdnEventID').value = 0;
            document.getElementById('ddlEventTypes').value = 1;
            document.getElementById('chkApproved').checked = true;
            document.getElementById('txtEventStart').value = '';
            document.getElementById('txtEventEnd').value = '';
            document.getElementById('txtEventDesc').value = '';
            var sel = document.getElementById("lstClasses");

            for (var i = 0; i < sel.options.length; i++) {

                sel.options[i].selected = false;
            }

        }
        function UpdateEvent() {
            var eventData = new Object();
            eventData.title = document.getElementById('txtEventTitle').value;
            eventData.id = document.getElementById('hdnEventID').value;
            eventData.eventTypeID = document.getElementById('ddlEventTypes').value;
            eventData.IsApproved = document.getElementById('chkApproved').checked ? 1 : 0;

            var d = new Date(document.getElementById('txtEventStart').value);
            dformat = [d.getFullYear(),(d.getMonth()+1).padLeft(),d.getDate().padLeft()].join('-') + 'T' +[d.getHours().padLeft(),d.getMinutes().padLeft(), d.getSeconds().padLeft()].join(':');


            eventData.start = dformat;

            d = new Date(document.getElementById('txtEventEnd').value);
            dformat = [d.getFullYear(),(d.getMonth()+1).padLeft(),d.getDate().padLeft()].join('-') + 'T' +[d.getHours().padLeft(),d.getMinutes().padLeft(), d.getSeconds().padLeft()].join(':');

            eventData.end = dformat;
            eventData.title = document.getElementById('txtEventTitle').value;
            eventData.description = document.getElementById('txtEventDesc').value;
            
            eventData.ClassesIncluded =""+$("#lstClasses").val()+"";
            UpdateEventFinal(eventData);
            ClearEditEventForm();

        }

        function DeleteEvent() {
            if (confirm("Are you sure You want to delete this event?")) {
                var eventData = new Object();
                eventData.OpType = -1;
                eventData.id = document.getElementById('hdnEventID').value;

                UpdateEventFinal(eventData);
            }
        }
        function UpdateEventFinal(eventData) {
            Notifyer=ShowNotification('Wait...', "Please wait the calender is being refreshed", 'info');
            if(eventData.ClassesIncluded==null || eventData.ClassesIncluded=='null')
            {
                eventData.ClassesIncluded='';
            }
            $.ajax({
                url: "@Url.Action("UpdateEvent", "Admin")",
                type: 'POST',
                data: JSON.stringify(eventData),
                contentType: 'application/json; charset=utf-8',
                success: function (html) {
                    $('#calendar').fullCalendar('refetchEvents'); // stick? = true
                    $('#modelEditEvent').modal('hide');
                    Notifyer.remove();
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);

                    Notifyer.remove();
                },
                async: true,
                processData: false
            });

        }

</script>

}
