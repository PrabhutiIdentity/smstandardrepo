
@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <title>Thought Of The Day Management</title>
}
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Thought Of The Day Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Thought Of The Day Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 5%">#</th>
                                <th style="width: 70%">Thought</th>
                                <th style="width: 10%">Seen</th>
                                <th style="width: 15%">Edit/Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int count = 0;
                                foreach (NameIDModel c in Model)
                                {
                                    <tr>

                                        <td>
                                            @(count + 1)
                                        </td>
                                        <td>
                                            <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnThought").val($(this).val())' id="txtGroupName" name="Name" value="@c.Name" />
                                        </td>
                                        <td>@c.Extra1</td>
                                        <td style="text-align: center;">
                                            <div class="btn-group">
                                                @using (Html.BeginForm("UpdateThought", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                {
                                                    <input type="hidden" name="ID" id="hdnThoughtID" value="@c.ID" />
                                                    <input type="hidden" id="hdnThought" name="Name" value="@c.Name" />
                                                    <input type="submit" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Save" />
                                                }
                                                @using (Html.BeginForm("UpdateThought", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                {
                                                    <input type="hidden" name="Extra1" value="-1" />
                                                    <input type="hidden" name="ID" value="@c.ID" />
                                                    <button onclick="return ThoughtDelete(this);" style="background-color: red;color: white;" class="btn btn-default" value="Edit">Delete</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>

                                    count++;
                                }
                                <tr>

                                    <td>
                                        @(count + 1)
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnThought").val($(this).val())' id="txtGroupName" name="GroupName" value="" />
                                    </td>
                                    <td>0</td>
                                    <td style="text-align: center;">
                                        <div class="btn-group">
                                            @using (Html.BeginForm("UpdateThought", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" name="GroupID" id="hdnGroupID" value="0" />
                                                <input type="hidden" id="hdnThought" name="Name" value="" />
                                                <input type="submit" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Add New" />
                                            }

                                        </div>
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>

</section>
<script>
    $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });
        $('#liThoughtManagement').closest('ul').closest('li').addClass('active');
        $('#liThoughtManagement').addClass('active');
    });
    function ThoughtDelete(sender) {
        if (confirm('Are you sure you wish to delete this Group?')) {

            return true;
        }
        else {
            return false;
        }

    }

</script>
<!-- /.content -->