<div class="modal-dialog" role="document">
    <div class="modal-content">
        <div class="modal-header edit-header">
            <button type="button" class="close edit-close" data-dismiss="modal" aria-label="Close">
                <a href="javascript:void(0);" style="color:white;" onclick="CancelLactureEdit();">X</a>
            </button>
            <h4 class="modal-title" id="myModalLabel" style="text-align: center;">Substitution(s) For (@Model.ClassName - @Model.SectionName)</h4>
        </div>
        <div class="modal-body edit-body">
            <table id="tblCategory" class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th style="width: 5%">#</th>
                        <th style="width: 30%">Subject</th>
                        <th style="width: 25%">Teacher</th>
                        <th style="width: 30%">Date</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var ctr = 1;
                        foreach (var Subs in Model.Substitutions)
                        {
                            <tr>
                                <td>@ctr</td>
                                <td>
                                    @Subs.NewSubject
                                </td>
                                <td>
                                    @Subs.TeacherName
                                </td>
                                <td>
                                    @Subs.FromDate.ToString("dd MMM, yyyy")
                                </td>
                                
                            </tr>
                            ctr++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
