@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model AdminFeeDiscountRequestMaster
@section IncludeCss
{
    <title>Discount Requests</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
<link href="@Url.Content("~/css/toggle-switch.css")" rel="stylesheet" />
}
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Discount Requests
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Discount Requests</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    @using (Html.BeginForm("DiscountRequests", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetRequests" }))
                    {
                        <div class="row std-mng-head">
                            <div class="col-md-12 class-section">
                                <div class="row">
                                   
                                    <div class="col-md-4 padding">

                                    </div>
                                    <div class="col-md-4 padding">
                                        
                                    </div>
                                    <div class="col-md-4 padding">
                                        <label class="col-md-4 text-right">Status :</label>
                                        <div class="col-md-8">
                                            <select name="ID" class="form-control" id="ddlSection" onchange="$('#frmGetRequests').submit();">
                                                <option value="0" @(Model.Status==0?"selected":"")>Pending</option>
                                                <option value="1" @(Model.Status==1?"selected":"")>Approved</option>
                                                <option value="2" @(Model.Status==2?"selected":"")>Rejected</option>
                                            </select>
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="box-body">
                    <table id="PaymentsTable" class="table table-striped">
                        <thead>
                            <tr>
                                <th style="width:17%">Student</th>
                                <th style="width:12%">Class</th>
                                <th style="width:10%">Month</th>
                                <th style="width:15%">Asked Amount</th>
                                <th style="width:15%">Approved Amount</th>
                                <th style="width:10">Req. Date</th>
                                <th style="width:10%">Status</th>
                                <th style="width:10%">View</th>
                            </tr>
                        </thead>
                        @{
                            foreach (FeeDiscountRequestMaster c in Model.Requests)
                            {
                                <tr>
                                    <td>
                                        @c.StudentName<br />
                                        @c.StudentSID
                                    </td>
                                    <td>
                                        @c.ClassSection<br />
                                        @c.RollNo
                                    </td>
                                    <td>
                                        @SMEnterprise.Repository.CommonUsage.MonthNames[c.FeeMonth - 1], @c.FeeYear
                                    </td>
                                    <td>@c.TotalAmount</td>
                                    <td>@(c.ApprovedAmount==-1?"NA":c.ApprovedAmount.ToString("N2"))</td>
                                    <td>@c.RequestDate.ToString("dd MMM,yyyy")</td>
                                    <td>
                                        @if (c.Status == 0)
                                        {
                                            <label class='badge bg-blue'>Pending</label>
                                        }
                                        else if (c.Status == 1)
                                        {
                                            <label class='badge bg-green'>Approved</label>
                                        }
                                        else
                                        {
                                            <label class='badge bg-red'>Rejected</label>
                                        }
                                    </td>
                                    <td><a class="btn btn-primary Closed" href="javascript:void(0);" onclick="ViewDetails(this,@c.DiscRequestID);">View</a></td>
                                </tr>
                            }

                        }
                        
                    </table>
                </div>
            </div>
        </div>
    </div>

</section>
@section scripts
{

<script>
    $(function () {
        if(@Model.Status==0)
        {
            $('#liPendingDiscountRequests').closest('ul').closest('li').addClass('active');
            $('#liPendingDiscountRequests').addClass('active');
        }
        else if(@Model.Status==1)
        {
            $('#liApprovedDiscountRequests').closest('ul').closest('li').addClass('active');
            $('#liApprovedDiscountRequests').addClass('active');
        }
        else
        {
            $('#liRejectedDiscountRequests').closest('ul').closest('li').addClass('active');
            $('#liRejectedDiscountRequests').addClass('active');
        }
        $("#PaymentsTable").DataTable();
    });

    function ViewDetails(sender, RequestID) {
        if ($(sender).hasClass('Closed')) {
            $(sender)
                   .closest("tr")
                   .after("<tr><td id='tdDetails' colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);font-size: 30px;text-align: -webkit-center;'> Loading.... </td></tr>");
            var ele = document.getElementsByClassName("Open");
            if (ele.length > 0) {
                $(ele[0]).click();

                //$(ele[0]).text('Edit');
            }

            $.ajax({
                url: "/Admin/GetFeeDiscountDetails/" + RequestID,
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                success: function (html) {
                    $(sender).closest("tr").next().remove();
                    $(sender)
                   .closest("tr")
                   .after("<tr><td id='tdDetails' colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + html + "</td></tr>");
                    $(sender).text('Close');
                    $(sender).removeClass('Closed');
                    $(sender).addClass('Open');
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
                },
                async: true,
                processData: false
            });
        }
        else {
            $(sender).text('View');
            $(sender).removeClass('Open');
            $(sender).addClass('Closed');
            $(sender).closest("tr").next().remove();
        }
    }
    function ChangeStatus(sender)
    {
        $(sender).closest('.col-md-4').find('#hdnStatus').val($(sender).attr('value'));
    }
</script>
    }
<!-- /.content -->