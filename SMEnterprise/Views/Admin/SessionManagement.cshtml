@using SMEnterprise.Models;
@using System.Web.Mvc;
@using SMEnterprise.Repository
@{
    ViewBag.Title = "Education Level/Period Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        School Academic Year Management

    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">School Academic Year Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th style="width: 5%">#</th>
                                <th style="width: 25%">Name</th>
                                <th style="width: 15%">Start Date</th>
                                <th style="width: 15%">End Date</th>
                                <th style="width: 15%">Status</th>
                                <th style="width: 15%"><a href="javascript:void(0);" onclick="EditSession(this,0)">Add New</a></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var elCounter = 1;
                                foreach (SchoolSessionModel c in Model)
                                {
                                    <tr>
                                        <td>
                                            @elCounter
                                        </td>
                                        <td>
                                            <span class="ViewCopy visible">@c.SessionName</span>
                                             </td>
                                        <td>
                                            <span class="ViewCopy visible">@c.SessionStartDate.ToString("dd MMM,yyyy")</span>
                                        </td>
                                        <td>
                                            <span class="ViewCopy visible">@c.SessionEndDate.ToString("dd MMM,yyyy")</span>
                                        </td>
                                        <td>
                                            <span class="ViewCopy visible"><label class='badge bg-@(c.SessionStatus == 0 ? "red" : "green")'>@(c.SessionStatus == 0 ? "Inactive" : "Active")</label></span>
                                           
                                        </td>
                                        <td>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <a href="javascript:void(0);" class="sbtn" onclick="EditSession(this,@c.SessionID);">Edit</a>
                                                    <input type="hidden" id="hdnSessionName" name="SessionName" required value="@c.SessionName" />
                                                    <input type="hidden" id="hdnSessionStartDate" name="SessionStartDate" value="@c.SessionStartDate.ToString("yyyy-MM-dd")" />
                                                    <input type="hidden" id="hdnSessionEndDate" name="SessionEndDate" value="@c.SessionEndDate.ToString("yyyy-MM-dd")" />
                                                    <input type="hidden" id="hdnSessionStatus" name="SessionStatus" value="@c.SessionStatus" />
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    elCounter++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</section>
@section pageBottom{
    <div id="mdlEditSession" class="modal fade" role="dialog">
        <div class="modal-dialog">

            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Update Session</h4>
                </div>
                <div class="modal-body">
                    <form role="form" action="/admin/UpdateSchoolSession">
                        <div class="box-body">
                            <div class="form-group">
                                <input type="hidden" id="hdnSessionID" name="SessionID" value="0" />
                                <label for="txtSchemeTitle">Session Title</label>
                                <input type="text" required name="SessionName" class="form-control" id="txtSessionName" placeholder="Enter Session Title">
                            </div>
                            <div class="form-group">
                                <label for="txtSchemeTitle">Session Start Date</label>
                                <input type="date" required name="SessionStartDate" class="form-control" id="txtSessionStartDate" placeholder="Enter Session Start Date">
                            </div>
                            <div class="form-group">
                                <label for="txtSchemeTitle">Session End Date</label>
                                <input type="date" required name="SessionEndDate" class="form-control" id="txtSessionEndDate" placeholder="Enter Session End Date">
                            </div>
                            <div class="form-group sessionStatus">
                                <label for="txtSchemeTitle">Session Status</label>
                                <label class="switch switch-green">
                                    <input type="checkbox" class="switch-input" Checked>
                                    <span class="switch-label" onclick='$(this).closest(".sessionStatus").find("#hdnSessionStatus").val($(this).closest(".sessionStatus").find("#hdnSessionStatus").val() == "0" ? "1" : "0");' data-on="Active" data-off="Inactive"></span>
                                    <span class="switch-handle" id="shTranding"></span>
                                    <input type="hidden" id="hdnSessionStatus" name="SessionStatus" value="1" />
                                </label>
                            </div>
                        </div>
                        <!-- /.box-body -->

                        <div class="box-footer">
                            <button type="submit" class="btn btn-primary pull-right" onclick="return SaveSession();">Submit</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
}
<script>
    function SaveSession() {
        var StartDate = $('#mdlEditSession').find('#txtSessionStartDate').val();
        var EndDate = $('#mdlEditSession').find('#txtSessionEndDate').val();
        if (EndDate < StartDate) {
            alert('Session End Date can not be less then Session Start Date')
            return false;
        }
    }
    function EditSession(sender, ID) {
        var SessionName = $(sender).closest('td').find('#hdnSessionName').val();
        var SessionStart = $(sender).closest('td').find('#hdnSessionStartDate').val();
        var SessionEnd = $(sender).closest('td').find('#hdnSessionEndDate').val();
        var SessionStatus = $(sender).closest('td').find('#hdnSessionStatus').val();
        $('#mdlEditSession').find('#hdnSessionID').val(ID);
        $('#mdlEditSession').find('#txtSessionName').val(SessionName);
        $('#mdlEditSession').find('#txtSessionStartDate').val(SessionStart);
        $('#mdlEditSession').find('#txtSessionEndDate').val(SessionEnd);
        $('#mdlEditSession').find('#hdnSessionID').val(ID);
        if (SessionStatus == 1) {
            $('#mdlEditSession').find('.sessionStatus').find('.switch-input').attr('checked', 'checked');
        }
        else {
            $('#mdlEditSession').find('.sessionStatus').find('.switch-input').removeAttr('checked');
        }
        $('#mdlEditSession').find('.sessionStatus').find('#hdnSessionStatus').val(SessionStatus);
        $('#mdlEditSession').modal('toggle');
    }
    $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });

        $('#liSessionSetup').closest('ul').closest('li').addClass('active');
        $('#liSessionSetup').addClass('active');
    });

</script>

<!-- /.content -->