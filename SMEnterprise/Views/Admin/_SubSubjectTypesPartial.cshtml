@model SMEnterprise.Models.SubSubjectTypeEditModel
<table id="tblCategory" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 5%">#</th>
            <th style="width: 20%">Type Name</th>
            <th style="width: 15%"><a class="sbtn" href="javascript:void(0);" onclick="OpenAddNewCopy(this)">Add New</a></th>
        </tr>
    </thead>
    <tbody>
        @{
            var scount = 1;
            foreach (var c in Model.Types)
            {
                <tr>
                    <td>
                        @scount
                    </td>
                    <td>
                        <span class="ViewCopy visible">@c.TypeName</span>
                        <input class="form-control editCopy hidden" id="txtTypeName" type="text" name="TypeName" value="@c.TypeName" />
                        <input type="hidden" id="hdnGroupID" name="GroupID" value="@Model.GroupID" />
                        <input type="hidden" id="hdnTypeID" name="TypeID" value="@c.TypeID" />
                    </td>
                    <td>
                        <div class="row" style="margin-right: 0px;">
                            <div class="col-md-6">
                                <a href="javascript:void(0);" class="sbtn" onclick="EditCopy(this);">Edit</a>
                            </div>
                            <div class="col-md-6">
                                <input type="button" class="btn btn-link sbtn editCopy hidden" value="Save" onclick="SaveGroupSubjectType(this, 1);" />
                                <input type="button" class="btn btn-link sbtn ViewCopy visible" value="Delete" onclick="return SaveGroupSubjectType(this, -1);" />
                            </div>
                        </div>
                    </td>
                </tr>
                scount++;
            }
            
        }
    </tbody>
    <tfoot style="border-width: 2px;border-style: groove;display:none;">
        <tr>
            <td>
                
            </td>
            <td>
                <input class="form-control" id="txtTypeName" type="text" name="TypeName" value="" />
                <input type="hidden" id="hdnGroupID" name="GroupID" value="@Model.GroupID" />
                <input type="hidden" id="hdnTypeID" name="TypeID" value="0" />
            </td>
            <td>
                <div class="row" style="margin-right: 0px;">
                    <div class="col-md-6">
                        <input type="button" class="btn btn-link" value="Add New" onclick="SaveGroupSubjectType(this, 1);" />
                    </div>

                </div>
            </td>
        </tr>

    </tfoot>
</table>

