@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<script src="@Url.Content("~/js/MD5.js")" type="text/javascript"></script>
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Change Password
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Change Password</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <div class="row" style="min-height:20px;">

    </div>
    <div class="row">
        <div class="col-md-3"></div>
        <div class="col-md-6">
            <div class="box box-info">
                <div class="box-header with-border">
                    <h3 class="box-title">Update Password</h3>
                </div>
                <!-- /.box-header -->
                <!-- form start -->
                @using (Html.BeginForm("UpdatePassword", "Common", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "UpdatePassword", @class = "form-horizontal" }))
                {
                    <div class="box-body">
                        <div class="form-group">
                            <label for="inputEmail3" class="col-sm-4 control-label">Password</label>
                            <input type="hidden" name="ID" id="hdnPassword" value="" />
                            <div class="col-sm-8">
                                <input type="password" class="form-control" id="txtPassword" placeholder="password">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="inputPassword3" class="col-sm-4 control-label">Confirm Password</label>

                            <div class="col-sm-8">
                                <input type="password" class="form-control" id="txtConfirmPassword" placeholder="Confirm Password">
                            </div>
                        </div>
                        <label id="lblError" style="color:red;display:none"></label>
                    </div>
                        <!-- /.box-body -->
                        <div class="box-footer">
                            <button type="submit" class="btn btn-info pull-right" onclick="return UpdatePassword();">Change</button>
                        </div>
                        <!-- /.box-footer -->
                }
            </div>
        </div>
        <div class="col-md-3"></div>
    </div>


</section>
<script>
    function UpdatePassword() {
        if ($('#txtPassword').val() == '' || $('#txtConfirmPassword').val() == '')
        {
            $('#lblError').css('display', '');
            $('#lblError').text('Please Enter Password');
            return false;
        }
        else if ($('#txtPassword').val() != $('#txtConfirmPassword').val())
        {
            $('#lblError').css('display', '');
            $('#lblError').text('Password and Confirm Password do not Match');
            return false;
        }
        else
        {
            var id = $("#txtPassword").val();
            var id2 = hex_md5(String(id + 'd2f*jk#g&h'));
            $("#hdnPassword").val(id2);
            $("#txtPassword").val('');
            $("#txtConfirmPassword").val('');
            return true;
        } 
    }
</script>
<!-- /.content -->