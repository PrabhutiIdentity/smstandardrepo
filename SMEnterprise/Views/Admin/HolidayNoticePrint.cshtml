
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Holiday Notice</title>
    <!-- Tell the browser to be responsive to screen width -->
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <!-- Bootstrap 3.3.6 -->
    <link rel="stylesheet" href="../../Admin/bootstrap/css/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.5.0/css/font-awesome.min.css">
    <!-- Ionicons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/ionicons/2.0.1/css/ionicons.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="../../Admin/dist/css/AdminLTE.min.css">
    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
</head>
<body onload="window.print();">
    <div class="wrapper" style="margin-left: 15px;margin-right: 15px;">
        <!-- Main content -->
        <section class="invoice">
            <!-- title row -->
            <div class="row">
                <div class="col-xs-12">
                    <h2 class="page-header">
                        <i class="fa fa-envelope"></i> Holiday Notice
                        <small class="pull-right">Date: @SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd MMM, yyyy")</small>
                    </h2>
                </div>
                <!-- /.col -->
            </div>
            <!-- info row -->
            <div class="row invoice-info">
                <div class="col-sm-4 invoice-col">
                    From
                    <address>
                        <strong>@Model.SchoolDetail.PrincipalName</strong><br>
                        <strong>@Model.SchoolDetail.SchoolName</strong><br>
                        @Html.Raw(Model.SchoolDetail.Address.Replace("\n", "<br>"))<br />
                        Phone: @Model.SchoolDetail.PhoneNo<br>
                        Email: @Model.SchoolDetail.EmailID
                    </address>
                </div>
                <!-- /.col -->
                <div class="col-sm-4 invoice-col">
                    
                    <address>
                        From : <strong>@Model.Holiday.StartDate.ToString("dd MMM, yyyy")</strong><br>
                        To : <strong>@Model.Holiday.EndDate.ToString("dd MMM, yyyy")</strong><br>
                        For :<strong> @Model.Holiday.Days</strong> Days<br>
                        Type : @Model.Holiday.HolidayTypeName<br> Holiday
                        Time : @Model.Holiday.DayDurationName<br>
                        Classes : @Model.Holiday.ClassesIncluded<br>
                    </address>
                </div>
                <!-- /.col -->
            </div>
            <!-- /.row -->
            <!-- Table row -->

            <div class="row">
                <div class="col-xs-12">
                Reg. : <strong>@Model.Holiday.Title</strong>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <p class="text-muted well well-sm no-shadow" style="margin-top: 10px;">
                        @Html.Raw(Model.Holiday.HolidayDescription.Replace("\n", "<br>"))
                    </p>
                </div>
                <!-- /.col -->
            </div>
            <div class="row pull-right">
                <div class="col-xs-12">
                    Authorized Signature
                </div>
            </div>
            <br />
            <br />
            <br />
            <br />
            <!-- /.row -->
            <div class="row">
                @foreach (var emp in Model.Staff)
                {
                    <div class="col-md-6">
                        @emp.EmployeeName
                    </div>
                }
            </div>
        </section>
        <!-- /.content -->
    </div>
    <!-- ./wrapper -->
</body>
</html>

