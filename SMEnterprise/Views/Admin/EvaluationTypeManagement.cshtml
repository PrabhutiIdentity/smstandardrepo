@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    ViewBag.Title = "Blog Categories";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Evaluation Type Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Evaluation Type Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    @using (Html.BeginForm("EvaluationTypeManagement", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetExams" }))
                    {
                        <div class="row std-mng-head">

                            <div class="col-md-12 class-section">
                                <div class="row">
                                    <div class="col-md-4 padding">
                                        <label class="col-md-5 text-right" style="padding-right: 0px;">Session :</label>
                                        <div class="col-md-7">
                                            <select class="form-control" name="ID" ID="ddlSessions" onchange="SessionChanged(this);">
                                                @foreach (SchoolSessionModel e in Model.Sessions)
                                                {
                                                    <option value="@e.SessionID" @(e.SessionID == Model.SessionID ? "Selected" : "")>@e.SessionName @(e.SessionStatus==1?"(Active)":"")</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 padding">
                                        <label class="col-md-5 text-right" style="padding-right: 0px;">Scheme :</label>
                                        <div class="col-md-7">
                                            <select class="form-control" name="ID2" ID="ddlSchemes">
                                                @foreach (EvaluationSchemeModel e in Model.Schemes)
                                                {
                                                    <option value="@e.EvaluationSchemeID" @(e.EvaluationSchemeID == Model.EvaluationSchemeID ? "Selected" : "")>@e.EvaluationSchemeName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 padding">
                                        <div class="row">
                                           
                                            <div class="col-md-2">
                                                <a onclick="$('#frmGetExams').submit();" ID="lbGetList"><i class="fa fa-search"></i></a>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    }
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 10%">Sl. No.</th>
                                <th style="width: 30%">Name</th>
                                <th style="width: 10%">Edit/Delete</th>
                            </tr>
                        </thead>
                        @{
                            int count = 0;
                            foreach (var c in Model.Evaluations)
                            {
                                <tr>

                                    <td>
                                        @(count+1)
                                        <input type="hidden" name="ID" id="hdnEvaluationTypeID" value="@c.EvaluationTypeID" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnEvaluationTypeName").val($(this).val())' id="txtEvaluationTypeName" name="Name" value="@c.EvaluationTypeName" />
                                    </td>

                                   
                                    <td>
                                        <div class="btn-group">
                                            @using (Html.BeginForm("UpdateEvaluationType", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" name="EvaluationTypeID" id="hdnEvaluationTypeID" value="@c.EvaluationTypeID" />
                                                        <input type="hidden" id="hdnEvaluationTypeName" name="EvaluationTypeName" value="@c.EvaluationTypeName" />
                                                        <input type="hidden" name="EvaluationSchemeID" id="hdnEvaluationSchemeID" value="@c.EvaluationSchemeID" />
                                                        <input type="submit" onclick="return BeforeEvaluationTypeUpdate(this);" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Save" />
                                            }
                                             @using (Html.BeginForm("UpdateEvaluationType", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" name="OpType" value="-1" />
                                                <input type="hidden" name="EvaluationTypeID" value="@c.EvaluationTypeID" />
                                                <button onclick="return EvaluationTypeDelete(this);" style="background-color: red;color: white;" class="btn btn-default" value="Edit">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>

                                count++;
                            }
                            <tr>

                                <td>
                                    @(count+1)
                                    <input type="hidden" name="EvaluationTypeID" id="hdnEvaluationTypeID" value="0" />
                                </td>
                                <td>
                                    <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnEvaluationTypeName").val($(this).val())' id="txtEvaluationTypeName" name="Name" value="" />
                                </td>

                               
                                <td>
                                    <div class="btn-group">
                                        @using (Html.BeginForm("UpdateEvaluationType", "Admin", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                        {
                                            <input type="hidden" name="EvaluationTypeID" id="hdnEvaluationTypeID" value="0" />
                                                <input type="hidden" id="hdnEvaluationTypeName" name="EvaluationTypeName" value="" />
                                                <input type="hidden" id="hdnSessionID" name="SessionID" value="@Model.SessionID" />
                                                <input type="hidden" name="EvaluationSchemeID" id="hdnEvaluationSchemeID" value="@Model.EvaluationSchemeID" />
                                                        <input type="hidden" id="hdnEvaluationTypeColor" name="EvaluationTypeColor" value="" />
                                                        <input type="submit" onclick="return BeforeEvaluationTypeUpdate(this);" class="btn btn-default" style="background-color: #605ca8;color: white;"  value="Add New" />
                                        }
                                       
                                    </div>
                                </td>
                            </tr>
                        }
                    </table>
                    
                </div>
            </div>
        </div>
    </div>

</section>
<script>
    function SessionChanged(sender)
    {
        $('#ddlSchemes').html('<option value="-1">Loading....</option>');
            $.ajax(
                {
                    type: "POST",
                    url: "/Admin/GetEvaluationSchemes/" + $(sender).val(),
                    cache: false,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        $('#ddlSchemes').html('');
                        if (data.length > 0) {
                            for (var i = 0; i < data.length; i++) {
                                $('#ddlSchemes').append('<option value="' + data[i].EvaluationSchemeID + '">' + data[i].EvaluationSchemeName + '</option>');
                            }
                        }
                        else {
                            $('#ddlSchemes').append('<option value="-1">No Scheme Added</option>');
                        }
                    },
                    error: function (e) {
                        alert("errorn");
                    }
                });
    }
    $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });
        $('#liEvaluationTypeManagement').closest('ul').closest('li').addClass('active');
        $('#liEvaluationTypeManagement').addClass('active');
    });
    function EvaluationTypeDelete(sender) {
       
            if (confirm('Are you sure you wish to delete this Evaluation Type?')) {

                return true;
            }
            else {
                return false;
            }
    }
    function BeforeEvaluationTypeUpdate(sender)
    {
        if ($(sender).closest('tr').find('#txtEvaluationTypeName').val() == "") {
            alert("Plese Fill Required Details!!!!");
            return false;
        }
        else {
            return true;
        }
    }
</script>
<!-- /.content -->