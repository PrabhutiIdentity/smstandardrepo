@using Pro.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@section IncludeCss
{
    <title>SMS Template Management</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">

}
<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">

            <div class="col-md-12">

                <div class="row std-mng-head">

                    <div class="col-md-12 class-section">
                        <div class="row">

                            <div class="col-md-2 padding">
                            </div>
                            <div class="col-md-3 padding" id="divHead" style="color: white;font-size: 1.15em;">
                                SMS Template Management
                            </div>
                        </div>
                    </div>

                </div>
                <div class="x_panel">
                    @using (Html.BeginForm("UpdateSMSStatus", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "UpdatePassword", @class = "form-horizontal" }))
                    {
                        <button type="submit" class="btn btn-danger">Submit</button>
                    }
                    <div class="x_content">
                        <div class="row">
                            <div class="col-md-12">
                                <button class="btn btn-success pull-right" onclick="AddNewTemplate(this);">Add New</button>
                            </div>
                        </div>

                        <div class="row">
                            <table id="tblCategory" class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 15%">Template ID</th>
                                        <th style="width: 60%">Details</th>
                                        <th style="width: 15%">Template For</th>
                                        <th style="width: 10%">Status</th>
                                    </tr>
                                </thead>
                                @{

                                    <tbody>
                                        @for (int i = 0; i < 10; i++)
                                        {
                                            <tr>


                                                <td>
                                                    @i
                                                </td>

                                                <td id="td_@i"></td>

                                            </tr>
                                        }
                                    </tbody>

                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{

}
<!-- /.content -->
