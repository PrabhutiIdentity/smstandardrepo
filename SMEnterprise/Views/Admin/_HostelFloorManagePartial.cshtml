<table id="tblCategory" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 10%">Sl.No.</th>
            <th style="width: 40%">Floor</th>
            <th style="width: 15%">#Rooms</th>
            <th style="width: 15%">Status</th>
            <th style="width: 20%"><a class="sbtn" href="javascript:void(0);" onclick="OpenAddNewCopy(this)">Add New</a></th>
        </tr>
    </thead>

    @{
        var count = 0;
        <tbody>
            
            @foreach (SMEnterprise.Models.HostalFloorModel c in Model.Floors)
                    {
                        count++;
            <tr>
                <td>@count</td>

                <td>
                    <input type="hidden" id="hdnHostalID" name="HostelID" value="@Model.ID" />
                    <input type="hidden" id="hdnFloorID" name="ID" value="@c.ID" />
                    <span class="ViewCopy visible">@c.Name</span>
                    <input type="text" class="form-control editCopy hidden" name="Name" id="txtFloorName" value="@c.Name" />
                </td>
                <td>
                   @c.RoomCount
                    (<a href="javascript:void(0);" onclick="ViewFloorRooms(this);" id="@c.ID" class="RoomClosed">Manage</a>)
                    <input type="hidden" value="@c.RoomCount" id="hdnRoomCount" />
                </td>
                <td>
                    <span class="ViewCopy visible"><label class='badge bg-@(c.Status == 0 ? "red" : "green")'>@(c.Status == 0 ? "Inactive" : "Active")</label></span>
                    <label class="switch switch-green editCopy hidden" style="padding-top: 3px;">
                        @if (c.Status == 1)
                        {
                            <input id="chkType" type="checkbox" class="switch-input" checked>
                        }
                        else
                        {
                            <input id="chkType" type="checkbox" class="switch-input">
                        }
                        <span class="switch-label" onclick='$(this).closest("tr").find("#hdnIsApproved").val($(this).closest("tr").find("#hdnIsApproved").val() == "0" ? "1" : "0");' data-on="Active" data-off="Inactive"></span>
                        <span class="switch-handle" id="shTranding"></span>
                        <input id="hdnIsApproved" type="hidden" value="@c.Status" />
                    </label>
                </td>
                             
                <td>
                    <div class="row" style="margin-right: 0px;">
                        <div class="col-md-6">
                            <a href="javascript:void(0);" class="sbtn" onclick="EditCopy(this);">Edit</a>
                        </div>
                        <div class="col-md-6">
                            <input type="submit" class="btn btn-link sbtn editCopy hidden" value="Save" onclick="SaveHostelFloor(this, 1);" />
                            <input type="submit" class="btn btn-link sbtn ViewCopy visible" value="Delete" onclick="return DeleteHostelFloor(this, -1);" />
                        </div>
                    </div>
                </td>



            </tr>
            }

        </tbody>
        <tfoot style="border-width: 2px;border-style: groove;display:none;">
            <tr>
                <td>@(count+1)</td>

                <td>
                    <input type="hidden" id="hdnHostalID" name="HostelID" value="@Model.ID" />
                    <input type="hidden" id="hdnFloorID" name="ID" value="0" />
                    <input type="text" class="form-control" name="Name" id="txtFloorName" value="" />
                </td>
                <td>
                    0
                </td>
                <td>
                    <label class="switch switch-green" style="padding-top: 3px;">
                       
                            <input id="chkType" type="checkbox" class="switch-input" checked>
                        
                        <span class="switch-label" onclick='$(this).closest("tr").find("#hdnIsApproved").val($(this).closest("tr").find("#hdnIsApproved").val() == "0" ? "1" : "0");' data-on="Active" data-off="Inactive"></span>
                        <span class="switch-handle" id="shTranding"></span>
                        <input id="hdnIsApproved" type="hidden" value="1" />
                    </label>
                </td>

                <td>
                    <div class="row" style="margin-right: 0px;">
                        <div class="col-md-12">
                            <input type="submit" class="btn btn-link" value="Add New" onclick="SaveHostelFloor(this, 1);" />
                        </div>
                        
                    </div>
                </td>



            </tr>

        </tfoot>
    }
</table>

