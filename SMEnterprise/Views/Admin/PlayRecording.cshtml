
@{
    ViewBag.Title = "Play Recording";
    //Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    Layout = null;
}
<style>
    .frame-area {
        width: 100%; /* RESPONSIVE WIDTH */
        height: 100%;
        overflow: hidden !important; /* EDIT TO hidden FOR NO SCROLLBAR */
        margin: 0px;
        padding: 0px;
    }
</style>
<iframe id="myIframe" name="mainIFrame" class="frame-area" style="width: 100%;min-height: 90vh;" src="@ViewBag.URL" frameborder="0" 
        allow="camera *; microphone *; fullscreen *;" onLoad="UrlChanged(this.contentWindow.location);">
</iframe>
<script>
    function UrlChanged(url) {
        window.history.pushState("", "", url);
    }
</script>