@using SMEnterprise.Models;
@using System.Web.Mvc;
@using SMEnterprise.Repository
@{
    ViewBag.Title = "Education Level/Period Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<script>
    function DeletePeriod(sender, type) {
        if (confirm("Do you Really Want to Delete this Period????")) {
            UpdatePeriod(sender, -1);
        }
    }
    function UpdatePeriod(sender, OpType) {

        $.ajax({
            url: "@Url.Action("UpdatePeriod", "Admin")",
            type: 'POST',
            data: JSON.stringify({
                OpType: OpType,
                EducationLevelID: $(sender).closest('tr').find('#hdnEducationLevelID').val(),
                PeriodType: $(sender).closest('tr').find('#ddlPeriodTypes').val(),
                PeriodID: $(sender).closest('tr').find('#hdnPeriodID').val(),
                Name: $(sender).closest('tr').find('#txtPeriodName').val(),
                StartTime: $(sender).closest('tr').find('#txtStartTime').val(),
                EndTime: $(sender).closest('tr').find('#txtEndTime').val(),
                Status: $(sender).closest('tr').find('#hdnPeriodStatus').val()
            }),
            contentType: 'application/json; charset=utf-8',
            success: function (html) {
                ShowClosingNotification('Success', 'Changes updated successfully', 'info');
                $(sender).closest('table').closest('td').html(html);
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
            },
            async: true,
            processData: false
        });
    }
</script>
<script>
    function ToggleDetails(sender) {


        if ($(sender).hasClass("PeriodsClosed")) {
            var notice = ShowNotification('Loading', 'Please wait while we load the required details....', 'info');
            $.ajax(
{
    type: "POST",
    url: "/Admin/GetPeriodList/" + $(sender).attr('id'),
    cache: false,
    processData: false,
    contentType: false,
    success: function (html) {
        notice.remove();
        // fill the div with the html returned by action
        $(sender)
            .closest("tr")
            .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + html + "</td></tr>");
        $(sender).closest("tr").css('background-color', 'rgba(123, 100, 165, 0.48)');
        var ele = document.getElementsByClassName("PeriodsOpened");
        if (ele.length > 0) {
            $(ele[0]).click();
            $(ele[0]).closest("tr").css('background-color', 'white');
        }

        $(sender).removeClass("PeriodsClosed");
        $(sender).addClass("PeriodsOpened");
        $(sender).text('Close');
    },
    error: function (e) {
        alert("errorn");
    }
});
        }
        else {
            $(sender).removeClass("PeriodsOpened");
            $(sender).closest("tr").css('background-color', 'white');
            $(sender).addClass("PeriodsClosed");
            $(sender).text('Manage');
            $(sender).closest("tr").next().remove();

        }

    }
    function DeleteEducationLevel(sender)
    {
        var pCount = $(sender).closest('tr').find('#hdnPeriodsCount').val();
        var cCount = $(sender).closest('tr').find('#hdnClassesCount').val();
        if (pCount == 0 && cCount==0) {
            return confirm("Do you Really Want to Delete this Education Level????");
        }
        else
        {
            var abc = "";
            if (pCount > 0)
            {
                abc = "Periods";
            }
            if (cCount > 0)
            {
                if(pCount>0)
                {
                    abc = "Periods And Classes";
                }
                else {
                    abc="Classes"
                }
            }
            ShowClosingNotification('Error', 'This Education Level has ' + abc + ' Defined, so can\'t be deleted....', 'error');
            return false;
        }
            
    }
</script>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Education Level/Period Management

    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Education Level/Period Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th style="width: 5%">#</th>
                                <th style="width: 20%">Education Level</th>
                                <th style="width: 10%">#Days</th>
                                <th style="width: 15%;">#Classes</th>
                                <th style="width: 7%">#Periods</th>
                                <th style="width: 12%">Start Time</th>
                                <th style="width: 12%">End Time</th>
                                <th style="width: 15%"><a class="sbtn" href="javascript:void(0);" onclick="OpenAddNewCopy(this)">Add New</a></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                            var elCounter = 1;
                                            foreach (var c in Model)
                                            {
                                    <tr>
                                        <td>
                                            @elCounter
                                        </td>
                                        <td>
                                            <input type="hidden" name="ID" value="@c.ID" />
                                            <span class="ViewCopy visible">@c.Name</span>
                                            <input class="form-control editCopy hidden" type="text" onchange='$(this).closest("tr").find("#hdnEducationLevelName").val($(this).val())' name="Name" value="@c.Name" />
                                        </td>
                                        <td>
                                            <span class="ViewCopy visible">@c.Days</span>
                                            <input class="form-control editCopy hidden" type="number" onchange='$(this).closest("tr").find("#hdnEducationLevelDays").val($(this).val())' name="Days" value="@c.Days" />
                                        </td>
                                        <td>
                                            @c.Classes <input type="hidden" id="hdnClassesCount" value="@c.Classes" />
                                        </td>
                                        <td>
                                            @c.Periods <input type="hidden" id="hdnPeriodsCount" value="@c.Periods" />
                                            (<a href="javascript:void(0);" onclick="ToggleDetails(this);" id="@c.ID" class="PeriodsClosed Poll-Options">Manage</a>)
                                    </td>

                                        <td>
                                            @c.PeriodStartTime
                                        </td>
                                        <td>
                                            @c.PeriodEndTime
                                        </td>
                                        <td>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <a href="javascript:void(0);" class="sbtn" onclick="EditCopy(this);">Edit</a>
                                                   

                                                </div>
                                                <div class="col-md-6">
                                                    @using (Html.BeginForm("UpdateEducationLevel", "Admin", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                    {
                                                        <input type="hidden" id="hdnEducationLevelName" name="Name" value="@c.Name" />
                                                        <input type="hidden" id="hdnEducationLevelID" name="ID" value="@c.ID" />
                                                        <input type="hidden" id="hdnEducationLevelDays" name="Days" value="@c.Days" />
                                                        <input type="hidden" id="hdnShiftTypeID" name="ShiftType" value="@c.ShiftType" />
                                                        <input type="submit" class="btn btn-link sbtn editCopy hidden" value="Save" />
                                                    }
                                                    @using (Html.BeginForm("UpdateEducationLevel", "Admin", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                    {
                                                        <input type="hidden" id="hdnEducationLevelID" name="ID" value="@c.ID" />
                                                        <input type="hidden" name="OpType" id="hdnOpType" value="-1" />

                                                        <input type="submit" class="btn btn-link sbtn ViewCopy visible" value="Delete" onclick="return DeleteEducationLevel(this);" />
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    elCounter++;
                                }
                            }
                        </tbody>
                        <tfoot style="border-width: 2px;border-style: groove;display:none;">
                            <tr>
                                <td></td>
                                <td>
                                    <input class="form-control" type="text" onchange='$(this).closest("tr").find("#hdnEducationLevelName").val($(this).val())' name="Name" value="" />
                                </td>
                                <td>
                                    <input class="form-control" type="number" onchange='$(this).closest("tr").find("#hdnEducationLevelDays").val($(this).val())' name="Days" value="0" />
                                </td>
                                <td style="display:none;">
                                    <select id="ddlShiftType" onchange="$(this).closest('tr').find('#hdnShiftTypeID').val($(this).val());" class="form-control">

                                        <option value="0" >First Shift</option>
                                        <option value="1" >Second Shift</option>
                                    </select>
                                </td>
                                <td>0</td>

                                <td>
                                    --:--:--
                                </td>
                                <td>
                                    --:--:--
                                </td>
                                <td>
                                    <div class="row">
                                        <div class="col-md-6">
                                            @using (Html.BeginForm("UpdateEducationLevel", "Admin", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" id="hdnEducationLevelName" name="Name" value="" />
                                                <input type="hidden" id="hdnEducationLevelID" name="ID" value="0" />
                                                <input type="hidden" id="hdnEducationLevelDays" name="Days" value="0" />
                                                        <input type="hidden" id="hdnShiftTypeID" name="ShiftType" value="0" />
                                                        <input type="submit" class="btn btn-link" value="Add New" />
                                            }

                                        </div>

                                    </div>
                                </td>
                            </tr>



                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

</section>
<script>
    $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });

        $('#liELManagement').closest('ul').closest('li').addClass('active');
        $('#liELManagement').addClass('active');
    });

</script>

<!-- /.content -->