
@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <title>Important Contacts</title>
}
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Important Contacts
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Important Contacts</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 10%">#</th>
                                <th style="width: 35%">Title</th>
                                <th style="width: 35%">Number</th>
                                <th style="width: 20%">Edit/Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int count = 0;
                                foreach (ImportantContactModel c in Model)
                                {
                                    <tr>

                                        <td>
                                            @(count + 1)
                                        </td>
                                        <td>
                                            <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnTitle").val($(this).val())' id="txtName" name="Name" value="@c.Name" />
                                        </td>

                                        <td>
                                            <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnContact").val($(this).val())' id="txtContact" name="Contact" value="@c.Contact" />
                                        </td>
                                        <td style="text-align: center;">
                                            <div class="btn-group">
                                                @using (Html.BeginForm("UpdateImportantContact", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                {
                                                    <input type="hidden" name="ICID" id="hdnThoughtID" value="@c.ICID" />
                                                    <input type="hidden" name="Name" id="hdnTitle" value="@c.Name" />
                                                    <input type="hidden" name="Contact" id="hdnContact" value="@c.Contact" />
                                                    <input type="submit" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Save" />
                                                }
                                                @using (Html.BeginForm("UpdateImportantContact", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                {
                                                    <input type="hidden" name="OpType" value="-1" />
                                                    <input type="hidden" name="ICID" id="hdnThoughtID" value="@c.ICID" />
                                                    <button onclick="return ContactDelete(this);" style="background-color: red;color: white;" class="btn btn-default" value="Edit">Delete</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>

                                    count++;
                                }
                                <tr>

                                    <td>
                                        @(count + 1)
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnTitle").val($(this).val())' id="txtName" name="Name" value="" />
                                    </td>

                                    <td>
                                        <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnContact").val($(this).val())' id="txtContact" name="Contact" value="" />
                                    </td>
                                    <td style="text-align: center;">
                                        <div class="btn-group">
                                            @using (Html.BeginForm("UpdateImportantContact", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" name="ICID" id="hdnThoughtID" value="0" />
                                                    <input type="hidden" name="Name" id="hdnTitle" value="" />
                                                    <input type="hidden" name="Contact" id="hdnContact" value="" />
                                                    <input type="submit" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Save" />
                                            }
                                        </div>
                                    </td>

                                </tr>

                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>

</section>
<script>
    $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });
        $('#liContactManagement').closest('ul').closest('li').addClass('active');
        $('#liContactManagement').addClass('active');
    });
    function ContactDelete(sender) {
        if (confirm('Are you sure you wish to delete this Contact?')) {

            return true;
        }
        else {
            return false;
        }

    }

</script>
<!-- /.content -->