<div class="box-body">
    <table id="tblCategory" class="table table-bordered table-hover">
        <thead>
            <tr>
                <th style="width: 5%">#</th>
                <th style="width: 30%">Title</th>
                <th style="width: 10%">Weightage</th>
                <th style="width: 15%">Month</th>
                <th style="width: 20%">Type</th>
                <th style="width: 15%">Edit/Delete</th>
            </tr>
        </thead>
        <tbody>
            @{
                int count = 0;
                foreach (SMEnterprise.Models.EvaluationModel c in Model.SubEvaluations)
                {
                    <tr>

                        <td>
                            @(count + 1)
                            <input type="hidden" name="EvaluationID" id="hdnEvaluationID" value="@c.EvaluationID" />
                            <input type="hidden" name="MasterID" id="hdnMasterID" value="@Model.EvaluationID" />
                        </td>
                        <td>

                            <input type="text" class="form-control" id="txtEvaluationName" name="EvaluationName" value="@c.EvaluationName" />

                        </td>
                        <td>

                            <input type="number" step="0.01" class="form-control" id="txtWeightage" name="Weightage" value="@c.Weightage" />

                        </td>
                        <td>

                            <select id="ddlMonth" class="form-control">
                                @{
                                    string[] Monthsnn = { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
                                    var counternn = 1;
                                    foreach (string Mon in Monthsnn)
                                    {
                                        <option value="@counternn" @(counternn == c.EvaluationMonth ? "Selected" : "")>@Mon</option>
                                        counternn++;
                                    }
                                }
                            </select>

                        </td>
                        <td>
                            <select id="ddlTypes" class="form-control">

                                @*<option value="0" @(0 == c.EvaluationType ? "selected" : "")> Unit Test</option>*@
                                @foreach (var e in Model.EvaluationTypes)
                                {
                                    <option value="@e.EvaluationTypeID" @(e.EvaluationTypeID == c.EvaluationType ? "selected" : "")>@e.EvaluationTypeName</option>

                                }
                            </select>
                        </td>
                        <td>
                            <div class="btn-group">
                                <a href="javascript:void(0);" onclick="SaveSubEvaluation(this,1);" class="btn btn-default" style="background-color: #1abb9c;color: white;">Save</a>

                                <a href="javascript:void(0);" onclick="SaveSubEvaluation(this, -1);" style="background-color: red;color: white;" class="btn btn-default" value="Edit">Delete</a>

                            </div>
                        </td>
                    </tr>

                                        count++;
                                    }
                                    <tr>

                                        <td>
                                            @(count + 1)
                                            <input type="hidden" name="EvaluationID" id="hdnEvaluationID" value="0" />
                                            <input type="hidden" name="MasterID" id="hdnMasterID" value="@Model.EvaluationID" />
                                        </td>
                                        <td>

                                            <input type="text" class="form-control" id="txtEvaluationName" name="EvaluationName" value="" />

                                        </td>
                                        <td>

                                            <input type="text" class="form-control" id="txtWeightage" name="Weightage" value="0" />

                                        </td>
                                        <td>

                                            <select id="ddlMonth" class="form-control">
                                                @{
                                                    string[] Monthsn = { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
                                                    var countern = 1;
                                                    foreach (string Mon in Monthsn)
                                                    {
                                                        <option value="@countern">@Mon</option>
                                                        countern++;
                                                    }
                                                }
                                            </select>

                                        </td>
                                        <td>
                                            <select id="ddlTypes" class="form-control">
                                                @foreach (var e in Model.EvaluationTypes)
                                                {
                                                    <option value="@e.EvaluationTypeID">@e.EvaluationTypeName</option>

                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="javascript:void(0);" onclick="SaveSubEvaluation(this,1);" class="btn btn-default" style="background-color: #1abb9c;color: white;">Add New</a>


                                            </div>
                                        </td>
                                    </tr>
            }
        </tbody>
    </table>
</div>