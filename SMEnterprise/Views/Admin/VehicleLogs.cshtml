@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model VehicleLogPageModel
@section IncludeCss
{
    <title>Vehicle Logs</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
}
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Vehicle Logs
        <small>Transport</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Vehicle Logs</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    @using (Html.BeginForm("VehicleLogs", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetExams" }))
                    {
                        <div class="row std-mng-head">

                            <div class="col-md-12 class-section">
                                <div class="row">

                                    @*<div class="col-md-5 padding">
                                            <label class="col-md-4 text-right">Payment Mode :</label>
                                            <div class="col-md-8">
                                                <select class="form-control" ID="ddlMainSessions" name="PaymentMode">
                                                    <option value="-1">--All Modes--</option>
                                                    @foreach (PaymentModeModel e in Model.PaymentModes)
                                                    {
                                                        <option value="@e.PaymentModeID" @(e.PaymentModeID == Model.PaymentMode ? "Selected" : "")>@e.PaymentModeName </option>
                                                    }
                                                </select>
                                            </div>
                                        </div>*@
                                    <div class="col-md-4 padding">
                                        <div class="row">
                                            <label class="col-md-3 text-right padding-R">Start Date : </label>
                                            <div class="col-md-7 padding-L" style="padding-left: 10px;">
                                                <input type="date" class="form-control" name="StartDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 padding">
                                        <div class="row">
                                            <label class="col-md-3 text-right padding-R">End Date : </label>
                                            <div class="col-md-7 padding-L" style="padding-left: 10px;">
                                                <input type="date" class="form-control" name="EndDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                                            </div>
                                            <div class="col-md-2">
                                                <a onclick="$('#frmGetExams').submit();" ID="lbGetList"><i class="fa fa-search"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2 padding">
                                        <a href="javascript:void(0);" data-toggle="modal" data-target="#myModal" onclick="EditLog(this,'',
                                               '@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("yyyy-MM-dd")',0,1,0,0);"><i class="fa fa-search">Add New</i></a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    }
                </div>
                <div class="box-body">
                    <table id="PaymentsTable" class="table table-striped payments">
                        <thead>
                            <tr>
                                <th style="width:5%">#</th>
                                <th style="width:10%">Type</th>
                                <th style="width:35%">Title</th>
                                <th style="width:10%">Date</th>
                                <th style="width:20%">Vehicle</th>
                                <th style="width:10%">Amount</th>
                                <th style="width:10%">Option</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int count = 1;
                                foreach (VehicleLogModel c in Model.Logs)
                                {
                                    <tr>
                                        <td>@count</td>
                                        <td>@c.LogTypeName</td>
                                        <td>@c.LogTitle</td>
                                        <td>@c.LogDate.ToString("dd MMM, yyyy")</td>
                                        <td>@c.VehicleNumber<br />@c.RegistrationNumber</td>
                                        <td>@c.Expance.ToString("0.00")</td>
                                        <td>
                                            <a href="javascript:void(0);" data-toggle="modal" data-target="#myModal" onclick="EditLog(this,'@c.LogTitle',
                                               '@c.LogDate.ToString("yyyy-MM-dd")',@c.VehicleID,@c.LogType,@c.VLogID,@c.Expance);">Edit</a>
                                        </td>
                                    </tr>
                                    count++;
                                }
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>

</section>
@section pageBottom{
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            @using (Html.BeginForm("UpdateVehicleLog", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetExams" }))
            {
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Vehicle Log Details</h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <input type="hidden" name="VLogID" id="hdnVLogID" />
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <span>Vehicle</span>
                                        </div>
                                        <select class="form-control" id="ddlVehicleID" name="VehicleID">
                                            @foreach (var g in Model.Vehicles)
                                            {
                                                <option value="@g.VehicleID">@g.VehicleNumber (@g.RegistrationNumber)</option>
                                            }

                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <span>Type</span>
                                        </div>
                                        <select class="form-control" id="ddlLogType" name="LogType">
                                            @foreach (var g in Model.LogTypes)
                                            {
                                                <option value="@g.ID">@g.Name</option>
                                            }

                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <span>Title</span>
                                        </div>
                                        <input type="text" class="form-control" name="LogTitle" id="txtLogTitle" value="">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <span>Log Date</span>
                                        </div>
                                        <input type="date" class="form-control" name="LogDate" id="txtLogDate" value="">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <span>Expance Amount</span>
                                        </div>
                                        <input type="number" step="0.01" class="form-control" name="Expance" id="txtExpance" value="">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-default">Save</button>
                    </div>
                </div>
            }
            </div>
    </div>
}
@section scripts
{
    <script src="@Url.Content("~/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.flash.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.print.min.js")"></script>
    <script src="@Url.Content("~/js/jszip.min.js")"></script>
    <script src="@Url.Content("~/js/pdfmake.min.js")"></script>
    <script src="@Url.Content("~/js/vfs_fonts.js")"></script>
    <script>
        function EditLog(sender, logTitle, LogDate, VehicleID, LogType, VLogID,Expance) {
            $('#hdnVLogID').val(VLogID);
            $('#ddlVehicleID').val(VehicleID);
            $('#ddlLogType').val(LogType);
            $('#txtLogTitle').val(logTitle);
            $('#txtLogDate').val(LogDate);
            $('#txtExpance').val(Expance);

        }
        $(document).ready(function () {
            var handleDataTableButtons = function () {
                if ($("#PaymentsTable").length) {
                    $("#PaymentsTable").DataTable({
                        dom: "Bfrtip",
                        buttons: [
                            {
                                extend: "copy",
                                className: "btn-sm"
                            },
                            {
                                extend: "csv",
                                className: "btn-sm"
                            },
                            {
                                extend: "excel",
                                className: "btn-sm"
                            },
                            {
                                extend: "pdfHtml5",
                                className: "btn-sm"
                            },
                            {
                                extend: "print",
                                className: "btn-sm"
                            },
                        ],
                        responsive: true
                    });
                }
            };

            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                };
            }();

            TableManageButtons.init();
        });
        $(function () {
            $('#liReportDailyCollection').closest('ul').closest('li').addClass('active');
            $('#liReportDailyCollection').addClass('active');

        });
    </script>
}
<!-- /.content -->