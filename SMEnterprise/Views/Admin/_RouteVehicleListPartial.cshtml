<table id="tblCategory" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 30%">Vehicle</th>
            <th style="width: 15%">#Students</th>
            <th style="width: 15%">#Employees</th>
            <th style="width: 20%">Delay From Route Timing</th>
            <th style="width: 20%"><a class="sbtn" href="javascript:void(0);" onclick="OpenAddNewCopy(this)">Add New</a></th>
        </tr>
    </thead>

    @{
        <tbody>
            
            @foreach (SMEnterprise.Models.RouteVehicleModel c in Model.RouteVehicles)
            {
            <tr>
               
                <td>
                    <input type="hidden" id="hdnRouteID" name="RouteID" value="@Model.RouteID" />
                    <input type="hidden" id="hdnVehicleRouteID" name="VehicleRouteID" value="@c.VehicleRouteID" />
                    @foreach (SMEnterprise.Models.VehicleModel v in Model.Vehicles)
                    {
                        if (c.VehicleID == v.VehicleID)
                        {
                            <span class="ViewCopy visible">@v.VehicleNumber</span>
                            break;
                        }
                    }
                    <select id="ddlVehicles" class="form-control editCopy hidden">
                        @foreach (SMEnterprise.Models.VehicleModel v in Model.Vehicles)
                        {
                            <option value="@v.VehicleID" @(c.VehicleID == v.VehicleID ? "Selected" : "")>@v.VehicleNumber</option>
                        }
                    </select>
                </td>
                <td>
                    <input type="hidden" id="hdnPassengerCount" value="@(c.Students+c.Employees)" />
                   @c.Students
                </td>
                <td>
                    @c.Employees
                </td>
                <td>
                    <span class="ViewCopy visible">@c.DelayFromRouteTime</span>
                    <input type="text" class="form-control editCopy hidden" style="width:20%;display:inline;" value="@c.DelayFromRouteTime" id="txtDelayFromRouteTime" /> (min)
                    (<a href="javascript:void(0);" onclick="ViewRouteTimings(this);" id="@c.VehicleRouteID" class="RouteVehicleTimingClose">View Route</a>)
                </td>
                
                <td>
                    <div class="row" style="margin-right: 0px;">
                        <div class="col-md-6">
                            <a href="javascript:void(0);" class="sbtn" onclick="EditCopy(this);">Edit</a>
                        </div>
                        <div class="col-md-6">
                            <input type="submit" class="btn btn-link sbtn editCopy hidden" value="Save" onclick="SaveRouteVehicle(this, 1);" />

                            <input type="hidden" name="OpType" id="hdnOpType" value="-1" />

                            <input type="submit" class="btn btn-link sbtn ViewCopy visible" value="Delete" onclick="return DeleteRouteVehicle(this, -1);" />

                        </div>
                    </div>
                </td>



            </tr>
            }

        </tbody>
        <tfoot style="border-width: 2px;border-style: groove;display:none;">
            <tr>
                <td>
                    <input type="hidden" id="hdnRouteID" name="RouteID" value="@Model.RouteID" />
                    <input type="hidden" id="hdnVehicleRouteID" name="VehicleRouteID" value="0" />
                    <select id="ddlVehicles" onchange="$(this).closest('tr').find('#hdnVehicleID').val($(this).val());" class="form-control">
                        @foreach (SMEnterprise.Models.VehicleModel v in Model.Vehicles)
                        {
                            <option value="@v.VehicleID" >@v.VehicleNumber</option>
                        }
                    </select>
                </td>
                <td>
                    0
                </td>
                <td>
                   0
                </td>
                <td>
                    <input type="text" class="form-control" style="width:20%;display:inline;" value="0" id="txtDelayFromRouteTime" /> (min) 
                </td>

                <td>
                    <div class="row" style="margin-right: 0px;">
                        <div class="col-md-6">
                            <input type="submit" class="btn btn-link" value="Add New" onclick="SaveRouteVehicle(this, 1);" />
                        </div>
                        
                    </div>
                </td>



            </tr>

        </tfoot>
    }
</table>

