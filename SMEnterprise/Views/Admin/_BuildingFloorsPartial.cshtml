<table id="tblCategory" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 5%">#</th>
            <th style="width: 45%">Floor Name</th>
            <th style="width: 15%">#Rooms</th>
            <th style="width: 20%">Status</th>
            <th style="width: 20%"><a class="sbtn" href="javascript:void(0);" onclick="OpenAddNewCopy(this)">Add New</a></th>
        </tr>
    </thead>
    <tbody>
        @{
                        var fCounter = 1;
                        foreach (var c in Model.Floors)
                        {
                <tr>
                    <td>
                        @fCounter
                    </td>
                    <td>
                        <input type="hidden" name="ID" value="@c.ID" />
                        <input type="hidden" name="BuildingID" value="@c.BuildingID" />
                        <span class="ViewCopy visible">@c.Name</span>
                        <input class="form-control editCopy hidden" type="text" onchange='$(this).closest("tr").find("#hdnName").val($(this).val())' name="Name" value="@c.Name" />
                    </td>


                    <td id="tdRoomCount">
                        <input type="hidden" id="hdnRoomCount" value="@c.RoomCount" />
                        @c.RoomCount
                        (<a href="javascript:void(0);" onclick="ToggleFloorDetails(this);" id="@c.ID" class="RoomsClosed Floor-Rooms">Manage</a>)
                        
                </td>
                    <td>
                        <span class="ViewCopy visible"><label class='badge bg-@(c.Status == 0 ? "red" : "green")'>@(c.Status == 0 ? "Inactive" : "Active")</label></span>
                        <label class="switch switch-green editCopy hidden">
                            @if (c.Status == 1)
                    {
                                <input type="checkbox" class="switch-input" Checked>
                            }
                            else
                            {
                                <input type="checkbox" class="switch-input">
                            }
                            <span class="switch-label" onclick='$(this).closest("tr").find("#hdnFloorStatus").val($(this).closest("tr").find("#hdnFloorStatus").val() == "0" ? "1" : "0");' data-on="Active" data-off="Inactive"></span>
                            <span class="switch-handle" id="shTranding"></span>

                        </label>
                    </td>
                    <td>
                        <div class="row" style="margin-right: 0px;">
                            <div class="col-md-6">

                                <a href="javascript:void(0);" class="sbtn" onclick="EditCopy(this);">Edit</a>



                            </div>
                            <div class="col-md-6">

                                <input type="hidden" name="ID" id="hdnID" value="@c.ID" />
                                <input type="hidden" name="BuildingID" id="hdnBuildingID" value="@Model.ID" />
                                <input type="hidden" id="hdnFloorStatus" name="Status" value="@c.Status" />
                                <input type="hidden" id="hdnName" name="Name" value="@c.Name" />

                                <input type="submit" class="btn btn-link sbtn editCopy hidden" value="Save" onclick="UpdateFloor(this,1);" />


                                <input type="hidden" name="OpType" id="hdnOpType" value="-1" />

                                <input type="submit" class="btn btn-link sbtn ViewCopy visible" value="Delete" onclick="return DeleteFloor(this);" />

                            </div>
                        </div>
                    </td>



                </tr>
                fCounter++;
            }
        }
    </tbody>
    <tfoot style="border-width: 2px;border-style: groove;display:none;">
        <tr>
            <td></td>
            <td>
                <input type="hidden" name="ID" value="0" />
                <input class="form-control" type="text" onchange='$(this).closest("tr").find("#hdnName").val($(this).val())' name="Name" value="" />
            </td>

            <td>0</td>
            <td>
                <label class="switch switch-green">

                    <input type="checkbox" class="switch-input" Checked>

                    <span class="switch-label" onclick='$(this).closest("tr").find("#hdnFloorStatus").val($(this).closest("tr").find("#hdnFloorStatus").val() == "0" ? "1" : "0");' data-on="Active" data-off="Inactive"></span>
                    <span class="switch-handle" id="shTranding"></span>

                </label>
            </td>
            <td>
                <div class="row">
                    <div class="col-md-6">
                       
                            <input type="hidden" name="ID" id="hdnID" value="0" />
                            <input type="hidden" name="BuildingID" id="hdnBuildingID" value="@Model.ID" />
                            <input type="hidden" id="hdnFloorStatus" name="Status" value="1" />
                            <input type="hidden" id="hdnName" name="Name" value="" />

                                                <input type="submit" class="btn btn-link" value="Add New"  onclick="UpdateFloor(this,1);"/>
                        

                    </div>

                </div>
            </td>





        </tr>

    </tfoot>
</table>

