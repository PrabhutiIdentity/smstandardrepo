@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <link rel="stylesheet" href="@Url.Content("~/css/Admin/bootstrap-colorpicker.min.css")">
    <title>Salary Category Management</title>

<style>
    .btn {
        padding: 3px 6px;
    }
</style>
}
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Salary Category Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Salary Category Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 10%">Sl. No.</th>
                                <th style="width: 20%">Salary Head Name</th>
                                <th style="width: 20%">Salary Head Color</th>
                                <th style="width: 10%">Type</th>
                                <th style="width: 20%">Edit/Delete</th>
                            </tr>
                        </thead>
                        @{
                            int count = 0;
                            foreach (SalaryCategoryModel c in Model)
                            {
                                <tr>

                                    <td>
                                        @(count + 1)
                                        <input type="hidden" name="ID" id="hdnSalaryTypeID" value="@c.TypeID" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnSalaryTypeName").val($(this).val())' id="txtSalaryTypeName" name="SalaryTypeName" value="@c.TypeName" />
                                    </td>

                                    <td>
                                        <div class="input-group my-colorpicker2">
                                            <input type="text" class="form-control" id="txtSalaryTypeColor" onchange='$(this).closest("tr").find("#hdnSalaryTypeColor").val($(this).val())' value="@c.ChartColor">
                                            <div class="input-group-addon">
                                                <i style="background-color: @c.ChartColor;"></i>
                                            </div>
                                        </div>

                                    </td>
                                    <td>
                                        <select id="ddlSalaryApplicableType" class="form-control" onchange="$(this).closest('tr').find('#hdnSalaryTypeApplicable').val($(this).val())">
                                            <option value="2" @(c.TypeApplicable == 2 ? "selected" : "")>Earning</option>
                                            <option value="4" @(c.TypeApplicable == 4 ? "selected" : "")>Deduction</option>
                                        </select>
                                    </td>

                                    <td>
                                        <div class="btn-group">
                                            @using (Html.BeginForm("UpdateSalaryType", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" name="TypeID" id="hdnSalaryTypeID" value="@c.TypeID" />
                                                <input type="hidden" name="TypeApplicable" id="hdnSalaryTypeApplicable" value="@c.TypeApplicable" />
                                                <input type="hidden" id="hdnSalaryTypeName" name="TypeName" value="@c.TypeName" />
                                                        <input type="hidden" id="hdnSalaryTypeColor" name="ChartColor" value="@c.ChartColor" />
                                                        <input type="submit" onclick="return BeforeSalaryTypeUpdate(this);" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Save" />
                                            }
                                            @using (Html.BeginForm("UpdateSalaryType", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" name="OpType" value="-1" />
                                                <input type="hidden" name="TypeID" value="@c.TypeID" />
                                                <button onclick="return SalaryTypeDelete(this);" style="background-color: red;color: white;" class="btn btn-default" value="Edit">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>

                                count++;
                            }
                            <tr>

                                <td>
                                    @(count + 1)
                                    <input type="hidden" name="ID" id="hdnSalaryTypeID" value="0" />
                                </td>
                                <td>
                                    <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnSalaryTypeName").val($(this).val())' id="txtSalaryTypeName" name="SalaryTypeName" value="" />
                                </td>

                                <td>
                                    <div class="input-group my-colorpicker2">
                                        <input type="text" class="form-control" id="txtSalaryTypeColor" onchange='$(this).closest("tr").find("#hdnSalaryTypeColor").val($(this).val())' value="">
                                        <div class="input-group-addon">
                                            <i></i>
                                        </div>
                                    </div>

                                </td>
                                <td>
                                    <select id="ddlSalaryApplicableType" class="form-control" onchange="$(this).closest('tr').find('#hdnSalaryTypeApplicable').val($(this).val())">
                                       
                                        <option value="2">Earning</option>
                                        <option value="4">Deduction</option>
                                    </select>
                                </td>

                                <td>
                                    <div class="btn-group">
                                        @using (Html.BeginForm("UpdateSalaryType", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                        {
                                            <input type="hidden" name="TypeID" id="hdnSalaryTypeID" value="0" />
                                                <input type="hidden" name="TypeApplicable" id="hdnSalaryTypeApplicable" value="1" />
                                                <input type="hidden" id="hdnSalaryTypeName" name="TypeName" value="" />
                                                <input type="hidden" id="hdnSalaryTypeColor" name="ChartColor" value="" />
                                                        <input type="submit" onclick="return BeforeSalaryTypeUpdate(this);" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Add New" />
                                        }
                                        
                                    </div>
                                </td>
                            </tr>
                        }
                    </table>

                </div>
            </div>
        </div>
    </div>

</section>
@section scripts
{
    <script src="@Url.Content("~/js/Admin/bootstrap-colorpicker.min.js")"></script>
<script>
    $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });
        $('#liSalaryTypeManagement').closest('ul').closest('li').addClass('active');
        $('#liSalaryTypeManagement').addClass('active');
        $(".my-colorpicker2").colorpicker();
    });
    function SalaryTypeDelete(sender) {
        if (confirm('Are you sure you wish to delete this Salary Category?')) {

            return true;
        }
        else {
            return false;
        }
    }
    function BeforeSalaryTypeUpdate(sender) {
        if ($(sender).closest('tr').find('#txtSalaryTypeName').val() == "" || $(sender).closest('tr').find('#txtSalaryTypeColor').val() == "") {
            alert("Plese Fill Required Details!!!!");
            return false;
        }
        else {
            $(sender).closest('td').find('#hdnSalaryTypeColor').val($(sender).closest('tr').find('#txtSalaryTypeColor').val());
            return true;
        }
    }
</script>
    }
<!-- /.content -->