@using System.Web.Mvc;
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <!-- Bootstrap -->
    <link href="@Url.Content("~/css/Admin/bootstrap.min.css")" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="@Url.Content("~/css/font-awesome.min.css")" rel="stylesheet">
    <!-- Custom Theme Style -->
    <link href="@Url.Content("~/css/Admin/blue.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/Admin/bootstrap-colorpicker.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/Admin/AdminLTE.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/Admin/bootstrap-modal.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/Admin/bootstrap.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/Admin/jquery.dataTables.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/Admin/skin-purple.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/Gent/custom.min.css")" rel="stylesheet">
    <script src="@Url.Content("~/js/jquery.min.js")"></script>
    <script src="@Url.Content("~/js/MD5.js")" type="text/javascript"></script>
    <meta name="viewport" content="width=device-width" />
    <title>Add First Branch</title>
    <script>
        function CheckAccountUserName(sender) {

            $(sender).closest('.form-group').find('#hdnIsUserNameOk').val(1);
            $.ajax(
                {
                    type: "POST",
                    url: "/Admin/CheckUserNameExist/" + $(sender).val() + "/" + $('#hdnSBranchID').val(),
                    cache: false,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        $(sender).closest('.form-group').find('#hdnIsUserNameOk').val(data);
                        if (data == 1) {
                            $(sender).addClass('errorClass');
                        }
                        else {
                            $(sender).removeClass('errorClass');
                        }
                    },
                    error: function (e) {
                        alert("errorn");
                    }
                });
        }

        function BeforeBranchSave() {
            return true;
        }
        function PhotoChanged(fileBox) {

            if (fileBox.files && fileBox.files[0]) {
                if (fileBox.files[0].size / 1024 < 500) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $(fileBox).closest('.col-md-4').find('#imgMainPhoto').prop('src', e.target.result);
                    }
                    reader.readAsDataURL(fileBox.files[0]);
                }
                else {

                    ShowNotification('Large Image', 'Kindly Upload Image of Size less the 500KB', 'error');
                }
            }
        }
    </script>
    <style>
        .container1 {
            width: 100%;
            margin: 10px auto;
            position: relative;
            text-align: center;
        }

        .block1 {
            background: white;
            height: 350px;
            width: 250px;
            border-radius: 15px;
            margin-top: 30px;
            display: inline-block;
            margin: 10px;
        }

        .btn {
            padding: 3px 6px;
        }

        .thumbImageGrid {
            max-width: 75px;
            max-height: 75px;
        }


        *html1 .thumbImageGrid {
            width: expression((this.width/this.height)>=1?75:'auto');
            height: expression((this.width/this.height)<1?100:'auto');
        }

        .thumbImageMain {
            max-width: 125px;
            max-height: 125px;
        }


        *html .thumbImageMain {
            width: expression((this.width/this.height)>=1?125:'auto');
            height: expression((this.width/this.height)<1?125:'auto');
        }

        .errorClass {
            border: 1px solid red;
        }
    </style>
</head>
<body class="nav-md skin-red sidebar-mini avgrund-ready" style="background-color:#2a3f54;">

    <div class="row" style="min-height:10px;">
    </div>
    <section class="content">
        <div class="col-md-1">

        </div>
        <div class="col-md-10">

            <div class="container1">
                @using (Html.BeginForm("UpdateBranch", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "UpdateBranch" }))
                {
                    <div class="box box-danger" id="divEditFormDetails" style="height:auto;">
                        <div class="box-header">
                            <h3 class="box-title">Add First Branch <small> (You can Modify Later)</small></h3>

                        </div>
                        <div class="box-body">
                            <input type="hidden" id="hdnSBranchID" name="SBranchID" value="0" />
                            <div class="row">
                                <div class="col-md-4">
                                    <input type="hidden" id="hdnImageName" name="Logo" value="" />
                                    <div style="height: 175px;">
                                        <img class="thumbImageMain" id="imgMainPhoto" src="" alt="Photo" />
                                    </div>
                                    <input type="file" onchange="PhotoChanged(this)" name="BranchLogo" id="fuDCImage" />

                                </div>
                                <div class="col-md-8">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <span>Branch Name</span>
                                            </div>
                                            <input type="text" id="txtBranchName" name="BranchName" placeholder="Branch Name" class="form-control" value="" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <span>Contact</span>
                                            </div>
                                            <input type="text" id="txtContactNo" name="ContactNo" placeholder="Contact Number" class="form-control" value="" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <span>EmailID</span>
                                            </div>
                                            <input type="text" id="txtEmailID" name="EmailID" placeholder="Branch Email ID" class="form-control" value="" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <span>Principal Name</span>
                                            </div>
                                            <input type="text" id="txtPrincipalName" name="PrincipalName" placeholder="Principal Name" class="form-control" value="" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <span>Principal Mobile</span>
                                            </div>
                                            <input type="text" id="txtPrincipalMobile" name="PrincipalMobile" placeholder="Principal Mobile Number" class="form-control" value="" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <span>Principal EmailID</span>
                                            </div>
                                            <input type="text" id="txtPrincipalEmail" name="PrincipalEmail" placeholder="Principal Email ID" class="form-control" value="" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <span>School Name</span>
                                            </div>
                                            <input type="text" id="txtBranchSchoolName" name="BranchSchoolName" placeholder="Branch School Name" class="form-control" value="" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <span>Address</span>
                                            </div>
                                            <textarea rows="5" id="txtAddress" style="resize:none;" name="Address" placeholder="Branch Address" class="form-control"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr />
                            <div class="row">
                                <div class="col-md-12">
                                    <button class="btn btn-info pull-right" onclick="return BeforeBranchSave();">Save</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="col-md-1">

        </div>
    </section>
    <script>
        $(document).ready(function () {
            (function () {
                $.ajax(
                        {
                            type: "POST",
                            url: "/Account/GetSessionState/",
                            cache: false,
                            processData: false,
                            contentType: false,
                            success: function (data) {
                            },
                            error: function (e) {

                            }
                        });
                setTimeout(arguments.callee, 60000);
            })();
        });
    </script>
</body>
</html>
