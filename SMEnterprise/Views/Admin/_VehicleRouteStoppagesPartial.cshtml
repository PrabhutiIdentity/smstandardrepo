<table id="tblCategory" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th rowspan="2" style="width: 5%">Sl.</th>
            <th rowspan="2" style="width: 31%;">Area</th>
            <th colspan="3" style="width: 32%">Pick-up</th>
            <th colspan="3" style="width: 32%">Drop</th>
            
        </tr>
        <tr>
            <th style="width: 13%">Seq. No</th>
            <th style="width: 10%">Time</th>
            <th style="width: 9%">Halt</th>
            <th style="width: 13%">Seq. No</th>
            <th style="width: 10%">Time</th>
            <th style="width: 9%">Halt</th>
            
        </tr>
    </thead>
    <tbody>
        @{
            int rcount = 0;
            foreach (SMEnterprise.Models.RouteStoppageModel c in Model)
            {
                rcount++;
                    <tr>
                        <td>@rcount</td>

                        <td>
                            @c.AreaName
                        </td>
                        <td>
                            @c.SequenceNo
                        </td>
                        <td>@c.Time</td>
                        <td>@c.HaltDuration min</td>
                        <td>
                            @c.SequenceNoR
                        </td>
                        <td>@c.TimeR</td>

                        <td>@c.HaltDurationR min</td>
                    </tr>
            }
        }
    </tbody>

</table>

