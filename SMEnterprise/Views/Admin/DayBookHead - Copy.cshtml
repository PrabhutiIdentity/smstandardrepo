@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    ViewBag.Title = "Day Book Head";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <link rel="stylesheet" href="@Url.Content("~/css/Admin/bootstrap-colorpicker.min.css")">
    <title>Product Category Management</title>
    <script src="@Url.Content("~/js/Admin/jquery.dataTables.min.js")"></script>

    <script>
        $(function () {
            $("#tblCategory").DataTable();
        });
        function EditDayBookHead(sender) {
            $('#hdnDayBookID').val($(sender).closest('tr').find('#hdnID').val());
            $('#txtName').val($(sender).closest('tr').find('#hdnName').val());
            $('#txtCode').val($(sender).closest('tr').find('#hdnCode').val());
            $('#txtDesc').val($(sender).closest('tr').find('#hdnDesc').val());

            $('#mdlEditDayBookHead').modal('toggle');
        }
        function AddDayBookHead(sender) {

            $('#hdnDayBookID').val(0);
            $('#txtName').val('');
            $('#txtCode').val('');
            $('#txtDesc').val('');
            $('#mdlEditDayBookHead').modal('toggle');
        }
        $(function () {
            $("#tblCategory").DataTable({
                "ordering": false
            });
            $('#liDayBookHead').closest('ul').closest('li').addClass('active');
            $('#liDayBookHead').addClass('active');
        });
        function DayBookHeadDelete(sender) {

            var Daybook = $(sender).closest('tr').find('#hdnHeadCount').val();


            if (Daybook > 0) {
                ShowClosingNotification('Error', 'This Day Book Head has Item, so can\'t be deleted!!!!', 'error');
                return false
            }
            else {
                return confirm("Do you Really Want to  Book Head this Day Book????");
            }
        }

    </script>
}
@model List<SMEnterprise.Models.DayBookHeadModel>
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Day Book Head U

    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i>Dashboard</a></li>
        <li class="active">Day Book Head</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 10%">Sl. No.</th>
                                <th style="width: 30%">Name</th>
                                <th style="width: 15%">Code</th>
                                <th style="width: 30%">Description</th>
                                <th style="width: 15%">Edit/Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int count = 0;
                                foreach (var c in Model)
                                {
                                    <tr>

                                        <td>
                                            <input type="hidden" id="hdnID" value="@c.ID" />
                                            <input type="hidden" id="hdnName" value="@c.Name" />
                                            <input type="hidden" id="hdnCode" value="@c.Code" />
                                            <input type="hidden" id="hdndesc" value="@c.Description" />
                                            <input type="hidden" id="hdnHeadCount" name="HeadCount" value="@c.HeadCount" />
                                            @(count + 1)
                                        </td>
                                        <td>
                                            @c.Name
                                        </td>
                                        <td>@c.Code</td>

                                        <td>
                                            <div class="btn-group">
                                                <a class="btn btn-link" onclick="EditDayBookHead(this)">Edit</a>
                                                @using (Html.BeginForm("UpdateDayBookHead", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                {
                                                    <input type="hidden" name="OpType" value="-1" />
                                                    <input type="hidden" name="ID" value="@c.ID" />
                                                    <button onclick="return DayBookHeadDelete(this);" style="background-color: red;color: white;" class="btn btn-default" value="Edit">Delete</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>

                                    count++;
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5">
                                    <a href="javascript:void(0);" class="btn btn-link pull-right" onclick="AddDayBookHead(this)">Add New Head</a>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                </div>
            </div>
        </div>
    </div>

</section>

@section pageBottom{
    <div id="mdlEditDayBookHead" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Day Book Head</h4>
                </div>
                <div class="modal-body">
                    <form role="form" action="/admin/UpdateDayBookHead">
                        <div class="box-body row">
                            <div class="form-group col-md-8">
                                <input type="hidden" name="ID" id="hdnDayBookID" />
                                <label for="txtName">Head Title</label>
                                <input type="text" required name="Name" class="form-control" id="txtName" placeholder="Enter Day Book Head Name">
                            </div>

                            <div class="form-group col-md-4">
                                <label for="txtCode"> Code</label>
                                <input type="text" required name="Code" class="form-control" id="txtCode" placeholder="Enter Code">
                            </div>
                            <div class="form-group col-md-8">
                                <label for="txtDesc"> Description</label>
                                <textarea type="text" required name="Desc" rows="3" class="form-control" id="txtDesc" placeholder="Enter Description" />
                            </div>


                        </div>
                        <div class="box-footer">
                            <button type="submit" class="btn btn-primary pull-right">Submit</button>
                        </div>
                        @*<div class="box-footer">
                                <button type="submit" class="btn btn-primary pull-right" onclick="return SaveDayBookHead();">Submit</button>
                            </div>*@
                    </form>
                </div>
            </div>

        </div>
    </div>
}
@section scripts
{

}
<!-- /.content -->