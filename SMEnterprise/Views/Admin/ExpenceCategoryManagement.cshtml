@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <link rel="stylesheet" href="@Url.Content("~/css/Admin/bootstrap-colorpicker.min.css")">
    <title>Expence Category Management</title>
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
    }
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Expence Category Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Expence Category Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 10%">Sl. No.</th>
                                <th style="width: 20%">ExpenceType Name</th>
                                <th style="width: 20%">ExpenceType Color</th>
                                <th style="width: 10%">Occurance</th>
                                <th style="width: 20%">Edit/Delete</th>
                            </tr>
                        </thead>
                        @{
                            int count = 0;
                            foreach (ExpenceCategoryModel c in Model)
                            {
                                <tr>

                                    <td>
                                        @(count + 1)
                                        <input type="hidden" name="ID" id="hdnExpenceTypeID" value="@c.ExpenceTypeID" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnExpenceTypeName").val($(this).val())' id="txtExpenceTypeName" name="ExpenceTypeName" value="@c.ExpenceTypeName" />
                                    </td>

                                    <td>
                                        <div class="input-group my-colorpicker2">
                                            <input type="text" class="form-control" id="txtExpenceTypeColor" onchange='$(this).closest("tr").find("#hdnExpenceTypeColor").val($(this).val())' value="@c.ChartColor">
                                            <div class="input-group-addon">
                                                <i style="background-color: @c.ChartColor;"></i>
                                            </div>
                                        </div>

                                    </td>
                                    <td>
                                        <select id="ddlExpenceApplicableType" class="form-control" onchange="$(this).closest('tr').find('#hdnExpenceTypeApplicable').val($(this).val())">
                                            <option value="1" @(c.ExpenceTypeApplicable == 1 ? "selected" : "")>One Time</option>
                                            <option value="2" @(c.ExpenceTypeApplicable == 2 ? "selected" : "")>Monthly</option>
                                            <option value="3" @(c.ExpenceTypeApplicable == 3 ? "selected" : "")>Other</option>
                                        </select>
                                    </td>

                                    <td>
                                        <div class="btn-group">
                                            @using (Html.BeginForm("UpdateExpenceType", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" name="ExpenceTypeID" id="hdnExpenceTypeID" value="@c.ExpenceTypeID" />
                                                <input type="hidden" name="ExpenceTypeApplicable" id="hdnExpenceTypeApplicable" value="@c.ExpenceTypeApplicable" />
                                                <input type="hidden" id="hdnExpenceTypeName" name="ExpenceTypeName" value="@c.ExpenceTypeName" />
                                                        <input type="hidden" id="hdnExpenceTypeColor" name="ChartColor" value="@c.ChartColor" />
                                                        <input type="submit" onclick="return BeforeExpenceTypeUpdate(this);" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Save" />
                                            }
                                            @using (Html.BeginForm("UpdateExpenceType", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" name="OpType" value="-1" />
                                                <input type="hidden" name="ExpenceTypeID" value="@c.ExpenceTypeID" />
                                                <button onclick="return ExpenceTypeDelete(this);" style="background-color: red;color: white;" class="btn btn-default" value="Edit">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>

                                count++;
                            }
                            <tr>

                                <td>
                                    @(count + 1)
                                    <input type="hidden" name="ID" id="hdnExpenceTypeID" value="0" />
                                </td>
                                <td>
                                    <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnExpenceTypeName").val($(this).val())' id="txtExpenceTypeName" name="ExpenceTypeName" value="" />
                                </td>

                                <td>
                                    <div class="input-group my-colorpicker2">
                                        <input type="text" class="form-control" id="txtExpenceTypeColor" onchange='$(this).closest("tr").find("#hdnExpenceTypeColor").val($(this).val())' value="#7f30e3">
                                        <div class="input-group-addon">
                                            <i style="background-color:#7f30e3;"></i>
                                        </div>
                                    </div>

                                </td>
                                <td>
                                    <select id="ddlExpenceApplicableType" class="form-control" onchange="$(this).closest('tr').find('#hdnExpenceTypeApplicable').val($(this).val())">
                                        <option value="1" selected>One Time</option>
                                        <option value="2">Monthly</option>
                                        <option value="3">Other</option>
                                    </select>
                                </td>

                                <td>
                                    <div class="btn-group">
                                        @using (Html.BeginForm("UpdateExpenceType", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                        {
                                            <input type="hidden" name="ExpenceTypeID" id="hdnExpenceTypeID" value="0" />
                                            <input type="hidden" name="ExpenceTypeApplicable" id="hdnExpenceTypeApplicable" value="1" />
                                                <input type="hidden" id="hdnExpenceTypeName" name="ExpenceTypeName" value="" />
                                                <input type="hidden" id="hdnExpenceTypeColor" name="ChartColor" value="#7f30e3" />
                                                        <input type="submit" onclick="return BeforeExpenceTypeUpdate(this);" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Add New" />
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </table>

                </div>
            </div>
        </div>
    </div>

</section>
@section scripts
{
    <script src="@Url.Content("~/js/Admin/bootstrap-colorpicker.min.js")"></script>
<script>
    $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });
        $('#liExpenceTypeManagement').closest('ul').closest('li').addClass('active');
        $('#liExpenceTypeManagement').addClass('active');
        $(".my-colorpicker2").colorpicker();
    });
    function ExpenceTypeDelete(sender) {
        if (confirm('Are you sure you wish to delete this Expence Category?')) {

            return true;
        }
        else {
            return false;
        }
    }
    function BeforeExpenceTypeUpdate(sender) {
        if ($(sender).closest('tr').find('#txtExpenceTypeName').val() == "" || $(sender).closest('tr').find('#txtExpenceTypeColor').val() == "") {
            alert("Plese Fill Required Details!!!!");
            return false;
        }
        else {
            $(sender).closest('td').find('#hdnExpenceTypeColor').val($(sender).closest('tr').find('#txtExpenceTypeColor').val());
            return true;
        }
    }
</script>
    }
<!-- /.content -->