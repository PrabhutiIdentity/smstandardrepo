@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model MonthlyAttendancePageModel
@section IncludeCss
{
    <title>Monthly Attendance</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
<link href="@Url.Content("~/css/toggle-switch.css")" rel="stylesheet" />
}
<style>
    .btn {
        padding: 3px 6px;
    }
    .unknown {
        background-color: orange;
        font-size: 10px;
    }
    .leave {
        background-color: cornflowerblue;
        color: white;
        font-size: 10px;
    }
    .absent {
        background-color: #fb5252;
        color: white;
        font-size: 10px;
    }
    .holiday {
        background-color: lightyellow;
        font-size: 10px;
    }
    .present {
        background-color: green;
        color: white;
        font-size: 10px;
    }
    .inentry {
        background-color: red;
        color: white;
        font-size:10px;
    }
    #datatable > td{
        text-align:center;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Monthly Attendance
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Monthly Attendance</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    @using (Html.BeginForm("MonthlyAttendanceStatus", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetRequests" }))
                    {
                        <div class="row std-mng-head">
                            <div class="col-md-12 class-section">
                                <div class="row">
                                   
                                    <div class="col-md-4 padding">
                                        <input type="text" name="RepoDate" class="form-control datepickerMonth" style="margin-top: 5px;" value="@Model.RepoDate.ToString("MMMM, yyyy")" />
                                    </div>
                                    <div class="col-md-5 padding">
                                        <label class="col-md-5 text-right">Employee Type :</label>
                                        <div class="col-md-7">
                                            <select id="ddlEmployeeTypes" name="EmployeeType" required="required" class="form-control col-md-7 col-xs-12">
                                                @foreach (var e in Model.EmployeeTypes)
                                                {

                                                    <option value="@e.EmployeeTypeID" @(Model.EmployeeType == e.EmployeeTypeID ? "selected" : "" )>@e.EmployeeTypeName</option>
                                                }

                                            </select>

                                        </div>
                                    </div>
                                    <div class="col-md-3 padding">
                                        <a href="Javascript:void(0);" id="0" onclick="$('#frmGetRequests').submit();" class="btn btn-link" style="color:white;">Go!</a>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="box-body">

                    <table id="datatable" class="table table-striped table-bordered" cellspacing="0" style="font-size: 8px;">
                        <thead>
                            <tr>
                                <th class="disabled-sorting" style="width:5%">#</th>
                                <th class="disabled-sorting" style="width:15%">Employee</th>
                                @for (var i = 0; i < DateTime.DaysInMonth(Model.RepoDate.Year, Model.RepoDate.Month); i++)
                                {
                                    <th class="">D@(i + 1)</th>
                                }
                                <th class="disabled-sorting" style="width:10%">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var ctr = 1;
                                foreach (var m in Model.StatusAttendance)
                                {
                                    <tr>
                                        <td>@ctr</td>
                                        <td>@m.EmployeeSID<br />@m.EmployeeName</td>
                                        @{
                                            double TotalPresent = 0;
                                            var status = "P";
                                            double dbStatus = 0;
                                            for (var i = 1; i <= DateTime.DaysInMonth(Model.RepoDate.Year, Model.RepoDate.Month); i++)
                                            {
                                                dbStatus = 0;
                                                try
                                                {
                                                    dbStatus = (double)m.GetType().GetProperty("D" + i).GetValue(m, null);
                                                }
                                                catch
                                                {
                                                    dbStatus = 3;
                                                }
                                                TotalPresent = TotalPresent + (dbStatus != 3 && dbStatus != 2 && dbStatus != -2 && dbStatus != -1 ? dbStatus : 0);
                                                <td class="@(dbStatus==1?"present": dbStatus==-2||dbStatus==2?"holiday":dbStatus==-1?"leave":dbStatus==0?"absent":dbStatus==3?"unknown":"")">
                                                    @(dbStatus == 1 ? "p" : dbStatus == -2|| dbStatus == 2 ? "H": dbStatus == -1 ? "L" : dbStatus == 0 ? "A" : dbStatus == 3 ? "NA" : "")
                                                </td>
                                            }
                                        }
                                        <td>

                                            <b>@TotalPresent</b>
                                        </td>
                                    </tr>
                                                ctr++;
                                            }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</section>
@section scripts
{
<script src="@Url.Content("~/js/Admin/jquery.dataTables.min.js")"></script>
<script src="@Url.Content("~/js/dataTables.bootstrap.min.js")"></script>
<script>
   

</script>
    }
<!-- /.content -->