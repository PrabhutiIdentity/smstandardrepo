@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model ClassWiseFeeDuePageModel
@section IncludeCss
{
<title>Class Wise Fee Summery</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
}
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Class Wise Fee Summery
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Class Wise Fee Summery</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    @using (Html.BeginForm("ReportClassWiseFee", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
                    {
                        <div class="row std-mng-head">
                            <div class="col-md-12 class-section">
                                <div class="row">
                                    <div class="col-md-2 padding">
                                        <label class="text-right" style="padding-left: 25px;">@Model.QDate.ToString("MMM, yyyy")</label>
                                    </div>
                                    <div class="col-md-4 padding">
                                        <label class="col-md-4 text-right">Sessions :</label>
                                        <div class="col-md-8">
                                            <select name="SessionID" class="form-control" id="ddlSessions">
                                                <option value="0">--Select Session--</option>
                                                @foreach(SMEnterprise.Models.SchoolSessionModel el in Model.Sessions)
                                                {
                                                    <option value="@el.SessionID" @(el.SessionID == Model.SessionID ? "selected" : "")>@el.SessionName @(el.SessionStatus==1?"(Active)":"")</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-1 padding">
                                        <div class="row">

                                            <div class="col-md-12">
                                                <a href="javascript:void(0);" onclick="$('#frmGetStudents').submit();"><i class="fa fa-search"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="box-body">
                    <table id="PaymentsTable" class="table table-striped payments">
                        <thead>
                            <tr>
                                <th style="width:15%">Class Name</th>
                                <th style="width:10%">Previous</th>
                                <th style="width:10%">Late Fee</th>
                                <th style="width:15%">Current</th>
                                <th style="width:15%">Discount</th>
                                <th style="width:10%">Payment</th>
                                <th style="width:15%">Net Due</th>
                            </tr>
                        </thead>
                        @{
                            int count = 0;
                            decimal TotalDue = 0;
                            foreach (ClassWiseFeeDueModel c in Model.ClassWiseDueFee)
                            {
                                TotalDue = TotalDue + (c.PreviousDues+c.LateFee + c.ApplicableFee - c.PaymentAmount-c.DiscAmt);
                                                <tr>

                                                    <td>
                                                        @c.ClassName
                                                    </td>
                                                    <td>
                                                        <i class="fa fa-inr" aria-hidden="true"></i>  @c.PreviousDues
                                                    </td>
                                                    <td>
                                                        @c.LateFee
                                                    </td>
                                                    <td>
                                                        <i class="fa fa-inr" aria-hidden="true"></i>  @c.ApplicableFee
                                                    </td>
                                                    <td>
                                                        <i class="fa fa-inr" aria-hidden="true"></i>  @c.DiscAmt
                                                    </td>

                                                    <td>
                                                        <i class="fa fa-inr" aria-hidden="true"></i> @c.PaymentAmount
                                                    </td>
                                                    <td>
                                                        <i class="fa fa-inr" aria-hidden="true"></i> @(c.PreviousDues + c.ApplicableFee + c.LateFee - c.PaymentAmount-c.DiscAmt)
                                                    </td>
                                                </tr>

                                count++;
                            }

                        }
                        <tfoot>
                            <tr style="background-color: #606d73;color: white;">
                                <td colspan="6">
                                    <b> Total Due</b>
                                </td>
                                <td><b> <i class="fa fa-inr" aria-hidden="true"></i> @TotalDue.ToString("N2")</b></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

</section>
@section scripts
{
<script src="@Url.Content("~/js/Admin/jquery.dataTables.min.js")"></script>
<script src="@Url.Content("~/js/dataTables.bootstrap.min.js")"></script>
<script src="@Url.Content("~/js/dataTables.buttons.min.js")"></script>
<script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>
<script src="@Url.Content("~/js/buttons.flash.min.js")"></script>
<script src="@Url.Content("~/js/buttons.html5.min.js")"></script>
<script src="@Url.Content("~/js/buttons.print.min.js")"></script>
<script src="@Url.Content("~/js/jszip.min.js")"></script>
<script src="@Url.Content("~/js/pdfmake.min.js")"></script>
<script src="@Url.Content("~/js/vfs_fonts.js")"></script>
<script>
    $(document).ready(function () {
        var handleDataTableButtons = function () {
            if ($("#PaymentsTable").length) {
                $("#PaymentsTable").DataTable({
                    "bPaginate": false,
                    "retrieve": true,
                    dom: "Bfrtip",
                    buttons: [
                      {
                          extend: "copy",
                          className: "btn-sm"
                      },
                      {
                          extend: "csv",
                          className: "btn-sm"
                      },
                      {
                          extend: "excel",
                          className: "btn-sm"
                      },
                      {
                          extend: "pdfHtml5",
                          className: "btn-sm"
                      },
                      {
                          extend: "print",
                          className: "btn-sm"
                      },
                    ],
                    responsive: true
                });
            }
        };

        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtons();
                }
            };
        }();

        TableManageButtons.init();
    });
    $(function () {

        $('#liReportClassWiseFee').closest('ul').closest('li').addClass('active');
        $('#liReportClassWiseFee').addClass('active');
    });

    function ClassMainChanged(sender) {
        $('#ddlSection').html('<option value="-1">Loading....</option>');
        $.ajax(
    {
        type: "POST",
        url: "/Admin/GetSectionOnClass/" + $(sender).val(),
        cache: false,
        processData: false,
        contentType: false,
        success: function (html) {
            $('#ddlSection').html('');
            $('#ddlSection').html('<option value="0">--Select Section--</option>');
            $('#ddlSection').append(html);
        },
        error: function (e) {
            alert("errorn");
        }
    });
    }
</script>
    }
<!-- /.content -->