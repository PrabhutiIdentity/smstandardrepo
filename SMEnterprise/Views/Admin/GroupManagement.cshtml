
@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model GroupEditModel
@section IncludeCss
{
    <title>Group / Subject Management</title>
}
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Group / Subject Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Group / Subject Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 5%">#</th>
                                <th style="width: 30%">Group Name</th>
                                <th style="width: 15%">Education Level</th>
                                <th style="width: 10%">#Subjects</th>
                                <th style="width: 10%">#Types</th>
                                <th style="width: 15%">Status</th>
                                <th style="width: 15%"><a class="sbtn" href="javascript:void(0);" onclick="OpenAddNewCopy(this)">Add New</a></th>
                            </tr>
                        </thead>
                        @{
                            int count = 0;
                            <tbody>

                                @foreach (GroupModel c in Model.Groups)
                                {
                                    <tr>

                                        <td>
                                            @(count + 1)
                                            <input type="hidden" name="GroupID" id="hdnGroupID" value="@c.GroupID" />
                                        </td>
                                        <td>
                                            <span class="ViewCopy visible">@c.GroupName</span>
                                            <input type="text" class="form-control editCopy hidden" onchange='$(this).closest("tr").find("#hdnGroupName").val($(this).val())' id="txtGroupName" name="GroupName" value="@c.GroupName" />
                                        </td>
                                        <td>
                                            @{
                                                foreach (EducationLevelModel e in Model.EducationLevels)
                                                {
                                                    if (e.ID == c.EducationLevelID)
                                                    {

                                                        <span class="ViewCopy visible">@e.Name</span>
                                                        break;
                                                    }
                                                }

                                            }
                                            <select id="ddlEducationLevel" class="form-control editCopy hidden" onchange="$(this).closest('tr').find('#hdnEducationLevel').val($(this).val());">
                                                @{
                                                    foreach (EducationLevelModel e in Model.EducationLevels)
                                                    {
                                                        <option value="@e.ID" @(e.ID == c.EducationLevelID ? "Selected" : "")>@e.Name</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="hidden" id="hdnSubjectCount" value="@c.Subjects" />
                                            @c.Subjects
                                            (<a href="javascript:void(0);" onclick="ViewSubjects(this);" id="@c.GroupID" class="SubjectClosed">Manage</a>)
                                        </td>
                                        <td>
                                            <input type="hidden" id="hdnSubjectTypesCount" value="@c.Types" />
                                            @c.Types
                                            (<a href="javascript:void(0);" onclick="ViewSubjectTypes(this);" id="@c.GroupID" class="SubjectClosed">Manage</a>)
                                        </td>
                                        <td>
                                            <span class="ViewCopy visible"><label class='badge bg-@(c.Status == 0 ? "red" : "green")'>@(c.Status == 0 ? "Inactive" : "Active")</label></span>

                                            <label class="switch switch-green editCopy hidden" style="padding-top: 3px;">

                                                <input type="checkbox" id="chkEmailSettingSSL" @(c.Status == 1 ? "checked" : "") class="switch-input">

                                                <span class="switch-label" onclick='$(this).closest("tr").find("#hdnStatus").val($(this).closest("tr").find("#hdnStatus").val() == "0" ? "1" : "0");' data-on="Yes" data-off="No"></span>
                                                <span class="switch-handle" id="shTranding"></span>
                                            </label>
                                        </td>
                                        <td style="text-align: center;">
                                            <div class="btn-group">

                                                <a href="javascript:void(0);" class="sbtn btn btn-default" onclick="EditCopy(this);">Edit</a>

                                                @using (Html.BeginForm("UpdateGroup", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                {
                                                    <input type="hidden" name="GroupID" id="hdnGroupID" value="@c.GroupID" />
                                                    <input type="hidden" id="hdnGroupName" name="GroupName" value="@c.GroupName" />
                                                    <input type="hidden" id="hdnEducationLevel" name="EducationLevelID" value="@c.EducationLevelID" />
                                                    <input type="hidden" id="hdnStatus" name="Status" value="@c.Status" />
                                                    <input type="submit" class="btn btn-default sbtn editCopy hidden" style="background-color: #1abb9c;color: white;" value="Save" />
                                                }
                                                @using (Html.BeginForm("UpdateGroup", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                {
                                                    <input type="hidden" name="OpType" value="-1" />
                                                    <input type="hidden" name="GroupID" value="@c.GroupID" />
                                                    <button onclick="return GroupDelete(this);" style="background-color: red;color: white;" class="btn btn-default sbtn ViewCopy visible" value="Edit">Delete</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>

                                    count++;
                                }


                            </tbody>

                            <tfoot style="display:none;">

                                <tr>

                                    <td>
                                        @(count + 1)
                                        <input type="hidden" name="GroupID" id="hdnGroupID" value="" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" onchange='$(this).closest("tr").find("#hdnGroupName").val($(this).val())' id="txtGroupName" name="GroupName" value="" />
                                    </td>
                                    <td>
                                        <select id="ddlEducationLevel" class="form-control" onchange="$(this).closest('tr').find('#hdnEducationLevel').val($(this).val());">
                                            @{
                                                <option value="0">--Select--</option>
                                                foreach (EducationLevelModel e in Model.EducationLevels)
                                                {
                                                    <option value="@e.ID">@e.Name</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>
                                        <label class="switch switch-green" style="padding-top: 3px;">

                                            <input type="checkbox" id="chkEmailSettingSSL" checked class="switch-input">

                                            <span class="switch-label" onclick='$(this).closest("tr").find("#hdnStatus").val($(this).closest("tr").find("#hdnStatus").val() == "0" ? "1" : "0");' data-on="Yes" data-off="No"></span>
                                            <span class="switch-handle" id="shTranding"></span>
                                        </label>
                                    </td>
                                    <td style="text-align: center;">
                                        <div class="btn-group">
                                            @using (Html.BeginForm("UpdateGroup", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                            {
                                                <input type="hidden" name="GroupID" id="hdnGroupID" value="0" />
                                                <input type="hidden" id="hdnGroupName" name="GroupName" value="" />
                                                <input type="hidden" id="hdnEducationLevel" name="EducationLevelID" value="0" />
                                                <input type="hidden" id="hdnStatus" name="Status" value="1" />
                                                <input type="submit" class="btn btn-default" style="background-color: #1abb9c;color: white;" value="Add New" />
                                            }

                                        </div>
                                    </td>
                                </tr>

                            </tfoot>
                        }
                    </table>

                </div>
            </div>
        </div>
    </div>

</section>
<script>
    $(function () {
        $("#tblCategory").DataTable({
            "ordering": false
        });
        $('#liGroupManagement').closest('ul').closest('li').addClass('active');
        $('#liGroupManagement').addClass('active');
    });
    function GroupDelete(sender) {
        var Subs = $(sender).closest('tr').find('#hdnSubjectCount').val();
        if (Subs == 0) {
            if (confirm('Are you sure you wish to delete this Group?')) {

                return true;
            }
            else {
                return false;
            }
        }
        else
        {
            alert("Group has Subjects, So it can't be Deleted!!!!");
            return false;
        }
    }
    function ViewSubjects(sender) {

        if ($(sender).hasClass("SubjectClosed")) {

            var notice = ShowNotification('Loading', 'Please wait while we load the required details....', 'info');
            $.ajax(
            {
                type: "POST",
                url: "/Admin/GetGroupSubjects/" + $(sender).attr('id'),
                cache: false,
                processData: false,
                contentType: false,
                success: function (html) {
                    notice.remove();
                    // fill the div with the html returned by action
                    var ele = document.getElementsByClassName("SubjectOpen");
                    if (ele.length > 0) {
                        $(ele[0]).click();
                        $(ele[0]).closest("tr").css('background-color', 'white');
                    }
                    $(sender)
                        .closest("tr")
                        .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + html + "</td></tr>");
                    $(sender).closest("tr").css('background-color', 'rgba(123, 100, 165, 0.48)');


                    $(sender).text("Close");
                    $(sender).removeClass("SubjectClosed");
                    $(sender).addClass("SubjectOpen");
                },
                error: function (e) {
                    alert("errorn");
                }
            });
        }
        else {
            $(sender).text("Manage");
            $(sender).removeClass("SubjectOpen");
            $(sender).closest("tr").css('background-color', 'white');
            $(sender).addClass("SubjectClosed");
            $(sender).closest("tr").next().remove();

        }

    }

    function SaveGroupSubject(sender, OpType) {
        var isContinue = true;
        if (OpType == -1)
        {
            var subsubcount = $(sender).closest('tr').find('#hdnSubSubjectCount').val()
            var IsSubAssigned = $(sender).closest('tr').find('#hdnTAssigned').val()
            if (subsubcount > 0) {
                isContinue = false;
                alert('Subject have sub-subjects defined, please delete subsubject first....');
            }
            else
            {
                if (IsSubAssigned > 0) {
                    isContinue = false;
                    alert('Subject already assigned to teacher, please un-assign subject first....');
                }
                else
                {
                    isContinue = confirm("Do You Really Want To Delete this Subject!!!!");
                }

            }
        }
        if (isContinue) {
            $.ajax({
                url: "@Url.Action("UpdateGroupSubject", "Admin")",
                type: 'POST',
                data: JSON.stringify({
                    OpType: OpType,
                    SubjectID: $(sender).closest('tr').find('#hdnSubjectID').val(),
                    SubjectName: $(sender).closest('tr').find('#txtSubjectName').val(),
                    SubjectCode: $(sender).closest('tr').find('#txtSubjectCode').val(),
                    IsOptionalsubject: $(sender).closest('tr').find('#hdnIsOptionalsubject').val(),
                    Status: $(sender).closest('tr').find('#hdnSubjectStatus').val(),
                    GroupID: $(sender).closest('tr').find('#hdnGroupID').val(),
                    MainSubID: $(sender).closest('tr').find('#hdnMainSubID').val(),
                    SubjectType: $(sender).closest('tr').find('#ddlSubjectType').val()
                }),
                contentType: 'application/json; charset=utf-8',
                success: function (html) {
                    $(sender).closest('table').closest('td').html(html);
                    ShowClosingNotification('Success', 'Changes updated successfully', 'info');
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
                },
                async: true,
                processData: false
            });
        }
    }
    function ViewSubSubjects(sender) {

        if ($(sender).hasClass("SubSubjectClosed")) {

            var notice = ShowNotification('Loading', 'Please wait while we load the required details....', 'info');
            $.ajax(
            {
                type: "POST",
                url: "/Admin/GetSubSubjects/" + $(sender).attr('id'),
                cache: false,
                processData: false,
                contentType: false,
                success: function (html) {
                    notice.remove();
                    // fill the div with the html returned by action
                    var ele = document.getElementsByClassName("SubSubjectOpen");
                    if (ele.length > 0) {
                        $(ele[0]).click();
                        $(ele[0]).closest("tr").css('background-color', 'white');
                    }
                    $(sender)
                        .closest("tr")
                        .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + html + "</td></tr>");
                    $(sender).closest("tr").css('background-color', 'rgba(123, 100, 165, 0.48)');


                    $(sender).text("Close");
                    $(sender).removeClass("SubSubjectClosed");
                    $(sender).addClass("SubSubjectOpen");
                },
                error: function (e) {
                    alert("errorn");
                }
            });
        }
        else {
            $(sender).text("Manage");
            $(sender).removeClass("SubSubjectOpen");
            $(sender).closest("tr").css('background-color', 'white');
            $(sender).addClass("SubSubjectClosed");
            $(sender).closest("tr").next().remove();

        }

    }

    function ViewSubjectTypes(sender) {

        if ($(sender).hasClass("SubjectClosed")) {

            var notice = ShowNotification('Loading', 'Please wait while we load the required details....', 'info');
            $.ajax(
            {
                type: "POST",
                url: "/Admin/GetGroupSubjectTypes/" + $(sender).attr('id'),
                cache: false,
                processData: false,
                contentType: false,
                success: function (html) {
                    notice.remove();
                    // fill the div with the html returned by action
                    var ele = document.getElementsByClassName("SubjectOpen");
                    if (ele.length > 0) {
                        $(ele[0]).click();
                        $(ele[0]).closest("tr").css('background-color', 'white');
                    }
                    $(sender)
                        .closest("tr")
                        .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + html + "</td></tr>");
                    $(sender).closest("tr").css('background-color', 'rgba(123, 100, 165, 0.48)');


                    $(sender).text("Close");
                    $(sender).removeClass("SubjectClosed");
                    $(sender).addClass("SubjectOpen");
                },
                error: function (e) {
                    alert("errorn");
                }
            });
        }
        else {
            $(sender).text("Manage");
            $(sender).removeClass("SubjectOpen");
            $(sender).closest("tr").css('background-color', 'white');
            $(sender).addClass("SubjectClosed");
            $(sender).closest("tr").next().remove();

        }

    }
    function SaveGroupSubjectType(sender, OpType) {
        var isContinue = true;
        if (OpType == -1)
        {
            isContinue = confirm("Do You Really Want To Delete this Subject!!!!");
        }
        if (isContinue) {
            $.ajax({
                url: "@Url.Action("UpdateGroupSubjectType", "Admin")",
                type: 'POST',
                data: JSON.stringify({
                    OpType: OpType,
                    TypeID: $(sender).closest('tr').find('#hdnTypeID').val(),
                    TypeName: $(sender).closest('tr').find('#txtTypeName').val(),
                    GroupID: $(sender).closest('tr').find('#hdnGroupID').val()
                }),
                contentType: 'application/json; charset=utf-8',
                success: function (html) {
                    $(sender).closest('table').closest('td').html(html);
                    ShowClosingNotification('Success', 'Changes updated successfully', 'info');
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
                },
                async: true,
                processData: false
            });
        }
    }
</script>
<!-- /.content -->