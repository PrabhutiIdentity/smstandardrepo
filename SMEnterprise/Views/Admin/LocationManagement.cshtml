@using SMEnterprise.Models;
@using System.Web.Mvc;
@using SMEnterprise.Repository
@{
    ViewBag.Title = "Location Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
<link href="@Url.Content("~/css/MapStyleSheet.css")" rel="stylesheet" type="text/css" />
    <title>Location/Area Management</title>
    <script type="text/javascript" src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCnOlC8MgMBPoCAhPFtLa-N3YeXztqBXyI&libraries=places">
</script>
<style>
    .modal {
       
        width:auto!important;
        height:auto!important;
    }
    .apply
    {
        color:black;
    }
</style>
}
<script>
    var DistrictName = '';
    var Dlat = 0;
    var Dlong = 0;
    function ToggleDetails(sender) {
       
        if ($(sender).hasClass("Closed")) {
            $(sender)
          .closest("tr")
          .after("<tr><td style='background-color: rgba(123, 100, 165, 0.48);'></td><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>Loading....</td></tr>");
            var cName = '.Table_' + (parseInt($(sender).attr('lType')) - 1);
            $(cName).each(function (index) {
                if ($(this).hasClass('Opened')) {
                    $(this).removeClass("Opened");
                    $(this).addClass("Closed");
                    $(this).closest("tr").next().remove();
                    $(this).text("Manage");
                }
            });
            if ($(sender).attr('lType') == '4') {
                var DistName = $(sender).closest('tr').find('#txtName').val();
                DistrictName = DistName;
                var geocoder = new google.maps.Geocoder();

                geocoder.geocode({ 'address': DistrictName }, function (results, status) {
                    if (status === 'OK') {
                        Dlat = results[0].geometry.location.lat();
                        Dlong = results[0].geometry.location.lng();
                    } else {
                        //alert('Geocode was not successful for the following reason: ' + status);
                    }
                });

                
            }
            $.ajax(
                    {
                        type: "POST",
                        url: "/Admin/GetLocation/" + $(sender).attr('id') + "/" + $(sender).attr('lType'),
                        cache: false,
                        processData: false,
                        contentType: false,
                        success: function (html) {
                            html = html.replace('[MasterNamePlaceHolder]', $(sender).closest('tr').find('#txtName').val());
                            $(sender).closest("tr").next().remove();
                            // fill the div with the html returned by action
                            $(sender)
                                .closest("tr")
                                .after("<tr><td style='background-color: rgba(123, 100, 165, 0.48);'><input type='hidden' id='hdnMainName' value='" + $(sender).closest('tr').find('#txtName').val() + "'/></td><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);'>" + html + "</td></tr>");
                           

                            $(sender).removeClass("Closed");
                            $(sender).addClass("Opened");
                            $(sender).text("Close");
                        },
                        error: function (e) {
                            alert("errorn");
                        }
                    });
        }
        else {
            $(sender).removeClass("Opened");
            $(sender).addClass("Closed");
            $(sender).closest("tr").next().remove();
            $(sender).text("Manage");
        }

    }
    function DeleteCountry(sender)
    {
        if ($(sender).closest('tr').find('#hdnCount').val() != '0') {
            ShowClosingNotification('Error', 'States are added in Country, It can\'t be deleted!!!!', 'error');
            return false;
        }
        else {
            return confirm("Do you Really Want to Delete this Country????");
        }
    }
    function DeleteLocation(sender) {
        var type = $(sender).closest('tr').find('#hdnType').val();
        var mName = type == "2" ? "State" : type == "3" ? "City" : "Area";
        var sName = type == "2" ? "Cities" : type == "3" ? "Areas" : "Route Stoppages";
        if ($(sender).closest('tr').find('#hdnCount').val() != '0') {
            ShowClosingNotification('Error', sName + " are added in " + mName + ", It can't be deleted!!!!", 'error');
        }
        else {
            if (confirm("Do you Really Want to Delete this " + mName + "????")) {
                UpdateLocation(sender, -1);
            }
        }
    }

    function UpdateLocation(sender, OpType) {
        var MainName = $(sender).closest('table').closest('tr').find('#hdnMainName').val();
        $.ajax({
            url: "@Url.Action("AddLocation", "Admin")",
            type: 'POST',
            data: JSON.stringify({
                OpType: OpType,
                Name: $(sender).closest('tr').find('#hdnName').val(),
                IsApproved: $(sender).closest('tr').find('#hdnStatus').val(),
                ID: $(sender).closest('tr').find('#hdnID').val(),
                MasterID: $(sender).closest('tr').find('#hdnMasterID').val(),
                Type: $(sender).closest('tr').find('#hdnType').val(),
                Other: $(sender).closest('tr').find('#hdnOther').val(),
                Latitude: $(sender).closest('tr').find('#hdnLatitude').val(),
                Longitude: $(sender).closest('tr').find('#hdnLongitude').val()
            }),
            contentType: 'application/json; charset=utf-8',
            success: function (html) {
                ShowNotification('Saved', 'Successfully Saved', 'success');
                html = html.replace('[MasterNamePlaceHolder]', MainName);
                $(sender).closest('table').closest('td').html(html);
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                ShowNotification('Not Saved', 'Some problem occured, please try again!!!!', 'error');
            },
            async: true,
            processData: false
        });
    }
    

</script>
