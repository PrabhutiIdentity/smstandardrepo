                                                    {
                                                        <input type="hidden" name="ID" id="hdnID" value="@c.ID" />
                                                        <input type="hidden" name="Type" id="hdnType" value="@c.Type" />
                                                        <input type="hidden" id="hdnStatus" name="IsApproved" value="@c.IsApproved" />
                                                        <input type="hidden" id="hdnName" name="Name" value="@c.Name" />

                                                        <input type="submit" class="btn btn-link sbtn editCopy hidden" value="Save" />
                                                    }
                                                    @using (Html.BeginForm("UpdateCity", "Admin", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data", @ID = "BuildingUpdate" }))
                                                    {
                                                        <input type="hidden" name="ID" id="hdnID" value="@c.ID" />
                                                        <input type="hidden" name="Type" id="hdnType" value="@c.Type" />
                                                        <input type="hidden" name="OpType" id="hdnOpType" value="-1" />

