</section>


<div style="display:none;" id="divloadMap">
    <div class="row">
        <div class="col-md-12">
            <input id="txtsearch" class="apply" type="text" placeholder="Enter Search Place">
            <div id="map_canvas" style="width: 90%; height: 275px; box-shadow: 0px 0px 5px 5px #BBB; margin-top: 10px;"></div>
            <input type="hidden" ID="hdnLongitude" value="0" />
        </div>
        <div class="col-md-12">
            <a href="javascript:void(0);" class="btn btn-link pull-right" onclick="CloseMap(this);">Close</a>
        </div> 
    </div>
    <input type="hidden" ID="hdnLatitude" value="0" />
</div>
<script>
    $(function () {
        $("#tblCategory").DataTable({
            "aoColumns": [{ "bSortable": false }, null, null, null,  { "bSortable": false }]
        });
        $('#liLocationManagement').closest('ul').closest('li').addClass('active');
        $('#liLocationManagement').addClass('active');
    });
    
    function CloseMap(sender)
    {
        $(rowsender).click();
    }
    var map;
    var NewLatitude;
    var NewLongitude;
    var marker;
    var rowsender;
    //creating function to load initial MAP when page loading
    function LoadGoogleMAP(sender, lat, long) {
        $(sender).closest("tr").next().remove();
        $(sender)
       .closest("tr")
       .after("<tr><td id='tdDetails' colspan = '999' style='border-left: 3px solid #7b64a5;background-color: white'>" + $('#divloadMap').html().replace('map_canvas','cmap_canvas').replace('txtsearch','Ctxtsearch') + "</td></tr>");
        $(sender).removeClass('MapClosed');
        $(sender).addClass('MapOpen');

        var isMarker = true;
        if (lat == '')
        {
            isMarker = false;
            lat = Dlat;
            long = Dlong;
        }
        var myLatlng = new google.maps.LatLng(lat, long);
        var markers = [];
        var myOptions = {
            center: myLatlng,
            zoom: 14,
            mapTypeId: google.maps.MapTypeId.ROADMAP
        };
        map = new google.maps.Map(document.getElementById("cmap_canvas"), myOptions);
            try {
                marker.setVisible(false);
            }
            catch (err) {

            }

        map.panTo(myLatlng)
        // map = new google.maps.Map(document.getElementById("map_canvas"), myOptions);
            marker = new google.maps.Marker({
                position: myLatlng,
                title: "lat: " + lat + " long: " + long
            });
        if (isMarker) {
            marker.setMap(map);
        }
        // Create the search box and link it to the UI element.
        var input = (document.getElementById('Ctxtsearch'));
        map.controls[google.maps.ControlPosition.TOP_LEFT].push(input);

        var searchBox = new google.maps.places.SearchBox(input);
        // Listen for the event fired when the user selects an item from the
        // pick list. Retrieve the matching places for that item.
        google.maps.event.addListener(searchBox, 'places_changed', function () {
            var places = searchBox.getPlaces();

            if (places.length == 0) {
                return;
            }
            //              for (var i = 0, marker; marker = markers[i]; i++) {
            //                  //marker.setMap(null);
            //              }

            // For each place, get the icon, place name, and location.
            markers = [];

            var bounds = new google.maps.LatLngBounds();
            for (var i = 0, place; place = places[i]; i++) {
                var image = {
                    url: place.icon

                };

                // Create a marker for each place.
                marker = new google.maps.Marker({
                    map: map,
                    title: place.name,
                    position: place.geometry.location
                });

                markers.push(marker);

                bounds.extend(place.geometry.location);
            }

            map.fitBounds(bounds);
            google.maps.event.trigger(map, "resize");
        });


        google.maps.event.addListener(map, "click", function (e) {

            if (confirm("Are you sure you want to change Map Location?") == true) {

                marker.setVisible(false);


                var clickLat = e.latLng.lat();
                var clickLon = e.latLng.lng();
                var latLng = e.latLng;

                NewLatitude = clickLat;
                NewLongitude = clickLon;

                $(sender).closest('td').find('#hdnLongitude').val(NewLongitude.toString().substring(0, 8));
                $(sender).closest('td').find('#hdnLatitude').val(NewLatitude.toString().substring(0, 8));
                $(sender).html(NewLatitude.toString().substring(0, 8) + ',' + NewLongitude.toString().substring(0, 8));
                var markerNew = new google.maps.Marker({

                    position: new google.maps.LatLng(clickLat, clickLon),
                    map: map

                });
                markerNew.setMap(map);

                marker = markerNew;
            }
        });
        // current map's viewport.
        google.maps.event.addListener(map, 'bounds_changed', function () {
            var bounds = map.getBounds();
            searchBox.setBounds(bounds);
        });
            
    }
    function ShowLocationMap(sender) {
        if ($(sender).hasClass('MapClosed')) {
            rowsender = sender;
            var Lat = $(sender).closest('td').find('#hdnLatitude').val();
            var Long = $(sender).closest('td').find('#hdnLongitude').val();
            $(sender)
                   .closest("tr")
                   .after("<tr><td id='tdDetails' colspan = '999' style='border-left: 3px solid #7b64a5;font-size: 30px;text-align: -webkit-center;'> Loading.... </td></tr>");
            var ele = document.getElementsByClassName("MapOpen");
            if (ele.length > 0) {
                $(ele[0]).click();

                //$(ele[0]).text('Edit');
            }
            
            LoadGoogleMAP(sender, Lat, Long);           
        }
        else {
            rowsender = null;
            $(sender).removeClass('MapOpen');
            $(sender).addClass('MapClosed');
            $(sender).closest("tr").next().remove();
        }
    
    }
    function SetMapCordinates(sender,lat, long) {
        try {
            marker.setVisible(false);
        }
        catch (err) {

        }
        

        NewLatitude = lat;
        NewLongitude = long;
        $('#hdnLongitude').val(NewLongitude);
        $('#hdnLatitude').val(NewLatitude);
        var myLatlng = new google.maps.LatLng(lat, long);
        map.panTo(myLatlng)
        // map = new google.maps.Map(document.getElementById("map_canvas"), myOptions);

        marker = new google.maps.Marker({
            position: myLatlng,
            title: "lat: " + lat + " long: " + long
        });

        marker.setMap(map);
        google.maps.event.trigger(map, "resize");
      
    }

</script>

