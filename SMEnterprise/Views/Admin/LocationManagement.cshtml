                                            </div>
                                        </td>



                                    </tr>
                                    bCounter++;
                                }
                            }
                        </tbody>
                        <tfoot style="border-width: 2px;border-style: groove;display:none;">
                            <tr>
                                <td></td>
                                <td>
                                    <input type="hidden" name="ID" value="0" />
                                    <input class="form-control" type="text" onchange='$(this).closest("tr").find("#hdnName").val($(this).val())' name="Name" value="" />
                                </td>
                                <td>
                                    0
                                </td>
                                <td>
                                    <label class="switch switch-green">

                                        <input type="checkbox" class="switch-input" Checked>

                                        <span class="switch-label" onclick='$(this).closest("tr").find("#hdnStatus").val($(this).closest("tr").find("#hdnStatus").val() == "0" ? "1" : "0");' data-on="Active" data-off="Inactive"></span>
                                        <span class="switch-handle" id="shTranding"></span>

                                    </label>
                                </td>
                                <td>
                                    <div class="row">
                                        <div class="col-md-6">
                                            @using (Html.BeginForm("UpdateCity", "Admin", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data", @ID = "BuildingUpdate" }))
