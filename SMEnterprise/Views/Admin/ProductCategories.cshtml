@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    ViewBag.Title = "Blog Categories";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section IncludeCss
{
    <link rel="stylesheet" href="@Url.Content("~/css/Admin/bootstrap-colorpicker.min.css")">
    <title>Product Category Management</title>
}
@model List<SMEnterprise.Models.ProductCategoryModel>
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Product Category Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Admin/Dashboard"><i class="fa fa-dashboard"></i>Dashboard</a></li>
        <li class="active">Product Category Management</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                </div>
                <div class="box-body">
                    <table id="tblCategory" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 10%">Sl. No.</th>
                                <th style="width: 30%">Name</th>
                                <th style="width: 15%">HSN Code</th>
                                <th style="width: 30%">SGST/CGST/IGST</th>
                                <th style="width: 20%">Edit/Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int count = 0;
                                foreach (var c in Model)
                                {
                                    <tr>

                                        <td>
                                            <input type="hidden" id="hdnID" value="@c.ID" />
                                            <input type="hidden" id="hdnName" value="@c.Name" />
                                            <input type="hidden" id="hdnHSNCode" value="@c.HSNCode" />
                                            <input type="hidden" id="hdnSGST" value="@c.SGST" />
                                            <input type="hidden" id="hdnCGST" value="@c.CGST" />
                                            <input type="hidden" id="hdnIGST" value="@c.IGST" />
                                            <input type="hidden" id="hdnProudctCount" name="ProudctCount" value="@c.ProductCount" />
                                            @(count + 1)
                                        </td>
                                        <td>
                                            @c.Name
                                        </td>
                                        <td>@c.HSNCode</td>
                                        <td>@c.SGST.ToString("0.0")/@c.CGST.ToString("0.0")/@c.IGST.ToString("0.0")</td>
                                        <td>
                                            <div class="btn-group">
                                                <a class="btn btn-link" onclick="EditProductCategory(this)">Edit</a>
                                                @using (Html.BeginForm("UpdateProductCategory", "Admin", FormMethod.Post, new { style = "display: inline-block;", role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                                                {
                                                    <input type="hidden" name="OpType" value="-1" />
                                                    <input type="hidden" name="ID" value="@c.ID" />
                                                    <button onclick="return ProductCategoryDelete(this);" style="background-color: red;color: white;" class="btn btn-default" value="Edit">Delete</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>

                                    count++;
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5">
                                    <a class="btn btn-link pull-right" onclick="AddProductCategory(this)">Add New Category</a>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                </div>
            </div>
        </div>
    </div>

</section>

@section pageBottom{
    <div id="mdlEditProductCategory" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Product Category</h4>
                </div>
                <div class="modal-body">
                    <form role="form" action="/admin/UpdateProductCategory">
                        <div class="box-body row">
                            <div class="form-group col-md-8">
                                <input type="hidden" name="ID" id="hdnCategoryID" />
                                <label for="txtSchemeTitle">Category Title</label>
                                <input type="text" required name="Name" class="form-control" id="txtName" placeholder="Enter Product Category Name">
                            </div>
                            @*<div class="form-group" id="divChartColor">
                                    <label for="txtSchemeTitle">Chart Color</label>
                                    <div class="input-group my-colorpicker2">
                                        <input type="text" class="form-control" id="txtSalaryTypeColor" onchange='$("#hdnSalaryTypeColor").val($(this).val())' value="">
                                        <div class="input-group-addon">
                                            <i></i>
                                        </div>
                                        <input type="hidden" id="hdnSalaryTypeColor" name="ChartColor" value="" />
                                    </div>
                                </div>*@
                            <div class="form-group col-md-4">
                                <label for="txtHSNCode">HSN Code</label>
                                <input type="text" required name="HSNCode" class="form-control" id="txtHSNCode" placeholder="Enter HSN Code">
                            </div>
                            <div class="form-group col-md-4">
                                <label for="txtSGST">SGST</label>
                                <input type="number" step="0.1" required name="SGST" class="form-control" id="txtSGST" placeholder="Enter SGST %">
                            </div>
                            <div class="form-group col-md-4">
                                <label for="txtSGST">CGST</label>
                                <input type="number" step="0.1" required name="CGST" class="form-control" id="txtCGST" placeholder="Enter CGST %">
                            </div>
                            <div class="form-group col-md-4">
                                <label for="txtSGST">IGST</label>
                                <input type="number" step="0.1" required name="IGST" class="form-control" id="txtIGST" placeholder="Enter IGST %">
                            </div>
                        </div>
                        <div class="box-footer">
                            <button type="submit" class="btn btn-primary pull-right" onclick="return SaveSalaryCategory();">Submit</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
}
@section scripts
{
    <script src="@Url.Content("~/js/Admin/bootstrap-colorpicker.min.js")"></script>
    <script>
        function EditProductCategory(sender) {
            $('#hdnCategoryID').val($(sender).closest('tr').find('#hdnID').val());
            $('#txtName').val($(sender).closest('tr').find('#hdnName').val());
            $('#txtHSNCode').val($(sender).closest('tr').find('#hdnHSNCode').val());
            $('#txtSGST').val($(sender).closest('tr').find('#hdnSGST').val());
            $('#txtCGST').val($(sender).closest('tr').find('#hdnCGST').val());
            $('#txtIGST').val($(sender).closest('tr').find('#hdnIGST').val());
            $('#mdlEditProductCategory').modal('toggle');
        }
        function AddProductCategory(sender) {
            $('#hdnCategoryID').val(0);
            $('#txtName').val('');
            $('#txtHSNCode').val('');
            $('#txtSGST').val(0);
            $('#txtCGST').val(0);
            $('#txtIGST').val(0);
            $('#mdlEditProductCategory').modal('toggle');
        }
        $(function () {
            $("#tblCategory").DataTable({
                "ordering": false
            });
            $('#liProductCategories').closest('ul').closest('li').addClass('active');
            $('#liProductCategories').addClass('active');
        });
        function ProductCategoryDelete(sender) {
          
            var Product = $(sender).closest('tr').find('#hdnProudctCount').val();

            
            if (Product > 0) {
                ShowClosingNotification('Error', 'This Category has Product, so can\'t be deleted!!!!', 'error');
                return false
            }
            else {
                return confirm("Do you Really Want to Delete this Category????");
            }
        }
       
        //{
        //    if (confirm('Are you sure you wish to delete this ProductCategory?')) {

        //        return true;
        //    }
        //    else {
        //        return false;
        //    }
        //}
        function BeforeProductCategoryUpdate(sender) {
            if ($(sender).closest('tr').find('#txtProductCategoryName').val() == "") {
                ShowClosingNotification('Error', 'Plese Fill Required Details!!!!', 'error');
                return false;
            }
            else {
                return true;
            }
        }
    </script>
}
<!-- /.content -->