
<div class="row">
    <div class="col-md-6">
        <div class="row" style="margin-bottom: 10px;">
            <div class="col-md-1">
            </div>
            <div class="col-md-8">
                <h4 style="text-align:center">Father</h4>
                <div class="profile_img">
                    <!-- end of image cropping -->
                    <div id="crop-avatar">
                        <!-- Current avatar -->
                        <img style="margin-left: auto;margin-right: auto;display: block;max-height:200px;" class="img-responsive avatar-view" onerror="return OnImageError(this,0);" src="@Url.Content("~/Images/ParentImage/Father/")@(Model.ParentID)_@Model.FatherImage" alt="Avatar">
                    </div>
                    <!-- end of image cropping -->
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span class="pull-right">
                    Name : 
                </span>
            </div>
            <div class="col-md-9">
                @Model.FatherName
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span class="pull-right">
                    Mobile : 
                </span>
            </div>
            <div class="col-md-9">
                @Model.FatherMobileNo
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span class="pull-right">
                    Email : 
                </span>
            </div>
            <div class="col-md-9">
                @Model.FatherEmailID
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="row" style="margin-bottom: 10px;">
            <div class="col-md-1">
            </div>
            <div class="col-md-8">
                <h4 style="text-align:center">Mother</h4>
                <div class="profile_img">
                    <!-- end of image cropping -->
                    <div id="crop-avatar">
                        <!-- Current avatar -->
                        <img style="margin-left: auto;margin-right: auto;display: block;max-height:200px;" class="img-responsive avatar-view" onerror="return OnImageError(this,1);" src="@Url.Content("~/Images/ParentImage/Mother/")@(Model.ParentID)_@Model.MotherImage" alt="Avatar">

                    </div>
                    <!-- end of image cropping -->
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span class="pull-right">
                    Name : 
                </span>
            </div>
            <div class="col-md-9">
                @Model.MotherName
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span class="pull-right">
                    Mobile : 
                </span>
            </div>
            <div class="col-md-9">
                @Model.MotherMobileNo
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span class="pull-right">
                    Email : 
                </span>
            </div>
            <div class="col-md-9">
                @Model.MotherEmailID
            </div>
        </div>
    </div>
</div>