
<div class="row">
    <table class="table table-bordered">
        <thead>
            <tr>
                <td>
                    #
                </td>
                <td>Subject</td>
                <td>Education Level</td>
            </tr>
        </thead>
        <tbody>
            @{
                var cnt = 0;
                foreach (var s in Model)
                {
                    <tr>
                        <td>@(cnt+1)</td>
                        <td>@s.SubjectName</td>
                        <td>@s.EducationLevel</td>
                    </tr>
                    cnt++;
                }
            }
        </tbody>
    </table>
</div>