<tr class="square">
    <td>@Model.SrNo</td>
    <td>
        <label class='badge bg-green'>Name: @Model.StudentName</label>
        <label class='badge bg-green'>DOB: @Model.StudentDOB.ToString("dd MMM, yyyy")</label>
        <label class='badge bg-green'>Class: @Model.ClassName</label>
        <label class='badge bg-purple'>Father: @Model.FatherName</label>
        <label class='badge bg-purple'>Mobile: @Model.FatherMobileNo</label>
        <label class='badge bg-blue'>Session: @Model.SessionName</label>
        <label class='badge bg-red'>Income: @Model.FamilyIncome.ToString("00") Lakh</label>
        <input type="hidden" id="hdnData" value="@(Json.Encode(Model))" />
    </td>
    <td>
        @if (Model.ESource == 0)
        {
            <label class='badge bg-blue'>Search</label>
        }
        else if (Model.ESource == 1)
        {
            <label class='badge bg-green'>Referance</label>
        }
        else
        {
            <label class='badge bg-red'>Ads</label>
        }
    </td>
    <td>
        Next Followup<br /> <label id="lblNextFollowDate" class='badge bg-red'>
            @Model.NextFollowUpDate.ToString("dd MMM, yyyy")
        </label><br />
        Enq. Date<br /> <label class='badge bg-gray'>@Model.EDate.ToString("dd MMM, yyyy")</label>
    </td>
    <td>
        @if (Model.EStatus == 0)
        {
            <label class='badge bg-blue'>Open</label>
        }
        else if (Model.EStatus == 1)
        {
            <label class='badge bg-green'>Converted</label>
        }
        else
        {
            <label class='badge bg-red'>Lost</label>
        }
    </td>
    <td>
        @if (Model.EPossibility == 0)
        {
            <label class='badge bg-blue'>Neutral</label>
        }
        else if (Model.EPossibility == 1)
        {
            <label class='badge bg-green'>Positive</label>
        }
        else
        {
            <label class='badge bg-red'>Negative</label>
        }
    </td>
    <td>
        @Model.Followups
    </td>
    <td>
        <a href="javascript:void(0);" class="btn btn-link Closed" onclick="ViewEnquiry(this,@Model.EnquiryID);">View</a>
    </td>
</tr>