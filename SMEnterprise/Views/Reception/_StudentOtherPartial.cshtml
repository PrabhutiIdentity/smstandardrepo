
<div class="row">
    <div class="col-md-6">
        <div class="row">
            <div class="col-md-3">
                <span class="pull-right">
                    Bus Route : 
                </span>
            </div>
            <div class="col-md-9">
                @Model.BusRoute
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span class="pull-right">
                    Driver : 
                </span>
            </div>
            <div class="col-md-9">
                @Model.Driver
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="row">
            <div class="col-md-3">
                <span class="pull-right">
                    Bus No. : 
                </span>
            </div>
            <div class="col-md-9">
                @Model.BusNo
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span class="pull-right">
                    Conductor : 
                </span>
            </div>
            <div class="col-md-9">
                @Model.Conductor
            </div>
        </div>
    </div>
</div>