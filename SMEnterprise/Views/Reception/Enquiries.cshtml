                                <select class="form-control editEnquiry hidden" name="EStatus" id="ddlEStatus">
                                    <option value="0">Open</option>
                                    <option value="1">Converted</option>
                                    <option value="2">Lost</option>
                                </select>
                            </div>
                            <div class="col-md-2">
