                    <div class="editEnquiry hidden">
                        <div class="row">

                            <input type="hidden" name="EnquiryID" value="" id="hdnEnquiryID" />
                            <input type="hidden" name="SrNo" value="" id="hdnSrNo" />
                            <div class="col-md-3">Enquery Date : <input type="date" name="EDate" class="form-control" id="txtEnqDate" /></div>
                            <div class="col-md-2">
