

@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_ReceptionLayout.cshtml";
}
@model SMEnterprise.Models.AdmissionEnquiryPageModel
@section IncludeCss
{
    <title>Admission Enquiries Management</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">
}
<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }

    .tblEqDetails > tbody > tr > td {
        padding: 0px;
    }

    .noPadRight {
        padding-right: 0px;
    }

    .noPadLeft {
        padding-left: 0px;
    }

    .enqDetails .row {
        border-bottom: 1px solid #d9dbdf;
        padding: 2px 0px 2px 0px;
    }

    .enqDetails .form-control {
        display: inline;
        width: auto;
        border-radius: 3px;
        padding: 2px 5px;
        font-size: 12px;
        height: 20px;
    }

    .enqDetails .btn {
        padding: 0px 2px;
        font-size: 13px;
    }

    .hidden {
        display: none;
    }

    .Followup {
        border: 2px solid #5cb8a0;
        padding: 2px 2px 2px 8px;
        border-radius: 3px;
        margin-top: 2px;
    }

        .Followup .row {
            border-bottom: 0px;
        }

        .Followup .col-md-4 {
            border-bottom: 1px solid red;
            text-align: center;
        }

        .Followup .col-md-12 {
            margin-top: 2px;
        }

    .square {
        background-color: rgba(255, 0, 0, 0.59);
        transition: opacity 1s ease-in-out;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("Enquiries", "Reception", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetEnquiries" }))
                {
                <div class="row std-mng-head">

                    <div class="col-md-12 class-section">
                        <div class="row">
                            <div class="col-md-3 padding">
                                <label class="col-md-4 text-right">Session :</label>
                                <div class="col-md-8">
                                    <select class="form-control" name="SessionID" id="ddlSessions">
                                        <option value="0">--Any Session--</option>
                                        @foreach (NameIDModel el in Model.Sessions)
                                            {
                                        <option value="@el.ID" @(el.ID == Model.SessionID ? "selected" : "")>@el.Name @(el.Extra1 == "1" ? "(Active)" : "")</option>
                                            }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 padding">
                                <label class="col-md-4 text-right">Class :</label>
                                <div class="col-md-8">
                                    <select class="form-control" name="ClassID" id="ddlClass">
                                        <option value="0">--Any Class--</option>
                                        @foreach (NameIDModel el in Model.Classes)
                                            {
                                        <option value="@el.ID" @(el.ID == Model.ClassID ? "selected" : "")>@el.Name</option>
                                            }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 padding">
                                <div class="row">
                                    <label class="col-md-3 text-right padding-R" style="padding-left: 10px;">From : </label>
                                    <div class="col-md-7 padding-L" style="padding-left: 10px;">
                                        <input type="date" name="StartDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 padding">
                                <div class="row">
                                    <label class="col-md-2 text-right padding-R" style="padding-left: 10px;">To : </label>
                                    <div class="col-md-7 padding-L" style="padding-left: 10px;">
                                        <input type="date" name="EndDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                                    </div>
                                    <div class="col-md-1 padding-L" style="padding-left: 10px;">
                                        <a href="javascript:void(0);" onclick="$('#frmGetEnquiries').submit();"><i class="fa fa-search"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                }
                <div class="x_panel">

                    <div class="x_content">

                        <table id="tblCategory" class="table table-bordered">
                            <thead>
                                <tr id="trHeader">
                                    <th style="width: 5%">#</th>
                                    <th style="width: 35%">Details</th>
                                    @*<th style="width: 10%">Source</th>*@
                                    <th style="width: 10%">Dates</th>
                                    <th style="width: 10%">Eq. Status</th>
                                    <th style="width: 10%">Prospect</th>
                                    <th style="width: 15%">Assign To</th>
                                    <th style="width: 5%">Followups</th>
                                    <th style="width: 10%"><a href="javascript:void(0);" onclick="AddEnquiry(this);" class="Closed">Add New</a></th>
                                    <th style="width: 15%">Convert</th>
                                </tr>
                            </thead>
                            @{
                                int count = 0;
                                foreach (AdmissionEnquiryMasterModel c in Model.Enquiries)
                                {
                                <tr>
                                    <td>
                                        <input type="hidden" id="hdnEnquiryUID" value="@c.EnquiryID" />
                                        <input type="hidden" id="hdnStudentName" value="@c.StudentName" />
                                        <input type="hidden" id="hdnAssigneName" value="@c.ReciptionistName" />
                                        <input type="hidden" id="hdnFatherName" value="@c.FatherName" />
                                        <input type="hidden" id="hdnFatherOcc" value="@c.FatherQuaAndOcc" />
                                        <input type="hidden" id="hdnMotherName" value="@c.MotherName" />
                                        <input type="hidden" id="hdnMotherOcc" value="@c.MotherQuaAndOcc" />
                                        <input type="hidden" id="hdnDOB" value="@c.StudentDOB.ToString("dd MMM, yyyy")" />
                                        <input type="hidden" id="hdnMobileNo" value="@c.TelephoneNoReg" />
                                        <input type="hidden" id="hdnSessionName" value="@c.SessionName" />
                                        <input type="hidden" id="hdnClassName" value="@c.ClassName" />
                                        <input type="hidden" id="hdnEnquiry" value="@c.Gender" />
                                        <input type="hidden" id="hdnAddress" value="@c.PermanentAddress" />
                                        <input type="hidden" id="hdnEnquiryDate" value="@c.EDate.ToString("dd MMM, yyyy")" />
                                        <input type="hidden" id="hdnNxtFollowupDate" value="@c.EDate.ToString("dd MMM, yyyy")" />
                                        <input type="hidden" id="hdnReligionID" value="@c.ReligionID" />
                                        <input type="hidden" id="hdnClassID" value="@c.AppliedForClass" />

                                        @(count + 1)
                                    </td>
                                    <td>
                                        <input type="hidden" id="hdnSrNo" value="@(count+1)" />
                                        <label class='badge bg-green'>Name: @c.StudentName</label>
                                        <label class='badge bg-green'>DOB: @c.StudentDOB.ToString("dd MMM, yyyy")</label>
                                        <label class='badge bg-green'>Class: @c.ClassName</label>
                                        <label class='badge bg-purple'>Father: @c.FatherName</label>
                                        <label class='badge bg-purple'>Mobile: @c.FatherMobileNo</label>
                                        <label class='badge bg-blue'>Session: @c.SessionName</label>
                                        <label class='badge bg-red'>Income: @c.FamilyIncome.ToString("00") Lakh</label>
                                        <input type="hidden" id="hdnData" value="@(Json.Encode(c))" />
                                    </td>
                                    @*<td>
                                            @if (c.ESource == 0)
                                            {
                                                <label class='badge bg-blue'>Search</label>
                                            }
                                            else if (c.ESource == 1)
                                            {
                                                <label class='badge bg-green'>Referance</label>
                                            }
                                            else
                                            {
                                                <label class='badge bg-red'>Ads</label>
                                            }
                                        </td>*@
                                    <td>
                                        Next Followup<br /> <label id="lblNextFollowDate" class='badge bg-red'>
                                            @c.NextFollowUpDate.ToString("dd MMM, yyyy")
                                        </label><br />
                                        Enq. Date<br /> <label class='badge bg-gray'>@c.EDate.ToString("dd MMM, yyyy")</label>
                                    </td>
                                    <td>
                                        @if (c.EStatus == 0)
                                            {
                                        <label class='badge bg-blue'>Open</label>
                                            }
                                            else if (c.EStatus == 1)
                                            {
                                        <label class='badge bg-green'>Converted</label>
                                            }
                                            else
                                            {
                                        <label class='badge bg-red'>Lost</label>
                                            }
                                    </td>
                                    <td>
                                        @if (c.EPossibility == 0)
                                            {
                                        <label class='badge bg-blue'>Neutral</label>
                                            }
                                            else if (c.EPossibility == 1)
                                            {
                                        <label class='badge bg-green'>Positive</label>
                                            }
                                            else
                                            {
                                        <label class='badge bg-red'>Negative</label>
                                            }
                                    </td>
                                    <td>
                                        <p>Assignee Name : <b>@c.ReciptionistName</b></p>
                                        <a href="javascript:void(0);" class="btn btn-link" onclick="AddAssignee(this,@c.EnquiryID);">Assign To</a>
                                    </td>
                                    <td>
                                        @c.Followups
                                    </td>
                                    <td>
                                        <a href="javascript:void(0);" class="btn btn-link Closed" onclick="ViewEnquiry(this,@c.EnquiryID);">View</a>
                                    </td>
                                    <td>
                                        @if (c.EStatus == 1)
                                            {
                                        <a href="javascript:void(0);" class="btn btn-link" onclick="">Converted</a>

                                            }
                                            else
                                            {
                                                using (Html.BeginForm("ConvertEnquiry", "Reception", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @class = "form-horizontal" }))
                                                {

                                        <input type="hidden" id="hdnEnquiryUID" name="EnquiryID" value="@c.EnquiryID" />
                                        <input type="hidden" id="hdnStudentName" name="StudentName" value="@c.StudentName" />
                                        <input type="hidden" id="hdnAssigneName" name="AssigneeName" value="@c.ReciptionistName" />
                                        <input type="hidden" id="hdnFatherName" name="FatherName" value="@c.FatherName" />
                                        <input type="hidden" id="hdnFatherOcc" name="FatherQuaAndOcc" value="@c.FatherQuaAndOcc" />
                                        <input type="hidden" id="hdnMotherName" name="MotherName" value="@c.MotherName" />
                                        <input type="hidden" id="hdnMotherOcc" name="MotherQuaAndOcc" value="@c.MotherQuaAndOcc" />
                                        <input type="hidden" id="hdnDOB" name="StudentDOB" value="@c.StudentDOB" />
                                        <input type="hidden" id="hdnMobileNo" name="TelephoneNoReg" value="@c.TelephoneNoReg" />
                                        <input type="hidden" id="hdnSessionName" name="SessionName" value="@c.AppliedForSession" />
                                        <input type="hidden" id="hdnClassName" name="ClassName" value="@c.ClassName" />
                                        <input type="hidden" id="hdnEnquiry" name="Gender" value="@c.Gender" />
                                        <input type="hidden" id="hdnAddress" name="PermanentAddress" value="@c.PermanentAddress" />
                                        <input type="hidden" id="hdnEnquiryDate" name="EDate" value="@c.EDate" />
                                        <input type="hidden" id="hdnNxtFollowupDate" name="NextFollowUpDate" value="@c.NextFollowUpDate" />
                                        <input type="hidden" id="hdnReligionID" name="ReligionID" value="@c.ReligionID" />
                                        <input type="hidden" id="hdnClassID" name="AppliedForClass" value="@c.AppliedForClass" />
                                        <input type="hidden" id="hdnClassID" name="FatherEmailID" value="@c.FatherEmailID" />
                                        <input type="hidden" id="hdnClassID" name="MotherEmailID" value="@c.MotherEmailID" />

                                        <button type="submit" onclick="return Convertenquiry(this);" class="btn btn-link">Convert</button>
                                                }
                                            }

                                    </td>
                                </tr>

                                    count++;
                                }

                            }
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="x_panel tblEqDetailswrapper" style="display:none;">

</div>
<input type="hidden" id="hdnCurrentDate" value="@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("yyyy-MM-dd")" />
<input type="hidden" id="hdnNext2DaysDate" value="@SMEnterprise.Repository.CommonUsage.GetCurrentDate().AddDays(2).ToString("yyyy-MM-dd")" />
@section PageBottom{
    <div class="modal fade bs-example-modal-sm" id="AssigneeTo" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                @using (Html.BeginForm("AddAssignee", "Reception", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmAddFollowup" }))
                {
                <div class="modal-body">
                    <input type="hidden" name="EnquiryID" id="hdnNewEnquiryID" value="" />
                    <div class="row">
                        <div class="col-md-12">
                            Assigned To : <b id="vReceptionist"></b>
                            <select class="form-control" id="ddlReceptionist" name="AssignedTo" onchange="$(this).closest('.enqDetails').find('#hdnFollowupBy').val($(this).val())">

                                <option value="0">--Select--</option>
                                @foreach (var Emp in Model.Receptionists)
                                    {
                                <option value="@Emp.ID">@Emp.Name</option>
                                    }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
                }
            </div>
        </div>
    </div>

