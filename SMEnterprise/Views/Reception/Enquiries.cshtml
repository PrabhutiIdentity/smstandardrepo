                        function SaveAdmissionEnquiry(sender)
                        {

                            var $this = $(sender).closest('#tdDetails').find('#frmSaveAdmissionEnquiry');
                            var form = $(sender).closest('#tdDetails').find('#frmSaveAdmissionEnquiry');
                            var formdata = true;
                            if (window.FormData) {
                                formdata = new FormData(form[0]);
                            }

                            event.preventDefault();
                            $.ajax({
                                type: $this.attr('method'),
                                url: $this.attr('action'),
                                data: formdata ? formdata : form.serialize(),
                                contentType: false,
                                processData: false,
                                method: 'POST'
                            })
                            .done(function (html) {
                                ShowNotification('Updated', 'Admission Enquiry Successfully Updated', 'success');
                                var $row = $(sender).closest('tr');
                                $row.prev().replaceWith(html);
                                $row.remove();
                                var $square = $('.square');

                                $square.css('opacity', '0');

                                $square.one("webkitTransitionEnd otransitionend oTransitionEnd msTransitionEnd transitionend", function() {
                                    $square.removeClass('square');

                                    $square.css('opacity', '1');
                                });
                            })
                            .fail(function () {
                                ShowNotification('Error', 'Admission Enquiry Not Updated', 'error');
                            });


                            return false;
                        }
