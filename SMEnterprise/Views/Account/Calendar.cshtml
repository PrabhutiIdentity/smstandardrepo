            background-color: #1ABB9C;
            height: 35px;
            vertical-align: middle !important;
            color: #fff;
        }

        .fc-today {
            background-color: rgba(74, 255, 31, 0.32);
        }

        .tool_box {
            background-color: #F3FBFD;
            /* border: 1px solid #006DBB; */
            border-radius: 4px;
            width: 350px;
            box-shadow: 0px 2px 10px 3px #ddd;
            font-family: 'Ubuntu', sans-serif;
        }

            .tool_box h4 {
                background-color: #0085E4;
                /* border: 1px solid #006DBB; */
                color: #fff;
                border-top: 0;
                margin: 0px;
                padding: 5px 10px;
                text-align: center;
            }

        .date-time-row {
            border-bottom: 1px solid #ddd;
        }

        .tool_box .content {
            /* color: #888; */
            text-align: justify;
            padding: 5px 10px;
        }

        .tool_box .date-time-row > h5:first-child {
            border-right: 1px solid #006DBB;
        }

        .tool_box .date-time-row > h5 {
            width: 48%;
            display: inline-block;
            color: #000246;
            text-align: center;
        }
    </style>
}
<div class="">

    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2>Calendar<small>School Events</small></h2>
                    <ul class="nav navbar-right panel_toolbox"></ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <div id='calendar'></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{

    <script src="@Url.Content("~/js/moment.min.js")"></script>
    <script src="@Url.Content("~/js/fullcalendar.min.js")"></script>


    <script>
        var EventModel;
        var Holidays;
        var arrHolidays = [];
        $(function () {
            EventModel = @Html.Raw(Json.Encode(Model.Events));
            Holidays = @Html.Raw(Json.Encode(Model.Holidays));
            LoadCalendar();
        });
        function LoadCalendar() {
            $('#calendar').fullCalendar({

                fixedWeekCount: false,
                height: 550,
                themeButtonIcons: false,
                theme: true,
                defaultDate: new Date(),
                selectable: false,
                selectHelper: false,

                dayRender: function (date, cell) {
                    var res = RenderDays(date, cell);


                },
                viewRender: function (view, element) {
                    var currentdate = new Date(view.intervalStart);
                    CalYear = currentdate.getFullYear();
                    CalMonth = currentdate.getMonth() + 1;
                },
                eventMouseover: function (calEvent, jsEvent) {
                    var ind = calEvent.backgroundColor.lastIndexOf(",");
                    var col = calEvent.backgroundColor.substr(0, ind);
                    // var d = new Date(calEvent.start);
                    dStartformat = moment(calEvent.start).format("MMM Do YY HH:mm");//[(d.getMonth() + 1).padLeft(), d.getDate().padLeft(), d.getFullYear()].join('/') + ' ' + [d.getHours().padLeft(), d.getMinutes().padLeft(), d.getSeconds().padLeft()].join(':');
                    //var d = new Date(calEvent.end);
                    dEndformat = moment(calEvent.end).format("MMM Do YY HH:mm");//[(d.getMonth() + 1).padLeft(), d.getDate().padLeft(), d.getFullYear()].join('/') + ' ' + [d.getHours().padLeft(), d.getMinutes().padLeft(), d.getSeconds().padLeft()].join(':');

                    var tooltip = '<div class="tool_box" style="position:absolute;z-index:10001; background-color:#fff' + '!important;border: 1px solid ' + col + ',1)' + ';"><h4 style="background-color:' + col + ',0.7)' + '!important;border: 1px solid ' + col + ',1)' + '">' + calEvent.title + '</h4><div class="row date-time-row" style="background-color:' + col + ',0.4)!important;margin-right: 0px; margin-left: 0px;"><h5>' + dStartformat + '</h5><h5>' + dEndformat + '</h5></div>' +
                        '<div class="content" style="background-color:' + col + ',0.4)!important;">'
                         + '<p>' + calEvent.description + '</p></div></div>';
                    $("body").append(tooltip);
                    $(this).mouseover(function (e) {
                        $(this).css('z-index', 10000);
                        $('.tool_box').fadeIn('500');
                        $('.tool_box').fadeTo('10', 1.9);
                    }).mousemove(function (e) {
                        $('.tool_box').css('top', e.pageY + 10);
                        $('.tool_box').css('left', e.pageX - 340);
                    });
                },

                eventMouseout: function (calEvent, jsEvent) {
                    $(this).css('z-index', 8);
                    $('.tool_box').remove();
                },

                editable: false,
                eventLimit: false, // allow "more" link when too many events
                events: function (start, end, timezone, callback) {
                    $.ajax(
                        {
                            type: "POST",
                            url: "/Account/GetEventCalender/" + CalMonth+"/"+CalYear,
                            cache: false,
                            processData: false,
                            contentType: false,
                            success: function (data) {
                                
                                Holidays=data.Holidays;
                                var events = [];
                                for (var i = 0; i < data.Events.length; i++) {
                                    events.push({
                                        title: data.Events[i].title,
                                        description: data.Events[i].Description,
                                        end: data.Events[i].end,
                                        start: data.Events[i].start,
                                        eventTypeID: data.Events[i].EventTypeID,
                                        ClassesIncludedIDs: data.Events[i].ClassesIncluded,
                                        ClassNames: data.Events[i].ClassNames,
                                        backgroundColor: data.Events[i].backgroundColor,
                                        textColor: data.Events[i].textColor,
                                        id: data.Events[i].EventID,
                                        IsApproved: data.Events[i].IsApproved
                                    });
                                }
                                callback(events);
                            },
                            error: function (e) {
                                alert("errorn");
                            }
                        });
                }
            });

        }
        function RenderDays(date, cell) {

            var arr = [];
            for (var hi = 0; hi < Holidays.length; hi++) {
                var startDate = new Date(Holidays[hi].StartDate.match(/\d+/)[0] * 1);
                var endDate = new Date(Holidays[hi].EndDate.match(/\d+/)[0] * 1);
                var curDate = Date.parse(date.format());
                var dDate = new Date(date);
                var hStartDate = Date.parse(new Date(startDate).toLocaleDateString());
                var hEndDate = Date.parse(new Date(endDate).toLocaleDateString()) + 86400000;
                //alert(startDate + " : " + curDate + " : " + hStartDate);
                if (curDate >= hStartDate && curDate < hEndDate) {
                    arr.push({
                        hTitle: Holidays[hi].Title,
                        hstart: moment(Holidays[hi].StartDate).format("MMM Do YY"),//startDate.getFullYear().padLeft() + '-' + (startDate.getMonth() + 1).padLeft() + '-' + startDate.getDate().padLeft(),
                        hend: moment(Holidays[hi].EndDate).format("MMM Do YY"),// endDate.getFullYear().padLeft() + '-' + (endDate.getMonth() + 1).padLeft() + '-' + endDate.getDate().padLeft(),
                        hType: Holidays[hi].HolidayTypeName,
                        hDescription: Holidays[hi].HolidayDescription,
                        hETypes:Holidays[hi].EmployeeTypes,
                        hClasses: Holidays[hi].ClassesIncluded// == 0 ? 'All Classes' : Holidays[hi].Classes
                    });
                    //if ($.inArray(date, holidays) >= 0) {


                    //}
                }
                else if(dDate.getDay()==0)
                {
                    cell.attr('style', 'background-color:rgba(247, 5, 27, 0.28) !important');
                    var cl = cell.attr('class').replace(" holiday", "").replace("fc-day", "fc-day-number");
                    var theads = document.getElementsByClassName(cl);
                    for (var e = 0; e < theads.length; e++) {

                        if (theads[e].getAttribute('data-date') == cell.attr('data-date')) {

                            theads[e].setAttribute('style', 'color:white !important;');
                        }
                    }
                }
            }
            if (arr.length > 0) {
                arrHolidays.push({ h: arr });

                // if you aren't using ui theme, just remove this line
                $(cell).removeClass('ui-widget-content');
                $(cell).addClass('holiday');

                cell.attr('onmouseover', 'javascript:DayMouseOver(' + (arrHolidays.length) + ');');
                cell.attr('onmouseout', 'javascript:DayMouseOut();');
                cell.attr('style', 'background-color:rgba(247, 5, 27, 0.28) !important');
                var cl = cell.attr('class').replace(" holiday", "").replace("fc-day", "fc-day-number");
                var theads = document.getElementsByClassName(cl);
                for (var e = 0; e < theads.length; e++) {

                    if (theads[e].getAttribute('data-date') == cell.attr('data-date')) {
                        theads[e].setAttribute('onmouseover', 'javascript:DayMouseOver(' + (arrHolidays.length) + ');');
                        theads[e].setAttribute('onmouseout', 'javascript:DayMouseOut();');
                        theads[e].setAttribute('style', 'color:white !important;');
                    }
                }
            }
            return 0;
        }
        function DayMouseOver(ind) {
            var arrH = arrHolidays[ind - 1].h;
            var ttD = '<div class="tool_box" style="position:absolute;z-index:10001; background-color:#fff!important;border: 1px solid rgba(243, 22, 42, 1);">';
            for (var hi = 0; hi < arrH.length; hi++) {
                
                ttD = ttD + ' <h4 style="background-color:rgba(243, 22, 42, 0.7);!important;border: 1px solid rgba(243, 22, 42, 1);' + '">' + arrH[hi].hTitle + '</h4><div class="row date-time-row" style="margin-right: 0px; margin-left: 0px;background-color:rgba(243, 22, 42, 0.4);!important;"><h5>' + arrH[hi].hstart + '</h5><h5>' + arrH[hi].hend + '</h5></div>' +
                    '<div class="row date-time-row" style="margin-right: 0px; margin-left: 0px;background-color:rgba(243, 22, 42, 0.4);!important;">' + arrH[hi].hClasses+' ,'+ arrH[hi].hETypes + '</div>' +
                    '<div class="row date-time-row" style="margin-right: 0px; margin-left: 0px;background-color:rgba(243, 22, 42, 0.4);!important;">' + arrH[hi].hType+ '</div>'+
                    '<div class="row date-time-row" style="margin-right: 0px; margin-left: 0px;background-color:rgba(243, 22, 42, 0.4);!important;">' + arrH[hi].hDescription + '</div>';
            }
            ttD = ttD + '</div>'
            tooltipDay = ttD;
            $("body").append(tooltipDay);
            $(this).mouseover(function (e) {
                $(this).css('z-index', 10000);
                $('.tool_box').fadeIn('500');
                $('.tool_box').fadeTo('10', 1.9);
            }).mousemove(function (e) {
                $('.tool_box').css('top', e.pageY + 10);
                $('.tool_box').css('left', e.pageX - 260);
            });
        }
        function DayMouseOut() {
            $('.tool_box').remove();
        }
    </script>

}