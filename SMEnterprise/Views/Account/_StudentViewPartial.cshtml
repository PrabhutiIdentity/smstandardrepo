    <br/>
    <div class="x_panel">
        <div class="x_title">
            <h2>Health Card</h2>
            <button type="button" class="btn btn-primary pull-right" onclick="Printpage(1);"><i class="fa fa-print"></i> Health Card</button>
            <div class="clearfix"></div>
        </div>
        <div class="x_content Healthcontainer">
            <table style="width: 100%;padding:2px;">
                <thead>
                    <tr>
                        <td style="text-align:center;width:20%;">
                            <img onerror="return OnImageError(this,2);" style="width:100px;height:100px;" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.SBranchDetails.SBranchID)_@(Model.SBranchDetails.Logo)" />
                        </td>
                        <td style="text-align:center;width:60%;">
                            <table style="width: 100%; padding: 0px;">
                                <tr>
                                    <td style="text-align: left;vertical-align: middle;">
                                        <p style="margin-top: 2px;margin-bottom: 2px;text-align: left;font-size: 20px;">@Model.SBranchDetails.BranchSchoolName</p>

                                        <p style="margin-bottom: 2px;margin-left:10px;font-size: 14px;">
                                            @Html.Raw(Html.Encode(Model.SBranchDetails.Address).Replace("\n", "<br />"))
                                            @*@Model.SBranchDetails.Address*@
                                        </p>
                                      
                                    </td>
                                </tr>
                            </table>
                           
                        </td>
                        <td style="text-align:center;width:20%;">
                            @if (Model.Student.Photo == null)
                            {

                            }
                            else
                            {
                                <img id="imgPhoto" onerror="return OnImageError(this,@(Model.Student.Gender));" style="width:100px;height:100px;" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(Model.Student.StudentID)_@Model.Student.Photo" />
                            }
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3" style="text-align:center">
                         
                            <b> HEALTH CARD</b>
                           
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3" style="text-align: center;font-size:16px;">
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <br /><br />
                            <p style="font-size: 15px;">
                                1.    Name of the student : @Model.Student.Name
                            </p>
                            <p style="font-size: 15px;">
