                            </p>
                            <p style="font-size: 15px;">
                                5.    Address: @Model.Student.MiniAddress
                            </p>
                            <p style="font-size: 15px;">
                                6.    Telephone No: @Model.ParantDetails.FatherMobileNo
                            </p>
                            <p>
                                <table style="width: 100%;padding:0px;">
                                    <tr>
                                        <td style="text-align:left;width:40%;">
                                            7.  Immunization Histroy
                                        </td>
                                        <td style="text-align:center;width:30%;">
                                            Yes
                                        </td>
                                        <td style="text-align:center;width:30%;">
                                            No
                                        </td>

                                    </tr>
                                    <tr>
                                        <td style="text-align: left; padding-left: 50px; width: 40%;">
                                            a).   B C G
                                        </td>
                                        <td style="text-align:center;width:30%;">
                                            <input type="checkbox" style=" width: 15px; height: 15px;">
                                        </td>
                                        <td style="text-align:center;width:30%;">
                                            <input type="checkbox" style=" width: 15px; height: 15px;">
                                        </td>

                                    </tr>
                                    <tr>
                                        <td style="text-align: left; padding-left: 50px; width: 40%;">
                                            b).   D P T
                                        </td>
                                        <td style="text-align:center;width:30%;">
