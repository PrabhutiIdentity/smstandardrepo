        @section scripts
        {
            <script>
                //$(function () {
                //    $("#tblCategory").DataTable();


                //});
                function editData(sender, type) {
                    if ($(sender).hasClass('fa-edit')) {
                        $('.view_' + type).css('display', 'none');
                        $('.edit_' + type).css('display', '');
                        $(sender).removeClass('fa-edit').addClass('fa-close');
                    }
                    else {
                        $('.view_' + type).css('display', '');
                        $('.edit_' + type).css('display', 'none');
                        $(sender).addClass('fa-edit').removeClass('fa-close');
                    }
                }
                function ClassChanged(sender) {
                    $('#ddlSection').html('<option value="0">Loading....</option>');
                    $.ajax(
                        {
                            type: "POST",
                            url: "/Account/GetSectionOnClass/" + $(sender).val(),
                            cache: false,
                            processData: false,
                            contentType: false,
                            success: function (html) {
                                $('#ddlSection').html('');
                                $('#ddlSection').html('<option value="0">--Select Section--</option>');
                                $('#ddlSection').append(html);
                            },
                            error: function (e) {
                                alert("errorn");
                            }
                        });
                }
            </script>


        }
