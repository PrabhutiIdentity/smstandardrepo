                                <option value="3" @(Model.PaymentMode == 3 ? "selected" : "")>Other Payment</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="ln_solid"></div>
                        <div class="col-md-12">
                            @if (Model.PaymentStatus != 1 && Model.PaymentStatus != 2)
                            {
                                <button type="submit" class="btn btn-success pull-right">Save</button>
                            }
                        </div>
                    </div>
                                                }
            </div>
        </div>
    </div>
</div>
