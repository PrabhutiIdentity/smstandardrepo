
<div class="x_content">
    <div class="row">
        @using (Html.BeginForm("SaveAdvancePayment", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @class = "form-horizontal form-label-left" }))
            {
            <div class="col-md-12">
                <label class="control-label col-md-12 col-sm-3 col-xs-12" style="text-align: center;font-size: 22px;padding-bottom: 8px;">Advance Payment Details</label>
            </div>
                <div class="form-group col-md-12">
                    <label class="control-label col-md-2 col-sm-3 col-xs-12">Employee : </label>
                    <div class="col-md-10 col-sm-10 col-xs-12 input-group">
                        <input type="hidden" name="EmployeeType" id="hdnEmployeeType" />
                        <select class="form-control select2_single" id="ddlEmployee" name="EmployeeID">
                            @foreach (SMEnterprise.Models.EmployeeModel q in Model.Employees)
                            {

                            <option EType="@q.EmployeeType" value="@q.EmployeeID">@q.EmployeeSID @q.EmployeeName </option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group col-md-12">
                    <label class="control-label col-md-2 col-sm-3 col-xs-12">Title : </label>
                    <div class="col-md-10 col-sm-9 col-xs-12 input-group">
                        <input type="text" class="form-control" required name="Title" />
                    </div>

                </div>
                <div class="form-group col-md-6">
                    <label class="control-label col-md-4">Amount : </label>
                    <div class="col-md-8 input-group">
                        <input id="txtAmount" required onchange="UpdateEMI();" type="number" class="form-control" name="Amount" />
                    </div>
                    <label class="control-label col-md-4 col-sm-3 col-xs-12">Date : <small>(mm/dd/yyyy)</small></label>
                    <div class="col-md-8 col-sm-9 col-xs-12 input-group">
                        <input type="text" required="" class="form-control has-feedback-left dateinput" id="txtDate" placeholder="Date" aria-describedby="inputSuccess2Status" value="@Model.Payment.PaymentDate.ToShortDateString()" name="PaymentDate" >
                        <span class="fa fa-calendar-o form-control-feedback left" aria-hidden="true"></span>
                        <span id="inputSuccess2Status" class="sr-only">(success)</span>
                    </div>
                </div>
                <div class="form-group col-md-6">
                    <label class="control-label col-md-4">Months : </label>
                    <div class="col-md-8 input-group">
                        <input id="txtMonths" required onchange="UpdateEMI();" type="number" class="form-control" name="Months" />
                    </div>
                    <label class="control-label col-md-4">EMI : </label>
                    <div class="col-md-8 input-group">
                        <input id="txtEMI" type="number" step="0.01" readonly class="form-control" name="EMI" />
                    </div>
                </div>
               
                <div class="form-group col-md-12">
                    <label class="control-label col-md-2 col-sm-3 col-xs-12">Description : </label>
                    <div class="col-md-10 col-sm-9 col-xs-12 input-group">
                        <textarea name="Description" required rows="4" class="form-control" style="resize:none" ></textarea>
                    </div>

                </div>
                <div class="col-md-12 pull-right">
                    <div class="col-md-9 col-sm-9 col-xs-12 col-md-offset-3">
                        <button type="submit" class="btn btn-success pull-right" onclick="return BeforePaymentSave();">Submit</button>
                        <button type="button" onclick="CancelPaymentEdit()" class="btn btn-primary pull-right">Cancel</button>
                    </div>
                </div>
                <script>
                    $('.dateinput').daterangepicker({
                        singleDatePicker: true,
                        calender_style: "picker_1"
                    }, function (start, end, label) {
                        console.log(start.toISOString(), end.toISOString(), label);
                    });
                    $(".select2_single").select2({
                        placeholder: "Select a Employee",
                        allowClear: true
                    });
                </script>
        }
    </div>
</div>