@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model SMEnterprise.Models.ClassGenderCategoryCountPageModel
@section IncludeCss
{
    <title>Class wise Student List based on Category and Gender</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">
}
<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }

    .MyBorder {
        border: dotted;
    }

    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("ClassCategoryGenderStudents", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
                {
                    <div class="row std-mng-head">

                        <div class="col-md-12 class-section">
                            <div class="row">

                                <div class="col-md-3 padding">
                                    <label class="col-md-4 text-right">Session :</label>
                                    <div class="col-md-8">
                                        <select class="form-control" name="SessionID" id="ddlSessions" onchange="$('#frmGetStudents').submit();">
                                            @foreach (var el in Model.Sessions)
                                            {
                                                <option value="@el.ID" @(el.ID == Model.SessionID ? "selected" : "")>@el.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                }
                <div class="x_panel">
                    <div class="x_content">
                        <div class="row">
                            <div class="col-md-12" style="text-align:right;">
                                <button type="button" class="btn btn-primary" id="btnprint" onclick="PrintDemantRecipt();"><i class="fa fa-print"></i> Print</button>
                            </div>
                        </div>
                        <div class="myTable" id="PrintDiv">
                            <p style="text-align:right">Print Date : @SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd/MM/yyyy")</p>
                            <table style="width:100%">
                                <tr style="width:100%">
                                    <td style="width:20%;text-align:left;">
                                        <img onerror="return OnImageError(this,2);" style="width:120px;height:120px;" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.Branch.SBranchID)_@(Model.Branch.Logo)" />
                                    </td>

                                    <td style="width:60%;text-align:center;">
                                        <table style="width:100%">
                                            <tr>
                                                <td style="text-align: left;vertical-align: middle;">
                                                    <p style="margin-top: 2px;margin-bottom: 5px;text-align: center;font-size: 26px;">@Model.Branch.BranchSchoolName</p>

                                                    <p style="margin-bottom: 2px;font-size: 16px;text-align: center;">
                                                        @Html.Raw(Html.Encode(Model.Branch.Address).Replace("\n", "<br />"))
                                                        @*@Model.SBranchDetails.Address*@
                                                    </p>
                                                    <p style="margin-bottom: 2px;text-align: center;"> <b>Ph.</b> @Model.Branch.ContactNo,  <b> Email :</b> @Model.Branch.EmailID</p>
                                                    <p style="margin-bottom: 2px;text-align: center;display:none;"> <b>Session Name:</b>  </p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="width:20%;text-align:right;">
                                        <img onerror="return OnImageError(this,2);" style="width:120px;height:120px;display:none;" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.Branch.SBranchID)_@(Model.Branch.Logo)" />
                                    </td>

                                </tr>

                            </table>
                            <h5 style="text-align:center">Class wise Student List based on Category and Gender</h5>

                            <table id="tblCategory" class="table table-bordered table-hover display nowrap" style="overflow-x: scroll;width: 100%;">
                                <thead>

                                    <tr style="width:100%;padding-bottom: 1px;">
                                        <td rowspan="2" style="text-align:center;padding-top: 27px;border:1px solid">
                                            Classes
                                        </td>
                                        @foreach (var cat in Model.Categories)
                                        {
                                            <td style="text-align:center;border:1px solid" colspan="3">
                                                @cat.Name
                                            </td>
                                        }
                                        <td style="text-align:center;border:1px solid" colspan="3">
                                            Not Defined Category
                                        </td>
                                        <td style="text-align:center;border:1px solid" colspan="3">
                                            All
                                        </td>
                                    </tr>
                                    <tr style="width:100%;padding-bottom: 1px;border:1px solid;text-align:center;">
                                        @foreach (var cat in Model.Categories)
                                        {
                                            <td style="border:1px solid">Boys</td>
                                            <td style="border:1px solid">Girls</td>
                                            <td style="border:1px solid">Total</td>
                                        }
                                        <td style="border:1px solid">Boys</td>
                                        <td style="border:1px solid">Girls</td>
                                        <td style="border:1px solid;">Total</td>
                                        <td style="border:1px solid">Boys</td>
                                        <td style="border:1px solid">Girls</td>
                                        <td style="border:1px solid;">Total</td>
                                    </tr>
                                </thead>
                                @{
                                    int count = 0;
                                    <tbody>
                                        @foreach (var c in Model.Classes)
                                        {
                                            <tr style="width: 100%; border: 1px solid;">
                                                <td style="border: 1px solid; text-align: center;">
                                                    @c.ClassName
                                                </td>

                                                @foreach (var cat in Model.Categories)
                                                {
                                                    <td style="border: 1px solid; text-align: center;">@Model.Data.Where(r => r.Gender == 0 && r.ClassID == c.ClassID && r.Category == cat.ID).Sum(it => it.Students)</td>
                                                    <td style="border: 1px solid; text-align: center;">@Model.Data.Where(r => r.Gender == 1 && r.ClassID == c.ClassID && r.Category == cat.ID).Sum(it => it.Students)</td>
                                                    <td style="border: 1px solid; text-align: center; font-weight: 900;">@Model.Data.Where(r => r.ClassID == c.ClassID && r.Category == cat.ID).Sum(it => it.Students)</td>
                                                }
                                                <td style="border: 1px solid; text-align: center;">@Model.Data.Where(r => r.Gender == 0 && r.ClassID == c.ClassID && r.Category == 0).Sum(it => it.Students)</td>
                                                <td style="border: 1px solid; text-align: center;">@Model.Data.Where(r => r.Gender == 1 && r.ClassID == c.ClassID && r.Category == 0).Sum(it => it.Students)</td>
                                                <td style="border: 1px solid; text-align: center; font-weight: 900;">@Model.Data.Where(r => r.ClassID == c.ClassID && r.Category == 0).Sum(it => it.Students)</td>

                                                <td style="border: 1px solid; text-align: center;">@Model.Data.Where(r => r.Gender == 0 && r.ClassID == c.ClassID).Sum(it => it.Students)</td>
                                                <td style="border: 1px solid; text-align: center;">@Model.Data.Where(r => r.Gender == 1 && r.ClassID == c.ClassID).Sum(it => it.Students)</td>
                                                <td style="border: 1px solid; text-align: center; font-weight: 900; ">@Model.Data.Where(r => r.ClassID == c.ClassID).Sum(it => it.Students)</td>


                                            </tr>

                                            count++;
                                        }

                                        <tr style="font-weight: 900;">

                                            <td style="border: 1px solid; text-align: center;">
                                                Total
                                            </td>
                                            @foreach (var cat in Model.Categories)
                                            {
                                                <td style="border: 1px solid; text-align: center;">@Model.Data.Where(r => r.Gender == 0 && r.Category == cat.ID).Sum(it => it.Students)</td>
                                                <td style="border: 1px solid; text-align: center;">@Model.Data.Where(r => r.Gender == 1 && r.Category == cat.ID).Sum(it => it.Students)</td>
                                                <td style="border: 1px solid; text-align: center;">@Model.Data.Where(r => r.Category == cat.ID).Sum(it => it.Students)</td>
                                            }
                                            <td style="border: 1px solid; text-align: center;">@Model.Data.Where(r => r.Gender == 0 && r.Category == 0).Sum(it => it.Students)</td>
                                            <td style="border: 1px solid; text-align: center;">@Model.Data.Where(r => r.Gender == 1 && r.Category == 0).Sum(it => it.Students)</td>
                                            <td style="border: 1px solid; text-align: center;">@Model.Data.Where(r => r.Category == 0).Sum(it => it.Students)</td>

                                            <td style="border: 1px solid; text-align: center;">
                                                @Model.Data.Where(r => r.Gender == 0).Sum(it => it.Students)
                                            </td>
                                            <td style="border: 1px solid; text-align: center;">
                                                @Model.Data.Where(r => r.Gender == 1).Sum(it => it.Students)
                                            </td>
                                            <td style="border: 1px solid; text-align: center;">
                                                @Model.Data.Where(r => r.Category >= 0).Sum(it => it.Students)
                                            </td>
                                        </tr>
                                    </tbody>
                                }


                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="@Url.Content("https://cdn.datatables.net/buttons/2.1.0/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("https://cdn.datatables.net/buttons/2.1.1/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("https://cdn.datatables.net/buttons/2.1.1/js/buttons.print.min.js")"></script>
    <script src="@Url.Content("https://cdnjs.cloudflare.com/ajax/libs/jszip/2.5.0/jszip.min.js")"></script>
    <script src="@Url.Content("https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/pdfmake.min.js")"></script>
    <script src="@Url.Content("https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/vfs_fonts.js")"></script>

    @*<script src="@Url.Content("~/js/dataTables.buttons.min.js")"></script>
        <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>

        <script src="@Url.Content("~/js/buttons.html5.min.js")"></script>
        <script src="@Url.Content("~/js/buttons.print.min.js")"></script>

        <script src="@Url.Content("~/js/jszip.min.js")"></script>
        <script src="@Url.Content("~/js/pdfmake.min.js")"></script>
        <script src="@Url.Content("~/js/vfs_fonts.js")"></script>*@
    <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>
    <script>
        $(document).ready(function () {
           // var repname = '@PermissionManager.GetLoggedInUser().Description' +'<br /> Student Records ' + $('#ddlSessions option:selected').text();
            var handleDataTableButtons = function () {
                  var printdate='Print Date: @SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd/MM/yyyy  hh:mm:ss tt")';
                var rpname = 'All Student Records based on Category and Gender' + 'Session ' + $('#ddlSessions option:selected').text() ;
            var repname = 'Report Generate on: ' + '@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd-MM-yyy hh:mm:ss tt")'

                if ($("#tblCategory").length) {
                    $("#tblCategory").DataTable({

                        "pageLength": 50,
                        bSort: false,
                        dom: "Bfrtip",
                        buttons: [
                            {
                                extend: "copy",
                                className: "btn-sm",
                                footer: true,
                                text: '<i class="fa fa- copy"></i> Copy',

                            message: printdate,
                             messageTop: '@Model.Branch.BranchSchoolName',
                            messageBottom: repname,
                            title: rpname
                            },
                            {
                                extend: "csv",
                                className: "btn-sm",
                                text: '<i class="fas fa-file-csv"></i> CSV',
                                 footer: true,
                          message: printdate,
                            messageTop: '@Model.Branch.BranchSchoolName',
                            messageBottom: repname,
                            title: rpname
                            },
                            {
                                extend: "excel",
                                className: "btn-sm",
                                text: '<i class="fa fa-table fainfo" aria-hidden="true"></i> Excel',
                                footer: true,
                         messageTop: rpname,
                          messageBottom: repname,
                          title: 'Model.Branch.BranchSchoolName'
                            },
                            {
                                extend: "pdfHtml5",
                                className: "btn-sm",
                                text: '<i class="fa fa-file-pdf-o"></i> Pdf',
                                footer: true,
                          orientation: 'landscape',
                          customize: function (doc) {

                              doc.defaultStyle.fontSize = 7;
                              doc.styles.tableHeader.fontSize = 10;

                              doc['header'] = (function () {
                                  return {
                                      columns: [
                                          {
                                              alignment: 'left',
                                              italics: true,
                                              text: '@Model.Branch.BranchSchoolName',
                                              fontSize: 14,
                                              margin: [0, 0]
                                          }
                                      ],
                                      margin: 20
                                  }
                              });
                          },
                          message: printdate,
                          messageBottom: repname,
                          title: rpname
                            },
                            {
                                extend: "print",
                                className: "btn-sm",
                                text: '<i class="fa fa-print"></i> Print',
                                footer: true,
                                orientation: 'landscape',
                          message: printdate,
                          messageTop: rpname,
                          messageBottom: repname,
                          title: '@Model.Branch.BranchSchoolName'
                            },
                        ],
                        responsive: true
                    });
                }
            };
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                };
            }();
            TableManageButtons.init();

        });
    </script>
    <script>
    function ClassChanged(sender) {
    $('#ddlSection').html('<option value="0">Loading....</option>');
    $.ajax(
    {
    type: "POST",
    url: "/Admin/GetSectionOnClass/" + $(sender).val(),
    cache: false,
    processData: false,
    contentType: false,
    success: function (html) {
    $('#ddlSection').html('');
    $('#ddlSection').html('<option value="0">--Select Section--</option>');
    $('#ddlSection').append(html);
    },
    error: function (e) {
    alert("errorn");
    }
    });
    }

    function PrintDemantRecipt() {
    var contents = $("#PrintDiv").html();
    var frame1 = $('<iframe />');
    frame1[0].name = "frame1";
    frame1.css({ "position": "absolute", "top": "-1000000px" });
    $("body").append(frame1);
    var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
    frameDoc.document.open();

    frameDoc.document.write('<html><head><title>Class wise Social Category Report</title>');
        frameDoc.document.write('<link href="@Url.Content("~/css/ReportCard.css")" rel="stylesheet" type="text/css" />');

        //Append the external CSS file.
        //Append the DIV contents.
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
            frameDoc.document.close();
            setTimeout(function () {
                window.frames["frame1"].focus();
                window.frames["frame1"].print();
                frame1.remove();
            }, 1000);
        }




    </script>

}
<!-- /.content -->
