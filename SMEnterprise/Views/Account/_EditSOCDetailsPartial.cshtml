@model SMEnterprise.Models.SOCertificateDetails

<div class="">
    <div class="row">
        @using (Html.BeginForm("UpdateSOCDetails", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @class = "form-horizontal form-label-left" }))
        {
            <input type="hidden" name="StudentID" value="@Model.StudentID" />
            <input type="hidden" name="SessionID" value="@Model.Session.SessionID" />
            <input type="hidden" name="CertType" value=0 />
            <input type="hidden" name="ID" value="@Model.ID" />
            <div class="form-horizontal form-label-left">
                <div class="">
                    <h2 class="col-md-12">Student Details</h2>
                    <div class="row">
                        <div class="col-md-4">
                            <label class="">School Sl. No.</label>
                            <input type="text" name="SchoolUID" disabled value="@Model.Student.SchoolUID" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="">Birth Date</label>
                            <input type="date" name="DOB" disabled value="@Model.Student.DOB.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="">Joining Date</label>
                            <input type="date" name="DOJ" disabled value="@Model.Student.DOJ.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                    </div>
                    <h2 class="col-md-12">Certificate Details</h2>
                    <div class="row">
                        <div class="col-md-3">
                            <label class="">Certificate Number</label>
                            <input type="text" name="CertID" value="@Model.CertID" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="">Certificate Generation Date</label>
                            <input type="date" name="CertDate" value="@Model.CertDate.ToString("yyyy-MM-dd")" required class="form-control" />

                        </div>
                        <div class="col-md-3">
                            <label class="">Character</label>
                            <input type="text" name="Character" value="@Model.Character" required class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="">Due Status</label>
                            <input type="text" name="DueStatus" value="@Model.DueStatus" required class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="">Birth Place</label>
                            <input type="text" name="BirthPlace" value="@Model.BirthPlace" required class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <input class="pf-button btn btn-primary pull-right" type="submit" onclick="return SaveSOCDetails(this)" name="submit" value="Save" />
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>
</div>
<script>

    function SaveSOCDetails(sender) {
        return confirm('Are you Sure you want to save the Details?');
    }
</script>