@using SMEnterprise.Models
@{
    ViewBag.Title = "All Students Admission Report";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@section IncludeCss
{
    <title>All Students Admission Report</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
}
@model SMEnterprise.Models.StudentAdmissionReportModel
<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    .thumbImage {
        max-width: 235px;
        max-height: 250px;
    }

    *html .thumbImage {
        width: expression((this.width/this.height)>=1?250:'auto');
        height: expression((this.width/this.height)<1?250:'auto');
    }
</style>

<section class="content-header">
    <h1>
        All Students Admission Report
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href=""><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">All Students Admission Report</li>
    </ol>
</section>

<section class="content">
    <!-- Small boxes (Stat box) -->
    @using (Html.BeginForm("SessionAdmissionReport", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
    {
        <div class="row">
            <div class="col-md-2 form-group">
                <label>Session</label>
            </div>
            <div class="col-md-3 form-group">
                <select class="form-control" id="ddlSessions" name="SessionID">
                    @foreach (var s in Model.Sessions)
                    {
                        <option value="@s.ID" @(s.ID == Model.SessionID ? "selected" : "")>@s.Name @(s.Extra1 == "1" ? "(Active)" : "")</option>
                    }
                </select>
            </div>
            @*<div class="col-md-3 form-group">
                    <label>Select Month:<small>(mm/yyyy)</small><span class="tx-danger">*</span></label>
                    <input type="month" name="StartDate" class="form-control" id="txtStartDate" placeholder="Enter Name" value="@Model.StartDate.ToString("yyyy-MM")" required>
                </div>*@
            @*<div class="col-md-3 form-group">
                    <label>Class</label>
                    <select class="form-control" name="ClassID" id="ddlClass" onchange="javascript:ClassChanged(this);">
                        @foreach (var s in Model.Classes)
                        {
                            <option value="@s.ID" @(s.ID == Model.ClassID ? "selected" : "")>@s.Name</option>
                        }
                    </select>
                </div>*@

            <div class="col-md-3 form-group">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </div>
    }
    <div class="row">
        <div class="col-xs-12">

            <div class="box-body">
                <table id="tblCategory" class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th style="width: 4%">Sl.</th>
                            <th style="width: 4%">SID</th>
                            <th style="width: 8%">Student Name</th>
                            <th style="width: 8%">Father Name</th>
                            <th style="width: 8%">Mother Name</th>
                            <th style="width: 6%">Class</th>
                            <th style="width: 8%">Section</th>
                            <th style="width: 8%">Admission Date</th>
                            <th style="width: 8%">Date of Birth</th>
                            <th style="width: 12%">Student Sessions</th>
                        </tr>
                    </thead>
                    @{
                        int count = 0;
                        foreach (var c in Model.StudentDetail)
                        {
                            <tr>
                                <td>@(count + 1)</td>
                                <td>
                                    @c.StudentSID
                                </td>
                                <td>
                                    @c.Name
                                </td>
                                <td>
                                    @c.FatherName
                                </td>

                                <td>
                                    @c.MotherName
                                </td>
                                <td>
                                    @c.ClassName
                                </td>
                                <td>@c.SectionName</td>
                                <td>@c.DOJ.ToString("dd/MM/yyyy")</td>
                                <td>@c.DOB.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @Html.Raw(Html.Encode(c.StudentSessions).Replace(",", "<br/>"))
                                </td>
                            </tr>

                            count++;
                        }

                    }
                </table>

            </div>
        </div>
    </div>

</section>
@section scripts
{
    <script src="@Url.Content("https://cdn.datatables.net/buttons/2.1.0/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("https://cdn.datatables.net/buttons/2.1.1/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("https://cdn.datatables.net/buttons/2.1.1/js/buttons.print.min.js")"></script>
    <script src="@Url.Content("https://cdnjs.cloudflare.com/ajax/libs/jszip/2.5.0/jszip.min.js")"></script>
    <script src="@Url.Content("https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/pdfmake.min.js")"></script>
    <script src="@Url.Content("https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/vfs_fonts.js")"></script>

    <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>
    <script>

        $(document).ready(function () {
            var handleDataTableButtons = function () {
                  var printdate='Print Date: @SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd/MM/yyyy  hh:mm:ss tt")';
                var rpname = 'All Student Session Report for ' + 'Session (' + $('#ddlSessions option:selected').text() +')';
                var repname = 'Report Generate on: ' + '@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd-MM-yyy hh:mm:ss tt")'

                if ($("#tblCategory").length) {
                    $("#tblCategory").DataTable({
                        bPaginate: false,
                        dom: "Bfrtip",
                        buttons: [
                            {
                                extend: "copy",
                                className: "btn-sm",
                                footer: true,
                                text: '<i class="fa fa- copy"></i> Copy',

                            message: printdate,
                             messageTop: '@Model.Branches.BranchSchoolName',
                            messageBottom: repname,
                            title: rpname
                            },
                            {
                                extend: "csv",
                                className: "btn-sm",
                                text: '<i class="fas fa-file-csv"></i> CSV',
                                 footer: true,
                          message: printdate,
                            messageTop: '@Model.Branches.BranchSchoolName',
                            messageBottom: repname,
                            title: rpname
                            },
                            {
                                extend: "excel",
                                className: "btn-sm",
                                text: '<i class="fa fa-table fainfo" aria-hidden="true"></i> Excel',
                                footer: true,
                         messageTop: rpname,
                          messageBottom: repname,
                          title: '@Model.Branches.BranchSchoolName'
                            },
                            {
                                extend: "pdfHtml5",
                                className: "btn-sm",
                                text: '<i class="fa fa-file-pdf-o"></i> Pdf',
                                footer: true,
                          orientation: 'landscape',
                          customize: function (doc) {

                              doc.defaultStyle.fontSize = 7;
                              doc.styles.tableHeader.fontSize = 10;

                              doc['header'] = (function () {
                                  return {
                                      columns: [
                                          {
                                              alignment: 'left',
                                              italics: true,
                                              text: '@Model.Branches.BranchSchoolName',
                                              fontSize: 14,
                                              margin: [0, 0]
                                          }
                                      ],
                                      margin: 20
                                  }
                              });
                          },
                          message: printdate,
                          messageBottom: repname,
                          title: rpname
                            },
                            {
                                extend: "print",
                                className: "btn-sm",
                                text: '<i class="fa fa-print"></i> Print',
                                footer: true,
                                orientation: 'landscape',
                                message: rpname,
                          //messageTop: rpname,
                          messageBottom: repname,
                          title: '@Model.Branches.BranchSchoolName'
                            },
                        ],
                        responsive: true
                    });
                }
            };

            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                };
            }();

            TableManageButtons.init();
        });
            //$(function () {
            //    $("#tblCategory").DataTable({
            //        "ordering": true
            //    });
            //});
    </script>
}