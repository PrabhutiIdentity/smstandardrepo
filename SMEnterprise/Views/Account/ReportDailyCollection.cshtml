@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model  SMEnterprise.Models.CollectionReportModel
@section IncludeCss
{
    <title>Daily Collection Report</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
}

<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Daily Collection Report
       
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Account/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Daily Collection Report</li>
    </ol>
</section>

<!-- Main content -->
<div class="" style="background-color: white;">
    <div class="row">
        <div class="col-md-12">
            @using (Html.BeginForm("ReportDailyCollection", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetExams" }))
            {
                <div class="row std-mng-head">

                    <div class="col-md-12 class-section">
                        <div class="row">

                            <div class="col-md-3 padding">

                            </div>
                            <div class="col-md-5 padding">
                                <label class="col-md-4 text-right">Payment Mode :</label>
                                <div class="col-md-8">
                                    <select class="form-control" ID="ddlMainSessions" name="PaymentMode">
                                        <option value="-1">--All Modes--</option>
                                        @foreach (PaymentModeModel e in Model.PaymentModes)
                                        {
                                            <option value="@e.PaymentModeID" @(e.PaymentModeID == Model.PaymentMode ? "Selected" : "")>@e.PaymentModeName </option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4 padding">
                                <div class="row">
                                    <label class="col-md-3 text-right padding-R">Date : </label>
                                    <div class="col-md-7 padding-L" style="padding-left: 10px;">

                                        <input type="date" class="form-control" name="FromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="ReportType" value="1" />
                                        <input type="hidden" name="PaymentMode" value="-1" />

                                    </div>
                                    <div class="col-md-2">
                                        <a onclick="$('#frmGetExams').submit();" ID="lbGetList"><i class="fa fa-search"></i></a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            }
        </div>
    </div>
    <div class="x_panel">

        <div class="x_content">


            <table id="PaymentsTable" class="table table-bordered" style="width: 100%;display: inline-block;">
                <thead>
                    <tr>
                        <th>Payee</th>
                        <th>Class</th>
                        <th>Session</th>
                        <th>Details</th>
                        <th>Date</th>
                        <th>Collected By</th>
                        <th>Amount</th>
                        @*<th style="width:15%">Delete</th>*@

                    </tr>
                    </thead>
                    @{
                        int count = 0;
                        decimal TotalPayment = 0;
                        foreach (FeePaymentModel c in Model.Report)
                        {
                            var PayMode = "";
                            TotalPayment = TotalPayment + c.PaymentAmount;
                            <tr>

                                <td style="width:15%">
                                    @c.Name
                                </td>
                                <td style="width:15%">

                                    @c.ClassName / @c.SectionName
                                </td>
                                <td>
                                    @c.SessionName
                                </td>
                                <td style="width:25%">
                                    @if (c.PaymentMode == 0)
                                    {
                                        PayMode = "Cash Payment";
                                    }
                                    else if (c.PaymentMode == 1)
                                    {
                                        PayMode = "Cheque Payment";
                                    }
                                    else if (c.PaymentMode == 2)
                                    {
                                        PayMode = "NEFT Payment";
                                    }
                                    else if (c.PaymentMode == 2)
                                    {
                                        PayMode = "Other Payment";
                                    }
                                    @PayMode<br />
                                    @c.PayMonths
                                </td>
                                <td style="width:15%">
                                    @c.PaymentDate.ToString("dd MMM, yyyy")
                                </td>
                                <td style="width:15%">
                                    @c.CollectedBy
                                </td>
                                <td style="width:15%">
                                    <i class="fa fa-inr" aria-hidden="true"></i> @c.PaymentAmount.ToString("N2")
                                </td>
                                @*<td>
                                        @using (Html.BeginForm("DeletePayment", "Admin", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "UpdatePassword", @class = "form-horizontal" }))
                                        {
                                            <input type="hidden" name="PaymentID" value="@c.PaymentID" />
                                            <input type="hidden" name="PaymentMode" value="@c.PaymentMode" />
                                            <input type="hidden" name="PaymentDate" value="@c.PaymentDate.ToString("yyyy-MM-dd")" />
                                            <button type="submit" style="display:none;" value="Delete" class="btn btn-danger" onclick="return DeletePayment(this);">Delete</button>
                                        }
                                    </td>*@
                            </tr>

                            count++;
                        }

                    }
                    <tfoot>
                        <tr style="background-color: #606d73;color: white;">
                            <td colspan="6">
                                <b> Total Collection</b>
                            </td>
                            <td><b> <i class="fa fa-inr" aria-hidden="true"></i> @TotalPayment.ToString("N2")</b></td>
                        </tr>
                    </tfoot>
            </table>

        </div>
    </div>
</div>



@section scripts
{
   
    <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.print.min.js")"></script>
    <script src="@Url.Content("~/js/jszip.min.js")"></script>
    <script src="@Url.Content("~/js/pdfmake.min.js")"></script>
    <script src="@Url.Content("~/js/vfs_fonts.js")"></script>
    <script>

        $(document).ready(function () {
        var repname = 'Daily Fee Collection Report  @Model.Branch.BranchSchoolName as on Date: @SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd-MM-yyy")'
        var handleDataTableButtons = function () {
            if ($("#PaymentsTable").length) {
                $("#PaymentsTable").DataTable({
                    dom: "Bfrtip",
                    "paging": true,
                    "pageLength": 31,
                    buttons: [
                      {
                          extend: "copy",
                            className: "btn-sm",
                            footer: true,
                            title: function () {
                                return "<div style='font-size: 16px;'>" + repname + "</div>"
                            }
                      },
                      {
                          extend: "csv",
                          className: "btn-sm",
                          footer: true,
                          title: function () {
                              return "<div style='font-size: 16px;'>" + repname + "</div>"
                          }
                      },
                      {
                          extend: "excel",
                          className: "btn-sm",
                          footer: true,
                          title: function () {
                              return "<div style='font-size: 16px;'>" + repname + "</div>"
                          }
                      },
                      {
                          extend: "pdfHtml5",
                          className: "btn-sm",
                          footer: true,
                          title: function () {
                              return "<div style='font-size: 16px;'>" + repname + "</div>"
                          }
                      },
                      {
                          extend: "print",
                          className: "btn-sm",
                          footer: true,
                          title: function () {
                              return "<div style='font-size: 16px;'>" + repname + "</div>"
                          }
                      },
                    ],
                    responsive: true
                });
            }
        };

        TableManageButtons = function () {
            "use strict";
            return {
                init: function () {
                    handleDataTableButtons();
                }
            };
        }();

        TableManageButtons.init();
    });
    $(function () {
        $('#liReportDailyCollection').closest('ul').closest('li').addClass('active');
        $('#liReportDailyCollection').addClass('active');

    });
    </script>
}
<!-- /.content -->