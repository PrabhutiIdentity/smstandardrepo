
@{
    ViewBag.Title = "BulUploadInfo";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}


@model SMEnterprise.Models.BulkUploadInfoModel


<div class="">
    <div class="row">
        <div class="col-md-12">
            <div class="box-header">
                <div class="col-md-12">
                    <h6>Bulk Upload Related Info.</h6>
                </div>
                </div>

                <div class="x_panel">
                    <div class="x_content">

                        <div class="row">
                            <div class="col-md-6">
                                <p><span><b>CATEGORY DETAIL INFO</b></span></p>
                                <table id="tblCategory" class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th style="width: 15%">Name</th>
                                            <th style="width: 15%">ID</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int count = 1;
                                            foreach (var nam in Model.Categroy)
                                            {
                                                <tr>
                                                    <td>@nam.Name</td>
                                                    <td>@nam.ID</td>
                                                </tr>
                                                count++;
                                            }
                                        }
                                    </tbody>
                                </table>
                                <span>Add Category> Go to> Principal Login> Master SetUp> Social Category</span>
                            </div>
                            <div class="col-md-6">
                                <p><span><b>RELIGION DETAIL INFO</b></span></p>
                                <table id="tblCategory" class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th style="width: 15%">Name</th>
                                            <th style="width: 15%">ID</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int count1 = 1;
                                            foreach (var nam in Model.Religion)
                                            {
                                                <tr>
                                                    <td>@nam.Name</td>
                                                    <td>@nam.ID</td>
                                                </tr>
                                                count1++;
                                            }
                                        }
                                    </tbody>
                                </table>
                                <span>Add Religion> Go to> Principal Login> Master SetUp> Religion</span>
                            </div>
                        </div>

                        <br /><br /><br />
                        <div class="row">
                            <div class="col-md-6">
                                <p><span><b>QUOTA DETAIL INFO</b></span></p>
                                <table id="tblCategory" class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th style="width: 15%">Name</th>
                                            <th style="width: 15%">ID</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int count2 = 1;
                                            foreach (var nam in Model.Quota)
                                            {
                                                <tr>
                                                    <td>@nam.Name</td>
                                                    <td>@nam.ID</td>
                                                </tr>
                                                count2++;
                                            }
                                        }
                                    </tbody>
                                </table>
                                <span>Add Quota> Go to> Principal Login> Account Setting> Admission Quota</span>
                            </div>
                            <div class="col-md-6">
                                <p><span><b>GENDER DETAIL INFO</b></span></p>
                                <table id="tblCategory" class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th style="width: 15%">Name</th>
                                            <th style="width: 15%">ID</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <tr>
                                            <td>MALE</td>
                                            <td>0</td>
                                        </tr>
                                        <tr>
                                            <td>FEMALE</td>
                                            <td>1</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</div>