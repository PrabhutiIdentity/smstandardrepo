<table id="tblCategory" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th width="15%">Date</th>
            <th width="15%">Amount</th>
            <th width="55%">Remark</th>
            <th width="15%">Add</th>
        </tr>
    </thead>
    <tbody>
        @{
            foreach (SMEnterprise.Models.EmployeeAdvancePaymentDeductionModel c in Model.Deductions)
            {
                <tr>
                    <td>@c.Date.ToString("dd MMM, yyyy")</td>

                    <td>@c.Amount</td>
                    <td>@c.Remark</td>
                    
                    <td>
                       
                    </td>
                </tr>
            }
            <tr>
                <td>
                    <input type="hidden" id="hdnAdPaymentID" value="@Model.AdPaymentID" />
                    <input type="date" value="@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("yyyy-MM-dd")" class="form-control" id="txtDate" />
                </td>

                <td><input type="number" step="0.01" class="form-control" id="txtAmount" /></td>
                <td><input type="text" class="form-control" id="txtRemark" /></td>

                <td>
                    <a href="javascript:void(0);" id="0" class="btn btn-info" onclick="UpdateAdvancePayment(this);">Add</a>


                </td>
            </tr>
        }
    </tbody>

</table>

