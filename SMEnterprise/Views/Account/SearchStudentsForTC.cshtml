@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model SMEnterprise.Models.StudentSearchListModel
@section IncludeCss
{
    <title>Search Students For TC</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">
}
<style>
    .modal-lg {
        width: 95% !important;
    }

    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">

            <div class="col-md-12">
                @using (Html.BeginForm("SearchStudentsForTC", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
                {
                    <div class="row std-mng-head">

                        <div class="col-md-12 class-section">
                            <div class="row">

                                <div class="col-md-4 padding">
                                    <label class="col-md-4 text-right">Session :</label>
                                    <div class="col-md-8">
                                        <select class="form-control" name="SessionID" id="ddlSessions" onchange="$('#frmGetStudents').submit();">
                                            @foreach (NameIDModel el in Model.Sessions)
                                            {
                                                <option value="@el.ID" @(el.ID == Model.SessionID ? "selected" : "")>@el.Name @(el.Extra1 == "1" ? "(Active)" : "")</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <!--<div class="col-md-3 padding">
                                <label class="col-md-4 text-right">TC Type :</label>
                                <div class="col-md-8">
                                    <select class="form-control" name="TCType" id="ddlSessions" onchange="$('#frmGetStudents').submit();">

                                        <option value="0">New TC Format </option>-->
                                @*<option value="1">Old TC Format </option>*@

                                <!--</select>
                                    </div>
                                </div>-->
                                <div class="col-md-2">
                                    <span style="color:white;">Search Student</span>
                                </div>
                                <div class="col-md-4 padding">
                                    <input type="text" name="SearchText" class="form-control" placeholder="Search by StudentID/Student Name/Roll/SRNo/FamilyID/Aadhar No/Father Name" value="@Model.SearchText" />
                                </div>
                                <div class="col-md-2 padding-L" style="padding-left: 10px;">
                                    <a href="javascript:void(0);" onclick="$('#frmGetStudents').submit();"><i class="fa fa-search"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <div class="x_panel">

                    <div class="x_content">

                        <table id="tblCategory" class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th style="width: 9%">Photo</th>
                                    <th style="width: 18%">Student Details</th>
                                    <th style="width: 18%">Parent's </th>
                                    <th style="width: 11%">DOB</th>
                                    @*<th style="width: 10%">Aadhar Number</th>*@
                                    <th style="width: 10%">Contact</th>
                                    <th style="width: 8%">Class/Section</th>
                                    <th style="width: 13%">Address</th>
                                    <th style="width: 5%">Option</th>
                                    <th style="width: 8%">Certificates</th>
                                </tr>
                            </thead>
                            @{
                                int count = 0;
                                foreach (StudentSearchModel c in Model.Students)
                                {
                                    <tr>
                                        <td>
                                            <img id="imgPhoto" onerror="return OnImageError(this,@(c.Gender));" class="thumbImageGrid" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(c.StudentID)_@c.Photo" />
                                        </td>
                                        <td>
                                            Name : @c.Name <br />
                                            SID : @c.StudentSID  <br />
                                            SR. No. :@c.SchoolUID<br />

                                            SSSID :@c.SSSID
                                        </td>

                                        <td>
                                            F Name: @c.FatherName<br />
                                            M Name: @c.MotherName<br />
                                            G Name: @c.GuardianName <br />
                                            Family ID: @c.FamilyID
                                        </td>
                                        @*<td>@c.BloodGroup</td>*@
                                        <td>@c.DOB.ToString("dd MMM, yyyy")</td>
                                        @*<td>
                                                @c.AadharCardNo
                                            </td>*@
                                        <td>
                                            F :  @c.FatherMobileNo<br />
                                            M :  @c.MotherMobileNo <br />
                                            G :  @c.GuardianMobileNo
                                        </td>
                                        <td>
                                            @c.ClassName / @c.SectionName
                                        </td>
                                        <td>
                                            @c.MiniAddress
                                        </td>


                                        <td>
                                            @using (Html.BeginForm("GenerateTC", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "UpdatePassword", @class = "form-horizontal" }))
                                            {
                                                <input type="hidden" name="SessionID" value="@Model.SessionID" />
                                                <input type="hidden" name="StudentID" value="@c.StudentID" />

                                                if (c.TCGenerated == 0)
                                                {
                                                    <button type="submit" onclick="return GenerateTC(this);" class="btn btn-link">Generate TC</button>
                                                }
                                                else
                                                {
                                                    <button type="submit" onclick="return GenerateTC(this);" class="btn btn-link">Edit</button>
                                                    <a href="/Account/ViewTCForStudent/@Model.SessionID/@c.StudentID" target="_blank" class="btn btn-link">View</a>
                                                }
                                            }
                                        </td>
                                        <td>
                                            @if (c.SLCGenerated == 0)
                                            {
                                                <a href="javascript:void(0);" onclick="OpenSLCDetails(this,@c.StudentID,@Model.SessionID)" class="btn btn-link">Generate</a>
                                            }
                                            else
                                            {
                                                <a href="javascript:void(0);" onclick="OpenSLCDetails(this,@c.StudentID,@Model.SessionID)" class="btn btn-link">Edit</a>
                                                <a href="/Account/ViewStudentSLC/@c.StudentID/@Model.SessionID" target="_blank" class="btn btn-link">View</a>
                                            }
                                        </td>

                                        <td>
                                            @if (c.CSGenerated == 0)
                                            {
                                                <a href="javascript:void(0);" onclick="OtherCertificateDetails(this,@c.StudentID,@Model.SessionID)" class="btn btn-link">Generate</a>
                                            }
                                            else
                                            {
                                                <a href="javascript:void(0);" onclick="OtherCertificateDetails(this,@c.StudentID,@Model.SessionID)" class="btn btn-link">Edit</a>
                                                <a href="/Account/Certificates/@c.StudentID/@Model.SessionID" target="_blank" class="btn btn-link">View</a>
                                            }
                                        </td>
                                    </tr>

                                    count++;
                                }

                            }
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="mdlEditSLCDetails" class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Generate Student Certificates</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

            </div>
        </div>
    </div>
</div>
@section scripts
{

    <script>
        function OpenSLCDetails(sender, StudentID, SessionID) {
            $('.se-pre-con').css('display', '');
            $.ajax(
                {
                    type: "POST",
                    url: "/Account/GetStudentSLCDetails/" + StudentID + "/" + SessionID,
                    cache: false,
                    processData: false,
                    contentType: false,
                    success: function (html) {
                        $('#mdlEditSLCDetails').find('.modal-body').html(html);
                        $('#mdlEditSLCDetails').modal('toggle');

                        $('.se-pre-con').css('display', 'none');
                    },
                    error: function (e) {
                        alert("errorn");
                    }
                });
        }
        function OtherCertificateDetails(sender, StudentID, SessionID) {
            $('.se-pre-con').css('display', '');
            $.ajax(
                {
                    type: "POST",
                    url: "/Account/GetStudentOCDetails/" + StudentID + "/" + SessionID,
                    cache: false,
                    processData: false,
                    contentType: false,
                    success: function (html) {
                        $('#mdlEditSLCDetails').find('.modal-body').html(html);
                        $('#mdlEditSLCDetails').modal('toggle');

                        $('.se-pre-con').css('display', 'none');
                    },
                    error: function (e) {
                        alert("errorn");
                    }
                });
        }
        $(function () {
            $("#tblCategory").DataTable();
        });
        function DeleteStudent(sender) {
            return confirm('Do you really want to delete Student!!!!');
        }
        function ClassChanged(sender) {
            $('#ddlSection').html('<option value="0">Loading....</option>');
            $.ajax(
                {
                    type: "POST",
                    url: "/Admin/GetSectionOnClass/" + $(sender).val(),
                    cache: false,
                    processData: false,
                    contentType: false,
                    success: function (html) {
                        $('#ddlSection').html('');
                        $('#ddlSection').html('<option value="0">--Select Section--</option>');
                        $('#ddlSection').append(html);
                    },
                    error: function (e) {
                        alert("errorn");
                    }
                });
        }
    </script>
}
<!-- /.content -->
