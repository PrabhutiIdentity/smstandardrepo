﻿@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    List<NameIDModel> SubjectEvaluationFinalStatus = new List<NameIDModel>();

    var watermarkUrl = Url.Content("~/Images/SBranchLogo/")
        + Model.SBranchDetails.SBranchID + "_"
        + Model.SBranchDetails.Logo;

    // ── Rank helper functions (declared once here, used inside foreach) ──
    Func<int, string>
    GetRankColor = (r) =>
    r == 1 ? "#b7950b" :
    r == 2 ? "#626567" :
    r == 3 ? "#935116" : "#2c3e50";

    Func<int, string>
        GetRankDisplay = (r) =>
        r == 1 ? "1st" :
        r == 2 ? "2nd" :
        r == 3 ? "3rd" : r + "th";

    bool rankAlt = false;  // alternating row color for rank table
}

@model SMEnterprise.Models.PerformanceParameterDetailModel
@section IncludeCss
{
    <title>Performance Card | @Model.Student.Name</title>
    <!-- Bootstrap CSS -->
   
    <style>
        :root {
            --primary-color: #1a237e;
            --secondary-color: #3949ab;
            --accent-color: #5c6bc0;
            --success-color: #43a047;
            --warning-color: #fb8c00;
            --danger-color: #e53935;
            --light-color: #f5f5f5;
            --dark-color: #263238;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f0f2f5;
            color: var(--dark-color);
            padding: 20px;
            margin: 0;
        }

        .report-container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .school-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
            padding: 30px;
            text-align: center;
            position: relative;
        }

            .school-header::before {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #ffd700, #ffed4e, #ffd700);
            }

        .school-name {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 5px;
            letter-spacing: 1px;
        }

        .school-subtitle {
            font-size: 16px;
            opacity: 0.9;
            margin-bottom: 15px;
        }

        .school-details {
            font-size: 14px;
            opacity: 0.8;
            line-height: 1.6;
        }

        .report-title {
            background: var(--light-color);
            padding: 20px;
            text-align: center;
            border-bottom: 2px solid #e0e0e0;
        }

            .report-title h2 {
                color: var(--primary-color);
                font-size: 24px;
                font-weight: 600;
                margin: 0;
            }

        .student-info {
            padding: 25px;
            background: #fafafa;
            border-bottom: 1px solid #e0e0e0;
        }

        .info-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 15px;
        }

        .info-item {
            flex: 1;
            min-width: 200px;
        }

        .info-label {
            font-size: 13px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 5px;
        }

        .info-value {
            font-size: 16px;
            font-weight: 600;
            color: var(--dark-color);
        }

        .results-section {
            padding: 30px;
        }

        .section-header {
            display: flex;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--accent-color);
        }

            .section-header i {
                font-size: 20px;
                color: var(--primary-color);
                margin-right: 10px;
            }

            .section-header h3 {
                margin: 0;
                color: var(--primary-color);
                font-size: 20px;
                font-weight: 600;
            }

        .results-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
            background: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            border-radius: 8px;
            overflow: hidden;
        }

            .results-table th {
                background: var(--primary-color);
                color: white;
                padding: 12px 8px;
                text-align: center;
                font-weight: 600;
                font-size: 13px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                vertical-align: middle;
            }

            .results-table td {
                padding: 12px 8px;
                border-bottom: 1px solid #f0f0f0;
                font-size: 14px;
                text-align: center;
                vertical-align: middle;
            }

            .results-table tr:last-child td {
                border-bottom: none;
            }

            .results-table tr:hover {
                background: #f8f9fa;
            }

        .subject-name {
            font-weight: 600;
            color: var(--dark-color);
            text-align: left !important;
        }

        .term-header {
            background: var(--accent-color) !important;
            color: white !important;
            font-weight: 700 !important;
        }

        .term-subheader {
            background: rgba(92, 107, 192, 0.2) !important;
            color: var(--primary-color) !important;
            font-weight: 600 !important;
        }

        .grade-badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 15px;
            font-weight: 700;
            font-size: 12px;
            text-align: center;
            min-width: 30px;
        }

        .grade-a {
            background-color: #c8e6c9;
            color: #2e7d32;
        }

        .grade-b {
            background-color: #bbdefb;
            color: #1565c0;
        }

        .grade-c {
            background-color: #fff9c4;
            color: #f57f17;
        }

        .grade-d {
            background-color: #ffcdd2;
            color: #c62828;
        }

        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }

        .summary-card {
            background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            border: 1px solid #e0e0e0;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .summary-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.1);
            }

        .summary-value {
            font-size: 32px;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 5px;
        }

        .summary-label {
            font-size: 14px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .attendance-section {
            background: #f8f9fa;
            padding: 25px;
            margin: 30px 0;
            border-radius: 10px;
        }

        .attendance-bar {
            height: 30px;
            background: #e0e0e0;
            border-radius: 15px;
            overflow: hidden;
            margin: 15px 0;
            position: relative;
        }

        .attendance-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--success-color) 0%, #66bb6a 100%);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            transition: width 1.5s ease;
        }

        .remarks-section {
            background: #fff8e1;
            padding: 25px;
            border-radius: 10px;
            border-left: 4px solid var(--warning-color);
            margin: 30px 0;
        }

        .remarks-content {
            font-style: italic;
            line-height: 1.8;
            color: #5d4037;
            font-size: 15px;
        }

        .grading-scale-section {
            background: #f5f5f5;
            padding: 30px;
            margin: 30px 0;
            border-radius: 10px;
            border: 1px solid #e0e0e0;
        }

        .grading-scale-container {
            display: flex;
            gap: 30px;
            flex-wrap: wrap;
        }

        .grading-scale-box {
            flex: 1;
            min-width: 300px;
            background: white;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .grading-scale-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--accent-color);
            display: flex;
            align-items: center;
        }

            .grading-scale-title i {
                margin-right: 10px;
            }

        .grading-scale-table {
            width: 100%;
            border-collapse: collapse;
        }

            .grading-scale-table th,
            .grading-scale-table td {
                padding: 10px;
                text-align: left;
                border-bottom: 1px solid #f0f0f0;
            }

            .grading-scale-table th {
                font-weight: 600;
                color: var(--primary-color);
                background: #f8f9fa;
            }

        .grade-scale-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 15px;
            font-weight: 700;
            font-size: 12px;
            text-align: center;
            min-width: 35px;
        }

        .signature-area {
            display: flex;
            justify-content: space-between;
            padding: 30px;
            border-top: 1px solid #e0e0e0;
            margin-top: 30px;
        }

        .signature-box {
            text-align: center;
            flex: 1;
        }

        .signature-line {
            width: 180px;
            height: 2px;
            background: #bdbdbd;
            margin: 15px auto;
        }

        .signature-title {
            font-size: 14px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .signature-name {
            font-size: 13px;
            color: #999;
            margin-top: 5px;
        }

        .footer-note {
            text-align: center;
            padding: 20px;
            background: #f5f5f5;
            color: #666;
            font-size: 13px;
            border-top: 1px solid #e0e0e0;
        }

        .print-button {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: var(--primary-color);
            color: white;
            border: none;
            padding: 15px 25px;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            transition: all 0.3s;
            z-index: 1000;
        }

            .print-button:hover {
                background: var(--secondary-color);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.3);
            }

        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .report-container {
                box-shadow: none;
                max-width: none;
            }

            .print-button {
                display: none;
            }

            .results-table {
                page-break-inside: avoid;
            }
        }
    </style>
    <style>
        #tblResult > tbody > tr > td {
            text-align: center !important;
            vertical-align: middle !important;
        }

        .table > tbody > tr > td {
            padding-bottom: 1px;
            padding-top: 2px;
        }

        .print {
            display: none;
        }

        .reportSign {
            max-width: 200px;
            max-height: 90px;
        }

      .watermark-container {
    position: relative;
    height: auto; /* Let it auto size based on content */
    min-height: 400px; /* You may set this depending on the expected content */

}

.watermark-content {
    position: relative;
    z-index: 2; /* Layer above the watermark */
    text-align: center; /* Center the content, if needed */
}

.watermark-container::before {
   content: "";
    background-image: url('@Url.Content("~/Images/pschool-logo.png")'); /* Your watermark image */
    background-repeat: no-repeat;
    background-size: contain; /* Fit the image */
    position: absolute; /* Position absolutely to control placement */
    /* Change these values to position it as needed */
    top: 30%; /* Adjust to move down or up */
    left: 20%; /* Adjust to move left or right */
    width: 60%; /* Control width for the watermark */
    height: 60%; /* Control height for the watermark */
    z-index: 1; /* Ensure it's behind the content */
    opacity: 0.3; /* Adjust transparency */
    /* Optionally, add a rotation for aesthetics */
    transform: rotate(-30deg); /* Rotate as needed */
}

    </style>
}
<div class="">

    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                @using (Html.BeginForm("UpdateStudentPerformance", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                {
                    <div class="watermark-container">
                        <div class="watermark-content">

                            <div class="x_content">
                                <div class="print-watermark"
                                     style="background-image:url('@watermarkUrl')">
                                </div>
                                <table class="table" style="border-bottom: 1px solid #ddd;padding-bottom: 0px;">
                                    <tr style="width:100%">
                                        <td style="width:20%;text-align:left;">
                                            <img onerror="return OnImageError(this,2);" style="width:120px;height:120px;" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.SBranchDetails.SBranchID)_@(Model.SBranchDetails.Logo)" />
                                        </td>

                                        <td style="width:60%;text-align:center;">
                                            <table style="width:100%">
                                                <tr>
                                                    <td style="text-align: left;vertical-align: middle;">
                                                        @if (Model.SBranchDetails.SBranchID == 13)
                                                        {
                                                            <p style="margin-top: 2px;margin-bottom: 5px;text-align: center;font-size: 20px;"><b>@Model.SBranchDetails.BranchSchoolName</b></p>
                                                        }
                                                        else
                                                        {
                                                            <p style="margin-top: 2px;margin-bottom: 5px;text-align: center;font-size: 26px;">@Model.SBranchDetails.BranchSchoolName</p>
                                                        }


                                                        <p style="margin-bottom: 2px;font-size: 16px;text-align: center;">
                                                            @Html.Raw(Html.Encode(Model.SBranchDetails.Address).Replace("\n", "<br />"))
                                                            @*@Model.SBranchDetails.Address*@
                                                        </p>
                                                        <p style="margin-bottom: 2px;text-align: center;"> <b>Ph.</b> @Model.SBranchDetails.ContactNo,  <b> Email :</b> @Model.SBranchDetails.EmailID</p>

                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                        <td style="width:20%;text-align:right;">
                                            @if (Model.SBranchDetails.SBranchID == 17)
                                            {

                                            }
                                            @if (Model.SBranchDetails.SBranchID == 23)
                                            {
                                                <img onerror="return OnImageError(this,2);" class="ImageReportLogo" alt="Photo" style="width:120px;height:120px;" src="@Url.Content("~/Images/cbse-logo.png")" />
                                            }
                                            else
                                            {
                                                <img onerror="return OnImageError(this,2);" style="width:120px;height:120px;" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.SBranchDetails.SBranchID)_@(Model.SBranchDetails.Logo)" />
                                            }
                                        </td>

                                    </tr>


                                    <tr>
                                        <td colspan="3" style="text-align: center;border-bottom: 0px solid #ddd;">

                                            <p style="margin-bottom: 2px;text-align: center;">
                                                <b style="font-size: 26px;">Report Card</b>
                                                <br />

                                            </p>
                                            <p style="font-size: 22px;text-align: center;">Academic Session : @Model.SessionName</p>

                                        </td>
                                    </tr>

                                    <tr>
                                        <td colspan="3" style="text-align: center;">
                                            <table style="width:100%">
                                                <tr style="padding-top:10px;padding-bottom:10px;">

                                                    <td style="padding-left:10px;text-align:left; width:45%">
                                                        <div class="col-md-12">
                                                            <div class="row">
                                                                Roll No. :<b> @Model.Student.RollNo</b>
                                                            </div>
                                                            <div class="row">
                                                                Student : <b id="bStudentNate">@Model.Student.Name</b>
                                                            </div>
                                                            <div class="row">
                                                                Mother's Name : <b>@Model.Student.MotherName</b>
                                                            </div>
                                                            <div class="row">
                                                                Father's Name : <b>@Model.Student.FatherName</b>
                                                            </div>
                                                            <div class="row">
                                                                Parent's ID : <b>@Model.Student.SParentID</b>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="padding-left:10px;width:45%;text-align:left;">
                                                        <div class="col-md-12">
                                                            <div class="row">
                                                                Date of Birth :<b> @Model.Student.DOB.ToString("dd MMM, yyyy")</b>
                                                            </div>
                                                            <div class="row">
                                                                Class-Section :<b id="bClassSection"> @Model.Student.ClassName </b>
                                                            </div>
                                                            <div class="row">
                                                                Student ID :<b> @Model.Student.StudentSID</b>
                                                            </div>
                                                            <div class="row">
                                                                SR No.  :<b> @Model.Student.SchoolUID</b>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="width:10%">
                                                        <div class="col-md-12" style="text-align:right;">
                                                            @if (Model.Student.Photo == null)
                                                            {

                                                            }
                                                            else
                                                            {
                                                                <img id="imgPhoto" onerror="return OnImageError(this,@(Model.Student.Gender));" style="width:100px;height:100px;" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(Model.Student.StudentID)_@Model.Student.Photo" />
                                                            }
                                                        </div>

                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>


                                </table>

                                <input type="hidden" name="StudentSessionUID" value="@Model.StudentSessionUID" />
                                <input type="hidden" name="EvaluationID" value="@Model.EvaluationID" />
                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    @{
                                        var mainCounter = 0;
                                        <table class="table">
                                            @foreach (PerformanceParameterModel c in Model.PerformanceParameters)
                                            {
                                                if (c.ParamType == 0)
                                                {

                                                    <tr>
                                                        <td colspan="3" style="text-align: center;">
                                                            <b>   @c.ParamName</b> <br /><small>@c.ParamDesc</small>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="3">
                                                            <table id="tblResult" class="table table-bordered table-hover">
                                                                @{
                                                                    var sublevels = 1;
                                                                    <tr>
                                                                        <td @(Model.SubEvaluations.Count > 0 ? "rowspan=2" : "") style="min-width:100px;text-align:left;">
                                                                            <b> Subject</b>
                                                                        </td>

                                                                        @foreach (EvaluationModel me in Model.MainEvaluations)
                                                                        {
                                                                            if (sublevels < me.SubEvals)
                                                                            {
                                                                                sublevels = me.SubEvals;
                                                                            }
                                                                            <td colspan="@(me.SubEvals + 2)"><b>@me.EvaluationName</b> (@me.Weightage.ToString("0") marks)</td>
                                                                        }
                                                                        @if (Model.EvaluationID == -1)
                                                                        {
                                                                            <td colspan="2" style="font-size: 0.7em;"><b>Sub Total</b></td>
                                                                        }
                                                                    </tr>
                                                                    if (Model.SubEvaluations.Count > 0)
                                                                    {
                                                                        <tr>
                                                                            @foreach (EvaluationModel tme in Model.MainEvaluations)
                                                                            {
                                                                                foreach (EvaluationModel se in Model.SubEvaluations)
                                                                                {
                                                                                    if (se.MasterID == tme.EvaluationID)
                                                                                    {
                                                                                        <td style="font-size: 0.7em;"><b>@se.EvaluationName</b> (@se.Weightage)</td>
                                                                                    }
                                                                                }
                                                                                <td style="font-size: 0.7em;"><b>Marks Obtained (@tme.Weightage)</b></td>
                                                                                <td style="font-size: 0.7em;"><b>Grade</b></td>
                                                                            }
                                                                            @if (Model.EvaluationID == -1)
                                                                            {
                                                                                <td style="font-size: 0.7em;"><b>Marks Obtained</b>  <br /> (@Model.MainEvaluations.Sum(x => x.Weightage)) </td>
                                                                                <td style="font-size: 0.7em;"><b>Grade</b></td>
                                                                            }
                                                                        </tr>
                                                                    }
                                                                    var privSubID = 0;
                                                                    decimal totalmarksresult = 0;
                                                                    var division = "First";
                                                                    var Grade = "A";
                                                                    var GradeAll = "A";
                                                                    decimal TotalMarksT = 0;
                                                                    decimal TotalObtMarksT = 0;
                                                                    var divisionAll = "First";
                                                                    decimal totaltotal = 0;
                                                                    decimal totalscored = 0;


                                                                    foreach (ExamResultDetailModel r in Model.Result)
                                                                    {

                                                                        if (privSubID != r.SubjectID)
                                                                        {
                                                                            <tr>


                                                                                <td style="min-width: 110px;"><b>@r.SubjectName</b></td>
                                                                                @foreach (EvaluationModel er in Model.MainEvaluations)
                                                                                {
                                                                                    decimal EvalMaxMarks = 0;
                                                                                    decimal SATotalMarks = 0;
                                                                                    decimal EvalTotalMarks = 0;
                                                                                    foreach (EvaluationModel esr in Model.SubEvaluations)
                                                                                    {
                                                                                        if (esr.MasterID == er.EvaluationID)
                                                                                        {
                                                                                            var isFound = false;
                                                                                            foreach (ExamResultDetailModel err in Model.Result)
                                                                                            {
                                                                                                if (err.MasterID == er.EvaluationID && esr.EvaluationType == err.EvaluationID && r.SubjectID == err.SubjectID)
                                                                                                {
                                                                                                    @*<td>@(err.Grade == null ? "NA" : err.Grade)</td>*@
                                                                                                    if (Model.SBranchID == 0)
                                                                                                    {
                                                                                                        <td>@err.wMaxMarks.ToString("N2")</td>
                                                                                                    }
                                                                                                    else
                                                                                                    {
                                                                                                        if (err.Status == -1)
                                                                                                        {

                                                                                                            <td>M/L</td>
                                                                                                        }
                                                                                                        else if (err.Status == 3)
                                                                                                        {
                                                                                                            <td style="text-decoration: @(err.wMarksScored < err.PassMarks ? "underline" : "none")">@err.wMarksScored.ToString("0")</td>
                                                                                                        }
                                                                                                        else
                                                                                                        {

                                                                                                            <td style="text-decoration: @(err.wMarksScored < err.PassMarks ? "underline" : "none")">@err.wMarksScored.ToString("0")</td>
                                                                                                        }


                                                                                                        @* <td>@err.wMarksScored.ToString("N2")</td>*@
                                                                                                    }
                                                                                                    @*<td>@err.wMarksScored.ToString("N2")</td>*@
                                                                                                    EvalTotalMarks = EvalTotalMarks + err.wMarksScored;
                                                                                                    isFound = true;
                                                                                                    EvalMaxMarks = EvalMaxMarks + err.wMaxMarks;
                                                                                                    er.TotalMarks = er.TotalMarks + err.wMaxMarks;
                                                                                                    er.MarksObtained = er.MarksObtained + err.wMarksScored;
                                                                                                    r.etMarksScored = r.etMarksScored + err.wMarksScored;
