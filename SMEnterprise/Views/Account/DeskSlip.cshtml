
@{
    ViewBag.Title = "Admint Card";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@section IncludeCss
{
    <title>Desk Slip</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/DemandRecipt.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/style.min.css")" rel="stylesheet" />
}





<style>
    * {
        box-sizing: border-box;
    }

    .reciept-box {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 24px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    .reciept-box {
        box-shadow: none;
        border: 1px solid #000;
        page-break-inside: avoid; /* Prevents card from splitting across pages */
    }
    .col-4 {
        width: 33.3333%;
        padding: 0 8px;
    }

    .col-6 {
        width: 50%;
    }

    .col-12 {
        width: 100%;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
    }
</style>




@model SMEnterprise.Models.AdmitCardListModel
<div class="" style="background-color: white;">
    <div class="row">
        <div class="col-md-12">
            @using (Html.BeginForm("DeskSlip", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
            {
                <div class="row std-mng-head col-md-12">

                    <div class="col-md-12 class-section">
                        <div class="row">

                            <div class="col-md-2 ">
                                <label class="">Sessions :</label>
                                <div class="">
                                    <select name="SessionID" class="form-control" id="ddlSessions" onchange="$('#frmGetStudents').submit();">
                                        <option value="0">--Select Session--</option>
                                        @foreach (var el in Model.Sessions)
                                        {
                                            <option value="@el.SessionID" @(el.SessionID == Model.SessionID ? "selected" : "")>@el.SessionName @(el.SessionStatus == 1 ? "(Active)" : "")</option>
                                        }
                                    </select>
                                </div>

                            </div>
                            <div class="col-md-3 ">
                                <label class="" style="padding-right: 0px;">Class :</label>
                                <div class="">
                                    <select class="form-control" name="ClassID" id="ddlClass" onchange="javascript:ClassChanged(this);">
                                        <option value="0">--Select Class--</option>
                                        @foreach (var el in Model.Classes)
                                        {
                                            <option value="@el.ClassID" @(el.ClassID == Model.ClassID ? "selected" : "")>@el.ClassName</option>
                                        }
                                    </select>
                                </div>

                            </div>
                            <div class="col-md-3 ">
                                <label class="">Section :</label>
                                <div class="">
                                    <select name="SectionID" class="form-control" id="ddlSection" onchange="$('#frmGetStudents').submit();">
                                        <option value="0">--Select Section--</option>
                                        @foreach (var el in Model.Sections)
                                        {
                                            <option value="@el.ID" @(el.ID == Model.SectionID ? "selected" : "")>@el.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 ">
                                <label class="">Evaluation : </label>
                                <div class="" style="padding-left: 10px;">
                                    <select name="EvaluationID" class="form-control" id="ddlEvaluation" onchange="$('#frmGetStudents').submit();">
                                        @foreach (var el in Model.Evaluations)
                                        {
                                            <option value="@el.EvaluationID" @(el.EvaluationID == Model.EvaluationID ? "selected" : "")>@el.EvaluationName</option>
                                        }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-1 " style="top: 24px;">
                                <a href="javascript:void(0);" onclick="$('#frmGetStudents').submit();"><i class="fa fa-search" style="background: #ffffff;color: #606c72;"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <input type="text" class="form-control" id="txtsearch" placeholder="Search Text" onkeyup="Search(this);" />
        </div>
        <div class="col-md-6" style="text-align:right;">
            <button type="button" class="btn btn-primary" onclick="PrintDemantRecipt();"><i class="fa fa-print"></i> Print</button>
        </div>
    </div>

</div>

<div class="row" id="admitcards" style="margin-top: 20px;margin-left:10px;background-color: white; padding: 20px;">
      <div class="wrapper" style="display: flex; flex-wrap: wrap; width: 100%; margin-left: 10px; margin-right: 10px; ">



<div class="row" id="admitcards">
    <div class="wrapper">

        @foreach (var d in Model.AdmitCards)
        {
            <div class="col-4">
                <div class="listitem">
                    <div class="reciept-box" style="border: 1px solid #ccc; border-radius: 8px; padding: 16px; margin-bottom: 24px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">




                        <div class="row">
                            <div class="col-6"><h4><span>Desk Slip</span></h4></div>
                            <div class="col-6">
                                <img id="imgPhoto" style="height:120px;width:120px" onerror="return OnImageError(this,@(d.Gender));" class="thumbImageGrid" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(d.StudentID)_@d.Photo" />

<div class="row" id="admitcards" style="margin-top: 20px;margin-left:10px;background-color: white; padding: 20px;">
      <div class="wrapper" style="display: flex; flex-wrap: wrap; width: 100%; margin-left: 10px; margin-right: 10px; ">

        @foreach (var d in Model.AdmitCards)
        {
            <div class="col-4">
                <div class="listitem">
                    <div class="reciept-box" style="border: 1px solid #ccc; border-radius: 8px; padding: 16px; margin-bottom: 24px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">



                        <div class="row" style="display: flex; justify-content: space-between; align-items: center;">
                            <div class="col-6"><h4 style="font-size: 1.125rem; font-weight: 600;"><span>Desk Slip</span></h4></div>
                            <div class="col-6" style="width: 50%; text-align: right;">
                                <img id="imgPhoto" style="height: 120px; width: 120px; border-radius: 8px;" onerror="return OnImageError(this,@(d.Gender));" class="thumbImageGrid" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(d.StudentID)_@d.Photo" />




                                <br />
                            </div>
                        </div>
                        <p></p>
                        <div class="row">
                            <div class="col-12" style="text-align:center">
                                &nbsp;&nbsp;<b>@d.Name</b>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12" style="text-align:center">&nbsp;&nbsp;Father : @d.FatherName</div>

                        </div>
                        <div class="row">
                            <div class="col-12" style="text-align:center">&nbsp;&nbsp;Mother : @d.MotherName</div>

                        </div>
                        <div class="row">
                            <div class="col-12" style="text-align:center">&nbsp;&nbsp;Student ID : @d.StudentSID</div>

                        </div>




                       




                        <div>
                            <br />
                        </div>
                        <div class="row">
                            <div class="col-6">&nbsp;&nbsp;Room/Bench:<span>&nbsp; </span></div>
                            <div class="col-6">&nbsp;&nbsp;Session :<b>@d.SessionName</b></div>
                        </div>
                        <div class="row">
                            <div class="col-6">&nbsp;&nbsp;Student SR No:<span>@d.SchoolUID </span></div>
                            <div class="col-6">&nbsp;&nbsp;Roll No. : @d.RollNo</div>
                        </div>

                        <div class="row">
                            <div class="col-6">&nbsp;&nbsp;Class:<span> </span></div>
                            <div class="col-6"><b>@d.ClassName / @d.SectionName</b></div>
                        </div>
                        <div class="row">
                            <div class="col-6">&nbsp;&nbsp;DOB:<b>@d.DOB.ToString("dd-MMM-yyyy")  </b></div>
                            <div class="col-6">House :@d.HouseName</div>
                        </div>
                        <div class="row">
                            <div class="col-6">&nbsp;&nbsp;Mobile No:</div>
                            <div class="col-6">@d.MobileNo</div>
                        </div>


                        <p></p>
                        <div class="row">
                            <div class="col-6"></div>
                            <div class="col-6">
                                <img onerror="return OnImageError(this,2);" style="max-height:35px;max-width:100px" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.Branch.SBranchID)_P_@Model.Branch.PrincipalSignature" />
                                <br /> Principal's Signature
                            </div>
                        </div>
                        <p></p>



                    </div>
                </div>



        </div>


            </div>




        }
    </div>



</div>
@section scripts
{

    <script>

        <script>


            </div>




        }
    </div>



</div>
@section scripts
{
    <script>


        function Search(sender) {
            var sText = $(sender).val();
            console.log(sText);
            if (sText == "") {
                $('.listitem').css('display', '');
            }
            else {
                $(".listitem").each(function () {
                    var isExist = false;
                    $(this).find(".searchable").each(function () {
                        if ($(this).html().toLowerCase().includes(sText.toLowerCase()) == true) {
                            isExist = true;
                                }
                    });
                    if (isExist == true) {
                        $(this).css('display', '');
                    }
                    else {
                         $(this).css('display', 'none');
                    }
                  });
            }
        }
        function ClassChanged(sender) {
            $('#ddlSection').html('<option value="0">Loading....</option>');
            $.ajax(
    {
        type: "POST",
                    url: "/Account/GetSectionOnClass/" + $(sender).val(),
        cache: false,
        processData: false,
        contentType: false,
        success: function (html) {
            $('#ddlSection').html('');
            $('#ddlSection').html('<option value="0">--Select Section--</option>');
            $('#ddlSection').append(html);
        },
        error: function (e) {
            alert("errorn");
        }
    });
        }
        function PrintDemantRecipt() {
            var contents = $("#admitcards").html();
            var frame1 = $('<iframe />');
            frame1[0].name = "frame1";
            frame1.css({ "position": "absolute", "top": "-1000000px" });
            $("body").append(frame1);
            var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
            frameDoc.document.open();
            //Create a new HTML document.
            frameDoc.document.write('<html><head><title></title><style type = "text/css" > ' +
                    'table th, table td {' +
                'border-bottom:1px solid #000;' +
                '}' +
                '</style>');
            frameDoc.document.write('</head><body>');
            frameDoc.document.write('<link href="@Url.Content("~/css/style.min.css")" rel="stylesheet" type="text/css" />');
            frameDoc.document.write('<link  href="@Url.Content("~/css/studentStyle.css")" rel="stylesheet" type="text/css" />');
            frameDoc.document.write('<link href="@Url.Content("~/css/DemandRecipt.min.css")" rel="stylesheet" type="text/css" />');

            //Append the external CSS file.
            //Append the DIV contents.
            frameDoc.document.write(contents);
            frameDoc.document.write('</body></html>');
            frameDoc.document.close();
            setTimeout(function () {
                window.frames["frame1"].focus();
                window.frames["frame1"].print();
                frame1.remove();
            }, 1000);
        }

    </script>
}


        </script>
    }

    </script>
}


