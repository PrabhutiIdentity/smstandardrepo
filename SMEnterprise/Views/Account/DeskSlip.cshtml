</div>
<div class="row" id="admitcards">
                    
                            @foreach (var d in Model.AdmitCards)
                            {
                                <div class="col-md-6">
                                    <div class="row">
                                        <div> <b> Desk Slip (@d.SessionName)</b></div>
                                        <div class="col-6"></div>
                                        <div class="col-6">
                                            <img id="imgPhoto" style="height:120px;width:120px" onerror="return OnImageError(this,@(d.Gender));" class="thumbImageGrid" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(d.StudentID)_@d.Photo" />
                                        </div>
                                        <div class="col-6"></div>
                                        <div class="col-6"></div>
                                        </div>
                                        <table style="width:100%;border:none;">
                                            <tr>
                                                <td colspan="2" style="text-align:center;">
                                                </td>
                                                <td rowspan="3" style="width:20%;border:none;">
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align:right;">Room/Bench:</td>
                                                <td>&nbsp; </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align:right;">ID/Roll No.:</td>
                                                <td class="searchable">&nbsp; @d.SchoolUID/@d.RollNo</td>
                                            </tr>
                                            <tr>
                                                <td style="text-align:right;">
                                                    Class/House:
                                                </td>
                                                <td>
                                                    &nbsp; @d.ClassName (@d.SectionName)/@d.HouseName
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align:right;">
                                                    Mobile No/DOB:
                                                </td>
                                                <td>
                                                    &nbsp; @d.MobileNo/@d.DOB.ToString("dd-MMM-yyyy")
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align:right;">
                                                    Name:
                                                </td>
                                                <td class="searchable">
                                                    &nbsp; @d.Name
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align:right;border:none;">
                                                    Father's Name:
                                                </td>
                                                <td class="searchable" style="border:none;">
                                                    &nbsp; @d.FatherName
                                                </td>
                                                <td style="border-top:1px solid;border:none;text-align:center">
                                                    <img onerror="return OnImageError(this,2);" style="max-height:35px;max-width:100px" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.Branch.SBranchID)_P_@Model.Branch.PrincipalSignature" />
                                                    <br /> Principal's Signature
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                    }
                     
         
          
        
    </div>
@section scripts
{
    <script>
        function Search(sender) {
            var sText = $(sender).val();
            console.log(sText);
            if (sText == "") {
                $('.listitem').css('display', '');
            }
            else {
                $(".listitem").each(function () {
                    var isExist = false;
                    $(this).find(".searchable").each(function () {
                        if ($(this).html().toLowerCase().includes(sText.toLowerCase()) == true) {
                            isExist = true;
                                }
                    });
                    if (isExist == true) {
                        $(this).css('display', '');
                    }
                    else {
                         $(this).css('display', 'none');
                    }
                  });
            }
        }
        function ClassChanged(sender) {
            $('#ddlSection').html('<option value="0">Loading....</option>');
            $.ajax(
    {
        type: "POST",
                    url: "/Account/GetSectionOnClass/" + $(sender).val(),
        cache: false,
        processData: false,
        contentType: false,
        success: function (html) {
            $('#ddlSection').html('');
            $('#ddlSection').html('<option value="0">--Select Section--</option>');
            $('#ddlSection').append(html);
        },
        error: function (e) {
            alert("errorn");
        }
    });
        }
        function PrintDemantRecipt() {
            var contents = $("#admitcards").html();
            var frame1 = $('<iframe />');
            frame1[0].name = "frame1";
            frame1.css({ "position": "absolute", "top": "-1000000px" });
            $("body").append(frame1);
            var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
            frameDoc.document.open();
            //Create a new HTML document.
            frameDoc.document.write('<html><head><title></title><style type = "text/css" > ' +
                    'table th, table td {' +
                'border-bottom:1px solid #000;' +
                '}' +
                '</style>');
            frameDoc.document.write('</head><body>');
            frameDoc.document.write('<link href="@Url.Content("~/css/style.min.css")" rel="stylesheet" type="text/css" />');
            frameDoc.document.write('<link href="@Url.Content("~/css/DemandRecipt.min.css")" rel="stylesheet" type="text/css" />');

            //Append the external CSS file.
            //Append the DIV contents.
            frameDoc.document.write(contents);
            frameDoc.document.write('</body></html>');
            frameDoc.document.close();
            setTimeout(function () {
                window.frames["frame1"].focus();
                window.frames["frame1"].print();
                frame1.remove();
            }, 1000);
        }
    </script>
}
