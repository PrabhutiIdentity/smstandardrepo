
@{
    ViewBag.Title = "Admint Card";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@section IncludeCss
{
    <title>Desk Slip</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/style.min.css")" rel="stylesheet" />
}
<style>
    .desk-slip-page,
    .desk-slip-page * {
        box-sizing: border-box;
    }

    .desk-slip-page {
        background: #f5f7fb;
        padding: 18px;
    }

    .desk-slip-toolbar {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .06);
        margin-bottom: 18px;
        padding: 16px;
    }

    .desk-slip-toolbar label {
        color: #334155;
        display: block;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .02em;
        margin-bottom: 6px;
        text-transform: uppercase;
    }

    .desk-slip-toolbar .form-control {
        border-color: #cbd5e1;
        border-radius: 6px;
        box-shadow: none;
        min-height: 36px;
    }

    .desk-slip-actions {
        align-items: flex-end;
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        padding-top: 20px;
    }

    .desk-slip-search {
        margin-top: 12px;
    }

    .desk-slip-grid {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 16px 0;
        padding: 18px 10px;
    }

    .desk-slip-col {
        padding: 0 8px;
        width: 33.3333%;
    }

    .desk-slip-card {
        background: #fff;
        border: 1px solid #94a3b8;
        border-radius: 8px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .08);
        color: #0f172a;
        min-height: 360px;
        overflow: hidden;
        page-break-inside: avoid;
    }

    .desk-slip-header {
        align-items: center;
        background: #f8fafc;
        border-bottom: 2px solid #1e293b;
        display: flex;
        justify-content: space-between;
        min-height: 128px;
        padding: 12px 14px;
    }

    .desk-slip-title {
        color: #0f172a;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: .08em;
        margin: 0 0 10px;
        text-transform: uppercase;
    }

    .desk-slip-meta {
        color: #475569;
        font-size: 12px;
        line-height: 1.45;
    }

    .desk-slip-exam {
        color: #1e293b;
        font-weight: 700;
        margin-top: 4px;
        max-width: 155px;
        word-break: break-word;
    }

    .desk-slip-photo {
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        height: 104px;
        object-fit: cover;
        padding: 3px;
        width: 104px;
    }

    .desk-slip-identity {
        border-bottom: 1px solid #e2e8f0;
        padding: 12px 14px 10px;
        text-align: center;
    }

    .desk-slip-name {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .desk-slip-parents {
        color: #334155;
        font-size: 12px;
        line-height: 1.45;
    }

    .desk-slip-details {
        display: grid;
        font-size: 12px;
        grid-template-columns: 1fr 1fr;
        line-height: 1.35;
        padding: 12px 14px 6px;
    }

    .desk-slip-field {
        border-bottom: 1px dashed #cbd5e1;
        min-height: 34px;
        padding: 5px 6px 5px 0;
    }

    .desk-slip-label {
        color: #64748b;
        display: block;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .desk-slip-value {
        color: #0f172a;
        font-weight: 600;
        word-break: break-word;
    }

    .desk-slip-footer {
        align-items: flex-end;
        display: flex;
        justify-content: space-between;
        padding: 8px 14px 12px;
    }

    .desk-slip-bench {
        border-bottom: 1px solid #0f172a;
        color: #64748b;
        font-size: 11px;
        min-width: 128px;
        padding-bottom: 4px;
    }

    .desk-slip-signature {
        color: #334155;
        font-size: 11px;
        text-align: center;
    }

    .desk-slip-signature img {
        display: block;
        margin: 0 auto 2px;
        max-height: 34px;
        max-width: 110px;
    }

    @@media (max-width: 1199px) {
        .desk-slip-col {
            width: 50%;
        }
    }

    @@media (max-width: 767px) {
        .desk-slip-page {
            padding: 10px;
        }

        .desk-slip-col {
            width: 100%;
        }

        .desk-slip-actions {
            justify-content: flex-start;
            padding-top: 8px;
        }
    }
</style>
@model SMEnterprise.Models.AdmitCardListModel
<div class="desk-slip-page">
    <div class="desk-slip-toolbar">
        <div class="row">
        <div class="col-md-12">
            @using (Html.BeginForm("DeskSlip", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
            {
                <div class="row">

                    <div class="col-md-12">
                        <div class="row">

                            <div class="col-md-2">
                                <label>Session</label>
                                <div>
                                    <select name="SessionID" class="form-control" id="ddlSessions" onchange="SessionChanged();">
                                        <option value="0">--Select Session--</option>
                                        @foreach (var el in Model.Sessions)
                                        {
                                            <option value="@el.SessionID" @(el.SessionID == Model.SessionID ? "selected" : "")>@el.SessionName @(el.SessionStatus == 1 ? "(Active)" : "")</option>
                                        }
                                    </select>
                                </div>

                            </div>
                            <div class="col-md-3">
                                <label>Class</label>
                                <div>
                                    <select class="form-control" name="ClassID" id="ddlClass" onchange="javascript:ClassChanged(this);">
                                        <option value="0">--Select Class--</option>
                                        @foreach (var el in Model.Classes)
                                        {
                                            <option value="@el.ClassID" @(el.ClassID == Model.ClassID ? "selected" : "")>@el.ClassName</option>
                                        }
                                    </select>
                                </div>

                            </div>
                            <div class="col-md-3">
                                <label>Section</label>
                                <div>
                                    <select name="SectionID" class="form-control" id="ddlSection" onchange="$('#frmGetStudents').submit();">
                                        <option value="0">--Select Section--</option>
                                        @foreach (var el in Model.Sections)
                                        {
                                            <option value="@el.ID" @(el.ID == Model.SectionID ? "selected" : "")>@el.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label>Evaluation</label>
                                <div>
                                    <select name="EvaluationID" class="form-control" id="ddlEvaluation" onchange="$('#frmGetStudents').submit();">
                                        <option value="0">--Select Evaluation--</option>
                                        @foreach (var el in Model.Evaluations)
                                        {
                                            <option value="@el.EvaluationID" @(el.EvaluationID == Model.EvaluationID ? "selected" : "")>@el.EvaluationName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-1 desk-slip-actions">
                                <button type="button" class="btn btn-default" title="Search" onclick="$('#frmGetStudents').submit();"><i class="fa fa-search"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="row desk-slip-search">
        <div class="col-md-6">
            <input type="text" class="form-control" id="txtsearch" placeholder="Search student, parent, roll no. or ID" onkeyup="Search(this);" />
        </div>
        <div class="col-md-6" style="text-align:right;">
            <button type="button" class="btn btn-primary" onclick="PrintDeskSlip();"><i class="fa fa-print"></i> Print</button>
        </div>
    </div>
    </div>
    <div id="admitcards">
        <div class="desk-slip-grid">

        @foreach (var d in Model.AdmitCards)
        {
            <div class="desk-slip-col">
                <div class="listitem">
                    <div class="desk-slip-card">
                        <div class="desk-slip-header">
                            <div>
                                <h4 class="desk-slip-title">Desk Slip</h4>
                                <div class="desk-slip-meta">
                                    <div>Session: <strong>@d.SessionName</strong></div>
                                    <div class="desk-slip-exam">Exam: @d.EvaluationName</div>
                                    <div>Student ID: <strong class="searchable">@d.StudentSID</strong></div>
                                </div>
                            </div>
                            <img id="imgPhoto" onerror="return OnImageError(this,@(d.Gender));" class="thumbImageGrid desk-slip-photo" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(d.StudentID)_@d.Photo" />
                        </div>

                        <div class="desk-slip-identity">
                            <div class="desk-slip-name searchable">@d.Name</div>
                            <div class="desk-slip-parents searchable">Father: @d.FatherName</div>
                            <div class="desk-slip-parents searchable">Mother: @d.MotherName</div>
                        </div>

                        <div class="desk-slip-details">
                            <div class="desk-slip-field">
                                <span class="desk-slip-label">SR No.</span>
                                <span class="desk-slip-value searchable">@d.SchoolUID</span>
                            </div>
                            <div class="desk-slip-field">
                                <span class="desk-slip-label">Roll No.</span>
                                <span class="desk-slip-value searchable">@d.RollNo</span>
                            </div>
                            <div class="desk-slip-field">
                                <span class="desk-slip-label">Class / Section</span>
                                <span class="desk-slip-value searchable">@d.ClassName / @d.SectionName</span>
                            </div>
                            <div class="desk-slip-field">
                                <span class="desk-slip-label">House</span>
                                <span class="desk-slip-value">@d.HouseName</span>
                            </div>
                            <div class="desk-slip-field">
                                <span class="desk-slip-label">DOB</span>
                                <span class="desk-slip-value">@d.DOB.ToString("dd-MMM-yyyy")</span>
                            </div>
                            <div class="desk-slip-field">
                                <span class="desk-slip-label">Mobile No.</span>
                                <span class="desk-slip-value searchable">@d.MobileNo</span>
                            </div>
                        </div>

                        <div class="desk-slip-footer">
                            <div class="desk-slip-bench">Room / Bench</div>
                            <div class="desk-slip-signature">
                                <img onerror="return OnImageError(this,2);" alt="Principal Signature" src="@Url.Content("~/Images/SBranchLogo/")@(Model.Branch.SBranchID)_P_@Model.Branch.PrincipalSignature" />
                                Principal's Signature
                            </div>
                        </div>
                    </div>
                </div>

            </div>




        }
        </div>
    </div>
</div>
@section scripts
{
    <script>
        function Search(sender) {
            var sText = $(sender).val();
            console.log(sText);
            if (sText == "") {
                $('.listitem').css('display', '');
            }
            else {
                $(".listitem").each(function () {
                    var isExist = false;
                    $(this).find(".searchable").each(function () {
                        if ($(this).html().toLowerCase().includes(sText.toLowerCase()) == true) {
                            isExist = true;
                                }
                    });
                    if (isExist == true) {
                        $(this).css('display', '');
                    }
                    else {
                         $(this).css('display', 'none');
                    }
                  });
            }
        }

        function ResetEvaluation() {
            $('#ddlEvaluation').val('0');
        }

        function SessionChanged() {
            ResetEvaluation();
            $('#frmGetStudents').submit();
        }

        function PopulateNameOptions(selector, items, defaultText) {
            var $select = $(selector);
            $select.html('<option value="0">' + defaultText + '</option>');
            $.each(items || [], function (_, item) {
                $select.append($('<option />').val(item.ID).text(item.Name));
            });
        }

        function ClassChanged(sender) {
            ResetEvaluation();
            $('#ddlSection').html('<option value="0">Loading....</option>');
            $('#ddlEvaluation').html('<option value="0">Loading....</option>');
            $.ajax(
    {
        type: "POST",
                    url: "/Account/GetSectionEvaluationsOnClass/" + $(sender).val() + "?id2=" + $('#ddlSessions').val(),
        cache: false,
        processData: false,
        contentType: false,
        success: function (data) {
            PopulateNameOptions('#ddlSection', data.Sections, '--Select Section--');
            PopulateNameOptions('#ddlEvaluation', data.Evaluations, '--Select Evaluation--');
        },
        error: function (e) {
            $('#ddlSection').html('<option value="0">--Select Section--</option>');
            $('#ddlEvaluation').html('<option value="0">--Select Evaluation--</option>');
            alert("errorn");
        }
    });
        }
        function GetDeskSlipPrintStyles() {
            return ''
                + '*{box-sizing:border-box;}'
                + 'body{background:#fff;color:#0f172a;font-family:Arial,Helvetica,sans-serif;margin:0;padding:8px;}'
                + '.desk-slip-grid{display:flex;flex-wrap:wrap;gap:12px 0;width:100%;}'
                + '.desk-slip-col{padding:0 6px;width:33.3333%;}'
                + '.listitem{page-break-inside:avoid;}'
                + '.desk-slip-card{background:#fff;border:1px solid #1e293b;border-radius:6px;box-shadow:none;color:#0f172a;min-height:350px;overflow:hidden;page-break-inside:avoid;}'
                + '.desk-slip-header{align-items:center;background:#f8fafc;border-bottom:2px solid #1e293b;display:flex;justify-content:space-between;min-height:120px;padding:10px 12px;}'
                + '.desk-slip-title{color:#0f172a;font-size:18px;font-weight:700;letter-spacing:.08em;margin:0 0 8px;text-transform:uppercase;}'
                + '.desk-slip-meta{color:#475569;font-size:11px;line-height:1.45;}'
                + '.desk-slip-exam{color:#1e293b;font-weight:700;margin-top:3px;max-width:145px;word-break:break-word;}'
                + '.desk-slip-photo{border:1px solid #cbd5e1;border-radius:5px;height:96px;object-fit:cover;padding:3px;width:96px;}'
                + '.desk-slip-identity{border-bottom:1px solid #e2e8f0;padding:10px 12px 8px;text-align:center;}'
                + '.desk-slip-name{font-size:16px;font-weight:700;margin-bottom:4px;}'
                + '.desk-slip-parents{color:#334155;font-size:11px;line-height:1.45;}'
                + '.desk-slip-details{display:grid;font-size:11px;grid-template-columns:1fr 1fr;line-height:1.35;padding:10px 12px 5px;}'
                + '.desk-slip-field{border-bottom:1px dashed #cbd5e1;min-height:32px;padding:4px 6px 4px 0;}'
                + '.desk-slip-label{color:#64748b;display:block;font-size:9px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;}'
                + '.desk-slip-value{color:#0f172a;font-weight:600;word-break:break-word;}'
                + '.desk-slip-footer{align-items:flex-end;display:flex;justify-content:space-between;padding:8px 12px 10px;}'
                + '.desk-slip-bench{border-bottom:1px solid #0f172a;color:#64748b;font-size:10px;min-width:118px;padding-bottom:4px;}'
                + '.desk-slip-signature{color:#334155;font-size:10px;text-align:center;}'
                + '.desk-slip-signature img{display:block;margin:0 auto 2px;max-height:32px;max-width:100px;}'
                + '@@' + 'page{margin:8mm;}';
        }

        function PrintDeskSlip() {
            var contents = $("#admitcards").html();
            var frame1 = $('<iframe />');
            frame1[0].name = "frame1";
            frame1.css({ "position": "absolute", "top": "-1000000px" });
            $("body").append(frame1);
            var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
            frameDoc.document.open();
            frameDoc.document.write('<html><head><title>Desk Slip</title><style type="text/css">' + GetDeskSlipPrintStyles() + '</style>');
            frameDoc.document.write('</head><body>');
            frameDoc.document.write(contents);
            frameDoc.document.write('</body></html>');
            frameDoc.document.close();
            setTimeout(function () {
                window.frames["frame1"].focus();
                window.frames["frame1"].print();
                frame1.remove();
            }, 1000);
        }
    </script>
}
