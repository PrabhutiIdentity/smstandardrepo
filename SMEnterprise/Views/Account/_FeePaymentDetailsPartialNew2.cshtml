                        <button type="submit" class="btn btn-lg btn-block btn-success" onclick="ShowConfirmation(this);">Submit</button>
                    </div>
                </div>
                }
            </div>
        </div>
<script>
    (function () {
        var branchId = @Model.SBranchID;
        var restrictedBranches = [17, 25];

        var dt = document.getElementById("dtDate");
        if (!dt) return;

        var today = new Date().toISOString().split('T')[0];

        // 🔒 ALL branches → future date not allowed
        dt.setAttribute("max", today);

        if (restrictedBranches.indexOf(branchId) !== -1) {

            // 🔒 restricted → only today
            dt.setAttribute("min", today);

            dt.addEventListener("change", function () {
                if (dt.value !== today) {
                    dt.value = today;
                }
            });

        } else {

            // 🔒 other branches → no future, but past allowed
            dt.addEventListener("change", function () {
                if (dt.value > today) {
                    dt.value = today;
                }
            });
        }


        // ❌ block manual typing for all
        dt.addEventListener("keydown", function (e) {
            e.preventDefault();
        });

    })();

</script>

</script>


