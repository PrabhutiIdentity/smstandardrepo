@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model CollectionReportModel
@section IncludeCss
{
    <title>Date/Fee wise Collection Report</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    
}
<style>
    .btn {
        padding: 3px 6px;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Date/Fee wise Collection Report
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Account/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Date/Fee Wise Collection Report</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="">
                <div class="box-header">
                    @using (Html.BeginForm("ReportDatewiseFeeCollection", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetExams" }))
                    {
                        <div class="row std-mng-head">

                            <div class="col-md-12 class-section">
                                <div class="row">

                                    <div class="col-md-3 padding">

                                    </div>
                                    <div class="col-md-5 padding">
                                        <label class="col-md-4 text-right">Payment Mode :</label>
                                        <div class="col-md-8">
                                            <select class="form-control" ID="ddlMainSessions" name="PaymentMode">
                                                <option value="-1">--All Modes--</option>
                                                @foreach (PaymentModeModel e in Model.PaymentModes)
                                                {
                                                    <option value="@e.PaymentModeID" @(e.PaymentModeID == Model.PaymentMode ? "Selected" : "")>@e.PaymentModeName </option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 padding">
                                        <div class="row">
                                            <label class="col-md-3 text-right padding-R">Month : </label>
                                            <div class="col-md-7 padding-L" style="padding-left: 10px;">

                                                <input type="month" class="form-control" name="FromDate" value="@Model.FromDate.ToString("yyyy-MM")" />
                                                <input type="hidden" name="ReportType" value="1" />
                                                <input type="hidden" name="PaymentMode" value="-1" />

                                            </div>
                                            <div class="col-md-2">
                                                <a onclick="$('#frmGetExams').submit();" ID="lbGetList"><i class="fa fa-search"></i></a>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    }
                </div>
                <div class="box-body">
                    <table id="PaymentsTable" class="table table-striped payments">
                        <thead>
                            <tr>
                                <th style="width:13%">Date</th>
                                <th style="width:13%">Reciept Nos</th>
                                @foreach (var com in Model.FeeType)
                                {
                                    <th>@com.Name</th>
                                }
                            <th style="width:10%">Recieved Amount</th>
                                <th style="width:10%">Refund Amount</th>
                                <th style="width:10%"> Amount</th>
                            </tr>
                        </thead>
                        @{
                            int count = 0;
                            decimal TotalPayment = 0;
                            decimal TotalRefund = 0;
                            decimal TotalAmount = 0;
                            decimal dTotalRefund = 0;

                            for (var ld = Model.FromDate; ld <= Model.ToDate; ld = ld.AddDays(1))
                            {
                                decimal dTotalPayment = 0;
                                TotalRefund = TotalRefund + dTotalRefund;



                                                <tr>
                                                    <td>@ld.ToString("dd MMM,yyyy")</td>
                                                    @{
                                                        var td = Model.FeeReportType.Where(d => d.PaymentDate == ld).FirstOrDefault();
                                                        if (td != null)
                                                        {
                                                            <td>@td.PaymentNoRange</td>
                                                        }
                                                        else
                                                        {
                                                            <td>-</td>
                                                        }
                                                    }
                                                    @foreach (var FeeT in Model.FeeType)
                                                    {
                                                        var rep = Model.FeeReportType.Where(d => d.FeeTypeID == FeeT.ID && d.PaymentDate == ld).Sum(x => x.PaymentRecieved);
                                                        var repRefund = Model.FeeReportType.Where(d => d.FeeTypeID == 0 && d.PaymentDate == ld).Sum(x => x.RefundAmount);

                                                        FeeT.Sum = FeeT.Sum + rep;
                                                        dTotalPayment = dTotalPayment + rep;
                                                        TotalPayment = TotalPayment + dTotalPayment;
                                                        dTotalRefund = repRefund;
                                                        <td> <i class="fa fa-inr" aria-hidden="true"></i> @rep</td>

                                                    }
                                                    <td>
                                                        <i class="fa fa-inr" aria-hidden="true"></i> @dTotalPayment.ToString("N2")
                                                    </td>
                                                    <td>
                                                        <i class="fa fa-inr" aria-hidden="true"></i> @dTotalRefund.ToString("N2")
                                                    </td>
                                                    <td>
                                                        @{
                                                            decimal payAmount = dTotalPayment;
                                                            decimal refAmount = dTotalRefund;

                                                            var Amount = payAmount - refAmount;
                                                        }
                                                        @Amount.ToString("N2")
                                                    </td>
                                                </tr>
                                count++;
                            }

                        }
                        <tfoot>
                            <tr style="background-color: #606d73;color: white;">
                                <td colspan="2">
                                    <b> Total Collection</b>
                                </td>
                                @foreach (var com in Model.FeeType)
                                {
                                    <td>@com.Sum</td>
                                }
                                <td><b> <i class="fa fa-inr" aria-hidden="true"></i> @((Model.FeeType.Sum(x => x.Sum)).ToString("N2"))</b></td>
                                <td><b> <i class="fa fa-inr" aria-hidden="true"></i> @TotalRefund.ToString("N2")</b></td>
                                <td><b> <i class="fa fa-inr" aria-hidden="true"></i> @(((Model.FeeType.Sum(x => x.Sum)) - TotalRefund).ToString("N2"))</b></td>
                            </tr>
                        </tfoot>
                    </table>

                </div>
            </div>
        </div>
    </div>

</section>
@section scripts
{
    <script src="@Url.Content("~/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>

    <script src="@Url.Content("~/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.print.min.js")"></script>

    <script src="@Url.Content("~/js/jszip.min.js")"></script>
    <script src="@Url.Content("~/js/pdfmake.min.js")"></script>
    <script src="@Url.Content("~/js/vfs_fonts.js")"></script>
    <script>
        $(document).ready(function () {
               var repname = '@PermissionManager.GetLoggedInUser().Description' + '<br /> Date wise Student Records ';
            var handleDataTableButtons = function () {
                if ($("#PaymentsTable").length) {
                    $("#PaymentsTable").DataTable({
                        "paging": true,
                        "pageLength": 31,
                        dom: "Bfrtip",
                        buttons: [
                            {
                                extend: "copy",
                                className: "btn-sm",
                                footer: true,
                                title: repname
                            },
                            {
                                extend: "csv",
                                className: "btn-sm",
                                footer: true,
                                title: repname
                            },
                            {
                                extend: "excel",
                                className: "btn-sm",
                                footer: true,
                                title: repname
                            },
                            {
                                extend: "pdfHtml5",
                                className: "btn-sm",
                                footer: true,
                                title: repname
                            },
                            {
                                extend: "print",
                                className: "btn-sm",
                                footer: true,
                                title: repname
                            },
                        ],
                        responsive: true
                    });
                }
            };


            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                };
            }();

            TableManageButtons.init();
        });
        $(function () {
            $('#liReportDatewiseMonthlyFeeCollection').closest('ul').closest('li').addClass('active');
            $('#liReportDatewiseMonthlyFeeCollection').addClass('active');

        });
    </script>
}
<!-- /.content -->