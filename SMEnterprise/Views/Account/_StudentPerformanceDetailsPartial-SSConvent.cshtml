                                                                                Working Days : <input type="text" class="form-control" name="PerformanceParameters[@mainCounter].Grade" value="@s.Grade" />
                                                                                <aa class="print"> @s.Grade</aa>
                                                                            </td>
                                                                        </tr>
                                                                        mainCounter++;
                                                                    }
                                                                }
                                                            }
                                                        </table>
                                                    </td>
