    <script>
        $(document).ready(function () {
           // var repname = '@PermissionManager.GetLoggedInUser().Description' +'<br /> Student Records ' + $('#ddlSessions option:selected').text() + ' ' + $('#ddlClass option:selected').text() + ' ' + $('#ddlSection option:selected').text();

            var handleDataTableButtons = function () {
                 var printdate='Print Date: @SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd/MM/yyyy  hh:mm:ss tt")';
                var rpname = 'Student New Admission Records :' + $('#ddlSessions option:selected').text() ;
            var repname = 'Report Generate on: ' + '@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd-MM-yyy hh:mm:ss tt")'

                if ($("#tblCategory").length) {
                    $("#tblCategory").DataTable({
                        "pageLength": 100,
                        bSort: true,
                        dom: "Bfrtip",
                        buttons: [
                            {
                                extend: "copy",
                                className: "btn-sm",
                                footer: true,
                                text: '<i class="fa fa- copy"></i> Copy',

                                message: printdate,
                                messageTop: '@Model.Branches.BranchSchoolName',
                            messageBottom: repname,
                            title: rpname
                            },
                            {
                                extend: "csv",
                                className: "btn-sm",
                                text: '<i class="fas fa-file-csv"></i> CSV',
                                 footer: true,
                          message: printdate,
                            messageTop: '@Model.Branches.BranchSchoolName',
                            messageBottom: repname,
                            title: rpname
                            },
                            {
                                extend: "excel",
                                className: "btn-sm",
                                text: '<i class="fa fa-table fainfo" aria-hidden="true"></i> Excel',
                                footer: true,
                         messageTop: rpname,
                          messageBottom: repname,
                          title: '@Model.Branches.BranchSchoolName'
                            },
                            {
                                extend: "pdfHtml5",
                                className: "btn-sm",
                                text: '<i class="fa fa-file-pdf-o"></i> Pdf',
                                footer: true,
                          orientation: 'landscape',
                          customize: function (doc) {

                              doc.defaultStyle.fontSize = 7;
                              doc.styles.tableHeader.fontSize = 10;

                              doc['header'] = (function () {
                                  return {
                                      columns: [
                                          {
                                              alignment: 'left',
                                              italics: true,
                                              text: '@Model.Branches.BranchSchoolName',
                                              fontSize: 14,
                                              margin: [0, 0]
                                          }
                                      ],
                                      margin: 20
                                  }
                              });
                          },
                          message: printdate,
                          messageBottom: repname,
                          title: rpname
                            },
                            {
                                extend: "print",
                                className: "btn-sm",
                                text: '<i class="fa fa-print"></i> Print',
                                 footer: true,
                                message: rpname,
                          messageTop: rpname,
                          messageBottom: repname,
                          title: '@Model.Branches.BranchSchoolName'
                            },
                        ],
                        responsive: true
                    });
                }
            };
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                };
            }();
            TableManageButtons.init();

        });
    </script>
}
