@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    ViewBag.Title = "StudentAdmissionReport";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model SMEnterprise.Models.StudentAdmissionReportModel
@section IncludeCss
{
    <title>Student New Admission Report</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">

}

<style>
    .btn {
        padding: 3px 6px;
    }


    #tblAdmission > tbody > tr > td {
        vertical-align: middle;
    }

    table.dataTable tbody td {
        word-break: break-word;
        vertical-align: top;
    }
</style>

<section class="content-header">
    <h1>
        Student New Admission Report

    </h1>
    <ol class="breadcrumb">
        <li><a href=""><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Student New Admission Report</li>
    </ol>
</section>

<!-- Main content -->

<div class="">

    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12">
            @using (Html.BeginForm("StudentAdmissionReport", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
            {
                <div class="row std-mng-head">

                    <div class="col-md-12 class-section">
                        <div class="row">
                            <div class="col-md-3 padding">
                                <label class="col-md-4 text-right">Session :</label>
                                <div class="col-md-8">
                                    <select class="form-control" name="SessionID" id="ddlSessions">
                                        <option value="0">--Select Session--</option>
                                        @foreach (NameIDModel el in Model.Sessions)
                                        {
                                            <option value="@el.ID" @(el.ID == Model.SessionID ? "selected" : "")>@el.Name @(el.Extra1=="1"?"(Active)":"")</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            @*<div class="col-md-3 form-group">
                                    <label>Select Month:<small>(mm/yyyy)</small><span class="tx-danger">*</span></label>
                                    <input type="month" name="StartDate" class="form-control" id="txtStartDate" placeholder="Enter Name" value="@Model.StartDate.ToString("yyyy-MM")" required>
                                </div>*@
                            <div class="col-md-4 form-group">
                                <label class="col-md-5 text-right">From Date: <small>(dd/mm/yyyy)</small><span class="tx-danger">*</span></label>
                                <div class="col-md-7">
                                    <input type="date" name="StartDate" class="form-control" id="txtfromDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" required>
                                </div>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="col-md-5 text-right">To Date: <small>(dd/mm/yyyy)</small><span class="tx-danger">*</span></label>
                                <div class="col-md-7">
                                    <input type="date" name="EndDate" class="form-control" id="txtToDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" required>
                                </div>
                            </div>
                            <div class="col-md-1 form-group">
                                <button type="submit" class="btn btn-primary">Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="x_panel">
                <div class="x_content">

                    <table id="tblCategory" class="table table-bordered table-hover display nowrap" style="overflow-x: scroll;width: 100%;display: inline-block;">
                        <thead>
                            <tr>
                                <th>Seq</th>
                                <th>Student Name  </th>
                                <th>Student ID  </th>
                                <th>SR.No.</th>
                                <th>Gender</th>
                                <th>Class</th>
                                <th>Section</th>
                                <th>Admission Date</th>
                                <th>Date of Birth</th>
                                <th><b>User Name</b></th>
                                <th>Father Name </th>
                                <th>Father Contact No</th>
                                <th>Mother Name </th>
                                <th>Mother Contact No</th>
                            </tr>
                        </thead>
                        @{
                            int count = 0;
                            foreach (var c in Model.StudentDetail)

                            {
                                <tr>
                                    <td>@(count + 1)</td>
                                    <td>@c.Name </td>
                                    <td>@c.StudentSID</td>
                                    <td>@c.SchoolUID</td>
                                    <td>
                                        @if (@c.Gender != 0)
                                        {
                                            <label>Female</label>
                                        }
                                        else
                                        {
                                            <label>Male</label>
                                        }
                                    </td>
                                    <td> @c.ClassName</td>
                                    <td>@c.SectionName</td>
                                    <td>@c.DOJ.ToString("dd/MM/yyyy")</td>
                                    <td>@c.DOB.ToString("dd/MM/yyyy")</td>
                                    <td style="color:dodgerblue;"><b>@c.SParentID</b></td>
                                    <td> @c.FatherName</td>
                                    <td> @c.FatherMobileNo</td>
                                    <td>@c.MotherName</td>
                                    <td>@c.MotherMobileNo</td>


                                </tr>

                                count++;
                            }

                        }
                    </table>


                </div>
            </div>
        </div>
    </div>
</div>



