
@{
    ViewBag.Title = "StudentAdmissionReport";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@section IncludeCss
{
    <title>Student New Admission Report</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
}

@model SMEnterprise.Models.StudentAdmissionReportModel
<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    .thumbImage {
        max-width: 235px;
        max-height: 250px;
    }

    *html .thumbImage {
        width: expression((this.width/this.height)>=1?250:'auto');
        height: expression((this.width/this.height)<1?250:'auto');
    }
</style>

<section class="content-header">
    <h1>
        Student New Admission Report
      
    </h1>
    <ol class="breadcrumb">
        <li><a href=""><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Student New Admission Report</li>
    </ol>
</section>

<section class="content">
    <!-- Small boxes (Stat box) -->
    @using (Html.BeginForm("StudentAdmissionReport", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
    {
        <div class="row">
            <div class="col-md-3 form-group">
                <label>Session</label>
                <select class="form-control" name="SessionID">
                    @foreach (var s in Model.Sessions)
                    {
                        <option value="@s.ID" @(s.ID == Model.SessionID ? "selected" : "")>@s.Name @(s.Extra1 == "1" ? "(Active)" : "")</option>
                    }
                </select>
            </div>
            <div class="col-md-3 form-group">
                <label>Select Month:<small>(mm/yyyy)</small><span class="tx-danger">*</span></label>
                <input type="month" name="StartDate" class="form-control" id="txtStartDate" placeholder="Enter Name" value="@Model.StartDate.ToString("yyyy-MM")" required>
            </div>
            @*<div class="col-md-3 form-group">
                    <label>Class</label>
                    <select class="form-control" name="ClassID" id="ddlClass" onchange="javascript:ClassChanged(this);">
                        @foreach (var s in Model.Classes)
                        {
                            <option value="@s.ID" @(s.ID == Model.ClassID ? "selected" : "")>@s.Name</option>
                        }
                    </select>
                </div>*@

            <div class="col-md-3 form-group">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </div>
    }
    <div class="row">
        <div class="col-xs-12">

            <div class="box-body">
                <table id="tblAdmission" class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Seq</th>

                            <th>Student Name  </th>
                            <th>Student ID  </th>
                            <th>SR.No.</th>
                            <th>Gender</th>
                            <th>Class</th>
                            <th>Section</th>
                            <th>Admission Date</th>
                            <th>Date of Birth</th>
                            <th><b>User Name</b></th>
                            <th>Father Name </th>
                            <th>Father Contact No</th>
                            <th>Mother Name </th>
                            <th>Mother Contact No</th>
                        </tr>
                    </thead>
                    @{
                        int count = 0;
                        foreach (var c in Model.StudentDetail)

                        {
                                        <tr>
                                            <td>@(count + 1)</td>
                                            <td>
                                                @c.Name 
                                            </td>
                                            <td>
                                                @c.StudentSID
                                            </td>
                                            <td>  @c.SchoolUID</td>


                                            <td>
                                                @if (@c.Gender != 0)
                                                {
                                                    <label>Female</label>
                                                }
                                                else
                                                {
                                                    <label>Male</label>
                                                }
                                            </td>
                                            <td>
                                                @c.ClassName
                                            </td>
                                            <td>

                                                @c.SectionName
                                            </td>
                                            <td>@c.DOJ.ToString("dd/MM/yyyy")</td>
                                            <td>@c.DOB.ToString("dd/MM/yyyy")</td>
                                            <td style="color:dodgerblue;">

                                                <b>@c.SParentID</b>

                                            </td>
                                            <td>
                                                @c.FatherName
                                            </td>
                                            <td>
                                                @c.FatherMobileNo
                                            </td>
                                            <td>
                                                @c.MotherName
                                            </td>
                                            <td>
                                                @c.MotherMobileNo
                                            </td>


                                        </tr>

                            count++;
                        }

                    }
                </table>

            </div>
        </div>
    </div>

</section>


@section scripts
{
    <script src="@Url.Content("~/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.flash.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.print.min.js")"></script>
    <script src="@Url.Content("~/js/jszip.min.js")"></script>
    <script src="@Url.Content("~/js/pdfmake.min.js")"></script>
    <script src="@Url.Content("~/js/vfs_fonts.js")"></script>
    <script>
        $(document).ready(function () {
            var handleDataTableButtons = function () {
                if ($("#tblAdmission").length) {
                    $("#tblAdmission").DataTable({
                        dom: "Bfrtip",
                        "paging": true,
                     //   "ordering": false
                        "pageLength": 50,
                        buttons: [
                            {
                                extend: "copy",
                                className: "btn-sm",
                                footer: true
                            },
                            {
                                extend: "csv",
                                className: "btn-sm",
                                footer: true
                            },
                            {
                                extend: "excel",
                                className: "btn-sm",
                                footer: true
                            },
                            {
                                extend: "pdfHtml5",
                                className: "btn-sm",
                                footer: true
                            },
                            {
                                extend: "print",
                                className: "btn-sm",
                                footer: true
                            },
                        ],
                        responsive: true
                    });
                }
            };

            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                };
            }();

            TableManageButtons.init();
        });
       
    </script>
}
