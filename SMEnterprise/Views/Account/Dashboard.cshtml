
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model SMEnterprise.Models.AccountDashboardModel
@section IncludeCss
{
    <title>P-School | Dashboard</title>
    <style>
        .table td {
            padding: 0px !important;
        }
        .tile-stats .count {
            font-size: 24px;
        }

        .tile_count {
            background-color: white;
            padding-top: 5px;
            border-radius: 5px;
            border: 1px solid #E4E4E4;
        }
        .tile-stats .icon {
    color: #019ae6;
}
    </style>
}
    <section class="content" style="min-height: 0px;padding-top: 0px;">
        <div class="">

            <div class="row top_tiles">
                <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <a href="/Account/SearchStudents">
                        <div class="tile-stats">
                            <div class="icon"><i class="fa fa-search"></i></div>
                            <div class="count">Search</div>
                            <h3>Student</h3>
                            <p>Click Here to Search Student</p>
                        </div>
                    </a>
                </div>
                <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <a href="/Account/StudentDetails">
                        <div class="tile-stats">
                            <div class="icon" style="margin-right: 10px;"><i class="fa fa-graduation-cap"></i></div>
                            <div class="count">Add</div>
                            <h3>Student</h3>
                            <p>Click Here to add New Student</p>
                        </div>
                    </a>
                </div>
                <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <a href="/Account/EmployeeDetails">
                        <div class="tile-stats">
                            <div class="icon"><i class="fa fa-user-plus"></i></div>
                            <div class="count">Add</div>
                            <h3>Employee</h3>
                            <p>Click Here to add New Employee</p>
                        </div>
                    </a>
                </div>
                <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <a href="/Account/StudentsFee">
                        <div class="tile-stats">
                            <div class="icon"><i class="fa fa fa-money"></i></div>
                            <div class="count">Recieve</div>
                            <h3>Fee</h3>
                            <p>Click Here to recieve Fee</p>
                        </div>
                    </a>
                </div>
                <div class="animated flipInY col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <a href="/Account/SchoolSubscription">
                        <div class="tile-stats">
                            <div class="icon"><i class="fa fa-credit-card"></i></div>
                            <div class="count">ERP</div>
                            <h3>Subscription</h3>
                            <p>View receipt and pay due amount</p>
                        </div>
                    </a>
                </div>
            </div>
            <div class="row" style="margin-left: 0px;margin-right: 0px;">
                @{
                    var MaleStudent = 0;
                    var FemaleStudent = 0;
                    foreach (SMEnterprise.Models.NameIDModel s in Model.Students)
                    {
                        if (s.Name == "0")
                        {
                            MaleStudent = s.ID;
                        }
                        else
                        {
                            FemaleStudent = s.ID;
                        }
                    }
                    <div class="tile_count col-md-6">
                        <div class="col-md-4 col-sm-4 col-xs-6 tile_stats_count">
                            <span class="count_top"><i class="fa fa-graduation-cap"></i> Total Students</span>
                            <div class="count"><i class="fa fa-graduation-cap"></i> @(MaleStudent + FemaleStudent)</div>
                            <span class="count_bottom">Active Students</span>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-6 tile_stats_count">
                            <span class="count_top"><i class="fa fa-graduation-cap"></i> Male Students</span>
                            <div class="count"><i class="fa fa-male"></i> @MaleStudent</div>
                            <span class="count_bottom"><i class="green"><i class="fa fa-sort-asc"></i> @((MaleStudent * 100 / ((MaleStudent + FemaleStudent == 0 ? 1 : MaleStudent + FemaleStudent))).ToString("00"))% </i> of Total</span>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-6 tile_stats_count">
                            <span class="count_top"><i class="fa fa-graduation-cap"></i> Female Students</span>
                            <div class="count"><i class="fa fa-male"></i> @FemaleStudent</div>
                            <span class="count_bottom"><i class="green"><i class="fa fa-sort-asc"></i> @((FemaleStudent * 100 / ((MaleStudent + FemaleStudent == 0 ? 1 : MaleStudent + FemaleStudent))).ToString("00"))% </i> of Total</span>
                        </div>
                    </div>
                }
                <div class="tile_count col-md-6" style="color:#6b6b6b">
                    @{
                        var MaleEmployee = 0;
                        var FemaleEmployee = 0;
                        foreach (SMEnterprise.Models.NameIDModel e in Model.Employees)
                        {
                            if (e.Name == "0")
                            {
                                MaleEmployee = e.ID;
                            }
                            else
                            {
                                FemaleEmployee = e.ID;
                            }
                        }
                        <div class="col-md-4 col-sm-4 col-xs-6 tile_stats_count">
                            <span class="count_top"><i class="fa fa-user"></i> Total Employees</span>
                            <div class="count"><i class="fa fa-user"></i> @(MaleEmployee + FemaleEmployee)</div>
                            <span class="count_bottom">Active Employees</span>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-6 tile_stats_count">
                            <span class="count_top"><i class="fa fa-user"></i> Male Employees</span>
                            <div class="count"><i class="fa fa-male"></i> @MaleEmployee</div>
                            <span class="count_bottom"><i class="green"><i class="fa fa-sort-asc"></i> @((MaleEmployee * 100 / ((MaleEmployee + FemaleEmployee == 0 ? 1 : MaleEmployee + FemaleEmployee))).ToString("00"))% </i> of Total</span>
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-6 tile_stats_count">
                            <span class="count_top"><i class="fa fa-user"></i> Female Employees</span>
                            <div class="count"><i class="fa fa-female"></i> @FemaleEmployee</div>
                            <span class="count_bottom"><i class="green"><i class="fa fa-sort-asc"></i> @((FemaleEmployee * 100 / ((MaleEmployee + FemaleEmployee == 0 ? 1 : MaleEmployee + FemaleEmployee))).ToString("00"))% </i> of Total</span>
                        </div>
                    }
                </div>
                <div class="tile_count col-md-6">
                    <a href="/Account/StockManagement" class="col-md-6 col-sm-6 col-xs-6 tile_stats_count">
                        <span class="count_top"><i class="fa fa-money"></i> Sale Amount</span>
                        <div class="count"><i class="fa fa-mail-reply"></i> @(Model.MonthlySale.ToString("0.00"))K</div>
                        <span class="count_bottom">Monthly Sales</span>
                    </a>
                    <a href="/Account/StockManagement" class="col-md-6 col-sm-6 col-xs-6 tile_stats_count">
                        <span class="count_top"><i class="fa fa-money"></i> Paid Amount</span>
                        <div class="count"><i class="fa fa-mail-forward"></i> @Model.MonthlyPurchase.ToString("0.00")K</div>
                       
                        <span class="count_bottom">Monthly Purchase</span>
                    </a>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>Fee Collection <small>Monthly Classwise (in Thousands)</small><small id="smTotalAmount"></small></h2>
                            <div class="filter">
                                <div id="reportrange" class="pull-right" style="background: #fff; cursor: pointer; padding: 5px 10px; border: 1px solid #ccc">
                                    <i class="glyphicon glyphicon-calendar fa fa-calendar"></i>
                                    <input type="month" onchange="FeeMonthChanged();" id="txtFeeChartMonth" value="@Model.Year-@(Model.Month.ToString().PadLeft(2, '0'))" style="border: white;" />
                                </div>
                            </div>
                            <div class="clearfix"></div>
                        </div>
                        <div class="x_content">
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="demo-container" id="FeeChartContaiiner">
                                    <canvas id="FeeCollectionChart" class="demo-placeholder"></canvas>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>

        </div>
    </section>
        @section scripts
{
            <script src="@Url.Content("~/js/Chart.min.js")"></script>
            <script>
        var chartData=@Html.Raw(Json.Encode(Model.FeeCollection));
        var canvas = document.getElementById("FeeCollectionChart");
        var lineChartParent = document.getElementById('FeeChartContaiiner')
        canvas.width = lineChartParent.clientWidth;
        canvas.height = 325;
        var total = 0;
        function DrawAttandanceChart() {
            new Chart(document.getElementById("FeeCollectionChart"), {
                type: 'line',
                data: chartData,
                options: {
                    tooltips: {
                        mode: 'label'
                    },
                    responsive: false,
                    scales: {
                        yAxes: [{
                            ticks: {
                                beginAtZero: true
                            }
                        }]
                    }
                }
            });
            total=0;
            for(var i=0;i<chartData.datasets[0].data.length;i++)
            {
                total=total+chartData.datasets[0].data[i];
            }
            $('#smTotalAmount').html('Rs '+parseFloat(total).toFixed(2) +' Thousands');
        }
        $(function() {
            DrawAttandanceChart();
        });
        function FeeMonthChanged()
        {
            var MonYear=$('#txtFeeChartMonth').val().split('-');
            $.ajax(
            {
                type: "POST",
                url: "@Url.Action("GetDashboardFeeChartData", "Account")",
                processData: false,
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({
                    Month: MonYear[1],
                    Year:MonYear[0]
                }),
                success: function (data) {
                    chartData=data.FeeCollection;
                    DrawAttandanceChart();
                },
                error: function (e) {
                    alert("errorn");
                }
});
        }
            </script>

        }
