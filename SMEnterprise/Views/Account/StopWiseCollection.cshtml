@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    var stopWiseReport = Model.StopWiseReport ?? new List<StopWiseStudentAmountModel>();
    var totalStudents = 0;
    var totalAmount = 0M;
    foreach (var row in stopWiseReport)
    {
        totalStudents += row.Students;
        totalAmount += row.Amount;
    }
    var branchSchoolName = Model.Branch == null ? "" : Model.Branch.BranchSchoolName;
}
@model SMEnterprise.Models.BusStudentListModel
@section IncludeCss
{
    <title>Stop Wise Collection</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">
}

<style>
    .btn {
        padding: 3px 6px;
    }


    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("StopWiseCollection", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetReport" }))
                {
                    <div class="row std-mng-head">

                        <div class="col-md-12 class-section">
                            <div class="row">

                                <div class="col-md-6 padding">
                                    <label class="col-md-4 text-right"></label>
                                    <div class="col-md-8">

                                    </div>
                                </div>
                                <div class="col-md-5 padding">
                                    <div class="row">
                                        <label class="col-md-3 text-right padding-R">Month : </label>
                                        <div class="col-md-7 padding-L" style="padding-left: 10px;">
                                            <input type="month" value="@Model.SelectedDate.ToString("yyyy-MM")" name="SelectedDate" id="dtMonth" class="form-control" onchange="ExpenceMonthChanged();" />
                                        </div>
                                        <div class="col-md-2">
                                            <a href="javascript:void(0);" onclick="$('#frmGetReport').submit();"><i class="fa fa-search"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>
                }
                <div class="x_panel">

                    <div class="x_content">

                        <table id="tblCategory" class="table table-bordered table-hover display nowrap" style="overflow-x: scroll;width: 100%;">
                            <thead>
                                <tr>
                                    <th>Sr.No</th>
                                    <th>Bus</th>
                                    <th>Stopage Name</th>
                                    <th>Stopage Amount</th>
                                    <th>No. Of Student</th>
                                    <th>Total Amount</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th colspan="4" style="text-align:right;">Total Student</th>
                                    <th>@totalStudents</th>
                                    <th></th>
                                </tr>
                                <tr>
                                    <th colspan="5" style="text-align:right;">Total Amount</th>
                                    <th>@totalAmount.ToString("0.00")</th>
                                </tr>
                            </tfoot>
                            @{
                                int count = 0;
                                foreach (StopWiseStudentAmountModel c in stopWiseReport)
                                {
                                    var busStop = (c.AreaName ?? "").Split(new[] { "||" }, StringSplitOptions.None);
                                    var busName = busStop.Length > 1 ? busStop[0] : "";
                                    var stopName = busStop.Length > 1 ? busStop[1] : c.AreaName;
                                                        <tr>

                                                            <td>
                                                                @(count + 1)
                                                            </td>
                                                            <td>
                                                                @busName
                                                            </td>
                                                            <td>
                                                                @stopName
                                                            </td>
                                                            <td>
                                                                @c.Rate
                                                            </td>
                                                            <td>
                                                                @c.Students
                                                            </td>
                                                            <td>
                                                                @c.Amount.ToString("0.00")
                                                            </td>



                                                        </tr>

                                    count++;
                                }

                            }
                        </table>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{

    @*<script src="@Url.Content("~/js/Admin/jquery.dataTables.min.js")"></script>
        <script src="@Url.Content("~/js/dataTables.bootstrap.min.js")"></script>*@
    <script src="@Url.Content("https://cdn.datatables.net/buttons/2.1.0/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("https://cdn.datatables.net/buttons/2.1.1/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("https://cdn.datatables.net/buttons/2.1.1/js/buttons.print.min.js")"></script>
    <script src="@Url.Content("https://cdnjs.cloudflare.com/ajax/libs/jszip/2.5.0/jszip.min.js")"></script>
    <script src="@Url.Content("https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/pdfmake.min.js")"></script>
    <script src="@Url.Content("https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/vfs_fonts.js")"></script>

    @*<script src="@Url.Content("~/js/dataTables.buttons.min.js")"></script>
        <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>

        <script src="@Url.Content("~/js/buttons.html5.min.js")"></script>
        <script src="@Url.Content("~/js/buttons.print.min.js")"></script>

        <script src="@Url.Content("~/js/jszip.min.js")"></script>
        <script src="@Url.Content("~/js/pdfmake.min.js")"></script>
        <script src="@Url.Content("~/js/vfs_fonts.js")"></script>*@
    <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>
    <script>
        function ExpenceMonthChanged() {
            var monthyear = $('#dtMonth').val().split('-');
            var sMonth = parseInt(monthyear[1]);
            var sYear = parseInt(monthyear[0]);

            var cMonth = parseInt($('#hdnCurrentMonth').val());
            var cYear = parseInt($('#hdnCurrentYear').val());
            if (sMonth + sYear * 12 > cMonth + cYear * 12) {
                ShowNotification('error', 'Month Should be less then Current Month', 'error');
                if (cMonth < 10) {
                    $('#dtMonth').val(cYear + '-0' + cMonth);
                }
                else {
                    $('#dtMonth').val(cYear + '-' + cMonth);
                }
            }
        }
        $(document).ready(function () {
            var handleDataTableButtons = function () {
                 var printdate='Print Date: @SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd/MM/yyyy  hh:mm:ss tt")';
                var rpname = 'Student Stop Collection : ' + $('#ddlHouses option:selected').text();
            var repname = 'Report Generate on: ' + '@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd-MM-yyy hh:mm:ss tt")'

                if ($("#tblCategory").length) {
                    $("#tblCategory").DataTable({
                        "pageLength": 100,
                        bSort: true,
                        dom: "Bfrtip",
                        buttons: [
                            {
                                extend: "copy",
                                className: "btn-sm",
                                footer: true,
                                text: '<i class="fa fa- copy"></i> Copy',

                            message: printdate,
                             messageTop: '@branchSchoolName',
                            messageBottom: repname,
                            title: rpname
                            },
                            {
                                extend: "csv",
                                className: "btn-sm",
                                text: '<i class="fas fa-file-csv"></i> CSV',
                                 footer: true,
                          message: printdate,
                            messageTop: '@branchSchoolName',
                            messageBottom: repname,
                            title: rpname
                            },
                            {
                                extend: "excel",
                                className: "btn-sm",
                                text: '<i class="fa fa-table fainfo" aria-hidden="true"></i> Excel',
                                footer: true,
                         messageTop: rpname,
                          messageBottom: repname,
                          title: '@branchSchoolName'
                            },
                            {
                                extend: "pdfHtml5",
                                className: "btn-sm",
                                text: '<i class="fa fa-file-pdf-o"></i> Pdf',
                                footer: true,
                          orientation: 'landscape',
                          customize: function (doc) {

                              doc.defaultStyle.fontSize = 7;
                              doc.styles.tableHeader.fontSize = 10;

                              doc['header'] = (function () {
                                  return {
                                      columns: [
                                          {
                                              alignment: 'left',
                                              italics: true,
                                              text: '@branchSchoolName',
                                              fontSize: 14,
                                              margin: [0, 0]
                                          }
                                      ],
                                      margin: 20
                                  }
                              });
                          },
                          message: printdate,
                          messageBottom: repname,
                          title: rpname
                            },
                            {
                                extend: "print",
                                className: "btn-sm",
                                text: '<i class="fa fa-print"></i> Print',
                                 footer: true,
                          message: printdate,
                          messageTop: rpname,
                          messageBottom: repname,
                          title: '@branchSchoolName'
                            },
                        ],
                        responsive: true
                    });
                }
            };

            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                };
            }();

            TableManageButtons.init();
        });

    </script>

}
