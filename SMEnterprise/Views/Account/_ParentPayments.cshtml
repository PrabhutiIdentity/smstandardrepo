@model List<SMEnterprise.Models.FeePaymentModel>

@foreach(var p in Model)
{
    <tr>
        <td>@p.PaymentRecieptNo</td>
        <td>@p.PaymentDate.ToString("dd MMM, yyyy")</td>
        <td>@p.PaymentAmount</td>
        <td> <a href="javascript:void(0);" class="btn btn-link" onclick="PrintReciept(@p.PaymentID)"> Print</a></td>
    </tr>
}
@if(Model.Count()==0)
{
    <tr><td colspan="4" style="text-align:center">No Payments Found</td></tr>
}
