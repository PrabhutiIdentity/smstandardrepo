<div class="x_panel">

    <div class="x_content">
        @{
            decimal TotalRemaining = 0;
            <div class="row monthList">
                <input type="hidden" id="hdnMonth" value="@Model.Month" />
                <input type="hidden" id="hdnYear" value="@Model.Year" />
                <input type="hidden" id="hdnSaveSessionID" value="@Model.SessionID" />
                <div class="block">
                    <div id='radios' style='width: 100%!important;'>
                        @{
                            var Status = 0;
                            var counter = 1;
                            var MonthsName = "";
                            var isChecked = false;
                            while (Model.SessionStartDate < Model.SessionEndDate)
                            {

                                if (Status == 0 && Model.SessionStartDate.Month == Model.Months[0].Month)
                                {
                                    Status = 1;
                                }
                                if (counter <= Model.FeePaymentMode)
                                {
                                    if (MonthsName != "")
                                    {
                                        MonthsName = MonthsName + ", ";
                                    }
                                    MonthsName = MonthsName + Model.SessionStartDate.ToString("MMM");
                                }
                                if (counter == Model.FeePaymentMode)
                                {
                                    counter = 0;
                                    <input id='rbMonth_@Model.SessionStartDate.Month' month="@Model.SessionStartDate.Month" year="@Model.SessionStartDate.Year" name='options' @(isChecked ? "checked" : "" ) @(Status == 0 ? "disabled" : "") type="radio">
                                    <label for='rbMonth_@Model.SessionStartDate.Month' month="@Model.SessionStartDate.Month" year="@Model.SessionStartDate.Year">@MonthsName</label>
                                    MonthsName = "";
                                    if (Model.SessionStartDate.Month == Model.Month)
                                    {
                                        isChecked = true;
                                    }
                                    else if (isChecked)
                                    {
                                        isChecked = !isChecked;
                                    }
                                }

                                counter++;
                                Model.SessionStartDate = Model.SessionStartDate.AddMonths(1);
                            }
                        }
                        <script>
                            $("div[id^='radios']").radiosToSlider();
                            $('ins').on('click', function () {
                                var $radio = $('#' + $(this).attr('data-radio'));
                                MonthChanged($radio, $radio.attr('month'), $radio.attr('year'));
                            });
                            $('.slider-label').on('click', function () {
                                MonthChanged($(this), $(this).attr('month'), $(this).attr('year'));

                            });
                        </script>
                    </div>
                </div>

            </div>

            <div class="row" style="padding-top: 5px;">
                <table id="tblCategory" class="table table-bordered table-hover">
                    <thead>
                        <tr style="background-color: #e0e0e0;">
                            <th style="width: 15%;vertical-align: middle;">Fee Type</th>
                            @{
                                MonthsName = "";
                                var adjuster = 0;
                                foreach (SMEnterprise.Models.PayDetailMonthsModel pm in Model.Months)
                                {
                                    for (int i = 0; i < Model.FeePaymentMode; i++)
                                    {
                                        if (MonthsName != "")
                                        {
                                            MonthsName = MonthsName + ", ";
                                        }
                                        MonthsName = MonthsName + new DateTime(pm.Year, pm.Month, 1).AddMonths(i + adjuster).ToString("MMM");
                                    }

                                    if (pm.PaymentRecieved == 0)
                                    {
                                        <th style="vertical-align: middle;">@MonthsName <label class='badge bg-red'>Due</label><br /><a href="javascript:void(0);" onclick="OpenFeeDiscountForm(@pm.Month,@pm.Year);">Request Discount</a></th>

                                    }
                                    else if (pm.PaymentRecieved >= pm.ApplicableFee - pm.Waiver)
                                    {
                                        <th style="vertical-align: middle;">@MonthsName <label class='badge bg-green'>Paid</label></th>
                                    }
                                    else
                                    {
                                        <th style="vertical-align: middle;">@MonthsName <label class='badge bg-blue'>Partial</label></th>
                                    }

                                    MonthsName = "";
                                    adjuster = 1;
                                }
                            }
                            <th style="vertical-align: middle;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (SMEnterprise.Models.NameIDModel ft in Model.FeeTypes)
                        {
                            decimal TotalAmount = 0;
                            <tr>
                                <td>
                                    @ft.Name
                                </td>
                                @{
                                    foreach (SMEnterprise.Models.PayDetailMonthsModel pm in Model.Months)
                                    {
                                        var isFound = false;
                                        foreach (SMEnterprise.Models.FeeDetailsModel pdm in Model.PaymentDetails)
                                        {
                                            if (pdm.FeeTypeID == ft.ID && pdm.Month == pm.Month)
                                            {
                                                TotalAmount = TotalAmount + pdm.NetApplicablePayment - pdm.DiscAmt;
                                                isFound = true;
                                                <td>
                                                    <sa id="FeeAmt">@(pdm.NetApplicablePayment - pdm.DiscAmt)</sa>
                                                    @if (pdm.FeeTypeID == -2)
                                                    {
                                                        foreach (SMEnterprise.Models.PayDetailMonthsModel pmm in Model.Months)
                                                        {
                                                            if (pm.Month == pmm.Month && pmm.PaymentRecieved == 0)
                                                            {
                                                                <label class="switch switch-green">
                                                                    <input type="checkbox" class="switch-input" @(pmm.Waiver == 0 ? "checked" : "") />
                                                                    <span class="switch-label" onclick="FeeStatusChanged(this)" id="@pmm.Month" data-on="Add" data-off="Waiver"></span>
                                                                    <span class="switch-handle" id="shTranding"></span>
                                                                    <input type="hidden" name="Status" id="hdnMonthID" value="@pdm.Month">
                                                                    <input type="hidden" name="Status" id="hdnFeeStatus" value="@(pmm.Waiver==0?1:0)">
                                                                </label>
                                                            }
                                                        }
                                                    }
                                                </td>
                                            }
                                        }
                                        if (!isFound)
                                        {
                                            <td>0.00</td>
                                        }
                                    }

                                }
                                <td id="RowTotal">@TotalAmount</td>
                            </tr>
                                    }
                        @{

                            decimal TotalTotal = 0;
                            <tr style="background-color: beige;">
                                <td>Total Amount</td>
                                @{
                                    foreach (SMEnterprise.Models.PayDetailMonthsModel pm in Model.Months)
                                    {
                                        decimal TotalMonth = 0;
                                        foreach (SMEnterprise.Models.FeeDetailsModel pdm in Model.PaymentDetails)
                                        {
                                            if (pdm.Month == pm.Month)
                                            {
                                                TotalMonth = TotalMonth + pdm.NetApplicablePayment - pdm.DiscAmt;
                                            }
                                        }

                                        <td id="MonthTotal_@pm.Month">@TotalMonth</td>
                                        TotalTotal = TotalTotal + TotalMonth;
                                    }
                                    <td id="TotalTotal">@TotalTotal</td>
                                }
                            </tr>
                            <tr style="background-color: aliceblue;">
                                <td>Total Paid</td>
                                @{
                                    decimal TotalPaid = 0;
                                    foreach (SMEnterprise.Models.PayDetailMonthsModel pm in Model.Months)
                                    {
                                        decimal TotalPaidMonth = 0;
                                        foreach (SMEnterprise.Models.FeeDetailsModel pdm in Model.PaymentDetails)
                                        {
                                            if (pdm.Month == pm.Month)
                                            {
                                                TotalPaidMonth = TotalPaidMonth + pdm.PaymentRecieved;
                                            }
                                        }

                                        <td>@TotalPaidMonth</td>
                                        TotalPaid = TotalPaid + TotalPaidMonth;
                                    }
                                    <td>@TotalPaid</td>
                                }
                            </tr>
                            <tr style="background-color: rgba(255, 0, 0, 0.52);color: white;">
                                <td>Total Remaining</td>
                                @{
                                    foreach (SMEnterprise.Models.PayDetailMonthsModel pm in Model.Months)
                                    {
                                        decimal TotalRemainingMonth = 0;
                                        foreach (SMEnterprise.Models.FeeDetailsModel pdm in Model.PaymentDetails)
                                        {
                                            if (pdm.Month == pm.Month)
                                            {
                                                TotalRemainingMonth = TotalRemainingMonth + (pdm.NetApplicablePayment - pdm.DiscAmt - pdm.PaymentRecieved);
                                            }
                                        }

                                        <td id="MonthRemainingTotal_@pm.Month">@TotalRemainingMonth</td>
                                        TotalRemaining = TotalRemaining + TotalRemainingMonth;
                                    }
                                    <td id="tdTotalRemainingAmount">@TotalRemaining</td>
                                }
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
            <div class="row amount-paid">
                <div class="col-md-4">
                    Net Total Amount
                    <h4 id="NetTotal">@TotalRemaining</h4>
                </div>
                <div class="col-md-4">
                    Amount Paid
                    <input type="text" id="txtNetPaid" value="@TotalRemaining" style="resize:none" class="form-control">
                </div>
                <div class="col-md-4">
                    Payment Mode
                    <select class="form-control" name="PaymentMode" id="ddlPaymentMode">
                        <option value="0" selected="">Cash Payment</option>
                        <option value="1">Cheque Payment</option>
                        <option value="2">NEFT Payment</option>
                        <option value="3">Other Payment</option>
                    </select>
                </div>
            </div>
            <div class="row amount-paid">
                <div class="col-md-4">
                    Ref No.
                    <input type="text" id="txtReferanceNumber" value="" style="resize:none" class="form-control">
                </div>

                <div class="col-md-4">
                    Remarks
                    <input type="text" id="txtRemark" value="" style="resize:none" class="form-control">
                </div>
                <div class="col-md-4">
                    Collected By
                    <input type="text" id="txtCollectedBy" value="" style="resize:none" class="form-control">
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 col-md-offset-4">
                    <button type="submit" class="btn btn-lg btn-block btn-success" onclick="ShowConfirmation(this);">Submit</button>
                </div>
            </div>
        }
    </div>
</div>