@model SMEnterprise.Models.VendorPageModel
    @{ 
        if(Model.Vendor==null)
        {
            Model.Vendor = new SMEnterprise.Models.VendorModel();
        }
    }
<div class="">
    <div class="row">
        @using (Html.BeginForm("UpdateVendor", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @class = "form-horizontal form-label-left" }))
        {
            <input type="hidden" id="hdnVendorID" name="VendorID" value="@Model.Vendor.VendorID" />
            <div class="form-horizontal form-label-left">
                <div class="">
                    <div class="col-md-4">
                        <label class="">Company Name</label>
                        <input type="text" name="CompanyName" value="@Model.Vendor.CompanyName" required class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="">Contact Person</label>
                        <input type="text" name="ContactPerson" value="@Model.Vendor.ContactPerson" required class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="">Contact Number</label>
                        <input type="text" name="ContactNumber" value="@Model.Vendor.ContactNumber" required class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="">EmailID</label>
                        <input type="text" name="EmailID" value="@Model.Vendor.EmailID" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="">Company Contact</label>
                        <input type="text" name="CompanyContact" value="@Model.Vendor.CompanyContact" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="">GSTIN</label>
                        <input type="text" name="GSTIN" value="@Model.Vendor.GSTIN" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="">Registration Number</label>
                        <input type="text" name="RegistrationNumber" value="@Model.Vendor.RegistrationNumber" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="">State : </label>
                        <select class="form-control" name="StateID" id="ddlTCities" onchange="CityChanged(this, 1);">
                            @foreach (var o in Model.GSTStates)
                            {
                                <option value="@o.StateID" @(o.StateID == Model.Vendor.StateID ? "selected" : "")>@o.StateName (@o.StateCode)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="">Pin Code</label>
                        <input type="text" name="PinCode" value="@Model.Vendor.PinCode" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="">Address</label>
                        <textarea style="resize:none;" rows="3" name="Address" value="" class="form-control">@Model.Vendor.Address</textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="">Other Details</label>
                        <textarea style="resize:none;" rows="3" name="OtherDetails" value="" class="form-control">@Model.Vendor.OtherDetails</textarea>
                    </div>
                    <div class="col-md-3">
                        <label class="">Bank Name</label>
                        <input type="text" name="BankName" value="@Model.Vendor.BankName" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="">Branch Name</label>
                        <input type="text" name="BranchName" value="@Model.Vendor.BranchName" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="">Account Number</label>
                        <input type="text" name="AccountNumber" value="@Model.Vendor.AccountNumber" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="">IFSC Code</label>
                        <input type="text" name="IFSCCode" value="@Model.Vendor.IFSCCode" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="">PAN Number</label>
                        <input type="text" name="PANNumber" value="@Model.Vendor.PANNumber" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="">TIN Number</label>
                        <input type="text" name="TINNumber" value="@Model.Vendor.TINNumber" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="">CIN Number</label>
                        <input type="text" name="CINNumber" value="@Model.Vendor.CINNumber" class="form-control" />
                    </div>
                    <div class="col-md-12">
                        <input class="pf-button btn btn-primary pull-right" type="submit" onclick="SaveLocation(this)" name="submit" value="Save" />
                    </div>
                </div>
                
            </div>
        }
    </div>
</div>