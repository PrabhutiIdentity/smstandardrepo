@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model MonthlyAttendancePageModel
@section IncludeCss
{
    <title>Monthly Attendance</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/toggle-switch.css")" rel="stylesheet" />
}
<style>
    .btn {
        padding: 3px 6px;
    }

    .unknown {
        background-color: orange;
        font-size: 10px;
    }

    .leave {
        background-color: cornflowerblue;
        color: white;
        font-size: 10px;
    }

    .absent {
        background-color: #fb5252;
        color: white;
        font-size: 10px;
    }

    .holiday {
        background-color: lightyellow;
        font-size: 10px;
    }

    .present {
        background-color: green;
        color: white;
        font-size: 10px;
    }

    .inentry {
        background-color: red;
        color: white;
        font-size: 10px;
    }

    #datatable > td {
        text-align: center;
    }
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Monthly Attendance
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Account/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Monthly Attendance</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box" style="height: 100%;">
                <div class="box-header">
                    @using (Html.BeginForm("EMonthlyAttendanceStatus", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetRequests" }))
                    {
                        <div class="row std-mng-head">
                            <div class="col-md-12 class-section">
                                <div class="row">

                                    <div class="col-md-4 padding">
                                        <input type="month" name="RepoDate" class="form-control datepickerMonth" style="margin-top: 5px;" value="@Model.RepoDate.ToString("yyyy-MM")" />
                                    </div>
                                    <div class="col-md-5 padding">
                                        <label class="col-md-5 text-right">Employee Type :</label>
                                        <div class="col-md-7">
                                            <select id="ddlEmployeeTypes" name="EmployeeType" required="required" class="form-control col-md-7 col-xs-12">
                                                @foreach (var e in Model.EmployeeTypes)
                                                {

                                                    <option value="@e.EmployeeTypeID" @(Model.EmployeeType == e.EmployeeTypeID ? "selected" : "" )>@e.EmployeeTypeName</option>
                                                }

                                            </select>

                                        </div>
                                    </div>
                                    <div class="col-md-3 padding">
                                        <a href="Javascript:void(0);" id="0" onclick="$('#frmGetRequests').submit();" class="btn btn-link" style="color:white;">Go!</a>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="x_panel">

                    <div class="x_content">

                        <table id="print" class="table table-striped table-bordered" cellspacing="0" style="font-size: 8px;">
                            <thead>
                                <tr>
                                    <th class="disabled-sorting" style="width:5%">#</th>
                                    <th class="disabled-sorting" style="width:15%">Employee</th>
                                    @for (var i = 0; i < DateTime.DaysInMonth(Model.RepoDate.Year, Model.RepoDate.Month); i++)
                                    {
                                        <th class="">D@(i + 1)</th>
                                    }
                                    <th class="disabled-sorting" style="width:10%">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var ctr = 1;
                                    foreach (var m in Model.StatusAttendance)
                                    {
                                        <tr>
                                            <td>@ctr</td>
                                            <td>@m.EmployeeSID<br />@m.EmployeeName</td>
                                            @{
                                                double TotalPresent = 0;
                                                var status = "P";
                                                double dbStatus = 0;
                                                for (var i = 1; i <= DateTime.DaysInMonth(Model.RepoDate.Year, Model.RepoDate.Month); i++)
                                                {
                                                    dbStatus = 0;
                                                    try
                                                    {
                                                        dbStatus = (double)m.GetType().GetProperty("D" + i).GetValue(m, null);
                                                    }
                                                    catch
                                                    {
                                                        dbStatus = 3;
                                                    }
                                                    TotalPresent = TotalPresent + (dbStatus != 3 && dbStatus != 2 && dbStatus != -2 && dbStatus != -1 ? dbStatus : 0);
                                                    <td class="@(dbStatus==1?"present": dbStatus==-2||dbStatus==2?"holiday":dbStatus==-1?"leave":dbStatus==0?"absent":dbStatus==0.5?"unknown":"")">
                                                        @(dbStatus == 1 ? "p" : dbStatus == -2 || dbStatus == 2 ? "H" : dbStatus == -1 ? "L" : dbStatus == 0 ? "A" : dbStatus == 0.5 ? "HD" : dbStatus == 3 ? "NA" : "")
                                                    </td>
                                                }
                                            }
                                            <td>

                                                <b>@TotalPresent</b>
                                            </td>
                                        </tr>
                                        ctr++;
                                    }
                                }

                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>

</section>
@section scripts
{
    <script src="@Url.Content("~/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.flash.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.print.min.js")"></script>
    <script src="@Url.Content("~/js/jszip.min.js")"></script>
    <script src="@Url.Content("~/js/pdfmake.min.js")"></script>
    <script src="@Url.Content("~/js/vfs_fonts.js")"></script>
    <script>
        $(document).ready(function () {
            var handleDataTableButtons = function () {
                if ($("#print").length) {
                    $("#print").DataTable({
                        "paging": true,
                        "pageLength": 31,
                        dom: "Bfrtip",
                        buttons: [
                            {
                                extend: "copy",
                                className: "btn-sm",
                                footer: true,
                                title: repname
                            },
                            {
                                extend: "csv",
                                className: "btn-sm",
                                footer: true,
                                title: repname
                            },
                            {
                                extend: "excel",
                                className: "btn-sm",
                                footer: true,
                                title: repname
                            },
                            {
                                extend: "pdfHtml5",
                                className: "btn-sm",
                                footer: true,
                                title: repname
                            },
                            {
                                extend: "print",
                                className: "btn-sm",
                                footer: true,
                                title: repname
                            },
                        ],
                        responsive: true
                    });
                }
            };

            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                };
            }();

            TableManageButtons.init();
        });
        function PrintReport() {
            var contents = $(".x_content").html();
            var frame1 = $('<iframe />');
            frame1[0].name = "frame1";
            frame1.css({ "position": "absolute", "top": "-1000000px" });
            $("body").append(frame1);
            var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
            frameDoc.document.open();
            //Create a new HTML document.
            frameDoc.document.write('<html><head><title></title>');
            @*frameDoc.document.write('<link href="@Url.Content("~/css/bootstrap.min.css")" rel="stylesheet" type="text/css" />');*@
             frameDoc.document.write('<link href="@Url.Content("~/css/ReportCard.css")" rel="stylesheet" type="text/css" />');
            frameDoc.document.write('</head><body>');
            //Append the external CSS file.
            //Append the DIV contents.
            frameDoc.document.write(contents);
            frameDoc.document.write('</body></html>');
            frameDoc.document.close();
            setTimeout(function () {
                window.frames["frame1"].focus();
                window.frames["frame1"].print();
                frame1.remove();
            }, 500);
        }
    </script>
}
<!-- /.content -->