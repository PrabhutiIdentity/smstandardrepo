﻿@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model SMEnterprise.Models.PerformanceParameterDetailModel
@section IncludeCss
{
    <title>Performance Card | @Model.Student.Name</title>
    <style>
        #tblResult > tbody > tr > td {
            text-align: center !important;
            vertical-align: middle !important;
        }

        .table > tbody > tr > td {
            padding-bottom: 1px;
            padding-top: 2px;
        }

        .print {
            display: none;
        }
    </style>
}
<div class="">

    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                @using (Html.BeginForm("UpdateStudentPerformance", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "ClassUpdate" }))
                {
                <div class="x_content">
                    <table class="table" style="border-bottom: 1px solid #ddd;padding-bottom: 0px;">
                        <tr>
                            <td style="text-align:left;">
                                <img onerror="return OnImageError(this,2);" class="ImageReportLogo" alt="Photo" src="@Url.Content("~/Images/cbse-logo.png")" />
                            </td>
                            <td style="text-align: center;vertical-align: middle;">
                                <h2 class="SchoolNameHead" style="margin-top: 2px;margin-bottom: 5px;font-size: 30px;">@Model.SBranchDetails.BranchSchoolName</h2>
                                <p style="margin-bottom: 2px;">(@Model.SBranchDetails.TagLine)</p>
                                <p style="margin-bottom: 2px;">@Model.SBranchDetails.Address</p>
                                @if (Model.SBranchDetails.SBranchID == 1)
                                {
                                    <p style="margin-bottom: 2px;"> Email : @Model.SBranchDetails.EmailID</p>
                                }
                                else
                                {
                                    <p style="margin-bottom: 2px;"> Ph. @Model.SBranchDetails.ContactNo, Email : @Model.SBranchDetails.EmailID</p>
                                }
                            </td>
                            <td style="text-align: right;">
                                <img onerror="return OnImageError(this,2);" class="ImageReportLogo" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.SBranchDetails.SBranchID)_@(Model.SBranchDetails.Logo)" />
                            </td>
                        </tr>
                    </table>
                    <div class="col-md-8">
                        <div class="row" style="display:none;">
                            Roll No. :<b> @Model.Student.RollNo</b>
                        </div>
                        <div class="row">
                            Student : <b id="bStudentNate">@Model.Student.Name</b>
                        </div>
                        <div class="row">
                            Mother's Name : <b>@Model.Student.MotherName</b>
                        </div>
                        <div class="row">
                            Father's Name : <b>@Model.Student.FatherName</b>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row"  style="display:none;">
                            Date of Birth :<b> @Model.Student.DOB.ToString("dd MMM, yyyy")</b>
                        </div>
                        <div class="row">
                            Class-Section :<b id="bClassSection"> @Model.Student.ClassName </b>
                        </div>
                        <div class="row">
                            Student ID :<b> @Model.Student.StudentSID</b>
                        </div>
                    </div>

                    <input type="hidden" name="StudentSessionUID" value="@Model.StudentSessionUID" />
                    <input type="hidden" name="EvaluationID" value="@Model.EvaluationID" />
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        @{ var mainCounter = 0;
                            <table class="table">
                                @foreach (PerformanceParameterModel c in Model.PerformanceParameters)
                                {
                                    if (c.ParamType == 0)
                                    {

                                        <tr>
                                            <td colspan="3" style="text-align: center;">
                                                <b>   @c.ParamName</b> <br /><small>@c.ParamDesc</small>
                                            </td>
                                        </tr>
                                        <tr>
