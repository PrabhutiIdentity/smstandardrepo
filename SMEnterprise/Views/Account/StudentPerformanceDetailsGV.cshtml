                                                                        decimal EvalMaxMarks = 0;
                                                                        decimal SATotalMarks = 0;
                                                                        decimal EvalTotalMarks = 0;
                                                                        foreach (EvaluationModel esr in Model.SubEvaluations)
                                                                        {
                                                                            if (esr.MasterID == er.EvaluationID)
