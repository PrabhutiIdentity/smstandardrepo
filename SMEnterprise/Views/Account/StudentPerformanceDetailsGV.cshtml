                                                                                        @*<td>@(err.Grade == null ? "NA" : err.Grade)</td>*@
                                                                                        <td>@err.wMarksScored.ToString("N2")</td>
                                                                                        EvalTotalMarks = EvalTotalMarks + err.wMarksScored;
                                                                                        isFound = true;
                                                                                        EvalMaxMarks = EvalMaxMarks + err.wMaxMarks;
                                                                                        er.TotalMarks = er.TotalMarks + err.wMaxMarks;
                                                                                        er.MarksObtained = er.MarksObtained + err.wMarksScored;
                                                                                    }
                                                                                }
                                                                                if (!isFound)
                                                                                {
                                                                                    <td>NA</td>
                                                                                }
                                                                            }

                                                                        }
                                                                        <td>@Math.Round(EvalTotalMarks, 2)</td>
                                                                        <td>@AcadmicModel.CalculateGrade(EvalTotalMarks, EvalMaxMarks)</td>
                                                                    }
                                                                </tr>
                                                            }
                                                            privSubID = r.SubjectID;
                                                        }
                                                                <tr>
                                                                    <td></td>
                                                                    @foreach (var me in Model.MainEvaluations)
