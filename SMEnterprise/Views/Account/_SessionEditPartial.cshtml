
<div class="x_content">
    <div class="row">
        @using (Html.BeginForm("SaveStudentSession", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @class = "form-horizontal form-label-left" }))
        {
            <div class="col-md-12">
                <label class="control-label col-md-12 col-sm-3 col-xs-12" style="text-align: center;font-size: 22px;padding-bottom: 8px;">Session Details</label>
            </div>
            <input type="hidden" name="StudentID" value="@Model.StudentID" />
            <input type="hidden" name="StudentSessionUID" value="@Model.Session.StudentSessionUID" />

            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-4 col-sm-3 col-xs-12">Session : </label>
                    <div class="col-md-8 col-sm-9 col-xs-12 input-group">
                        <select class="form-control" id="ddlSchoolSessions" name="SessionID" onchange="SchoolSessionChanged(this);">
                            @foreach (var q in Model.SchoolSessions)
                            {
                                <option startDate="@q.SessionStartDate.ToShortDateString()" endDate="@q.SessionEndDate.ToShortDateString()" value="@q.SessionID" @(Model.Session.SessionID == q.SessionID ? "selected" : "")>@q.SessionName @(q.SessionStatus == 1 ? "(Active)" : "")</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="control-label col-md-4 col-sm-3 col-xs-12">House : </label>
                    <div class="col-md-8 col-sm-9 col-xs-12 input-group">
                        <select class="form-control" id="ddlHouses" name="HouseID">
                            @foreach (var q in Model.Houses)
                            {
                                <option value="@q.ID" @(Model.Session.HouseID == q.ID ? "selected" : "")>@q.Name </option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label class="control-label col-md-4 col-sm-3 col-xs-12">Class : </label>
                    <div class="col-md-8 col-sm-9 col-xs-12 input-group">
                        <select class="form-control" id="ddlSessionEditClass" name="ClassID" onchange="SessionClassChanged(this);">
                            @foreach (var q in Model.Classes)
                            {
                                <option value="@q.ID" @(Model.Session.ClassID == q.ID ? "selected" : "")>@q.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group col-md-6">
                    <label class="control-label col-md-4 col-sm-3 col-xs-12">Section : </label>
                    <div class="col-md-8 col-sm-9 col-xs-12 input-group">
                        <select class="form-control" name="SectionID" id="ddlSections" onchange="SessionSectionChanged(this);">
                            @foreach (var q in Model.Sections)
                            {
                                <option value="@q.ID" @(Model.Session.SectionID == q.ID ? "selected" : "")>@q.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label class="control-label col-md-4 col-sm-3 col-xs-12">Fee Mode : </label>
                    <div class="col-md-8 col-sm-9 col-xs-12 input-group">
                        <select class="form-control" name="FeePaymentMode">
                            <option value="1" @(Model.Session.FeePaymentMode == 1 ? "selected" : "")>Monthly</option>
                            <option value="3" @(Model.Session.FeePaymentMode == 3 ? "selected" : "")>Quarterly</option>
                            <option value="6" @(Model.Session.FeePaymentMode == 6 ? "selected" : "")>Half Yearly</option>
                        </select>
                    </div>
                </div>
                <div class="form-group col-md-6">
                    <label class="control-label col-md-4 col-sm-3 col-xs-12">Roll No : </label>
                    <div class="col-md-8 col-sm-9 col-xs-12 input-group">
                        <input type="text" class="form-control" placeholder="Roll No" name="RollNo" value="@Model.Session.RollNo" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label class="control-label col-md-4 col-sm-3 col-xs-12">Start Date : <small>(mm/dd/yyyy)</small></label>
                    <div class="col-md-8 col-sm-9 col-xs-12 input-group">
                        <input type="text" required="" class="form-control has-feedback-left dateinput" id="txtStartDate" placeholder="Start Date" aria-describedby="inputSuccess2Status" name="FromDate" value="@Model.Session.FromDate.ToShortDateString()">
                        <span class="fa fa-calendar-o form-control-feedback left" aria-hidden="true"></span>
                        <span id="inputSuccess2Status" class="sr-only">(success)</span>
                    </div>
                </div>
                <div class="form-group col-md-6">
                    <label class="control-label col-md-4 col-sm-3 col-xs-12">End Date : <small>(mm/dd/yyyy)</small></label>
                    <div class="col-md-8 col-sm-9 col-xs-12 input-group">
                        <input type="text" required="" class="form-control has-feedback-left dateinput" id="txtEndDate" placeholder="End Date" aria-describedby="inputSuccess2Status" name="ToDate" value="@Model.Session.ToDate.ToShortDateString()">
                        <span class="fa fa-calendar-o form-control-feedback left" aria-hidden="true"></span>
                        <span id="inputSuccess2Status" class="sr-only">(success)</span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label class="control-label col-md-4 col-sm-3 col-xs-12">Admission Quota : </label>
                    <div class="col-md-8 col-sm-9 col-xs-12 input-group">
                        <select class="form-control" name="QuotaID">
                            <option value="0" @(Model.Session.QuotaID == 0 ? "selected" : "")>No Quota</option>
                            @foreach (var q in Model.Quotas)
                            {
                                <option value="@q.ID" @(Model.Session.QuotaID == q.ID ? "selected" : "")>@q.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group col-md-6">
                    <label class="control-label col-md-4 col-sm-3 col-xs-12">Approved : </label>
                    <div class="col-md-8 col-sm-9 col-xs-12 input-group">
                        <label class="switch switch-green">
                            <input type="checkbox" class="switch-input" @(Model.Session.Status == 1 ? "checked" : "" )>
                            <span class="switch-label" onclick="$(this).closest('div').find('#hdnSessionStatus').val($(this).closest('label').find('#hdnSessionStatus').val() == '0' ? '1' : '0');" data-on="Active" data-off="Inactive"></span>
                            <span class="switch-handle" id="shTranding"></span>
                            <input type="hidden" name="Status" id="hdnSessionStatus" value="@Model.Session.Status">
                        </label>
                        Admission Fee :
                        <label class="switch switch-green" style="width: 115px;padding:0px">
                            <input type="checkbox" class="switch-input" @(Model.Session.IsAdmissionFeeApplicable == 1 ? "checked" : "" )>
                            <span class="switch-label" onclick="$(this).closest('label').find('#hdnAdmissionFee').val($(this).closest('label').find('#hdnAdmissionFee').val() == '0' ? '1' : '0');" data-on="Applicable" data-off="Not Applicable"></span>
                            <span class="switch-handle" id="shTranding" style="display:none;"></span>
                            <input type="hidden" name="IsAdmissionFeeApplicable" id="hdnAdmissionFee" value="@Model.Session.IsAdmissionFeeApplicable">
                        </label>
                    </div>
                </div>
            </div>

            <div class="row">
                <label class="control-label col-md-2 col-sm-3 col-xs-12">Optional Subjects : </label>
                <div class="col-md-8 col-sm-9 col-xs-12 input-group">
                    <div class="row">
                        <div class="col-md-12" style="padding-top: 5px;" id="divOptionalSubjects">
                            @{
                                var cnt = 0;
                                var atlest = ((List<SMEnterprise.Models.NameIDModel>)Model.OptionalSubjects).Where(x => x.Extra1 != "0").Count();
                                foreach (var subs in Model.OptionalSubjects)
                                {
                                    if ("0" != subs.Extra1 || atlest == 0)
                                    {
                                        <label class='badge bg-green OptedSubjects' onclick="OptionalSubjectClicked(this);" title="Student Opted for this subject">
                                            <input type="hidden" id="hdnSSOSID" name="SubjectsOpted[@cnt].Extra1" value="@subs.Extra1" />
                                            <input type="hidden" id="hdnOpSubjectID" name="SubjectsOpted[@cnt].ID" value="@subs.ID" />
                                            <input type="hidden" id="hdnStudentSessionID" name="SubjectsOpted[@cnt].Name" value="@Model.Session.StudentSessionUID" />
                                            <input type="hidden" id="hdnOpType" name="SubjectsOpted[@cnt].Extra2" value="1" />
                                            @subs.Name
                                        </label>
                                    }
                                    else
                                    {
                                        <label class='badge bg-red OptedSubjects' onclick="OptionalSubjectClicked(this);" title="This subject is not opted">
                                            <input type="hidden" id="hdnSSOSID" name="SubjectsOpted[@cnt].Extra1" value="0" />
                                            <input type="hidden" id="hdnOpSubjectID" name="SubjectsOpted[@cnt].ID" value="@subs.ID" />
                                            <input type="hidden" id="hdnStudentSessionID" name="SubjectsOpted[@cnt].Name" value="@Model.Session.StudentSessionUID" />
                                            <input type="hidden" id="hdnOpType" name="SubjectsOpted[@cnt].Extra2" value="0" />
                                            @subs.Name
                                        </label>
                                    }
                                    cnt++;
                                }
                            }
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-md-12 pull-right">
                    <div class="col-md-9 col-sm-9 col-xs-12 col-md-offset-3">
                        <button type="submit" class="btn btn-success pull-right" onclick="return CheckSessionEditForm(this)">Submit</button>
                        <button type="button" onclick="CancelSessionEdit()" class="btn btn-primary pull-right">Cancel</button>
                    </div>
                </div>
            </div>
            <script>
                $('.dateinput').daterangepicker({
                    singleDatePicker: true,
                    calender_style: "picker_1"
                }, function (start, end, label) {
                    console.log(start.toISOString(), end.toISOString(), label);
                });
            </script>
        }
    </div>
</div>