@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model SMEnterprise.Models.ClassGenderCategoryCountPageModel
@section IncludeCss
{
    <title>Class wise Student List based on House and Gender</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">
}
<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("ClassHouseGenderStudents", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
                {
                    <div class="row std-mng-head">

                        <div class="col-md-12 class-section">
                            <div class="row">

                                <div class="col-md-3 padding">
                                    <label class="col-md-4 text-right">Session :</label>
                                    <div class="col-md-8">
                                        <select class="form-control" name="SessionID" id="ddlSessions" onchange="$('#frmGetStudents').submit();">
                                            @foreach (var el in Model.Sessions)
                                            {
                                                <option value="@el.ID" @(el.ID == Model.SessionID ? "selected" : "")>@el.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                }
                <div class="x_panel">

                    <div class="x_content">

                        <table id="tblCategory" class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th rowspan="2">Class</th>
                                    @foreach (var h in Model.Houses)
                                    {
                                        <th colspan="3" style="text-align:center;">@h.Name</th>
                                    }
                                    <th colspan="3" style="text-align:center;">Not Defined</th>
                                </tr>
                                <tr>
                                    @foreach (var h in Model.Houses)
                                    {
                                        <th>Boy</th>
                                        <th>Girl</th>
                                        <th>Total</th>
                                    }
                                    <th>Boy</th>
                                    <th>Girl</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            @{
                                int count = 0;
                                foreach (var c in Model.Classes)
                                {
                                    <tr>

                                        <td>
                                            @c.ClassName
                                        </td>
                                        @foreach (var h in Model.Houses)
                                        {
                                            <td>
                                                @Model.Data.Where(r => r.ClassID == c.ClassID && r.Gender == 0 && r.HouseID == h.ID).Sum(it => it.Students)
                                            </td>
                                            <td>
                                                @Model.Data.Where(r => r.ClassID == c.ClassID && r.Gender == 1 && r.HouseID == h.ID).Sum(it => it.Students)
                                            </td>
                                            <td>
                                                @Model.Data.Where(r => r.ClassID == c.ClassID && r.HouseID == h.ID).Sum(it => it.Students)
                                            </td>
                                        }
                                        <td>
                                            @Model.Data.Where(r => r.ClassID == c.ClassID && r.Gender == 0 && r.HouseID == 0).Sum(it => it.Students)
                                        </td>
                                        <td>
                                            @Model.Data.Where(r => r.ClassID == c.ClassID && r.Gender == 1 && r.HouseID == 0).Sum(it => it.Students)
                                        </td>
                                        <td>
                                            @Model.Data.Where(r => r.ClassID == c.ClassID && r.HouseID == 0).Sum(it => it.Students)
                                        </td>
                                    </tr>

                                    count++;
                                }

                            }
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="@Url.Content("~/js/Admin/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/js/dataTables.bootstrap.min.js")"></script>
    <script>

        $(function () {
            //$("#tblCategory").DataTable(
            //    { "ordering": false }
            //    );
        });
        function DeleteStudent(sender) {
            return confirm('Do you really want to delete Student!!!!');
        }
        function ClassChanged(sender) {
            $('#ddlSection').html('<option value="0">Loading....</option>');
            $.ajax(
    {
        type: "POST",
        url: "/Admin/GetSectionOnClass/" + $(sender).val(),
        cache: false,
        processData: false,
        contentType: false,
        success: function (html) {
            $('#ddlSection').html('');
            $('#ddlSection').html('<option value="0">--Select Section--</option>');
            $('#ddlSection').append(html);
        },
        error: function (e) {
            alert("errorn");
        }
    });
        }
    </script>
}
<!-- /.content -->
