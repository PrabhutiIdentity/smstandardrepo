@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model SMEnterprise.Models.StudentsPageModel
@section IncludeCss
{
    <title>Students Report</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">
}

<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }

    table.dataTable tbody td {
        word-break: break-word;
        vertical-align: top;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("AllStudentReport", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
                {
                    <div class="row std-mng-head">

                        <div class="col-md-12 class-section">
                            <div class="row">

                                <div class="col-md-1 padding">
                                </div>
                                <div class="col-md-3 padding">
                                    <label class="col-md-4 text-right">Session :</label>
                                    <div class="col-md-8">
                                        <select class="form-control" name="SessionID" id="ddlSessions">
                                            <option value="0">--Select Session--</option>
                                            @foreach (NameIDModel el in Model.Sessions)
                                            {
                                                <option value="@el.ID" @(el.ID == Model.SessionID ? "selected" : "")>@el.Name @(el.Extra1=="1"?"(Active)":"")</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                @*<div class="col-md-3 padding">
                                        <label class="col-md-4 text-right">Class :</label>
                                        <div class="col-md-8">
                                            <select class="form-control" name="ClassID" id="ddlClass" onchange="javascript:ClassChanged(this);">
                                                <option value="0">--Select Class--</option>
                                                @foreach (ClassModel el in Model.Classes)
                                                {
                                                    <option value="@el.ClassID" @(el.ClassID == Model.ClassID ? "selected" : "")>@el.ClassName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>*@

                                <div class="col-md-1 padding">
                                    <div class="row">

                                        <div class="col-md-12">
                                            <a href="javascript:void(0);" onclick="$('#frmGetStudents').submit();"><i class="fa fa-search"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                }
                <div class="x_panel">

                    <div class="x_content" class="table table-bordered table-hover display nowrap" style="overflow-x: scroll;width: 100%;display: inline-block;">

                        <table id="tblCategory" class="display">
                            <thead>
                                <tr>
                                    <th>SR.No.</th>
                                    <th>Student Name </th>
                                    <th>StudentID</th>
                                    <th>Gender</th>
                                    <th>Father Name </th>
                                    <th>Mother Name </th>
                                    <th>DOB</th>
                                    <th>Age</th>
                                    <th>Class</th>
                                    <th>Section</th>
                                    <th>DOA</th>
                                    <th>House</th>
                                    <th>Mobile No</th>
                                    <th>Aadhar Number</th>
                                    <th>Transport</th>
                                    <th>Stoppage</th>
                                    <th>Bus/Van</th>
                                    <th>Address</th>
                                    @*<th>Hostel</th>*@
                                </tr>
                            </thead>
                            @{
                                int count = 0;
                                foreach (StudentModel c in Model.Students)
                                {
                                    <tr>
                                        <td>
                                            @c.SchoolUID

                                        </td>
                                        <td>
                                            @c.Name

                                           
                                        </td>

                                        <td>

                                            @c.StudentSID

                                        </td>
                                        <td>
                                            @if (@c.Gender != 0)
                                            {
                                                <label>Female</label>
                                            }
                                            else
                                            {
                                                <label>Male</label>
                                            }
                                        </td>
                                        <td>
                                            @c.FatherName
                                        </td>
                                        <td>
                                            @c.MotherName
                                        </td>
                                        <td>
                                            @c.DOB.ToString("dd MMM, yyyy")

                                        </td>
                                        <td>
                                            @c.Age

                                        </td>
                                        <td>
                                            @c.ClassName
                                        </td>
                                        <td>

                                            @c.SectionName
                                        </td>
                                        <td>
                                            @c.DOJ.ToString("dd MMM, yyyy")
                                        </td>
                                        <td>

                                            @c.HouseName

                                        </td>

                                        <td>

                                            @c.FatherMobileNo

                                        </td>
                                        <td>@c.AadharCardNo</td>

                                        <td>
                                            @if (c.StopID != 0)
                                            {
                                                <label class='badge bg-green'>Yes</label>
                                            }
                                            else
                                            {
                                                <label>NA</label>
                                            }
                                        </td>
                                        <td>@c.StopName</td>
                                        <td>

                                            @c.BusNo

                                        </td>
                                        <td>

                                            @c.MiniAddress

                                        </td>
                                        @*<td>
                                            @if (c.HostelRoomID != 0)
                                            {
                                                <label class='badge bg-green'>Yes</label>
                                            }
                                            else
                                            {
                                                <label>NA</label>
                                            }
                                        </td>*@

                                    </tr>

                                    count++;
                                }

                            }
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section scripts
{
    <script src="@Url.Content("https://cdn.datatables.net/buttons/2.1.0/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("https://cdn.datatables.net/buttons/2.1.1/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("https://cdn.datatables.net/buttons/2.1.1/js/buttons.print.min.js")"></script>
    <script src="@Url.Content("https://cdnjs.cloudflare.com/ajax/libs/jszip/2.5.0/jszip.min.js")"></script>
    <script src="@Url.Content("https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/pdfmake.min.js")"></script>
    <script src="@Url.Content("https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/vfs_fonts.js")"></script>

    @*<script src="@Url.Content("~/js/dataTables.buttons.min.js")"></script>
        <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>

        <script src="@Url.Content("~/js/buttons.html5.min.js")"></script>
        <script src="@Url.Content("~/js/buttons.print.min.js")"></script>

        <script src="@Url.Content("~/js/jszip.min.js")"></script>
        <script src="@Url.Content("~/js/pdfmake.min.js")"></script>
        <script src="@Url.Content("~/js/vfs_fonts.js")"></script>*@
    <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>
    <script>
        $(document).ready(function () {
           // var repname = '@PermissionManager.GetLoggedInUser().Description' +'<br /> Student Records ' + $('#ddlSessions option:selected').text();
            var handleDataTableButtons = function () {
                  var printdate='Print Date: @SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd/MM/yyyy  hh:mm:ss tt")';
                var rpname = 'All Student Records ' +  'Session ' + $('#ddlSessions option:selected').text() ;
            var repname = 'Report Generate on: ' + '@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd-MM-yyy hh:mm:ss tt")'

                if ($("#tblCategory").length) {
                    $("#tblCategory").DataTable({

                        "pageLength": 100,
                        bSort: true,
                        dom: "Bfrtip",
                        buttons: [
                            {
                                extend: "copy",
                                className: "btn-sm",
                                footer: true,
                                text: '<i class="fa fa- copy"></i> Copy',

                            message: printdate,
                             messageTop: '@Model.BranchDetails.BranchSchoolName',
                            messageBottom: repname,
                            title: rpname
                            },
                            {
                                extend: "csv",
                                className: "btn-sm",
                                text: '<i class="fas fa-file-csv"></i> CSV',
                                 footer: true,
                          message: printdate,
                            messageTop: '@Model.BranchDetails.BranchSchoolName',
                            messageBottom: repname,
                            title: rpname
                            },
                            {
                                extend: "excel",
                                className: "btn-sm",
                                text: '<i class="fa fa-table fainfo" aria-hidden="true"></i> Excel',
                                footer: true,
                         messageTop: rpname,
                          messageBottom: repname,
                          title: '@Model.BranchDetails.BranchSchoolName'
                            },
                            {
                                extend: "pdfHtml5",
                                className: "btn-sm",
                                text: '<i class="fa fa-file-pdf-o"></i> Pdf',
                                footer: true,
                          orientation: 'landscape',
                          customize: function (doc) {

                              doc.defaultStyle.fontSize = 7;
                              doc.styles.tableHeader.fontSize = 10;

                              doc['header'] = (function () {
                                  return {
                                      columns: [
                                          {
                                              alignment: 'left',
                                              italics: true,
                                              text: '@Model.BranchDetails.BranchSchoolName',
                                              fontSize: 14,
                                              margin: [0, 0]
                                          }
                                      ],
                                      margin: 20
                                  }
                              });
                          },
                          message: printdate,
                          messageBottom: repname,
                          title: rpname
                            },
                            {
                                extend: "print",
                                className: "btn-sm",
                                text: '<i class="fa fa-print"></i> Print',
                                footer: true,
                                orientation: 'landscape',
                          message: printdate,
                          messageTop: rpname,
                          messageBottom: repname,
                          title: '@Model.BranchDetails.BranchSchoolName'
                            },
                        ],
                        responsive: true
                    });
                }
            };
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                };
            }();
            TableManageButtons.init();

        });
    </script>
    <script>

        function ClassChanged(sender) {
            $('#ddlSection').html('<option value="0">Loading....</option>');
            $.ajax(
                {
                    type: "POST",
                    url: "/Account/GetSectionOnClass/" + $(sender).val(),
                    cache: false,
                    processData: false,
                    contentType: false,
                    success: function (html) {
                        $('#ddlSection').html('');
                        $('#ddlSection').html('<option value="0">--Select Section--</option>');
                        $('#ddlSection').append(html);
                    },
                    error: function (e) {
                        alert("errorn");
                    }
                });
        }
    </script>


}