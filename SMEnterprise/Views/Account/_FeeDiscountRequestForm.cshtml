<div class="row">
    <div class="col-md-12" style="text-align:center;">
        <h4> Request Discount for @Model.StudentName for @SMEnterprise.Repository.CommonUsage.MonthNames[Model.FeeMonth - 1], @Model.FeeYear</h4>
        <input type="hidden" name="StudentID" id="hdnStudentID" value="[StudentIDPlaceHolder]" />
        <input type="hidden" name="FeeMonth" value="@Model.FeeMonth" />
        <input type="hidden" name="FeeYear" value="@Model.FeeYear" />
        <input type="hidden" name="DiscRequestID" value="@Model.DiscRequestID" />
        <input type="hidden" name="RequestDate" value="@Model.RequestDate" />
        <input type="hidden" id="hdnRequestStatus" name="Status" value="@Model.Status" />
    </div>
    <div class="col-md-12">
        <table class="table">
            <thead style="font-weight: 800;">
                <tr>
                    <td>Fee Type</td>
                    <td>Applicable Amount</td>
                    <td>Requested Discount</td>
                    <td>Approved Discount</td>
                </tr>
            </thead>
            @{
                var count = 0;
                decimal TotalAmount = 0;
                decimal TotalReqDiscount = 0;
                decimal TotalAppDiscount = 0;
                <tbody>

                    @foreach (SMEnterprise.Models.FeeDiscountRequestDetails d in Model.Details)
                    {
                        TotalAmount = TotalAmount + d.NetApplicablePayment;
                        TotalReqDiscount = TotalReqDiscount + d.Amount;
                        TotalAppDiscount = TotalAppDiscount + d.ApprovedAmount;
                        <tr>
                            <td>@d.FeeTypeName</td>
                            <td>@d.NetApplicablePayment.ToString("0.00")</td>
                            <td>
                                <input type="hidden" name="Details[@count].FeeTypeID" value="@d.FeeTypeID" />
                                <input type="hidden" name="Details[@count].DiscDetailID" value="@d.DiscDetailID" />
                                <input type="hidden" name="Details[@count].NetApplicablePayment" value="@d.NetApplicablePayment" />
                                <input type="number" step="0.01" min="0" max="@d.NetApplicablePayment.ToString("0.00")" class="form-control" name="Details[@count].Amount" value="@d.Amount" />
                            </td>
                            <td>@d.ApprovedAmount.ToString("0.00")</td>
                        </tr>
                        count++;
                    }

                </tbody>
                <tfoot>
                    <tr>
                        <td>Total</td>
                        <td>@TotalAmount.ToString("0.00")</td>
                        <td>@TotalReqDiscount.ToString("0.00")</td>
                        <td>@TotalAppDiscount.ToString("0.00")</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
    <div class="col-md-12">
        <label>Remark</label>
        <textarea class="form-control" style="resize:none;" name="Remark" rows="3">@Model.Remark</textarea>
    </div>
    @if (Model.DirectorRemark != null)
    {
        <div class="col-md-12">
            <label>Directors Remark</label>
            <textarea class="form-control" readonly style="resize:none;" name="DirectorRemark" rows="3">@Model.DirectorRemark</textarea>
        </div>
    }
</div>