                <label>Issue Date</label>
                <div class="tc-alt-topvalue">@Model.TCDetails.DateOfIssue.ToString("dd MMM yyyy")</div>
            </div>
            <div class="tc-alt-topitem">
                <label>School No.</label>
                <div class="tc-alt-topvalue">@Model.Branch.SchoolCode</div>
            </div>
            <div class="tc-alt-topitem">
                <label>Affiliation No.</label>
                <div class="tc-alt-topvalue">@Model.Branch.AffiliationNo</div>
            </div>
            <div class="tc-alt-topitem">
                <label>Renewed upto</label>
                <div class="tc-alt-topvalue">@Model.Branch.RenewedUpto</div>
            </div>
        </div>

        <div class="tc-section-title">Student Profile</div>
