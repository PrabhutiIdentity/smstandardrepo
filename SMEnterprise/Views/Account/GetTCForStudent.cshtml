    var resultStatus = Model.TCDetails.FailedCount == 0 ? "NO" : "YES";
    var promotionStatus = Model.TCDetails.IsSCBLastExamPassed == 0 ? "No" : "Yes";
    var nccStatus = Model.TCDetails.IsNCC == 0 ? "No" : "Yes " + Model.TCDetails.NCCDetails;
    var resultStatusHindi = Model.TCDetails.FailedCount == 0 ? "नहीं" : "हाँ";
    var promotionStatusHindi = Model.TCDetails.IsSCBLastExamPassed == 0 ? "नहीं" : "हाँ";
    var nccStatusHindi = Model.TCDetails.IsNCC == 0 ? "नहीं" : "हाँ " + Model.TCDetails.NCCDetails;
}

