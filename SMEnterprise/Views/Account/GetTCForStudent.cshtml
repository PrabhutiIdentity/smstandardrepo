                <label>Admission No.</label>
                <div class="tc-alt-topvalue">@Model.StudentDetails.SchoolUID</div>
            </div>
            <div class="tc-alt-topitem">
                <label>Student ID</label>
                <div class="tc-alt-topvalue">@Model.StudentDetails.StudentSID</div>
            </div>
            <div class="tc-alt-topitem">
                <label>T.C. No.</label>
                <div class="tc-alt-topvalue">@Model.TCDetails.TCSLNo</div>
            </div>
        </div>
        <div class="tc-meta-panel tc-meta-panel-four">
