<div class="x_panel">
    <div class="x_title">
        <h2>Character Certificate</h2>
        <button type="button" class="btn btn-primary pull-right" onclick="PrintTC(1);"><i class="fa fa-print"></i> Print</button>
        <div class="clearfix"></div>
    </div>
    <div class="x_content charactercontainer">
        <table style="width: 100%;padding:10px;">
            <thead>
                <tr>
                    <td style="text-align:center;width:20%;">
                        <img onerror="return OnImageError(this,2);" width="100" class="ImageReportLogo" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.Branch.SBranchID)_@(Model.Branch.Logo)" />
                    </td>
                    <td style="text-align:center;width:60%;">
                        <h3> @Model.Branch.BranchSchoolName</h3>
                        <h2 style="white-space: break-spaces;">@Model.Branch.Address </h2>
                        <p>Affiliated To C.B.S.E.Board</p>
                    </td>
                    <td style="text-align:center;width:20%;">
                        <img id="imgPhoto" onerror="return OnImageError(this,@(Model.StudentDetails.Gender));" style="width:100px;height:100px;" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(Model.StudentDetails.StudentID)_@Model.StudentDetails.Photo" />
                    </td>
                </tr>
                <tr>
                    <td colspan="3" style="text-align:center">
                        <h1 style="padding: 20px;margin-bottom: 10px;">
                            * Character Certificate *
                        </h1>
                    </td>
                </tr>
                <tr>
                    <td colspan="3">
                        <table style="width:100%;padding:10px;">
                            <tr>
                                <td></td>
                                <td style="text-align:right">Dated @Model.TCDetails.DateOfIssue.ToString("dd MMM, yyyy")</td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    @{
                        var finalSession = Model.Sessions.LastOrDefault();
                        var firstSession = Model.Sessions.FirstOrDefault();
                    }
                    <td colspan="3">
                        <br />
                        <p style="font-size: 15px;">
                            This is to certify that <b>@Model.StudentDetails.Name</b> @(Model.StudentDetails.Gender == 0 ? "son" : "daughter") of @Model.StudentDetails.FatherName
                            has been / was a student of this school during the session from @firstSession.SessionName he has appeared in the class @finalSession.ClassName examination of the year
                            @finalSession.SessionName .
                        </p>
                        <p style="font-size: 15px;">
                            As far as I know @(Model.StudentDetails.Gender == 0 ? "he" : "she") bears a @Model.TCDetails.GeneralConduct Character.
                        </p>
                        <p style="font-size: 15px;">
                            I wish him all success in life
                        </p><br />
                        <br />
                        <br />
                        <br />

                        <label>
                            <br /><br /><br /><br />
                            <b>HEAD CLERK</b>
                        </label>


                        @if (Model.Branch.PrincipalSignature == null)
                        {

                            <br /><br /><br />
                            <label style="float:right">  Principal </label>


                        }
                        else
                        {
                            <label style="float:right">
                                <img onerror="return OnImageError(this,2);" style="width:200px;height:50px;" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.Branch.SBranchID)_P_@(Model.Branch.PrincipalSignature)" />
                                <br />&nbsp; &nbsp; &nbsp; &nbsp;  Principal
                            </label>
                        }
                        <div style="border-bottom:2px dotted"></div>
                    </td>
                </tr>
            </thead>
        </table>
    </div>
</div>
@section scripts{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.8.0/js/bootstrap-datepicker.min.js"></script>
    <script>
        function BranchChanged(sender) {
            var BranchID = $(sender).val();
            var isset = 0;
            $("#ddlSessions > option").each(function (index) {
                if ($(this).attr('branchid') != BranchID) {
                    $(this).css('display', 'none');
                    $(this).removeAttr('selected');
                }
                else {
                    $(this).css('display', '');
                    if (isset == 0) {
                        $(this).attr('selected', 'selected');
                        isset = 1;
                    }
                }
            });
        }
        $(document).ready(function () {
            $('.datepicker').datepicker({
                daysOfWeekDisabled: [0, 6]
            });
        });


        function PrintTC(type) {
            var contents = '';
            if (type == 0) {
                contents = $("#tcdiv").html();
            }

            else {
                contents = $(".charactercontainer").html();
            }
            //var nDiv = $('#tcdiv').html();
            //var contents = nDiv;//"<div class='row'><div style='width:50%'>"+ $("#divRecipt").html()+"</div><div style='width:50%'>"+ $("#divRecipt").html()+"</div></div>";
            var frame1 = $('<iframe />');
            frame1[0].name = "frame1";
            $("body").append(frame1);
            var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
            frameDoc.document.open();
            //Create a new HTML document.
            frameDoc.document.write('<html><head><title></title>');
            frameDoc.document.write('<link href="/Content/TC.css" rel="stylesheet" type="text/css" />');
            frameDoc.document.write('</head><body>');
            //Append the external CSS file.
            //Append the DIV contents.

            frameDoc.document.write(contents);
            frameDoc.document.write('</body></html>');
            frameDoc.document.close();
            setTimeout(function () {
                window.frames["frame1"].focus();
                window.frames["frame1"].print();
                frame1.remove();
            }, 500);
        }
    </script>

}


