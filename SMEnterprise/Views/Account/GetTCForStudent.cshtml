                    <h2 class="tc-school-name">@Model.Branch.BranchSchoolName</h2>
                    <p class="tc-sheet-subtitle">@Model.Branch.Address</p>
                    <p class="tc-sheet-subtitle"><b>Phone:</b> @Model.Branch.ContactNo  <b>Email:</b> @Model.Branch.EmailID</p>
                </div>
            </div>
            <h3 class="tc-sheet-title">Transfer Certificate</h3>
        </div>

        <div class="tc-meta-panel tc-meta-panel-three">
