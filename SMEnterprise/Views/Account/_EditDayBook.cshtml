@model SMEnterprise.Models.DayBookPageModel
    @{ 
        if(Model.DayBook==null)
        {
            Model.DayBook = new SMEnterprise.Models.DayBookModel();
            Model.DayBook.Date = SMEnterprise.Repository.CommonUsage.GetCurrentDate();
        }
    }
<div class="">
    <div class="row">
        @using (Html.BeginForm("UpdateDayBook", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @class = "form-horizontal form-label-left" }))
        {
            <input type="hidden" id="hdnDBookID" name="DBookID" value="@Model.DayBook.DBookID" />
            <div class="form-horizontal form-label-left">
                <div class="">
                    <div class="col-md-4">
                        <label class="">Payer/Buyer</label>
                        <input type="text" name="IncomeExpenceBy" value="@Model.DayBook.IncomeExpenceBy" required class="form-control" />
                    </div>
                
                  
                    <div class="col-md-12">
                        <label class="">Payment Title</label>
                        <input type="text" name="Title" value="@Model.DayBook.Title" required class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="">Day Book Head</label>
                        <select class="form-control" name="DayBookID" id="ddlDayBookID">
                            @foreach (var PH in Model.DayBookHead)
                            {
                                <option @(Model.DayBook.DayBookID == PH.DayBookID ? "selected" : "") value="@PH.DayBookID">@PH.Name</option>
                            }
                            @*@foreach (var PH in Model.Heads)
                            {
                                <option @(Model.IncomeDetail.EIHeadID == PH.ID ? "selected" : "") value="@PH.ID">@PH.Name</option>
                            }*@
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="">Payment Mode</label>
                        <select class="form-control" name="PaymentMode" id="ddlPaymentMode">
                            <option @(Model.DayBook.PaymentMode == 0 ? "selected" : "") value="0">Cash Payment</option>
                            <option @(Model.DayBook.PaymentMode == 1 ? "selected" : "") value="1">Cheque Payment</option>
                            <option @(Model.DayBook.PaymentMode == 2 ? "selected" : "") value="2">NEFT Payment</option>
                            <option @(Model.DayBook.PaymentMode == 3 ? "selected" : "") value="3">Other Payment</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="">Referance No</label>
                        <input type="text" name="ReferanceNo" value="@Model.DayBook.ReferanceNo" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="">Date<small>(MM/DD/YYYY)</small></label>
                        <input type="date" name="Date" required value="@Model.DayBook.Date.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="">Amount</label>
                        <input type="number" name="Amount" required value="@Model.DayBook.Amount" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="">Recieved By</label>
                        <input type="text" name="RecievedBy" required value="@Model.DayBook.RecievedBy" class="form-control" />
                    </div>
                    <div class="col-md-12">
                        <label class="">Details</label>
                        <textarea class="form-control" name="Description" rows="4" style="resize:none">@Model.DayBook.Description</textarea>
                    </div>
                    <div class="col-md-12">
                        <input class="pf-button btn btn-primary pull-right" type="submit" onclick="SaveDayBook(this)" name="submit" value="Save" />
                    </div>
                </div>
                
            </div>
        }
    </div>
</div>