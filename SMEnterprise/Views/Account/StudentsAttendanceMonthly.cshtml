@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model SMEnterprise.Models.StudentsMonthlyAttendancePageModel
@section IncludeCss
{
    <title>Students Management</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">
}
<style>
    input[type=month]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        display: none;
    }

    input[type=month]::-webkit-clear-button {
        display: none; /* Hide the button */
        -webkit-appearance: none; /* turn off default browser styling */
    }

    .btn {
        padding: 3px 6px;
    }
    .unknown {
        background-color: orange;
        font-size: 10px;
    }

    .leave {
        background-color: cornflowerblue;
        color: white;
        font-size: 10px;
    }

    .absent {
        background-color: #fb5252;
        color: white;
        font-size: 10px;
    }

    .holiday {
        background-color: lightyellow;
        font-size: 10px;
    }

    .present {
        background-color: green;
        color: white;
        font-size: 10px;
    }
    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
