@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model SMEnterprise.Models.PerformanceParameterDetailModel
@section IncludeCss
{
    <title>Result Card | @Model.Student.Name</title>
    <style>
        #tblResult > tbody > tr > td {
            text-align: center !important;
            vertical-align: middle !important;
        }

        .table > tbody > tr > td {
            padding-bottom: 1px;
            padding-top: 2px;
        }

        .print {
            display: none;
        }
    </style>
}
<div class="">

    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_content">
                    <table class="table" style="border-bottom: 1px solid #ddd;padding-bottom: 5px;">
                        <tr style="width:100%">
                            <td style="width:7%">
                                <img onerror="return OnImageError(this,2);" style="width:120px;height:120px;" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.SBranchDetails.SBranchID)_@(Model.SBranchDetails.Logo)" />
                            </td>
                            <td style="width:85%;text-align: center;vertical-align: middle;">
                                <table style="width:100%;">
                                    <tr>
                                        <td style="iddle;">
                                            <p style="margin-top: 2px;margin-bottom: 5px;font-size: 26px;">@Model.SBranchDetails.BranchSchoolName</p>
                                            <p style="margin-bottom: 2px;margin-left:10px;font-size: 16px;">
                                                @Html.Raw(Html.Encode(Model.SBranchDetails.Address).Replace("\n", "<br />"))
                                                @*@Model.SBranchDetails.Address*@
                                            </p>
                                            <p style="margin-bottom: 2px;margin-left:60px;"><b>Session : @Model.SessionName</b></p>

                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <td style="width:8%">
                                <img onerror="return OnImageError(this,2);" style="width:120px;height:120px;" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.SBranchDetails.SBranchID)_@(Model.SBranchDetails.Logo)" />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="3" style="text-align: center;">

                                <p style="margin-bottom: 2px;margin-left:80px;"> Ph. @Model.SBranchDetails.ContactNo, Email : @Model.SBranchDetails.EmailID</p>


                            </td>
                        </tr>
                        <tr>
                            <td colspan="3" style="text-align:center">
                                Evaluation:    @Model.EvaluationName
                            </td>
                        </tr>
                        <tr style="padding-top:10px;padding-bottom:10px;">

                            <td style="padding-left:10px;text-align:left; width:45%">
                                <div class="col-md-12">
                                    <div class="row">
                                        Roll No. :<b> @Model.Student.RollNo</b>
                                    </div>
                                    <div class="row">
                                        Student : <b id="bStudentNate">@Model.Student.Name</b>
                                    </div>
                                    <div class="row">
                                        Mother's Name : <b>@Model.Student.MotherName</b>
                                    </div>
                                    <div class="row">
                                        Father's Name : <b>@Model.Student.FatherName</b>
                                    </div>
                                </div>
                            </td>
                            <td style="padding-left:10px;width:45%">
                                <div class="col-md-12">
                                    <div class="row">
                                        Date of Birth :<b> @Model.Student.DOB.ToString("dd MMM, yyyy")</b>
                                    </div>
                                    <div class="row">
                                        Class-Section :<b id="bClassSection"> @Model.Student.ClassName </b>
                                    </div>
                                    <div class="row">
                                        Student ID :<b> @Model.Student.StudentSID</b>
                                    </div>
                                    <div class="row">
                                        SR No.  :<b> @Model.Student.SchoolUID</b>
                                    </div>
                                </div>
                            </td>
                            <td style="text-align:left;width:10%">
                                <div class="col-md-12" style="text-align:left;">
                                    <img id="imgPhoto" onerror="return OnImageError(this,@(Model.Student.Gender));" style="width:100px;height:100px;" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(Model.Student.StudentID)_@Model.Student.Photo" />
                                </div>

                            </td>
                        </tr>
                    </table>

                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="tblResult" class="table table-bordered table-hover">
                            @{
                                if (Model.SubjectTypes.Count > 1)
                                {
                                    <thead style="text-align: center;font-weight: bold;">
                                        <tr style="border-bottom-width: 2px;">
                                            <td rowspan="2" style="vertical-align: middle;border:1px solid #808080">
                                                Subject
                                            </td>
                                            @foreach (NameIDModel st in Model.SubjectTypes)
                                            {
                                                <td colspan="2" style="border:1px solid #808080">
                                                    @st.Name
                                                </td>
                                            }
                                            <td rowspan="2" style="vertical-align: middle;border:1px solid #808080">
                                                Total
                                            </td>
                                            <td rowspan="2" style="vertical-align: middle;border:1px solid #808080">
                                                Grade
                                            </td>
                                        </tr>
                                        <tr style="border-bottom-width: 2px;">
                                            @foreach (NameIDModel st in Model.SubjectTypes)
                                            {
                                                <td style="border:1px solid #808080">
                                                    Max Marks
                                                </td>
                                                <td style="border:1px solid #808080">Scored</td>
                                            }
                                        </tr>
                                    </thead>
                                }
                                else
                                {
                                    <thead style="font-weight: bold;">

                                        <tr>
                                            <td>
                                                Subject
                                            </td>
                                            <td>
                                                Max Marks
                                            </td>
                                            <td>
                                                Pass Marks
                                            </td>
                                            <td>
                                                Marks Scored
                                            </td>
                                            <td>
                                                Grade
                                            </td>
                                        </tr>
                                    </thead>
                                }
                                decimal TotalMarks = 0;
                                decimal MarksObtained = 0;
                                decimal PassMarks = 0;
                                foreach (SubjectModel sm in Model.Subjects)
                                {
                                    decimal subTotalMarks = 0;
                                    decimal subTotalScored = 0;
                                    var isML = false;
                                    var isAnyNML = false;
                                    <tr>
                                        <td><b>@sm.SubjectName</b></td>
                                        @foreach (NameIDModel st in Model.SubjectTypes)
                                        {
                                            var isfound = false;

                                            foreach (ExamResultDetailModel r in Model.Result)
                                            {
                                                if ((r.MainSubID == 0 && r.SubjectID == sm.SubjectID || r.MainSubID != 0 && r.MainSubID == sm.SubjectID) && r.SubjectType == st.ID)
                                                {
                                                    subTotalMarks = subTotalMarks + r.MaxMarks;
                                                    subTotalScored = subTotalScored + r.MarksScored;
                                                    isfound = true;
                                                    isML = r.Status == -1 || isML ? true : false;
                                                    isAnyNML = !isML && !isAnyNML ? true : isAnyNML;
                                                    <td>@(r.MaxMarks == 0 ? "NA" : r.MaxMarks.ToString("00") )</td>
                                                    <td>@(r.PassMarks == 0 ? "NA" : r.PassMarks.ToString("00") )</td>
                                                    @*<td>@(r.MaxMarks == 0 ? "NA" : r.MaxMarks.ToString("00") )</td>
                                                        <td>@(r.MaxMarks == 0 ? "NA" : r.MarksScored.ToString("00") )</td>*@
                                                    break;
                                                }
                                            }
                                            if (!isfound)
                                            {
                                                <td>NA</td>
                                                <td>NA</td>
                                            }
                                        }
                                        @*<td>@subTotalScored</td>
                                            <td>@(subTotalMarks == 0 ? "--" : AcadmicModel.CalculateGrade(subTotalScored, subTotalMarks))</td>*@
                                        <td>@(isAnyNML == false ? "M/L" : subTotalScored.ToString("00"))</td>
                                        <td>@(subTotalMarks == 0 || isML ? "--" : AcadmicModel.CalculateGrade(subTotalScored, subTotalMarks))</td>

                                    </tr>

                                    TotalMarks = TotalMarks + subTotalMarks;
                                    MarksObtained = MarksObtained + subTotalScored;
                                }
                                <tr style="font-weight: bold;display:none;">
                                    <td colspan="@(Model.SubjectTypes.Count*2+1)">
                                        Total
                                    </td>
                                    <td>@MarksObtained</td>
                                    <td>@(TotalMarks == 0 ? "--" : AcadmicModel.CalculateGrade(MarksObtained, TotalMarks))</td>
                                </tr>


                            }
                        </table>
                    </div>
                    <div class="col-md-12 col-sm-12 col-xs-12" style="text-align: center;">
                        <br /><br /><br /><br /><br />
                        <table style="width:100%">

                            <tr>
                                <td style="width:25%;text-align: left;">
                                    Place : <br />
                                    Date  :@Model.SBranchDetails.TagLine.ToString()
                                </td>
                                <td style="width:25%">
                                    <br /><br />
                                    Signature of Class Teacher
                                </td>


                                @if (Model.SBranchDetails.PrincipalSignature == null)
                                {
                                    <td style="width:25%">
                                        <br /><br />
                                        Signature of Principal
                                    </td>
                                }
                                else
                                {
                                    <td style="width:25%">
                                        <img onerror="return OnImageError(this,2);" style="width:200px;height:50px;" alt="Photo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.SBranchDetails.SBranchID)_P_@(Model.SBranchDetails.PrincipalSignature)" />
                                        <br />&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Signature of Principal
                                    </td>
                                }



                            </tr>
                        </table>
                    </div>

                </div>

                <div class="col-md-12">
                    <a class="btn btn-success pull-left" href="javascript:void(0);" onclick="PrintReport();">Print</a>
                </div>

            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        function DrawAttandanceChart(data) {
            new Chart(document.getElementById("canvas000"), {
                type: 'line',
                data: data
            });
        }
        function PrintReport() {
            var StudentName = $('#bStudentNate').html();
            var ClassSection = $('#bClassSection').html();
            var contents = $(".x_content").html();
            var frame1 = $('<iframe />');
            frame1[0].name = "frame1";
            frame1.css({ "position": "absolute", "top": "-1000000px" });
            $("body").append(frame1);
            var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
            frameDoc.document.open();
            //Create a new HTML document.
            frameDoc.document.write('<html><head><title>Result For ' + StudentName + ' Class ' + ClassSection + '</title>');
            frameDoc.document.write('<link href="@Url.Content("~/css/ReportCard1.css")" rel="stylesheet" type="text/css" />');
            frameDoc.document.write('</head><body>');
            //Append the external CSS file.
            //Append the DIV contents.
            frameDoc.document.write(contents);
            frameDoc.document.write('</body></html>');
            frameDoc.document.close();
            setTimeout(function () {
                window.frames["frame1"].focus();
                window.frames["frame1"].print();
                frame1.remove();
            }, 500);
        }
    </script>
}
