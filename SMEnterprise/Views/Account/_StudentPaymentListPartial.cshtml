<div>

    <table id="tblCategory" class="table table-bordered table-hover jambo_table">
        <thead>
            <tr>
                <th width="15%">PaymentID</th>
                <th width="15%">Session</th>
                <th width="15%">Payment Date</th>
                <th width="15%">Months</th>
                <th width="15%">Amount</th>
                <th width="15%">Recieved By</th>
                <th width="15%">Recipt</th>
            </tr>
        </thead>
        <tbody>
            @{
            foreach (SMEnterprise.Models.FeePaymentModel c in Model)
            {
                    <tr>
                        <td>
                            @("PAY"+c.PaymentID.ToString().PadLeft(6, '0'))
                        </td>
                        <td>
                            @c.SessionName
                        </td>
                        <td>
                            @c.PaymentDate.ToString("dd MMM, yyyy")
                        </td>
                        <td>
                            @c.PayMonths
                        </td>
                        <td>
                            @c.PaymentAmount
                        </td>
                        <td>
                            @c.CollectedBy
                        </td>
                        <td> <a href="javascript:void(0);" class="RClosed" onclick="ViewReciept(this,@c.PaymentID);">View</a></td>
                    </tr>
            }
            }
        </tbody>

    </table>

</div>
