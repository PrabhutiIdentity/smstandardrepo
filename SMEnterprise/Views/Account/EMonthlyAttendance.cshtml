@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model MonthlyAttendancePageModel
@section IncludeCss
{
    <title>Monthly Attendance</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
<link href="@Url.Content("~/css/toggle-switch.css")" rel="stylesheet" />
}
<style>
    .btn {
        padding: 3px 6px;
    }
    .present {
        background-color: green;
        color: white;
    }
    .inentry {
        background-color: red;
        color: white;
    }
    #datatable td:hover {
        background-size: 100% 100%;
        transform: scale(2,1.5);
        transform-origin: center;
    }
    
</style>
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Monthly Attendance
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="/Account/Dashboard"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li class="active">Monthly Attendance</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box" style="height: 100%;">
                <div class="box-header">
                    @using (Html.BeginForm("EMonthlyAttendance", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetRequests" }))
                    {
                        <div class="row std-mng-head">
                            <div class="col-md-12 class-section">
                                <div class="row">                                   
                                    <div class="col-md-4 padding">
                                        <input type="month" name="RepoDate" class="form-control datepickerMonth" style="margin-top: 5px;" value="@Model.RepoDate.ToString("yyyy-MM")" />
                                    </div>
                                    <div class="col-md-5 padding">
                                        <label class="col-md-5 text-right">Employee Type :</label>
                                        <div class="col-md-7">
                                            <select id="ddlEmployeeTypes" name="EmployeeType" required="required" class="form-control col-md-7 col-xs-12">
                                                @foreach (var e in Model.EmployeeTypes)
                                                {
                                                    <option value="@e.EmployeeTypeID" @(Model.EmployeeType == e.EmployeeTypeID ? "selected" : "" )>@e.EmployeeTypeName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 padding">
                                        <a href="Javascript:void(0);" id="0" onclick="$('#frmGetRequests').submit();" class="btn btn-link" style="color:white;">Go!</a>
                                    </div>                                    
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="box-body">
                    <table id="datatable" class="table table-striped table-bordered" cellspacing="0" style="font-size: 8px;">
                        <thead>
                            <tr>
                                <th class="disabled-sorting" style="width:5%">#</th>
                                <th class="disabled-sorting" style="width:15%">Employee</th>
                                @for (var i = 0; i < DateTime.DaysInMonth(Model.RepoDate.Year, Model.RepoDate.Month); i++)
                                {
                                    <th class="">D@(i + 1)</th>
                                }
                                <th class="disabled-sorting" style="width:10%">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var ctr = 1;
                                foreach (var m in Model.Employees)
                                {
                                    <tr>
                                        <td>@ctr</td>
                                        <td>@m.EmployeeSID<br />@m.EmployeeName</td>
                                        @{
                                            double TotalMinutes = 0;
                                            for (var i = 1; i <= DateTime.DaysInMonth(Model.RepoDate.Year, Model.RepoDate.Month); i++)
                                            {

                                                int Direction = 0;
                                                double minutes = 0;
                                                int lastStatus = 0;
                                                DateTime startDate = new DateTime();
                                                DateTime sDate = new DateTime();
                                                DateTime EDate = new DateTime();
                                                foreach (SMEnterprise.Models.MonthlyAttendanceLogModel p in Model.Attendance.Where(c => c.UserID == m.EmployeeSID && c.LogDate.Day == i))
                                                {
                                                    if (sDate.Year == 1)
                                                    {
                                                        startDate = p.LogDate;
                                                    }
                                                    if (sDate.Year == 1 || Direction == 0)
                                                    {
                                                        sDate = p.LogDate;
                                                    }
                                                    if (Direction == 1)
                                                    {
                                                        TimeSpan span = p.LogDate.Subtract(sDate);
                                                        minutes = minutes + span.TotalMinutes;
                                                        EDate = p.LogDate;
                                                    }
                                                    Direction = Direction == 0 ? 1 : 0;
                                                }

                                                TotalMinutes = TotalMinutes + minutes;
                                                TimeSpan timeSpan = TimeSpan.FromMinutes(minutes);
                                                <td @(timeSpan.ToString(@"hh\:mm")!="00:00"?"class=present": startDate.Year!=1? "class=inentry" : "")>
                                                    @timeSpan.ToString(@"hh\:mm")
                                                </td>
                                            }
                                        }
                                        <td>

                                            <b>@(((int)TotalMinutes) / 60) : @((TotalMinutes % 60).ToString("0"))</b>
                                        </td>
                                    </tr>
                                                ctr++;
                                            }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</section>
@section scripts
{
<script src="@Url.Content("~/js/Admin/jquery.dataTables.min.js")"></script>
<script src="@Url.Content("~/js/dataTables.bootstrap.min.js")"></script>
<script>
   

</script>
    }
<!-- /.content -->