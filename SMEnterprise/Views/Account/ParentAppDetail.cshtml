@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model SMEnterprise.Models.StudentsPageModel
@section IncludeCss
{
    <title>Parant Report</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">
}

<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("ParentAppDetail", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
                {
                    <div class="row std-mng-head">

                        <div class="col-md-12 class-section">
                            <div class="row">

                                <div class="col-md-1 padding">
                                </div>
                                <div class="col-md-3 padding">
                                    <label class="col-md-4 text-right">Session :</label>
                                    <div class="col-md-8">
                                        <select class="form-control" name="SessionID" id="ddlSessions">
                                            <option value="0">--Select Session--</option>
                                            @foreach (NameIDModel el in Model.Sessions)
                                            {
                                                <option value="@el.ID" @(el.ID == Model.SessionID ? "selected" : "")>@el.Name @(el.Extra1=="1"?"(Active)":"")</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3 padding">
                                    <label class="col-md-4 text-right">Class :</label>
                                    <div class="col-md-8">
                                        <select class="form-control" name="ClassID" id="ddlClass" onchange="javascript:ClassChanged(this);">
                                            <option value="0">--Select Class--</option>
                                            @foreach (ClassModel el in Model.Classes)
                                            {
                                                <option value="@el.ClassID" @(el.ClassID == Model.ClassID ? "selected" : "")>@el.ClassName</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4 padding">
                                    <div class="row">
                                        <label class="col-md-3 text-right padding-R" style="padding-left: 10px;">Section : </label>
                                        <div class="col-md-7 padding-L" style="padding-left: 10px;">

                                            <select name="SectionID" class="form-control" id="ddlSection" >
                                                <option value="0">--Select Section--</option>
                                                @foreach (SectionModel el in Model.Sections)
                                                {
                                                    <option value="@el.ID" @(el.ID == Model.SectionID ? "selected" : "")>@el.Name</option>
                                                }
                                            </select>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-md-1 padding">
                                    <div class="row">

                                        <div class="col-md-12">
                                            <a href="javascript:void(0);" onclick="$('#frmGetStudents').submit();"><i class="fa fa-search"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                }
                <div class="x_panel">

                    <div class="x_content">

                        <table id="tblCategory"  class="table table-bordered table-hover display nowrap" style="overflow-x: scroll;width: 100%;display: inline-block;">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>SR.No.</th>
                                    <th>Student Name </th>
                                    <th>StudentID</th>
                                    <th>Gender</th>
                                    <th>Class</th>
                                    <th>Section</th>
                                    <th><b>User Name</b></th>
                                    <th>Password</th>
                                    <th>Father Name </th>
                                    <th>F. DOB</th>
                                    <th>Father Contact No</th>
                                    <th>Mother Name </th>
                                    <th>Mother Contact No</th>
                                    
                                </tr>
                            </thead>
                            @{
                                int count = 0;
                                foreach (StudentModel c in Model.Students)
                                {
                            <tr>
                                <td>
                                    <img id="imgPhoto" style="height:70px;width:70px" onerror="return OnImageError(this,@(c.Gender));" class="thumbImageGrid" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(c.StudentID)_@c.Photo" />
                                </td>
                                <td>
                                    @c.SchoolUID

                                </td>
                                <td>
                                    @c.Name


                                </td>
                                <td>

                                    @c.StudentSID

                                </td>
                                <td>
                                    @if (@c.Gender != 0)
                                    {
                                        <label>Female</label>
                                    }
                                    else
                                    {
                                        <label>Male</label>
                                    }
                                </td>
                                <td>
                                    @c.ClassName
                                </td>
                                <td>

                                    @c.SectionName
                                </td>
                                <td style="color:dodgerblue;">

                                    <b>@c.SParentID</b> 

                                </td>

                                <td></td>
                                <td>
                                    @c.FatherName
                                </td>
                                <td>
                                    @c.FatherDOB.ToString("dd MMM, yyyy")

                                </td>
                                <td>

                                    @c.FatherMobileNo

                                </td>
                                <td>
                                    @c.MotherName
                                </td>


                                <td>
                                    @c.MotherMobileNo
                                </td>
                                
                            </tr>

                                    count++;
                                }

                            }
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section scripts
{
    @*<script src="@Url.Content("~/js/Admin/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/js/dataTables.bootstrap.min.js")"></script>*@

    <script src="@Url.Content("~/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>

    <script src="@Url.Content("~/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.print.min.js")"></script>

    <script src="@Url.Content("~/js/jszip.min.js")"></script>
    <script src="@Url.Content("~/js/pdfmake.min.js")"></script>
    <script src="@Url.Content("~/js/vfs_fonts.js")"></script>
    <script>
        $(document).ready(function () {            
            var repname = '@PermissionManager.GetLoggedInUser().Description' +'<br /> Parent App Details ' + $('#ddlSessions option:selected').text() + ' ' + $('#ddlClass option:selected').text() + ' ' + $('#ddlSection option:selected').text();
            var handleDataTableButtons = function () {
                if ($("#tblCategory").length) {
                    $("#tblCategory").DataTable({
                        "pageLength": 30,
                        bSort: true,
                        dom: "Bfrtip",
                        buttons: [
                            {
                                extend: "copy",
                                className: "btn-sm",
                                title: repname
                            },
                            {
                                extend: "csv",
                                className: "btn-sm",
                                title: repname
                            },
                            {
                                extend: "excel",
                                className: "btn-sm",
                                title: repname
                            },
                            {
                                extend: "pdfHtml5",
                                className: "btn-sm",
                                title: repname
                            },
                            {
                                extend: "print",
                                className: "btn-sm",
                                title: repname
                            },
                        ],
                        responsive: true
                    });
                }
            };
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                };
            }();
            TableManageButtons.init();

        });
    </script>
    <script>

        function ClassChanged(sender) {
            $('#ddlSection').html('<option value="0">Loading....</option>');
            $.ajax(
                {
                    type: "POST",
                    url: "/Account/GetSectionOnClass/" + $(sender).val(),
                    cache: false,
                    processData: false,
                    contentType: false,
                    success: function (html) {
                        $('#ddlSection').html('');
                        $('#ddlSection').html('<option value="0">--Select Section--</option>');
                        $('#ddlSection').append(html);
                    },
                    error: function (e) {
                        alert("errorn");
                    }
                });
        }
    </script>


}