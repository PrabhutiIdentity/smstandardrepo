@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    var sBranchStateID = SMEnterprise.Models.PermissionManager.GetLoggedInUser().StateID;





    var isPaymentLocked = Model.IsPaymentLocked;
    var canReceiveMorePayment = Model.Status != 0 && Model.TrType != 2 && Model.DueAmount > 0;
    var paymentRowLocked = Model.Status == 0 || Model.TrType == 2 || (Model.STID > 0 && Model.PaidAmount > 0 && Model.DueAmount <= 0);
    var receiveNowAmount = Model.STID > 0 && Model.PaidAmount > 0 && Model.DueAmount > 0 ? Model.DueAmount : Model.PaidAmount;
    var currentPaymentReference = Model.PaidAmount > 0 && Model.DueAmount > 0 ? "" : Model.PaymentReferanceNo;
    var paymentFieldClass = Model.PaidAmount > 0 ? "col-md-2" : "col-md-3";
    var hasPaymentHistory = Model.PaymentHistory != null && Model.PaymentHistory.Count > 0;
    var latestActivePaymentID = hasPaymentHistory
        ? Model.PaymentHistory.Where(x => !x.IsCancelled).OrderByDescending(x => x.PaymentDate).ThenByDescending(x => x.StockPaymentID).Select(x => x.StockPaymentID).FirstOrDefault()
        : 0;
    var disablePaymentInputs = paymentRowLocked;
    var stockSaved = ViewBag.StockSaved != null && (bool)ViewBag.StockSaved;
    var stockSaveMode = ViewBag.StockSaveMode == null ? "" : ViewBag.StockSaveMode.ToString();
    var saveButtonText = canReceiveMorePayment ? "Pay Now" : hasPaymentHistory ? "Cancel Selected Receipt" : isPaymentLocked && !canReceiveMorePayment ? "Save Cancellation" : "Save";
    var lastSavedPaymentID = ViewBag.LastSavedPaymentID == null ? 0 : Convert.ToInt32(ViewBag.LastSavedPaymentID);




}
@model SMEnterprise.Models.StockTransaferMasterModel
@section IncludeCss
{
    <title>Stock Details</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">

    <link rel="stylesheet" href="@Url.Content("~/css/RecieptStyle.css")">



    <link rel="stylesheet" href="@Url.Content("~/css/RecieptStyle.css")">


}
<style>
    .ui-pnotify {
        position: absolute;
        left: 0px;
        right: 36px;
        margin: 0px auto;
        width: 40%;
        top: 36px;
        cursor: auto;
    }

    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }

    .fa-remove {
        color: red;
    }

    .RedText {
        color: red;
    }

    .fileContainer {
        overflow: hidden;
        position: relative;
    }

        .fileContainer [type=file] {
            cursor: inherit;
            display: block;
            font-size: 999px;
            filter: alpha(opacity=0);
            min-height: 100%;
            min-width: 100%;
            opacity: 0;
            position: absolute;
            right: 0;
            text-align: right;
            top: 0;
        }

    .BillImageBox {
        padding: 10px 5px 5px 5px;
        background-color: white;
        margin-left: 5px;
        border-radius: 5px;
    }






    .payment-locked {
        pointer-events: none;
        opacity: 0.75;
    }

    .payment-summary-box {
        background-color: #f6f9fc;
        border: 1px solid #d7e4ef;
        border-radius: 4px;
        padding: 10px;
        margin-bottom: 10px;
    }

    .payment-lock-note {
        background-color: #fff7e6;
        border: 1px solid #f0c36d;
        color: #8a6d3b;
        border-radius: 4px;
        padding: 8px 12px;
        margin-bottom: 10px;
    }

    .save-success-panel {
        background-color: #eef9f1;
        border: 1px solid #97d7a7;
        color: #276738;
        border-radius: 4px;
        padding: 12px;
        margin-bottom: 12px;
    }

    .save-success-panel .btn {
        margin-right: 8px;
        margin-top: 8px;
    }

    .receipt-preview-box {
        background-color: #fff;
        border: 1px solid #d9e2ea;
        border-radius: 4px;
        padding: 10px;
        margin-bottom: 12px;
        box-shadow: 0 8px 24px rgba(32, 56, 85, 0.08);
    }

    .receipt-preview-box .wrapper {
        width: 100%;
        max-width: 860px;
        border: 1px solid #d8e1ea;
        border-radius: 10px;
        box-shadow: 0 12px 30px rgba(30, 57, 89, 0.08);
    }

    .receipt-preview-box .btn {
        padding: 8px 14px;
    }

    .receipt-preview-box .header-1 h1 {
        letter-spacing: 1px;
        text-shadow: none;
    }

    .receipt-preview-box .principle {
        text-align: right;
        color: #35506b;
    }

    .receipt-preview-box .receipt-copy-tag {
        display: inline-block;
        background: #e9f3ff;
        color: #214b78;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .5px;
        padding: 4px 10px;
        border-radius: 999px;
        margin-bottom: 10px;
        text-transform: uppercase;
    }

    .receipt-action-btn.active {
        box-shadow: inset 0 0 0 2px rgba(255,255,255,.45);
    }

    .receipt-close-link {
        float: right;
        color: #8a6d3b;
        font-weight: 600;
    }

    .receipt-cancelled-row {
        background-color: #fff1f1;
    }

    .receipt-status-cancelled {
        color: #c9302c;
        font-weight: 700;
    }




</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                <div class="row std-mng-head">
                    <div class="col-md-12 class-section">
                        <div class="row" style="color:white;">
                            <div class="col-md-8">
                                Transaction Details
                            </div>
                        </div>
                    </div>
                </div>
                <div class="x_panel">





                    <form id="frmCancelReceipt" method="post" action="/Account/CancelStockPaymentReceipt/@Model.STID" style="display:none;">
                        <input type="hidden" name="paymentId" id="hdnCancelPaymentID" value="0" />
                        <input type="hidden" name="remark" id="hdnCancelRemark" value="" />
                    </form>




                    @using (Html.BeginForm("SaveStock", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "UpdatePassword", @class = "form-horizontal" }))
                    {
                        if (Model.STID == 0)
                        {
                            Model.Status = 1;
                            Model.TrDate = SMEnterprise.Repository.CommonUsage.GetCurrentDate();



                        }
                        <div class="x_content">


                            Model.PaymentDate = Model.TrDate;
                            Model.PaymentMode = 0;
                        }
                        <div class="x_content">
                            @if (stockSaved)
                            {
                                <div class="save-success-panel">
                                    Transaction saved successfully. Current status: <strong>@(stockSaveMode == "latestreceiptonly" ? "Cancel Latest Receipt First" : stockSaveMode == "receiptcancelfailed" ? "Receipt Cancel Failed" : stockSaveMode == "receiptcancelled" ? "Receipt Cancelled" : stockSaveMode == "cancelled" ? "Cancelled" : stockSaveMode == "paid" ? "Paid" : stockSaveMode == "partial" ? "Partial Payment" : "Unpaid")</strong>
                                    <div>
                                        <a href="javascript:void(0);" id="btnInvoicePreview" class="btn btn-info receipt-action-btn" onclick="ToggleReceiptPreview(this, @Model.STID, 'invoice');">Open Invoice</a>
                                        @if (Model.PaidAmount > 0 || lastSavedPaymentID > 0 || Model.LastPaymentID > 0)
                                        {
                                            <a href="javascript:void(0);" id="btnPaymentPreview" class="btn btn-success receipt-action-btn" onclick="ToggleReceiptPreview(this, @Model.STID, 'payment', @(lastSavedPaymentID > 0 ? lastSavedPaymentID : Model.LastPaymentID));">Open Payment Receipt</a>
                                        }
                                        <a href="/Account/StockManagement?TrType=@Model.TrType" class="btn btn-default">Back To Transactions</a>
                                    </div>
                                </div>
                            }
                            <div id="dvReceiptPreview" class="receipt-preview-box" style="display:none;"></div>
                            @if (isPaymentLocked)
                            {
                                <div class="payment-lock-note">
                                    Payment is already recorded for this transaction. Item edit and remove are locked.
                                    @(canReceiveMorePayment ? " You can still receive the remaining balance amount below. Enter only the amount being paid this time, either full balance or another partial amount. You can also cancel a specific receipt from payment history." : " You can cancel a specific receipt from payment history below.")
                                </div>
                            }
                            <div class="payment-protected @(isPaymentLocked ? "payment-locked" : "")">




                            <div class="row BkRow">
                                <div class="col-md-3">
                                    <label>Transaction Type</label>
                                    <input type="hidden" name="STID" value="@Model.STID" />
                                    <select class="form-control" name="TrType" id="ddlTrType" onchange="TrTypeChanged(this);">
                                        <option value="0" @(0 == Model.TrType ? "selected" : "")>Purchase</option>
                                        <option value="1" @(1 == Model.TrType ? "selected" : "")>Sale</option>
                                        <option value="2" @(2 == Model.TrType ? "selected" : "")>Allocate (No Sale)</option>
                                    </select>
                                </div>
                                <div class="col-md-3" id="dvRecieverTypes" style="@(Model.TrType==0?"display:none":"")">
                                    <label>Reciever Type</label>
                                    <select class="form-control" name="RefType" id="ddlRefTypes" onchange="RefTypeChanged(this);">
                                        <option value="0" @(0 == Model.RefType ? "selected" : "")>Student</option>
                                        <option value="1" @(1 == Model.RefType ? "selected" : "")>Employee</option>
                                    </select>
                                    <input type="hidden" name="RefID" value="@Model.RefID" id="hdnRefID" />
                                </div>
                                <div class="col-md-3">
                                    <label>Transaction Date</label>
                                    <input type="date" class="form-control" id="txtTrDate" name="TrDate" value="@Model.TrDate.ToString("yyyy-MM-dd")" onchange="StockDateChanged(this)" />

                                    <input type="hidden" name="SelectedPaymentID" id="hdnSelectedPaymentID" value="0" />
                                </div>
                                <div class="col-md-3">
                                    <label>Status</label>
                                    <select class="form-control" name="Status" id="ddlStatus">


                                </div>
                                <div class="col-md-3">
                                    <label>Status</label>
                                    <select class="form-control" name="Status">

                                    <input type="hidden" name="SelectedPaymentID" id="hdnSelectedPaymentID" value="0" />
                                </div>
                                <div class="col-md-3">
                                    <label>Status</label>
                                    <select class="form-control" name="Status" id="ddlStatus">


                                        <option value="1" @(1 == Model.Status ? "selected" : "")>Valid</option>
                                        <option value="0" @(0 == Model.Status ? "selected" : "")>Cancelled</option>
                                    </select>
                                </div>
                                <div class="col-md-12">
                                    <label>Remark</label>
                                    <input type="text" class="form-control" required name="Remark" value="@Model.Remark" />
                                </div>

                            </div>
                            <div class="row BkRow" id="dvStudentRefType" style="@(Model.TrType==1 && Model.RefType==0?"":"display:none")">
                                <div class="col-md-3 student">
                                    <label>Session</label>
                                    <select class="form-control" name="SessionID" id="ddlSessions" onchange="$('#ddlSection').trigger('change');">
                                        @foreach (var sess in Model.Sessions)
                                        {
                                            <option value="@sess.ID" @(sess.ID == Model.SessionID ? "selected" : "")>@sess.Name @(sess.Extra1 == "1" ? "(Active)" : "")</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 student">
                                    <label>Class</label>
                                    <select class="form-control" id="ddlClasses" name="ClassID" onchange="ClassChanged(this);">
                                        @foreach (var sess in Model.Classes)
                                        {
                                            <option value="@sess.ID" @(sess.ID == Model.ClassID ? "selected" : "")>@sess.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 student">
                                    <label>Section</label>
                                    <select class="form-control" name="SectionID" id="ddlSection" onchange="SectionChanged(this);">
                                        @foreach (var sess in Model.Sections)
                                        {
                                            <option value="@sess.ID" @(sess.ID == Model.SectionID ? "selected" : "")>@sess.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 student">
                                    <label>Student</label>
                                    <select class="form-control" id="ddlStudents">
                                        @foreach (var sess in Model.Students)
                                        {
                                            <option value="@sess.ID" @(sess.ID == Model.RefID ? "selected" : "")>@sess.Name @sess.Extra1</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row BkRow" id="dvEmployeeRefType" style="@(Model.TrType==1 && Model.RefType==1?"":"display:none")">
                                <div class="col-md-3 student">
                                    <label>Employee Category</label>
                                    <select class="form-control" name="EmployeeTypeID" id="ddlEmployeeTypes" onchange="EmployeeTypeChanged(this)">
                                        @foreach (var sess in Model.EmployeeTypes)
                                        {
                                            <option value="@sess.ID" @(sess.ID == Model.EmployeeTypeID ? "selected" : "")>@sess.Name </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-9 student">
                                    <label>Employee</label>
                                    <select class="form-control" name="RefID" id="ddlEmployees">
                                        @foreach (var sess in Model.Classes)
                                        {
                                            <option value="@sess.ID" @(sess.ID == Model.ClassID ? "selected" : "")>@sess.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="row BkRow" id="dvVendorRefType" style="@(Model.TrType!=0?"display:none":"")">
                                <div class="col-md-6 student">
                                    <label>Vendor</label>
                                    <select class="form-control" name="VendorID" id="ddlVendors">
                                        @foreach (var sess in Model.Vendors)
                                        {
                                            <option stateid="@sess.StateID" value="@sess.VendorID" @(sess.VendorID == Model.VendorID ? "selected" : "")>@sess.CompanyName </option>
                                        }
                                    </select>
                                </div>
                            </div>





                            </div>
                            <div class="row BkRow" id="dvCancelRemark" style="@(Model.Status == 0 ? "" : "display:none")">
                                <div class="col-md-12">
                                    <label>Cancellation Remark</label>
                                    <input type="text" class="form-control" name="CancelRemark" id="txtCancelRemark" value="@Model.CancelRemark" />
                                </div>
                            </div>
                            <div class="payment-protected @(isPaymentLocked ? "payment-locked" : "")">




                            <div class="row BkRow">
                                <div class="col-md-12">
                                    <label>Stock Details</label>
                                    <div class="row" style="margin-left: 0px;margin-right: 0px;">
                                        <table class="table table-striped jambo_table bulk_action">
                                            <thead>
                                                <tr class="headings">
                                                    <th style="width:30%">Product</th>
                                                    <th style="width:15%">Quantity</th>
                                                    <th class="costfield" style="width:15%;@(Model.TrType==2?"display:none;":"")">MRP</th>
                                                    <th class="costfield" style="width:15%;@(Model.TrType==2?"display:none;":"")">Price</th>
                                                    <th class="costfield" style="width:15%;@(Model.TrType==2?"display:none;":"")">GST <small>(SGST/CGST/IGST)</small></th>
                                                    <th class="costfield" style="width:15%;@(Model.TrType==2?"display:none;":"")">Net Amount</th>
                                                    <th style="width:20%">Remove</th>
                                                </tr>
                                            </thead>
                                            <tbody style="background-color: white;" id="tblExpDetails">
                                                @{

                                                    int counter = 0;
                                                    foreach (StockTransaferDetailModel d in Model.Details)
                                                    {
                                                        <tr class="trStockItem">
                                                            <td>
                                                                <input type="hidden" id="hdnSTDID" name="Details[@counter].STDID" value="@d.STDID" />
                                                                <input type="hidden" id="hdnProductID" name="Details[@counter].ProductID" value="@d.ProductID" />
                                                                <input type="hidden" id="hdnQuantity" name="Details[@counter].Quantity" value="@d.Quantity" />
                                                                <input type="hidden" id="hdnMRP" name="Details[@counter].MRP" value="@d.MRP" />
                                                                <input type="hidden" id="hdnSGST" name="Details[@counter].SGST" value="@d.SGST" />
                                                                <input type="hidden" id="hdnCGST" name="Details[@counter].CGST" value="@d.CGST" />
                                                                <input type="hidden" id="hdnIGST" name="Details[@counter].IGST" value="@d.IGST" />
                                                                <input type="hidden" id="hdnCost" name="Details[@counter].Cost" value="@d.Cost" />
                                                                <input type="hidden" id="hdnOpType" name="Details[@counter].OpType" value="1" />
                                                                @d.ProductName
                                                            </td>
                                                            <td>
                                                                @d.Quantity
                                                            </td>
                                                            <td class="costfield" style="@(Model.TrType==2?"display:none;":"")">@d.MRP.ToString("0.00")</td>
                                                            <td class="costfield" style="@(Model.TrType==2?"display:none;":"")">@d.Cost.ToString("0.00")</td>
                                                            <td class="costfield" style="@(Model.TrType==2?"display:none;":"")">
                                                                @d.SGST.ToString("0.0")%/ @d.CGST.ToString("0.0")%/ @d.IGST.ToString("0.0")%
                                                            </td>
                                                            <td class="costfield" style="@(Model.TrType==2?"display:none;":"")">
                                                                @((d.Cost * d.Quantity + d.Cost*d.Quantity*(d.SGST+d.CGST+d.IGST)/100).ToString("0.0"))

                                                            </td>
                                                            <td>



                                                                <a href="javascript:void(0);" onclick="RemoveStockDetail(this);" class="btn btn-danger">Remove</a>


                                                                @if (!isPaymentLocked)
                                                                {
                                                                    <a href="javascript:void(0);" onclick="RemoveStockDetail(this);" class="btn btn-danger">Remove</a>
                                                                }




                                                            </td>
                                                        </tr>
                                                        counter++;
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="row" style="margin-left: 0px;margin-right: 0px;">

                                        @if (!isPaymentLocked)
                                        {
                                            <a href="javascript:void(0);" onclick="AddNewStockDetail(this);" class="btn btn-dark pull-right" id="btnAddStockItem">Add New Stock Item</a>
                                        }
                                    </div>
                                </div>
                            </div>
                            </div>
                            <div class="row BkRow payment-row" style="@(Model.TrType==2?"display:none":"")">
                                <div class="col-md-12">
                                    <label>Payment Details</label>
                                </div>
                                @if (Model.PaidAmount > 0)
                                {
                                    <div class="@paymentFieldClass">
                                        <label>Amount Already Paid</label>
                                        <input type="text" class="form-control" value="@Model.PaidAmount.ToString("0.00")" readonly />


                                        <a href="javascript:void(0);" onclick="AddNewStockDetail(this);" class="btn btn-dark pull-right">Add New Stock Item</a>

                                    </div>
                                }
                                <div class="@paymentFieldClass">
                                    <label>Payment Date</label>
                                    <input type="date" class="form-control" id="txtPaymentDate" name="PaymentDate" value="@((Model.PaymentDate ?? Model.TrDate).ToString("yyyy-MM-dd"))" @(disablePaymentInputs ? "disabled" : "") />
                                </div>
                                <div class="@paymentFieldClass">
                                    <label>Payment Mode</label>
                                    <select class="form-control" name="PaymentMode" id="ddlPaymentMode" @(disablePaymentInputs ? "disabled" : "")>
                                        <option value="0" @(0 == Model.PaymentMode ? "selected" : "")>Cash Payment</option>
                                        <option value="1" @(1 == Model.PaymentMode ? "selected" : "")>Cheque Payment</option>
                                        <option value="2" @(2 == Model.PaymentMode ? "selected" : "")>NEFT Payment</option>
                                        <option value="4" @(4 == Model.PaymentMode ? "selected" : "")>Google Pay</option>
                                        <option value="5" @(5 == Model.PaymentMode ? "selected" : "")>PayTm</option>
                                        <option value="6" @(6 == Model.PaymentMode ? "selected" : "")>PhonePe</option>
                                        <option value="3" @(3 == Model.PaymentMode ? "selected" : "")>Other Payment</option>
                                    </select>
                                </div>
                                <div class="@paymentFieldClass">
                                    <label>Reference No</label>
                                    <input type="text" class="form-control" name="PaymentReferanceNo" id="txtPaymentReferenceNo" value="@currentPaymentReference" @(disablePaymentInputs ? "readonly" : "") />
                                    <div id="paymentReferenceHelp" style="font-size:12px;color:#6f7f91;margin-top:4px;"></div>
                                </div>
                                <div class="@paymentFieldClass">
                                    <label>@(Model.PaidAmount > 0 && Model.DueAmount > 0 ? "This Time Payment Amount" : "Enter Paid Amount")</label>
                                    <input type="number" min="0" step="0.01" class="form-control" name="PaidAmount" id="txtPaidAmount" value="@receiveNowAmount.ToString("0.00")" oninput="RecalculatePaymentSummary();" @(disablePaymentInputs ? "readonly" : "") />
                                    @if (Model.PaidAmount > 0 && Model.DueAmount > 0)
                                    {
                                        <div style="font-size:12px;color:#6f7f91;margin-top:4px;">
                                            Enter only this installment amount. You can pay full balance or partial balance again.
                                        </div>
                                    }
                                </div>
                                <div class="col-md-12">
                                    <div class="payment-summary-box">
                                        <div class="row">
                                            <div class="col-md-3"><strong>Total Amount:</strong> <span id="spnTotalAmount">@Model.Amount.ToString("0.00")</span></div>
                                            <div class="col-md-3"><strong>Total Paid:</strong> <span id="spnPaidAmount">@Model.PaidAmount.ToString("0.00")</span></div>
                                            <div class="col-md-3"><strong>Due Amount:</strong> <span id="spnDueAmount">@Model.DueAmount.ToString("0.00")</span></div>
                                            <div class="col-md-3"><strong>Payment Status:</strong> <span id="spnPaymentStatus">@Model.PaymentStatusText</span></div>
                                        </div>
                                    </div>
                                    <input type="hidden" name="DueAmount" id="txtDueAmount" value="@Model.DueAmount.ToString("0.00")" />
                                    <input type="hidden" name="PaymentStatus" id="txtPaymentStatus" value="@Model.PaymentStatus" />
                                    <input type="hidden" id="txtExistingPaidAmount" value="@Model.PaidAmount.ToString("0.00")" />
                                </div>
                                @if (Model.PaymentHistory != null && Model.PaymentHistory.Count > 0)
                                {
                                    <div class="col-md-12">
                                        <div class="payment-summary-box">
                                            <div style="font-weight:600; margin-bottom:8px;">Payment History</div>
                                            <div id="dvSelectedReceiptInfo" style="display:none; margin-bottom:8px; color:#c9302c; font-weight:600;"></div>
                                            <div class="table-responsive">
                                                <table class="table table-bordered table-condensed" style="width:100%;">
                                                    <thead>
                                                        <tr>
                                                            <th>Receipt No</th>
                                                            <th>Date</th>
                                                            <th>Mode</th>
                                                            <th>Reference No</th>
                                                            <th>Received</th>
                                                            <th>Total Paid</th>
                                                            <th>Balance</th>
                                                            <th>Status</th>
                                                            <th>Cancel Date</th>
                                                            <th>Receipt</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var payment in Model.PaymentHistory.OrderByDescending(x => x.PaymentDate).ThenByDescending(x => x.StockPaymentID))
                                                        {
                                                            <tr class="@(payment.IsCancelled ? "receipt-cancelled-row" : "")">
