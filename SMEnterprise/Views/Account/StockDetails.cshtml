        function BeforeSaveStock() {

            if ($('#txtTrDate').val() == '') {


            if ($('#txtStockDate').val() == '') {

            if ($('#txtTrDate').val() == '') {


                ShowNotification('Error', "Kindly Specify Date for Stock Transaction", "error");
                return false;
            }
            if ($('#tblExpDetails tr').length == 0) {
