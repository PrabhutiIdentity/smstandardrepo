        function GetStockTotalAmount() {
            var total = 0;
            $('#tblExpDetails').find('tr').each(function () {
                var opType = parseInt($(this).find('#hdnOpType').val() || '0');
                if (opType != -1) {
                    var qty = parseFloat($(this).find('#hdnQuantity').val() || '0');
                    var cost = parseFloat($(this).find('#hdnCost').val() || '0');
                    var sgst = parseFloat($(this).find('#hdnSGST').val() || '0');
                    var cgst = parseFloat($(this).find('#hdnCGST').val() || '0');
                    var igst = parseFloat($(this).find('#hdnIGST').val() || '0');
                    total += cost * qty + cost * qty * (sgst + cgst + igst) / 100;
                }
            });
            return total;
        }
        function RecalculatePaymentSummary() {
            var total = ($('#ddlTrType').val() == '2') ? 0 : GetStockTotalAmount();
            var existingPaid = parseFloat($('#txtExistingPaidAmount').val() || '0');
            var receiveNow = parseFloat($('#txtPaidAmount').val() || '0');
            if (receiveNow < 0) {
                receiveNow = 0;
            }
            if (existingPaid < 0) {
                existingPaid = 0;
            }
            if (existingPaid > total) {
                existingPaid = total;
            }
            if (receiveNow + existingPaid > total) {
                receiveNow = total - existingPaid;
                $('#txtPaidAmount').val(receiveNow.toFixed(2));
            }
            var paid = existingPaid + receiveNow;
            var due = total - paid;
            var statusText = 'Unpaid';
            var statusValue = 0;
            if ($('#ddlStatus').val() == '0') {
                statusText = 'Cancelled';
                statusValue = 3;
            }
            else if (paid > 0 && due > 0) {
                statusText = 'Partial';
                statusValue = 1;
            }
            else if (total > 0 && due <= 0) {
                statusText = 'Paid';
                statusValue = 2;
            }
            $('#spnTotalAmount').html(total.toFixed(2));
            $('#spnPaidAmount').html(paid.toFixed(2));
            $('#spnDueAmount').html(due.toFixed(2));
            $('#spnPaymentStatus').html(statusText);
            $('#txtDueAmount').val(due.toFixed(2));
            $('#txtPaymentStatus').val(statusValue);
        }
        function ToggleCancelRemark() {
            if ($('#ddlStatus').val() == '0') {
                $('#dvCancelRemark').show();
            }
            else {
                $('#dvCancelRemark').hide();
            }
            UpdateSaveButtonLabel();
        }
        function UpdateSaveButtonLabel() {
            var selectedPaymentID = parseInt($('#hdnSelectedPaymentID').val() || '0');
            var label = 'Save';
            if ($('#ddlStatus').val() == '0' && selectedPaymentID > 0) {
                label = 'Cancel Selected Receipt';
            }
            else if (canReceiveMorePayment) {
                label = 'Pay Now';
            }
            else if (hasPaymentHistory) {
                label = 'Cancel Selected Receipt';
            }
            else if (isPaymentLocked && !canReceiveMorePayment) {
                label = 'Save Cancellation';
            }
            $('#btnSaveStock').val(label);
        }
        function ClearReceiptCancellation() {
            $('#hdnSelectedPaymentID').val('0');
            $('#dvSelectedReceiptInfo').hide().html('');
            if (hasPaymentHistory && $('#ddlStatus').val() == '0') {
                $('#ddlStatus').val('1');
            }
            RecalculatePaymentSummary();
            ToggleCancelRemark();
        }
        function PrepareReceiptCancellation(paymentId, receiptNo) {
            $('#hdnSelectedPaymentID').val(paymentId);
            $('#ddlStatus').val('0');
            $('#txtPaidAmount').val('0.00');
            $('#dvSelectedReceiptInfo').html('Selected receipt for cancellation: ' + receiptNo + ' <a href=\"javascript:void(0);\" onclick=\"ClearReceiptCancellation();\" style=\"margin-left:10px; color:#35506b;\">Clear</a>').show();
            if (!$('#txtCancelRemark').val()) {
                $('#txtCancelRemark').val('Receipt cancelled');
            }
            RecalculatePaymentSummary();
            ToggleCancelRemark();
            $('#txtCancelRemark').focus();
        }
        function CancelReceiptFromHistory(evt, stid, paymentId, receiptNo) {
            if (evt) {
                evt.preventDefault();
                evt.stopPropagation();
            }
            var remark = prompt('Enter cancellation remark for receipt ' + receiptNo, 'Receipt cancelled');
            if (remark === null) {
                return;
            }
            remark = $.trim(remark);
            if (remark == '') {
                ShowNotification('Cancel Remark', 'Kindly specify cancellation remark.', 'error');
                return;
            }
            if (!confirm('Cancel receipt ' + receiptNo + '?')) {
                return;
            }
            $('#hdnCancelPaymentID').val(paymentId);
            $('#hdnCancelRemark').val(remark);
            $('#frmCancelReceipt').attr('action', '/Account/CancelStockPaymentReceipt/' + stid);
            $('#frmCancelReceipt').submit();
        }
        function ResetReceiptButtons() {
            $('.receipt-action-btn').removeClass('active');
            $('#btnInvoicePreview').text('Open Invoice');
            $('#btnPaymentPreview').text('Open Payment Receipt');
        }
        function OpenHistoryReceiptPreview(stid, paymentId) {
            ResetReceiptButtons();
            $('#btnPaymentPreview').addClass('active').text('Close Payment Receipt');
            LoadReceiptPreview(stid, 'payment', paymentId);
        }
        function ToggleReceiptPreview(sender, stid, mode, paymentId) {
            var box = $('#dvReceiptPreview');
            if ($(sender).hasClass('active') && box.is(':visible')) {
                box.hide().html('');
                ResetReceiptButtons();
                return;
            }
            ResetReceiptButtons();
            $(sender).addClass('active');
            if (mode == 'invoice') {
                $(sender).text('Close Invoice');
            }
            else {
                $(sender).text('Close Payment Receipt');
            }
            LoadReceiptPreview(stid, mode, paymentId);
        }
        function LoadReceiptPreview(stid, mode, paymentId) {
            var url = mode == 'payment'
                ? "/Account/GetSaleTransactionPaymentReceiptData/" + stid + "?paymentId=" + (paymentId || 0)
                : "/Account/GetSaleTransactionPrintData/" + stid;
            $('#dvReceiptPreview').show().html('Loading...');
            $.ajax({
                type: "POST",
                url: url,
                cache: false,
                processData: false,
                contentType: false,
                success: function (html) {
                    $('#dvReceiptPreview').html('<div><a href="javascript:void(0);" class="receipt-close-link" onclick="CloseReceiptPreview();">Close Preview</a></div>' + html);
                },
                error: function () {
                    $('#dvReceiptPreview').html('Unable to load receipt preview.');
                }
            });
        }
        function CloseReceiptPreview() {
            $('#dvReceiptPreview').hide().html('');
            ResetReceiptButtons();
        }
        function PrintRecipt() {
            var sender = arguments.length > 0 ? arguments[0] : null;
            var receiptBody = sender
                ? $(sender).closest('.receipt-print-root').find('.receipt-print-body').first()
                : $('.receipt-print-body').first();
            if (receiptBody.length == 0) {
                return;
            }
            var receiptHtml = receiptBody.html();
            var nDiv = '<table>';
            nDiv = nDiv + '<tr><td>' + receiptHtml.replace('[CopyPlaceHolder]', 'School Copy') + '</td><td>' + receiptHtml.replace('[CopyPlaceHolder]', 'Office Copy') + '</td></tr>';
            nDiv = nDiv + '</table>';
            var printWindow = window.open('', '_blank', 'width=1100,height=800,scrollbars=yes,resizable=yes');
            if (!printWindow) {
                alert('Please allow popups to print the receipt.');
                return;
            }
            printWindow.document.open();
            printWindow.document.write('<html><head><title>Print Receipt</title>');
            printWindow.document.write('<link href="@Url.Content("~/css/RecieptStyle.css")" rel="stylesheet" type="text/css" />');
            printWindow.document.write('</head><body>');
            printWindow.document.write(nDiv);
            printWindow.document.write('</body></html>');
            printWindow.document.close();
            setTimeout(function () {
                printWindow.focus();
                printWindow.print();
            }, 700);
        }




