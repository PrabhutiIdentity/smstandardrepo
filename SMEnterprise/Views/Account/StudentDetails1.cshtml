﻿﻿@using SMEnterprise.Models;
@{
    ViewBag.Title = "StudentDetails";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    var permissions = (EmployeePermissionsModel)Session["Permissions"];
    var canEditCustomFee = true;
    @*if (permissions.isPermissionsSet > 0)
        {
            var customFeePermission = permissions.Permissions.FirstOrDefault(x => x.Module == 1 && x.Action == 1);
            if (customFeePermission != null && customFeePermission.Status == 1)
            {
                canEditCustomFee = true;
            }
            else
            {
                canEditCustomFee = false;
            }
        }*@
}
@model SMEnterprise.Models.StudentEditModel
@section IncludeCss
{
    <title>P-School | Student Management</title>
    <link rel="stylesheet" href="@Url.Content(" ~ /css/select2.min.css")">
    <link rel="stylesheet" href="@Url.Content(" ~ /css/Admin/blue.css")">
    <style>
        div[aria-role="alertdialog"] {
            z-index: 2 !important;
        }

        .table thead tr th {
            text-align: center !important;
            vertical-align: middle !important;
            background-color: rgb(68, 88, 97);
            color: white;
        }

        #tblCategory table thead tr th a {
            color: #b26c33;
        }

        .thumbImage {
            max-width: 150px;
            max-height: 150px;
        }

        .OptedSubjects:hover {
            color: #535f7a;
            background-color: #e8edf1 !important;
            border: 1px solid #535f7a !important;
            cursor: pointer;
        }
    </style>
}
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_content">

                    <div class="" role="tabpanel" data-example-id="togglable-tabs">
                        <ul id="myTab" class="nav nav-tabs bar_tabs" role="tablist">
                            <li role="presentation" class="@(Model.CurrentTab == 1 || Model.Student.StudentID == 0 ? " active" : "" )">
                                <a href="#tab_Personal" id="Personal-tab" role="tab" data-toggle="tab" aria-expanded="true">Personal</a>
                            </li>
                            @if (Model.Student.StudentID != 0)
                            {
                                <li role="presentation" class="@(Model.CurrentTab == 2 ? " active" : "" )">
                                    <a href="#tab_Parent" role="tab" id="Parent-tab" data-toggle="tab" aria-expanded="false">Parent</a>
                                </li>
                                <li role="presentation" class="@(Model.CurrentTab == 3 ? " active" : "" )">
                                    <a href="#tab_address" role="tab" id="address-tab" data-toggle="tab" aria-expanded="false">Address</a>
                                </li>
                                <li role="presentation" class="@(Model.CurrentTab == 4 ? " active" : "" )">
                                    <a href="#tab_guardian" role="tab" id="guardian -tab" data-toggle="tab" aria-expanded="false">Guardian </a>
                                </li>
                                <li role="presentation" class="@(Model.CurrentTab == 5 ? " active" : "" )">
                                    <a href="#tab_documents" role="tab" id="documents -tab" data-toggle="tab" aria-expanded="false">Documents </a>
                                </li>
                                <li role="presentation" class="@(Model.CurrentTab == 6 ? " active" : "" )">
                                    <a href="#tab_session " role="tab" id="session -tab" data-toggle="tab" aria-expanded="false">Session </a>
                                </li>
                                <li role="presentation" class="@(Model.CurrentTab == 7 ? " active" : "" )">
                                    <a href="#tab_transport" role="tab" id="transport-tab" data-toggle="tab" aria-expanded="false">Transport </a>
                                </li>
                                if (Model.Hostel.Hostels != null)
                                {
                                    <li role="presentation" class="@(Model.CurrentTab == 8 ? " active" : "" )">
                                        <a href="#tab_hostel" role="tab" id="hostel-tab" data-toggle="tab" aria-expanded="false">Hostel  </a>
                                    </li>
                                }
                                if (canEditCustomFee)
                                {
                                    <li role="presentation" class="@(Model.CurrentTab == 9 ? " active" : "" )">
                                        <a href="#tab_Fee" role="tab" id="Fee-tab" data-toggle="tab" aria-expanded="false">Custom Fee  </a>
                                    </li>
                                }
                            }
                        </ul>
                        <div id="myTabContent" class="tab-content">
                            <div role="tabpanel" class="tab-pane fade @(Model.CurrentTab == 1 ? " active in" : "" )" id="tab_Personal" aria-labelledby="home-tab">
                                @using (Html.BeginForm("SaveStudentPersonal", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @class = "form-horizontal form-label-left" }))
                                {
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-group col-md-6">

                                                <label class="control-label col-md-4 col-sm-3 col-xs-12">
                                                </label>
                                                <div class="col-md-8 col-sm-9 col-xs-12">
                                                    <figure class="figure profile-box" style="height: 150px;">
                                                        <img id="imgStudentImage" onerror="return OnImageError(this,@Model.Student.Gender);" src="@Url.Content(" ~/Images/StudentImage/")@(Model.Student.StudentID)_@Model.Student.Photo" class="img-responsive thumbImage">
                                                    </figure>
                                                    <input type="hidden" id="hdnImageName" name="Photo" value="@Model.Student.Photo" />
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtAdmissionUID">
                                                        Admission UID
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="hidden" id="hdnStudentID" name="StudentID" value="@Model.Student.StudentID" />
                                                        <input style="background-color:@(Model.Student.StudentID == 0 ? " antiquewhite" : "aliceblue" );" type="text" id="txtAdmissionUID" class="form-control col-md-7 col-xs-12" disabled="" value="@Model.Student.StudentSID">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtDOB">
                                                        Birth Date <span class="required">*</span> <small>(mm/dd/yyyy)</small>
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" required="" class="form-control has-feedback-left dateinput" id="txtDOB" placeholder="Date Of Birth" aria-describedby="inputSuccess2Status" name="DOB" value="@Model.Student.DOB.ToShortDateString()">
                                                        <span class="fa fa-calendar-o form-control-feedback left" aria-hidden="true"></span>
                                                        <span id="inputSuccess2Status" class="sr-only">(success)</span>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtName">
                                                        Name <span class="required">*</span>
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" id="txtName" value="@Model.Student.Name" name="Name" required="required" class="form-control col-md-7 col-xs-12">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="ddlNationality">
                                                        Nationality
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <select type="text" id="ddlNationality" name="Nationality" required="required" class="form-control col-md-7 col-xs-12">
                                                            <option value="0" @(Model.Student.Nationality == 0 ? "selected" : "" )>NA</option>
                                                            @foreach (var s in Model.Nationalities)
                                                            {
                                                                <option value="@s.ID" @(Model.Student.Nationality == s.ID ? "selected" : "" )>@s.Name</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Gender
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <label class="switch switch-green col-md-6">
                                                            <input type="checkbox" class="switch-input" @(Model.Student.Gender == 0 ? "checked" : "" )>
                                                            <span class="switch-label" onclick="$(this).closest('label').find('#hdnStudentGender').val($(this).closest('label').find('#hdnStudentGender').val() == '0' ? '1' : '0');" data-on="Male" data-off="Female"></span>
                                                            <span class="switch-handle" id="shTranding"></span>
                                                            <input type="hidden" name="Gender" id="hdnStudentGender" value="@Model.Student.Gender">
                                                        </label>
                                                        <div class="col-md-6">
                                                            <input type="file" name="StudentImageUploader" onchange="ImageChanged(this, 'student');" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtDOj">
                                                        Joining Date <span class="required">*</span> <small>(mm/dd/yyyy)</small>
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" required="" class="form-control has-feedback-left dateinput" id="txtDOj" placeholder="Date Of Joining" aria-describedby="inputSuccess2Status" name="DOJ" value="@Model.Student.DOJ.ToShortDateString()">
                                                        <span class="fa fa-calendar-o form-control-feedback left" aria-hidden="true"></span>
                                                        <span id="inputSuccess2Status" class="sr-only">(success)</span>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSSchoolUID">
                                                        School UID
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="SchoolUID" value="@Model.Student.SchoolUID" id="txtSSchoolUID" placeholder="School's Unique ID/ Sr. No." aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>

                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSEmailID">
                                                        Aadhaar <span class="required">*</span>
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="AadharCardNo" value="@Model.Student.AadharCardNo" id="txtSEmailID" placeholder="Aadhaar Card Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="ddlReligion">
                                                        SMS Notification
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <select id="ddlReligion" name="NotificationSMSTo" class="form-control col-md-7 col-xs-12">
                                                            <option value="0" @(Model.Student.NotificationSMSTo == 0 ? "selected" : "" )>On Father's Mobile</option>
                                                            <option value="1" @(Model.Student.NotificationSMSTo == 1 ? "selected" : "" )>On Mother's Mobile</option>
                                                            <option value="2" @(Model.Student.NotificationSMSTo == 2 ? "selected" : "" )>On Guardian</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="ddlReligion">
                                                        Religion
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <select type="text" id="ddlReligion" name="ReligionID" class="form-control col-md-7 col-xs-12">
                                                            <option value="0" @(Model.Student.ReligionID == 0 ? "selected" : "" )>NA</option>
                                                            @foreach (var s in Model.Religions)
                                                            {
                                                                <option value="@s.ID" @(Model.Student.ReligionID == s.ID ? "selected" : "" )>@s.Name</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="ddlSDisability">
                                                        Disability
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <select id="ddlSDisability" name="Disability" required="required" class="form-control col-md-7 col-xs-12">
                                                            <option value="1" @(Model.Student.Disability == 1 ? "selected" : "" )>None</option>
                                                            <option value="2" @(Model.Student.Disability == 2 ? "selected" : "" )>Handicap</option>
                                                            <option value="3" @(Model.Student.Disability == 3 ? "selected" : "" )>Other</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="ddlSCategory">
                                                        Category
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <select id="ddlSCategory" name="Category" required="required" class="form-control col-md-7 col-xs-12">
                                                            <option value="0" @(Model.Student.Category == 0 ? "selected" : "" )>NA</option>
                                                            @foreach (var s in Model.SocialCategories)
                                                            {
                                                                <option value="@s.ID" @(Model.Student.Category == s.ID ? "selected" : "" )>@s.Name</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="ddlSMotherTongue">
                                                        Mother Tongue
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <select id="ddlSMotherTongue" name="MotherTongueID" required="required" class="form-control col-md-7 col-xs-12">
                                                            <option value="0" @(Model.Student.MotherTongueID == 0 ? "selected" : "" )>NA</option>
                                                            @foreach (var s in Model.MotherTongues)
                                                            {
                                                                <option value="@s.ID" @(Model.Student.MotherTongueID == s.ID ? "selected" : "" )>@s.Name</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="ddlSBloodGroup">
                                                        Blood Group
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <select id="ddlSBloodGroup" name="BloodGroup" required="required" class="form-control col-md-7 col-xs-12">
                                                            <option @(Model.Student.BloodGroup == "NA" ? "selected" : "" )>NA</option>
                                                            <option @(Model.Student.BloodGroup == "A+" ? "selected" : "" )>A+</option>
                                                            <option @(Model.Student.BloodGroup == "A-" ? "selected" : "" )>A-</option>
                                                            <option @(Model.Student.BloodGroup == "B+" ? "selected" : "" )>B+</option>
                                                            <option @(Model.Student.BloodGroup == "B-" ? "selected" : "" )>B-</option>
                                                            <option @(Model.Student.BloodGroup == "O-" ? "selected" : "" )>O-</option>
                                                            <option @(Model.Student.BloodGroup == "O+" ? "selected" : "" )>O+</option>
                                                            <option @(Model.Student.BloodGroup == "AB+" ? "selected" : "" )>AB-</option>
                                                            <option @(Model.Student.BloodGroup == "AB+" ? "selected" : "" )>AB+</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSPassportNo">
                                                        Passport No.
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="PassportNo" value="@Model.Student.PassportNo" id="txtSPassportNo" placeholder="Passport Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtAccessCard">
                                                        Access Card <span class="required">*</span>
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="AccessCardNo" value="@Model.Student.AccessCardNo" id="txtAccessCard" placeholder="Access Card Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSAllergicMedicine">
                                                        Allergic Med.
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <textarea rows="2" style="resize:none;" name="Allergic_Medicine" type="text" class="form-control" id="txtSAllergicMedicine" placeholder="Allergic Medicine" aria-describedby="inputSuccess2Status">@Model.Student.Allergic_Medicine</textarea>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSExtraCurricular">
                                                        Extra Curricular.
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <textarea rows="2" style="resize:none;" name="ExtraCurricular" type="text" class="form-control" id="txtSExtraCurricular" placeholder="Extra Curricular" aria-describedby="inputSuccess2Status">@Model.Student.ExtraCurricular</textarea>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-12">
                                                    Previous School Details
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSchoolName">
                                                        School Name
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="PSchoolName" value="@Model.Student.PSchoolName" id="txtSchoolName" placeholder="School Name" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSMedium">
                                                        School Medium
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="PSchoolMedium" value="@Model.Student.PSchoolMedium" id="txtSMedium" placeholder="School Medium" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSClassName">
                                                        Class Attend
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="PClassName" value="@Model.Student.PClassName" id="txtSClassName" placeholder="Class Attend" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSResult">
                                                        Result
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="PSResult" value="@Model.Student.PSResult" id="txtSResult" placeholder="School Result" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSchoolCity">
                                                        School City
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="PSchoolCity" value="@Model.Student.PSchoolCity" id="txtSchoolCity" placeholder="School City" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSchoolState">
                                                        School State
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="PSchoolState" value="@Model.Student.PSchoolState" id="txtSchoolState" placeholder="School State" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-12">
                                                    Student Bank Details for Scholarship
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSSSSID">
                                                        SSSID Number
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="SSSID" value="@Model.Student.SSSID" id="txtSSSID" placeholder="SSSID Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSFamilyID">
                                                        Family ID
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="FamilyID" value="@Model.Student.FamilyID" id="txtFamilyID" placeholder="Family ID" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSBankName">
                                                        BankName
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="BankName" value="@Model.Student.BankName" id="txtBankName" placeholder="Bank Name" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSAccountNumber">
                                                        Account Number
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="AccountNumber" value="@Model.Student.AccountNumber" id="txtAccountNumber" placeholder="Account Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSIFSCCode">
                                                        IFSC Code
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="IFSCCode" value="@Model.Student.IFSCCode" id="txtIFSCCode" placeholder="IFSC Code" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtSBranchName">
                                                        Branch Name
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="BranchName" value="@Model.Student.BranchName" id="txtBranch Name" placeholder="Branch Name" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-12">
                                                    <button type="submit" onclick="return CheckStudentDetails();" class="btn btn-success pull-right">Save</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
