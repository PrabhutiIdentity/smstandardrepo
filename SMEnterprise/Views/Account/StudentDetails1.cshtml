 function SaveLocation(sender) {
     var Type = $(sender).closest('#frmAddLocation').find('#hdnSenderType').val();
     var Value = $(sender).closest('#frmAddLocation').find('#txtLocationName').val();
     var MasterID = 0;
     var ctrID = '';
     if (Type == 1) {
         ctrID = '#ddlCadd_CountryCode';

     } else if (Type == 2) {
         ctrID = '#ddlCadd_StateCode';
         MasterID = $('#ddlCadd_CountryCode').val();
     } else if (Type == 3) {
         ctrID = '#ddlCadd_DistrictCode';
         MasterID = $('#ddlCadd_StateCode').val();

     } else if (Type == 4) {
         ctrID = '#ddlCadd_AreaCode';
         MasterID = $('#ddlCadd_DistrictCode').val();

     }
     $.ajax({
         type: "POST",
         url: "/Account/AddLocation/" + MasterID + "/" + Type + "/" + Value,
         cache: false,
         processData: false,
         contentType: false,
         success: function(html) {

             $(ctrID).html(html);
             $(ctrID).append('<option value="-1">Add New</option>');
             $(ctrID).select2('val', '0');

             AddLocation.remove();
         },
         error: function(e) {
             alert("errorn");
         }
     });

 }
