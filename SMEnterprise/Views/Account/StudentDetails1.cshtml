@section scripts
{


    <script src="@Url.Content("~/js/moment.min.js")"></script>
    <script src="@Url.Content("~/js/daterangepicker.js")"></script>
    <!-- Select2 -->
    <script src="@Url.Content("~/js/select2.full.min.js")"></script>
    <script>

    function DeleteTransportChange(sender) {
     if (confirm("Do you Really want to remove this entry, this might result in Fee Mismatch....")) {
         $(sender).closest('form').submit();
     }
 }

 function OpenTransportEdit(StudentID, THChangeID) {

     $('#mdlEditTransport').modal('toggle');
     $('#mdlEditTransport').find('.modal-body').find(".loader-container").css('display', '');
     $('#mdlEditTransport').find('.modal-body').find(".container").html('');
     $('.se-pre-con').css('display', '');
     $.ajax({
         type: "POST",
         url: "/Account/EditTransportDetails/" + StudentID + "/" + THChangeID,
         cache: false,
         processData: false,
         contentType: false,
         success: function (html) {
             $('#mdlEditTransport').find('.modal-body').find(".loader-container").css('display', 'none');
             $('#mdlEditTransport').find('.modal-body').find(".container").html(html);
             //$('#mdlEditTransport').modal('toggle');
             $('.se-pre-con').css('display', 'none');
         },
         error: function(e) {
             alert("errorn");
         }
     });
 }

 function OptionalSubjectClicked(sender) {
     if ($(sender).hasClass('bg-green')) {
         $(sender).removeClass('bg-green');
         $(sender).attr('title', 'This subject is not opted');
         $(sender).addClass('bg-red');
         $(sender).find('#hdnOpType').val(0);
     } else {
         $(sender).attr('title', 'Student Opted for this subject');
         $(sender).addClass('bg-green');
         $(sender).removeClass('bg-red');
         $(sender).find('#hdnOpType').val(1);
     }
 }

 function StudentCustomFeeSessionChanged(sender) {

     $('.se-pre-con').css('display', '');
     $.ajax({
         type: "POST",
         url: "/Account/StudentSessionCustomFeeDetails/" + $(sender).val(),
         cache: false,
         processData: false,
         contentType: false,
         success: function(html) {
             $('#frmStudentCustomFees').html(html);
             $('.se-pre-con').css('display', 'none');
         },
         error: function(e) {
             alert("errorn");
         }
     });
 }

 function SessionSectionChanged(sender) {
     $(sender).closest('.x_content').find('#divOptionalSubjects').html('<label class="badge bg-green OptedSubjects">Loading Optional Subjects....</label>')
     $.ajax({
         type: "POST",
         url: "/Account/GetSectionOptionalSubjects/" + $(sender).val(),
         cache: false,
         processData: false,
         contentType: false,
         success: function(data) {
             var OSubject = '';
             for (var i = 0; i < data.length; i++) {
                 OSubject = OSubject + '<label class="badge bg-red OptedSubjects" onclick="OptionalSubjectClicked(this);" title="This subject is not opted">' +
                     '<input type="hidden" id="hdnSSOSID" name="SubjectsOpted[' + i + '].Extra1" value="0">' +
                     '<input type="hidden" id="hdnOpSubjectID" name="SubjectsOpted[' + i + '].ID" value="' + data[i].ID + '">' +
                     ' <input type="hidden" id="hdnStudentSessionID" name="SubjectsOpted[' + i + '].Name" value="0">' +
                     '<input type="hidden" id="hdnOpType" name="SubjectsOpted[' + i + '].Extra2" value="0">' +
                     data[i].Name +
                     '</label>';
             }
             $(sender).closest('.x_content').find('#divOptionalSubjects').html(OSubject);
         },
         error: function(e) {
             alert("errorn");
         }
     });
 }

 function CustomFeeStatusChanged(sender) {
     var curStatus = $(sender).closest('label').find('#hdnCustomFeeApplicable').val();
