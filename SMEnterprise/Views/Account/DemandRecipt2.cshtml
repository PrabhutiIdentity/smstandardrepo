
@{
    ViewBag.Title = "DemandRecipt";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@section IncludeCss
{
    <title>Demand Recipt</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/DemandRecipt.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/style.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/main.css")" rel="stylesheet" />
}
@model SMEnterprise.Models.DemandReciptListModel
<div class="" style="background-color: white;">
    <div class="row">
        <div class="col-md-12">
            @using (Html.BeginForm("DemandRecipt2", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
            {
                <div class="row std-mng-head col-md-12">

                    <div class="col-md-12 class-section">
                        <div class="row">

                            <div class="col-md-2 padding">
                                @*<label class="col-md-5 text-right padding-R" style="padding-left: 150px;">Month  </label>*@
                                <label class="text-right" style="padding-left: 25px;">@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("MMM, yyyy")</label>
                            </div>
                            <div class="col-md-3 padding">
                                @*<input type="month" value="@Model.DemandMonth.ToString("yyyy-MM")" name="DemandMonth" id="dtDate" class="form-control" />*@
                            </div>
                            <div class="col-md-3 padding">
                                <label class="col-md-4 text-right" style="padding-right: 0px;">Class :</label>
                                <div class="col-md-8">
                                    <select class="form-control" name="ClassID" id="ddlClass" onchange="javascript:ClassChanged(this);">
                                        <option value="0">--Select Class--</option>
                                        @foreach (SMEnterprise.Models.NameIDModel el in Model.Classes)
                                        {
                                            <option value="@el.ID" @(el.ID == Model.ClassID ? "selected" : "")>@el.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 padding">
                                <label class="col-md-4 text-right">Section :</label>
                                <div class="col-md-8">
                                    <select name="SectionID" class="form-control" id="ddlSection">
                                        <option value="0">--Select Section--</option>
                                        @foreach (SMEnterprise.Models.NameIDModel el in Model.Sections)
                                        {
                                            <option value="@el.ID" @(el.ID == Model.SectionID ? "selected" : "")>@el.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-1 padding">
                                <div class="row">

                                    <div class="col-md-12">
                                        <a href="javascript:void(0);" onclick="$('#frmGetStudents').submit();"><i class="fa fa-search"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="row">
        <div class="col-md-2"></div>
        <div class="col-md-10" style="text-align:right;">
            <button type="button" class="btn btn-primary" onclick="PrintDemantRecipt();"><i class="fa fa-print"></i> Print</button>
        </div>
    </div>
    <div id="divList">
        <div class="text-cen">
    <div class="container" style="display: inline-block;">
       
            <div class="wrapper">
                @foreach (SMEnterprise.Models.DemandReciptModel d in Model.Recipts)
                {
                    <div class="col-md-6">




                        <div class="headert">
                            <h2>@Model.Branch.BranchName</h2>
                            <h5 style="text-align: center;">@Model.Branch.Address</h5>
                        </div>
                        <div class="sleek-bor"></div>
                        <fieldset>
                            <div class="patient-detail sleek-borone">
                                <div class="col-parent">
                                    <div class="col-child"><strong>REC. NO.</strong></div>
                                    <div class="col-child">DATE: <span style="margin:0 0 0 10px;"><strong>19-11-2018</strong></span></div>
                                </div>
                            </div>
                        </fieldset>
                        <fieldset>
                            <div class="patient-detail" style="line-height: 20px; text-align: justify;">
                                <div class="col-one">Regn. No.</div>
                                <div class="col-two"><strong>@d.StudentSID</strong></div>
                                <div class="col-one">Student:</div>
                                <div class="col-two"><strong>@d.Name</strong></div>
                                <div class="col-one">Father:</div>
                                <div class="col-two"><strong>@d.FatherName</strong></div>
                                <div class="col-one">Class:</div>
                                <div class="col-two"><strong>@d.ClassName</strong></div>
                                <div class="col-one">Fee For Months(s)</div>
                                <div class="col-two"><strong>Aug, Sep,</strong></div>
                            </div>
                        </fieldset>
                        <div class="particular-section">
                            <div class="head-part">
                                <p class="sr"><strong>S.NO.</strong></p>
                                <p class="product"><strong>Particulars</strong></p>
                                <p class="amount text-rt"><strong>Amount</strong></p>
                            </div>

                            <div class="particular-list particular-list01" style="border-bottom: 0; padding:10px 0 0 0;">
                                <p class="sr"><strong>1</strong></p>
                                <p class="product text-cen">Tution Fees</p>
                                <p class="amount text-rt"><strong>1150</strong></p>
                            </div>
                            <div class="particular-list particular-list01" style="border-bottom: 0;">
                                <p class="sr"><strong>2</strong></p>
                                <p class="product text-cen">Computer Fees</p>
                                <p class="amount text-rt"><strong>190</strong></p>
                            </div>
                            <div class="particular-list">
                                <p class="sr"><strong>3</strong></p>
                                <p class="product text-cen">Exam Fund</p>
                                <p class="amount text-rt"><strong>240</strong></p>
                            </div>
                            <div class="particular-list">
                                <p class="sr">4</p>
                                <p class="product text-cen">Transport Fees</p>
                                <p class="amount text-rt">480</p>
                            </div>
                            <div class="particular-list">
                                <p class="sr">&nbsp;</p>
                                <p class="product">&nbsp;</p>
                                <p class="amount text-rt">&nbsp;</p>
                            </div>

                            <div class="particular-list bore-top" style="padding:10px 0 0 0;">
                                <p class="product totalpro">TOTAL AMOUNT</p>
                                <p class="amount text-rt" style="width:50%;"><strong>@(d.ApplicableFee + d.LateFee) (@d.MonthName)</strong></p>
                            </div>
                            <div class="particular-list">
                                <p class="product text-lt">(+) Late Fees</p>
                                <p class="amount text-rt" style="width:50%;"><strong>@(d.LateFee)</strong></p>
                            </div>
                            <div class="particular-list" style="padding:0 0 10px 0;">
                                <p class="product amount-wrtext text-lt">(-) Concession Fees</p>
                                <p class="amount text-rt amount-wrtext" style="width:50%;"><strong>@d.DiscAmt</strong></p>
                            </div>
                            <div class="particular-list bore-top" style="padding:10px 0 0 0;">
                                <p class="product totalpro">GRAND TOTAL</p>
                                <p class="amount text-rt" style="width: 50%;"><strong>@(d.PreviousDues + d.ApplicableFee + d.LateFee)</strong></p>
                            </div>
                            <div class="particular-list">
                                <p class="product text-lt"><strong>Received Amt</strong></p>
                                <p class="amount text-rt" style="width: 50%;"><strong>@d.PaymentAmount</strong></p>
                            </div>
                            <div class="particular-list" style="padding:0 0 10px 0;">
                                <p class="product text-lt"><strong>Balance</strong></p>
                                <p class="amount text-rt" style="width: 50%;"><strong>@(d.PreviousDues + d.ApplicableFee + d.LateFee - d.PaymentAmount )</strong></p>
                            </div>
                            @*<div class="particular-list bore-top">
                        <p class="product totalpro-one">Amount In Words: <span>Rupees Two Thousand Sixty Only</span></p>

                    </div>*@
                        </div>
                    </div>


                }
            </div>
            </div>
    </div>
        </div>
</div>
@section scripts
{
    <script>
        function ClassChanged(sender) {
            $('#ddlSection').html('<option value="0">Loading....</option>');
            $.ajax(
    {
        type: "POST",
        url: "/Admin/GetSectionOnClass/" + $(sender).val(),
        cache: false,
        processData: false,
        contentType: false,
        success: function (html) {
            $('#ddlSection').html('');
            $('#ddlSection').html('<option value="0">--Select Section--</option>');
            $('#ddlSection').append(html);
        },
        error: function (e) {
            alert("errorn");
        }
    });
        }
        function PrintDemantRecipt() {
            var contents = $("#divList").html();
            var frame1 = $('<iframe />');
            frame1[0].name = "frame1";
            frame1.css({ "position": "absolute", "top": "-1000000px" });
            $("body").append(frame1);
            var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
            frameDoc.document.open();
            //Create a new HTML document.
            frameDoc.document.write('<html><head><title></title>');
            frameDoc.document.write('</head><body>');
            frameDoc.document.write('<link href="@Url.Content("~/css/style.min.css")" rel="stylesheet" type="text/css" />');
            frameDoc.document.write('<link href="@Url.Content("~/css/DemandRecipt.min.css")" rel="stylesheet" type="text/css" />');

            //Append the external CSS file.
            //Append the DIV contents.
            frameDoc.document.write(contents);
            frameDoc.document.write('</body></html>');
            frameDoc.document.close();
            setTimeout(function () {
                window.frames["frame1"].focus();
                window.frames["frame1"].print();
                frame1.remove();
            }, 1000);
        }
    </script>
}
