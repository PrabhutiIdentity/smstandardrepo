                                                            <th style="width:10%">#</th>
                                                            <th style="width:30%">Break-up</th>
                                                            <th style="width:10%">Type</th>
                                                            <th style="width:25%">Structural Amount </th>
                                                            <th style="width:25%">Offered Amount</th>

                                                        </tr>
                                                    </thead>
                                                    <tbody id="tbdSalary">
                                                        @{
                                                            var ctr = 0;
                                                            decimal TotalSalaryStructure = 0;
                                                            decimal TotalOffered = 0;
                                                            foreach (var salary in Model.Salary)
                                                            {
                                                                TotalSalaryStructure = TotalSalaryStructure + salary.SalaryStructure * (salary.IsDeduction == 1 ? -1 : 1);
                                                                TotalOffered = TotalOffered + salary.Amount * (salary.IsDeduction == 1 ? -1 : 1);
                                                                <tr>
                                                                    <td>
                                                                        @(ctr + 1)
                                                                        <input type="hidden" ID="hdnIsDeduction" value="@salary.IsDeduction" />
                                                                        <input type="hidden" name="Salary[@ctr].EmployeeSalaryID" value="@salary.EmployeeSalaryID" />
                                                                        <input type="hidden" name="Salary[@ctr].EmployeeTypeID" value="@salary.EmployeeTypeID" />
                                                                        <input type="hidden" name="Salary[@ctr].SalaryTypeID" value="@salary.SalaryTypeID" />
                                                                        <input type="hidden" name="Salary[@ctr].EmployeeID" value="@Model.EmployeeDetails.EmployeeID" />
                                                                    </td>
                                                                    <td>
                                                                        @salary.SalaryTypeName
                                                                    </td>
                                                                    <td>@(salary.IsDeduction == 0 ? "Earning" : "Deduction")</td>
                                                                    <td>
                                                                        @salary.SalaryStructure.ToString("N2")
                                                                    </td>
                                                                    <td>
                                                                        <input type="number" step=".01" name="Salary[@ctr].Amount" value="@(String.Format("{0:0}", salary.Amount))" class="form-control SalaryDetail" />
                                                                    </td>
                                                                </tr>
                                                                ctr++;
                                                            }
                                                            <tr style="background-color: rgba(115, 135, 156, 0.44);color:white">
                                                                <td colspan="3">
                                                                    Total
                                                                </td>
                                                                <td>
                                                                    @TotalSalaryStructure.ToString("N2")
                                                                </td>
                                                                <td>
                                                                    <input readonly type="number" step=".01" name="Amount" value="@(String.Format("{0:0}", TotalOffered))" class="form-control TotalSalary" />
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                    </tfoot>
                                                </table>
                                                <div class="form-group col-md-12">
                                                    <button type="submit" class="btn btn-success pull-right">Save</button>
                                                </div>
                                            </div>
                                        </div>
                                    }
