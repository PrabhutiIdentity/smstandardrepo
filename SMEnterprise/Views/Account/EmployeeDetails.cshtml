        function TransportRouteChanged(sender) {
            $('#ddlTStops').html('<option value="-1">Loading....</option>');
            $('#ddlTVehicles').html('<option value="-1">Loading....</option>');
            $.ajax(
                {
                    type: "POST",
                    url: "/Account/GetRouteVehicles/" + $(sender).val(),
                    cache: false,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        $('#divFilledStatus').html('Filled Seats :0  Capacity : 0');
                        $('#ddlTVehicles').html('');
                        $('#ddlTVehicles').append('<option capacity="0" filled="0" value="0" selected="">--Select--</option>');
                        for (var i = 0; i < data.length; i++) {

                            $('#ddlTVehicles').append('<option capacity="' + data[i].Extra2 + '" filled="' + data[i].Extra1 + '" value="' + data[i].ID + '">' + data[i].Name + ' </option>');
                        }
                    },
                    error: function (e) {
                        alert("errorn");
                    }
                });
        }
        function TransportRouteVehicleChanged(sender) {
            $('#divFilledStatus').html('Filled Seats :' + $("#ddlTVehicles option:selected").attr('filled') + ' Capacity : ' + $("#ddlTVehicles option:selected").attr('capacity') + '');

            $('#ddlTStops').html('<option value="-1">Loading....</option>');
            $.ajax(
                {
                    type: "POST",
                    url: "/Account/GetVehicleRouteStoppages/" + $(sender).val() + "/" + $('#hdnTransportStopID').val(),
                    cache: false,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        $('#ddlTStops').html('');
                        var stops = data.Stops;
                        for (var i = 0; i < stops.length; i++) {
                            $('#ddlTStops').append('<option value="' + stops[i].StopID + '" ' + (stops[i].StopID == data.StopDetails.StopID ? 'selected' : '') + ' >' + stops[i].AreaName + ' (' + stops[i].Time + ') Rs.' + stops[i].Rate + '</option>');
                        }
                    },
                    error: function (e) {
                        alert("errorn");
                    }
                });
        }
