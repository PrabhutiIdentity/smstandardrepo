        function ImageChanged(fileBox, Type) {
            if (fileBox.files && fileBox.files[0]) {
                MainImageName = fileBox.files[0].name;
                if (fileBox.files[0].size / 1024 < 5000) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        if (Type == 'Employee') {
                            $('#imgEmployeeImage').attr('src', e.target.result);
                        }
                        if (Type == 'birth') {
                            $('#imgBirthCertificate').attr('src', e.target.result);
                            $(fileBox).closest('.col-md-10').find('.bootstrap-filestyle').find('input').val(fileBox.files[0].name);
                        }
                        if (Type == 'address') {
                            $('#imgAddressProof').attr('src', e.target.result);
                            $(fileBox).closest('.col-md-10').find('.bootstrap-filestyle').find('input').val(fileBox.files[0].name);
                        }
                        if (Type == 'Medical') {
                            $('#imgMedicleCertificate').attr('src', e.target.result);
                            $(fileBox).closest('.col-md-10').find('.bootstrap-filestyle').find('input').val(fileBox.files[0].name);
                        }
                        if (Type == 'category') {
                            $('#imgCategoryCertificate').attr('src', e.target.result);
                            $(fileBox).closest('.col-md-10').find('.bootstrap-filestyle').find('input').val(fileBox.files[0].name);
                        }
                        if (Type == 'experience') {
                            $('#imgExperienceCertificate').attr('src', e.target.result);
                            $(fileBox).closest('.col-md-10').find('.bootstrap-filestyle').find('input').val(fileBox.files[0].name);
                        }
                        if (Type == 'relieving') {
                            $('#imgRelievingCertificate').attr('src', e.target.result);
                            $(fileBox).closest('.col-md-10').find('.bootstrap-filestyle').find('input').val(fileBox.files[0].name);
                        }
                        if (Type == 'PF') {
                            $('#imgPFDeclaration').attr('src', e.target.result);
                            $(fileBox).closest('.col-md-10').find('.bootstrap-filestyle').find('input').val(fileBox.files[0].name);
                        }
                        if (Type == 'appointment') {
                            $('#imgAppointmentLetter').attr('src', e.target.result);
                            $(fileBox).closest('.col-md-10').find('.bootstrap-filestyle').find('input').val(fileBox.files[0].name);
                        } if (Type == 'PAN') {
                            $('#imgPANCardCopy').attr('src', e.target.result);
                            $(fileBox).closest('.col-md-10').find('.bootstrap-filestyle').find('input').val(fileBox.files[0].name);
                        }
                        if (Type == 'bankproof') {
                            $('#imgBankAccountProof').attr('src', e.target.result);
                            $(fileBox).closest('.col-md-10').find('.bootstrap-filestyle').find('input').val(fileBox.files[0].name);
                        }
                    }
                    reader.readAsDataURL(fileBox.files[0]);
                }
                else {
                    ShowNotification('Large Image', 'Kindly Upload Image of Size less the 5MB', 'error');
                    clearFileInput(fileBox);
                }
            }
        }
        function clearFileInput(ctrl) {
            try {
                ctrl.value = null;
            } catch (ex) { }
            if (ctrl.value) {
                ctrl.parentNode.replaceChild(ctrl.cloneNode(true), ctrl);
            }
        }
        function AddLocationCancel() {
            AddLocation.remove();
