@{
    /**/

    ViewBag.Title = "EmployeeDetails";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model SMEnterprise.Models.EmployeeEditModel
@section IncludeCss
{
    <title>P-School | Employee Management</title>
    <link rel="stylesheet" href="@Url.Content("~/css/select2.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/css/Admin/blue.css")">
    <style>
        div[aria-role="alertdialog"] {
            z-index: 1 !important;
        }

        .table thead tr th {
            text-align: center !important;
            vertical-align: middle !important;
            background-color: rgb(68, 88, 97);
            color: white;
        }

        #tblCategory table thead tr th a {
            color: #b26c33;
        }

        #frmGetStudents .form-group input {
            z-index: 0;
        }

        #tblSalary > tbody > tr > td {
            vertical-align: middle;
        }
    </style>
}
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_content">

                    <div class="" role="tabpanel" data-example-id="togglable-tabs">
                        <ul id="myTab" class="nav nav-tabs bar_tabs" role="tablist">
                            <li role="presentation" class="@(Model.CurrentTab == 1 || Model.EmployeeDetails.EmployeeID == 0 ? " active" : "")">
                                <a href="#tab_Personal" id="Personal-tab" role="tab" data-toggle="tab" aria-expanded="true">Personal</a>
                            </li>
                            @if (Model.EmployeeDetails.EmployeeID != 0)
                            {
                                <li role="presentation" class="@(Model.CurrentTab == 2 ? " active" : "")">
                                    <a href="#tab_Account" role="tab" id="Account-tab" data-toggle="tab" aria-expanded="false">Account</a>
                                </li>
                                <li role="presentation" class="@(Model.CurrentTab == 3 ? " active" : "")">
                                    <a href="#tab_Address" role="tab" id="address-tab" data-toggle="tab" aria-expanded="false">Address</a>
                                </li>
                                <li role="presentation" class="@(Model.CurrentTab == 4 ? " active" : "")">
                                    <a href="#tab_salary" role="tab" id="salary-tab" data-toggle="tab" aria-expanded="false">Salary </a>
                                </li>
                                <li role="presentation" class="@(Model.CurrentTab == 5 ? " active" : "")">
                                    <a href="#tab_education" role="tab" id="education-tab" data-toggle="tab" aria-expanded="false">Education </a>
                                </li>
                                <li role="presentation" class="@(Model.CurrentTab == 6 ? " active" : "")">
                                    <a href="#tab_experience " role="tab" id="experience-tab" data-toggle="tab" aria-expanded="false">Experience </a>
                                </li>
                                <li role="presentation" class="@(Model.CurrentTab == 7 ? " active" : "")">
                                    <a href="#tab_documents" role="tab" id="document-tab" data-toggle="tab" aria-expanded="false">Documents </a>
                                </li>
                                <li role="presentation" class="@(Model.CurrentTab == 8 ? " active" : "")">
                                    <a href="#tab_Transport" role="tab" id="Transport-tab" data-toggle="tab" aria-expanded="false">Transport  </a>
                                </li>
                                <li role="presentation" class="@(Model.CurrentTab == 9 ? " active" : "")">
                                    <a href="#tab_leaves" role="tab" id="leaves-tab" data-toggle="tab" aria-expanded="false">Leaves  </a>
                                </li>
                                if (Model.EmployeeDetails.EmployeeType == 3 || Model.EmployeeDetails.EmployeeType == 8)
                                {
                                    <li role="presentation" class="@(Model.CurrentTab == 10 ? " active" : "")">
                                        <a href="#tab_subjects" role="tab" id="subjects-tab" data-toggle="tab" aria-expanded="false">Subjects  </a>
                                    </li>
                                }
                                <li role="presentation" class="@(Model.CurrentTab == 11 ? " active" : "")">
                                    <a href="#tab_Left" role="tab" id="Left-tab" data-toggle="tab" aria-expanded="false">Left  </a>
                                </li>
                            }
                        </ul>
                        <div id="myTabContent" class="tab-content">
                            <div role="tabpanel" class="tab-pane fade @(Model.CurrentTab == 1 || Model.EmployeeDetails.EmployeeID==0 ? " active in" : "")" id="tab_Personal" aria-labelledby="home-tab">
                                @using (Html.BeginForm("SaveEmployeePersonal", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @class = "form-horizontal form-label-left" }))
                                {
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-group col-md-6">
                                                <label class="control-label col-md-4 col-sm-3 col-xs-12">
                                                </label>
                                                <div class="col-md-8 col-sm-9 col-xs-12">
                                                    <figure class="figure profile-box" style="height: 150px;">
                                                        <img id="imgEmployeeImage" onerror="return OnImageError(this, @Model.EmployeeDetails.Gender);" src="@Url.Content("~/Images/EmployeeImage/")@(Model.EmployeeDetails.EmployeeID)_@Model.EmployeeDetails.Photo" class="img-responsive thumbImage">
                                                    </figure>
                                                    <input type="hidden" id="hdnImageName" name="Photo" value="@Model.EmployeeDetails.Photo" />
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtAdmissionUID">
                                                        Employee ID
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="hidden" id="hdnEmployeeID" name="EmployeeID" value="@Model.EmployeeDetails.EmployeeID" />
                                                        <input style="background-color:@(Model.EmployeeDetails.EmployeeID == 0 ? " antiquewhite" : "aliceblue");" type="text" id="txtAdmissionUID" class="form-control col-md-7 col-xs-12" disabled="" value="@Model.EmployeeDetails.EmployeeSID">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Birth Date <span class="required">*</span> <small>(mm/dd/yyyy)</small>
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" required="" class="form-control has-feedback-left dateinput" id="txtDOB" placeholder="Date Of Birth" aria-describedby="inputSuccess2Status" name="DOB" value="@Model.EmployeeDetails.DOB.ToShortDateString()">
                                                        <span class="fa fa-calendar-o form-control-feedback left" aria-hidden="true"></span>
                                                        <span id="inputSuccess2Status" class="sr-only">(success)</span>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtName">
                                                        Name <span class="required">*</span>
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" id="txtName" value="@Model.EmployeeDetails.EmployeeName" name="EmployeeName" required="required" class="form-control col-md-7 col-xs-12">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="ddlNationality">
                                                        Nationality
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <select type="text" id="ddlNationality" name="Nationality" required="required" class="form-control col-md-7 col-xs-12">
                                                            @*<option value="0" @(Model.EmployeeDetails.Nationality == 0 ? "selected" : "")>Please select ategory</option>*@
                                                            @foreach (var s in Model.Nationalities)
                                                            {
                                                                <option value="@s.ID" @(Model.EmployeeDetails.Nationality == s.ID ? "selected" : "")>@s.Name</option>
                                                            }
                                                        </select>
                                                        @*<select type="text" id="ddlNationality" name="Nationality" required="required" class="form-control col-md-7 col-xs-12">
                                                            <option value="1" @(Model.EmployeeDetails.Nationality == 1 ? "selected" : "" )>Indian</option>
                                                               <option value="2" @(Model.EmployeeDetails.Nationality == 2 ? "selected" : "" )>Other</option>
                                                                </select>*@
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtName">
                                                        Gender
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <label class="switch switch-green col-md-6">
                                                            <input type="checkbox" class="switch-input" @(Model.EmployeeDetails.Gender == 0 ? "checked" : "" )>
                                                            <span class="switch-label" onclick="$(this).closest('label').find('#hdnEmployeeGender').val($(this).closest('label').find('#hdnEmployeeGender').val() == '0' ? '1' : '0');" data-on="Male" data-off="Female"></span>
                                                            <span class="switch-handle" id="shTranding"></span>
                                                            <input type="hidden" name="Gender" id="hdnEmployeeGender" value="@Model.EmployeeDetails.Gender">
                                                        </label>
                                                        <div class="col-md-6">
                                                            <input type="file" name="EmployeeImageUploader" onchange="ImageChanged(this, 'Employee');" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="txtDOj">
                                                        Joining Date <span class="required">*</span> <small>(mm/dd/yyyy)</small>
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" required="" class="form-control has-feedback-left dateinput" id="txtDOj" placeholder="Date Of Joining" aria-describedby="inputSuccess2Status" name="DOJ" value="@Model.EmployeeDetails.DOJ.ToShortDateString()">
                                                        <span class="fa fa-calendar-o form-control-feedback left" aria-hidden="true"></span>
                                                        <span id="inputSuccess2Status" class="sr-only">(success)</span>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6" style="margin-bottom: 0px;">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Status
                                                    </label>
                                                    <div class="form-group col-md-4">
                                                        <div class="col-md-9 col-sm-9 col-xs-12" id="Estatus">
                                                            <label class="switch switch-green col-md-6">
                                                                <input type="checkbox" class="switch-input" @(Model.EmployeeDetails.Status == 1 ? "checked" : "" )>
                                                                <span class="switch-label" onclick="$(this).closest('label').find('#hdnEmployeeStatus').val($(this).closest('label').find('#hdnEmployeeStatus').val() == '0' ? '1' : '0');" data-on="Active" data-off="Inactive"></span>
                                                                <span class="switch-handle" id="shTranding"></span>
                                                                <input type="hidden" name="Status" id="hdnEmployeeStatus" value="@Model.EmployeeDetails.Status">
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="form-group col-md-5">
                                                        <label class="control-label col-md-5 col-sm-3 col-xs-12">
                                                            Married?
                                                        </label>
                                                        <div class="col-md-7 col-sm-9 col-xs-12">
                                                            <label class="switch switch-green col-md-6">
                                                                <input type="checkbox" class="switch-input" @(Model.EmployeeDetails.MaritalStatus == 1 ? "checked" : "" )>
                                                                <span class="switch-label" onclick="$(this).closest('label').find('#hdnEmployeeMaritalStatus').val($(this).closest('label').find('#hdnEmployeeMaritalStatus').val() == '0' ? '1' : '0');" data-on="Yes" data-off="No"></span>
                                                                <span class="switch-handle" id="shTranding"></span>
                                                                <input type="hidden" name="MaritalStatus" id="hdnEmployeeMaritalStatus" value="@Model.EmployeeDetails.Status">
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Religion
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        @*<select type="text" id="ddlReligion" name="ReligionID" class="form-control col-md-7 col-xs-12">
                                                                <option value="1" @(Model.EmployeeDetails.ReligionID == 1 ? "selected" : "" )>Hindu</option>
                                                                <option value="2" @(Model.EmployeeDetails.ReligionID == 2 ? "selected" : "" )>Muslim</option>
                                                                <option value="3" @(Model.EmployeeDetails.ReligionID == 3 ? "selected" : "" )>Sikh</option>
                                                                <option value="4" @(Model.EmployeeDetails.ReligionID == 4 ? "selected" : "" )>Christian</option>
                                                            </select>*@
                                                        <select type="text" id="ddlReligion" name="ReligionID" class="form-control col-md-7 col-xs-12">
                                                            <option value="0" @(Model.EmployeeDetails.ReligionID == 0 ? "selected" : "")>Please Select</option>
                                                            @foreach (var s in Model.Religions)
                                                            {
                                                                <option value="@s.ID" @(Model.EmployeeDetails.ReligionID == s.ID ? "selected" : "")>@s.Name</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Employee Type
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <select id="ddlEmployeeTypes" name="EmployeeType" required="required" class="form-control col-md-7 col-xs-12">
                                                            @foreach (var e in Model.EmployeeTypes)
                                                            {

                                                                <option value="@e.EmployeeTypeID" @(Model.EmployeeDetails.EmployeeType == e.EmployeeTypeID ? "selected" : "" )>@e.EmployeeTypeName</option>
                                                            }

                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        EmailID <span class="required">*</span>
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="EmailID" value="@Model.EmployeeDetails.EmailID" id="txtSEmailID" placeholder="Email ID" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>

                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Category
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <select id="ddlSCategory" name="CategoryID" required="required" class="form-control col-md-7 col-xs-12">
                                                            <option value="0" @(Model.EmployeeDetails.CategoryID == 0 ? "selected" : "")>Please Select</option>
                                                            @foreach (var s in Model.SocialCategories)
                                                            {
                                                                <option value="@s.ID" @(Model.EmployeeDetails.CategoryID == s.ID ? "selected" : "")>@s.Name</option>
                                                            }
                                                        </select>
                                                        @*<select id="ddlSCategory" name="CategoryID" required="required" class="form-control col-md-7 col-xs-12">
                                                                <option value="1" @(Model.EmployeeDetails.CategoryID == 1 ? "selected" : "" )>General</option>
                                                                <option value="2" @(Model.EmployeeDetails.CategoryID == 2 ? "selected" : "" )>SC</option>
                                                                <option value="3" @(Model.EmployeeDetails.CategoryID == 3 ? "selected" : "" )>ST</option>
                                                                <option value="4" @(Model.EmployeeDetails.CategoryID == 4 ? "selected" : "" )>OBC</option>
                                                                <option value="5" @(Model.EmployeeDetails.CategoryID == 5 ? "selected" : "" )>Other</option>
                                                            </select>*@
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Mother Tongue
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <select id="ddlSMotherTongue" name="MotherTongueID" required="required" class="form-control col-md-7 col-xs-12">
                                                            <option value="0" @(Model.EmployeeDetails.MotherTongueID == 0 ? "selected" : "")>NA</option>
                                                            @foreach (var s in Model.MotherTongues)
                                                            {
                                                                <option value="@s.ID" @(Model.EmployeeDetails.MotherTongueID == s.ID ? "selected" : "")>@s.Name</option>
                                                            }
                                                        </select>
                                                        @*<select id="ddlSMotherTongue" name="MotherTongueID" required="required" class="form-control col-md-7 col-xs-12">
                                                                <option value="1" @(Model.EmployeeDetails.MotherTongueID == 1 ? "selected" : "" )>Hindi</option>
                                                                <option value="2" @(Model.EmployeeDetails.MotherTongueID == 2 ? "selected" : "" )>English</option>
                                                                <option value="3" @(Model.EmployeeDetails.MotherTongueID == 3 ? "selected" : "" )>Tamil</option>
                                                                <option value="4" @(Model.EmployeeDetails.MotherTongueID == 4 ? "selected" : "" )>Telgu</option>
                                                                <option value="5" @(Model.EmployeeDetails.MotherTongueID == 5 ? "selected" : "" )>Marathi</option>
                                                            </select>*@
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Blood Group
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <select id="ddlSBloodGroup" name="BloodGroup" required="required" class="form-control col-md-7 col-xs-12">
                                                            <option @(Model.EmployeeDetails.BloodGroup == "NA" ? "selected" : "")>NA</option>
                                                            <option @(Model.EmployeeDetails.BloodGroup == "A+" ? "selected" : "" )>A+</option>
                                                            <option @(Model.EmployeeDetails.BloodGroup == "A-" ? "selected" : "" )>A-</option>
                                                            <option @(Model.EmployeeDetails.BloodGroup == "B+" ? "selected" : "" )>B+</option>
                                                            <option @(Model.EmployeeDetails.BloodGroup == "B-" ? "selected" : "" )>B-</option>
                                                            <option @(Model.EmployeeDetails.BloodGroup == "O-" ? "selected" : "" )>O-</option>
                                                            <option @(Model.EmployeeDetails.BloodGroup == "O+" ? "selected" : "" )>O+</option>
                                                            <option @(Model.EmployeeDetails.BloodGroup == "AB+" ? "selected" : "" )>AB-</option>
                                                            <option @(Model.EmployeeDetails.BloodGroup == "AB+" ? "selected" : "" )>AB+</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Passport No.
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="PassportNo" value="@Model.EmployeeDetails.PassportNo" id="txtSPassportNo" placeholder="Passport Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Access Card <span class="required">*</span>
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="AccessCardNo" value="@Model.EmployeeDetails.AccessCardNo" id="txtAccessCard" placeholder="Access Card Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Mobile Number *
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" required name="MobileNumber" value="@Model.EmployeeDetails.MobileNumber" id="txtMobileNumber" placeholder="Mobile Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Landline
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="LandLineNumber" value="@Model.EmployeeDetails.LandLineNumber" id="txtLandLineNumber" placeholder="Landline Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Father/Husband
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="FatherHubName" value="@Model.EmployeeDetails.FatherHubName" id="txtFatherHubName" placeholder="Father/Husband Name" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Aadhar Number
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="AadharNumber" value="@Model.EmployeeDetails.AadharNumber" id="txtAadharNumber" placeholder="Aadhar Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Licence Number
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="LicenceNumber" value="@Model.EmployeeDetails.LicenceNumber" id="txtLicenceNumber" placeholder="Licence Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-12">
                                                    <button type="submit" class="btn btn-success pull-right">Save</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (Model.EmployeeDetails.EmployeeID != 0)
                            {
                                <div role="tabpanel" class="tab-pane fade @(Model.CurrentTab == 2 ? " active in" : "")" id="tab_Account" aria-labelledby="Account-tab">
                                    @using (Html.BeginForm("SaveEmployeeAccount", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents", @class = "form-horizontal form-label-left" }))
                                    {
                                        <input type="hidden" name="EmployeeID" value="@Model.EmployeeDetails.EmployeeID" />
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        PAN Number
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="PANnumber" value="@Model.EmployeeDetails.PANnumber" placeholder="PAN Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        PF Number
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="PFNumber" value="@Model.EmployeeDetails.PFNumber" placeholder="PF Number" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Bank Name
                                                    </label>
                                                    <div class="col-md-9 col-sm-9 col-xs-12">
                                                        <input type="text" class="form-control" name="BankName" value="@Model.EmployeeDetails.BankName" placeholder="Bank Name" aria-describedby="inputSuccess2Status">
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                                                        Acc. Number
                                                    </label>
