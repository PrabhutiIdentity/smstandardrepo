                $('#frmAddLocation').find('#ssType').text('Area');
                $('#frmAddLocation').find('#txtLocationName').val('');
                AddLocation = new PNotify({
                    text: $('#form_notice').html(),
                    icon: false,
                    width: 'auto',
                    hide: false,
                    addclass: 'dark',
                    styling: 'bootstrap3',
                    buttons: {
                        closer: false,
                        sticker: false
                    },
                    insert_brs: false
                });
            }
            else {
                $('#tbTransportRouteDetails').html('');
                $('#ddlTRoutes').html('<option value="-1">--Select--</option>');
                $('#ddlTVehicles').html('<option capacity="0" filled="0" value="0" selected="">--Select--</option>');
                $.ajax(
                   {
                       type: "POST",
                       url: "/Account/GetAreaRoutes/" + $(sender).val(),
                       cache: false,
                       processData: false,
                       contentType: false,
                       success: function (html) {

                           $('#ddlTRoutes').html(html);
                       },
                       error: function (e) {
                           alert("errorn");
                       }
                   });
            }
        }
