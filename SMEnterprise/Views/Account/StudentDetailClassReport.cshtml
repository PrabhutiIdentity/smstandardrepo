@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model SMEnterprise.Models.StudentsPageModel
@section IncludeCss
{
    <title>Students Details</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/Gent/dataTables.bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/buttons.bootstrap.min.css")" rel="stylesheet">
}

<style>
    .tableexport-caption{
        display:none;
    }
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                @using (Html.BeginForm("StudentDetailClassReport", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
                {
                    <div class="row std-mng-head">

                        <div class="col-md-12 class-section">
                            <div class="row">

                                <div class="col-md-2 padding">
                                    <a href="javascript:void(0);" class="btn btn-info" onclick="PrintData()">Print</a>
                                </div>
                                <div class="col-md-3 padding">
                                    <label class="col-md-4 text-right">Session :</label>
                                    <div class="col-md-8">
                                        <select class="form-control" name="SessionID" id="ddlSessions" onchange="$('#frmGetStudents').submit();">
                                            <option value="0">--Select Session--</option>
                                            @foreach (NameIDModel el in Model.Sessions)
                                            {
                                                <option value="@el.ID" @(el.ID == Model.SessionID ? "selected" : "")>@el.Name @(el.Extra1 == "1" ? "(Active)" : "")</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3 padding">
                                    <label class="col-md-4 text-right">Class :</label>
                                    <div class="col-md-8">
                                        <select class="form-control" name="ClassID" id="ddlClass" onchange="javascript:ClassChanged(this);">
                                            <option value="0">--Select Class--</option>
                                            @foreach (ClassModel el in Model.Classes)
                                            {
                                                <option value="@el.ClassID" @(el.ClassID == Model.ClassID ? "selected" : "")>@el.ClassName</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4 padding">
                                    <div class="row">
                                        <label class="col-md-3 text-right padding-R" style="padding-left: 10px;">Section : </label>
                                        <div class="col-md-7 padding-L" style="padding-left: 10px;">

                                            <select name="SectionID" class="form-control" id="ddlSection" onchange="$('#frmGetStudents').submit();">
                                                <option value="0">--Select Section--</option>
                                                @foreach (SectionModel el in Model.Sections)
                                                {
                                                    <option value="@el.ID" @(el.ID == Model.SectionID ? "selected" : "")>@el.Name</option>
                                                }
                                            </select>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                }
                <div class="x_panel">

                    <div class="x_content">

                        <table id="tblCategory" class="table table-bordered table-hover">
                            <thead>
                                <tr><td colspan="13" style="text-align:center" id="tdHeader">Detail Student List</td></tr>
                                <tr>

                                    <th style="border:1px solid">Sr No.</th>
                                    <th style="border:1px solid">Sch. No.</th>
                                    <th style="border:1px solid">Student Name</th>
                                    <th style="border:1px solid">Father & Mother Name</th>
                                    <th style="border:1px solid">SSSMID <br />FamilyID</th>
                                    <th style="border:1px solid">Bank A/C No<br />IFS Code</th>
                                    <th style="border:1px solid">Date Of Birth</th>
                                    <th style="border:1px solid">Phone No.</th>
                                    <th style="border:1px solid">Caste</th>
                                    <th style="border:1px solid">Bus</th>
                                    <th style="border:1px solid">Adm<br />  Status/Date</th>
                                    <th style="border:1px solid">Stream</th>
                                    <th style="border:1px solid">Class <br /> Section</th>

                                </tr>
                            </thead>
                            <tbody style="font-size: 10px;">
                                @{
                                    int count = 1;
                                    foreach (StudentModel c in Model.Students)
                                    {
                                        <tr>
                                            <td style="border:1px solid" rowspan="2">@count</td>
                                            <td style="border:1px solid" rowspan="2">
                                                @c.SchoolUID
                                            </td>
                                            <td style="border:1px solid" rowspan="2">
                                                @c.Name
                                            </td>
                                            <td style="border:1px solid" rowspan="2">
                                                @c.FatherName <br />@c.MotherName<br />@c.FatherOccupationID
                                            </td>
                                            <td style="border:1px solid" rowspan="2">
                                                @c.SSSID <br />@c.FamilyID
                                            </td>
                                            <td style="border:1px solid" rowspan="2">
                                                @c.AccountNumber <br />@c.IFSCCode
                                            </td>
                                            <td style="border:1px solid">
                                                @c.DOB.ToString("dd/MM/yyyy")<br />@c.CityName
                                            </td>
                                            <td style="border:1px solid">
                                                @c.FatherMobileNo <br />@c.MotherMobileNo
                                            </td>
                                            <td style="border:1px solid">
                                                @c.SubReligion <br />@(c.Category == 1 ? "General" : c.Category == 2 ? "SC" : c.Category == 3 ? "ST" : c.Category == 4 ? "OBC" : "Other")
                                            </td>
                                            <td style="border:1px solid" rowspan="2">@(c.BusNo == "NA" ? "NO" : "Yes")<br />@(c.BusNo == null ? "NIL" : c.BusNo)</td>
                                            <td style="border:1px solid" rowspan="2">@(c.IsOld == 0 ? "New" : "Old")<br />@c.DOJ.ToString("dd/MM/yyyy")</td>
                                            <td style="border:1px solid" rowspan="2">
                                                @c.Stream
                                            </td>
                                            <td style="border:1px solid" rowspan="2">
                                                @c.ClassName <br />@c.SectionName
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="border:1px solid" colspan="3">Aadhar No : @c.AadharCardNo</td>
                                        </tr>

                                        count++;
                                    }

                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

