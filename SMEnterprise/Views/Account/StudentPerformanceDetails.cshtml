                {
                    <img onerror="return OnImageError(this,2);"
                         class="school-logo" alt="CBSE Logo"
                         src="@Url.Content("~/Images/cbse-logo.png")" />
                }
                else if (Model.SBranchDetails.SBranchID != 17)
                {
                    <img onerror="return OnImageError(this,2);"
                         class="school-logo" alt="Logo"
                         src="@Url.Content("~/Images/SBranchLogo/")@(Model.SBranchDetails.SBranchID)_@(Model.SBranchDetails.Logo)" />
                }
            </div>
        </div>

        <!-- ===== REPORT CARD TITLE ===== -->
        <div class="report-title-banner">
            <div class="rc-label">&#9670; Report Card &#9670;</div>
            <div class="session-label">Academic Session : @Model.SessionName</div>
        </div>

        <!-- ===== STUDENT INFO ===== -->
        <table class="student-info-table">
            <tr>
                <td style="width:44%">
                    <table style="width:100%;border-collapse:collapse;">
                        <tr><td><span class="info-label">Roll No.&nbsp;:</span> <b>@Model.Student.RollNo</b></td></tr>
                        <tr><td><span class="info-label">Student&nbsp;:</span> <b id="bStudentNate">@Model.Student.Name</b></td></tr>
                        <tr><td><span class="info-label">Mother's Name&nbsp;:</span> <b>@Model.Student.MotherName</b></td></tr>
                        <tr><td><span class="info-label">Father's Name&nbsp;:</span> <b>@Model.Student.FatherName</b></td></tr>
                        <tr><td><span class="info-label">Parent's ID&nbsp;:</span> <b>@Model.Student.SParentID</b></td></tr>
                    </table>
                </td>
                <td style="width:44%">
                    <table style="width:100%;border-collapse:collapse;">
                        <tr><td><span class="info-label">Date of Birth&nbsp;:</span> <b>@Model.Student.DOB.ToString("dd MMM, yyyy")</b></td></tr>
                        <tr><td><span class="info-label">Class-Section&nbsp;:</span> <b id="bClassSection">@Model.Student.ClassName</b></td></tr>
                        <tr><td><span class="info-label">Student ID&nbsp;:</span> <b>@Model.Student.StudentSID</b></td></tr>
                        <tr><td><span class="info-label">SR No.&nbsp;:</span> <b>@Model.Student.SchoolUID</b></td></tr>
                    </table>
                </td>
                <td style="width:12%;text-align:center;vertical-align:middle;">
                    @if (Model.Student.Photo != null)
                    {
                        <img id="imgPhoto"
                             onerror="return OnImageError(this,@(Model.Student.Gender));"
                             class="student-photo" alt="Student Photo"
                             src="@Url.Content("~/Images/StudentImage/")@(Model.Student.StudentID)_@Model.Student.Photo" />
                    }
                </td>
            </tr>
        </table>

        <!-- ===== HIDDEN FORM FIELDS ===== -->
        <input type="hidden" name="StudentSessionUID" value="@Model.StudentSessionUID" />
        <input type="hidden" name="EvaluationID" value="@Model.EvaluationID" />

        <!-- ===== PERFORMANCE PARAMETERS LOOP ===== -->

        var mainCounter = 0;


        <!-- Main marks table (ParamType 0) -->
        foreach (PerformanceParameterModel c in Model.PerformanceParameters)
        {
            if (c.ParamType == 0)
            {
                <table style="width:100%;border-collapse:collapse;border:1.5px solid #b0c4de;margin-bottom:12px;">
                    <tr>
                        <td class="section-header">
                            @c.ParamName
                            @if (!string.IsNullOrEmpty(c.ParamDesc))
                            {
                                <small>@c.ParamDesc</small>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:0;">
                            <table id="tblResult">
                                @{
                                    var sublevels = 1;

                                    <!-- Header Row 1: Evaluation names -->
                                    <tr>
                                        <td @(Model.SubEvaluations.Count > 0 ? "rowspan=2" : "") style="text-align:left!important;">
                                            <b>Subject</b>
                                        </td>
                                        @foreach (EvaluationModel me in Model.MainEvaluations)
                                        {
                                            if (sublevels < me.SubEvals) { sublevels = me.SubEvals; }
                                            <td colspan="@(me.SubEvals + 2)"><b>@me.EvaluationName</b> (@me.Weightage.ToString("0") marks)</td>
                                        }
                                        @if (Model.EvaluationID == -1)
                                        {
                                            <td colspan="2"><b>Sub Total</b></td>
                                        }
                                    </tr>

                                    <!-- Header Row 2: Sub-evaluation columns -->
                                    if (Model.SubEvaluations.Count > 0)
                                    {
                                        <tr>
                                            @foreach (EvaluationModel tme in Model.MainEvaluations)
                                            {
                                                foreach (EvaluationModel se in Model.SubEvaluations)
                                                {
                                                    if (se.MasterID == tme.EvaluationID)
                                                    {
                                                        <td><b>@se.EvaluationName</b> (@se.Weightage)</td>
                                                    }
                                                }
                                                <td><b>Marks Obtained (@tme.Weightage)</b></td>
                                                <td><b>Grade</b></td>
                                            }
                                            @if (Model.EvaluationID == -1)
                                            {
                                                <td><b>Marks Obtained</b><br />(@Model.MainEvaluations.Sum(x => x.Weightage))</td>
                                                <td><b>Grade</b></td>
                                            }
                                        </tr>
                                    }

                                    <!-- Data Rows -->
                                    var privSubID = 0;
                                    decimal totalmarksresult = 0;
                                    var division = "First";
                                    var Grade = "A";
                                    var GradeAll = "A";
                                    decimal TotalMarksT = 0;
                                    decimal TotalObtMarksT = 0;
                                    var divisionAll = "First";
                                    decimal totaltotal = 0;
                                    decimal totalscored = 0;

                                    foreach (ExamResultDetailModel r in Model.Result)
                                    {
                                        if (privSubID != r.SubjectID)
                                        {
                                            <tr class="subject-row">
                                                <td><b>@r.SubjectName</b></td>
                                                @foreach (EvaluationModel er in Model.MainEvaluations)
                                                {
                                                    decimal EvalMaxMarks = 0;
                                                    decimal SATotalMarks = 0;
                                                    decimal EvalTotalMarks = 0;

                                                    foreach (EvaluationModel esr in Model.SubEvaluations)
                                                    {
                                                        if (esr.MasterID == er.EvaluationID)
                                                        {
                                                            var isFound = false;
                                                            foreach (ExamResultDetailModel err in Model.Result)
                                                            {
                                                                if (err.MasterID == er.EvaluationID && esr.EvaluationType == err.EvaluationID && r.SubjectID == err.SubjectID)
                                                                {
                                                                    if (Model.SBranchID == 0)
                                                                    {
                                                                        <td>@err.wMaxMarks.ToString("N2")</td>
                                                                    }
                                                                    else
                                                                    {
                                                                        if (err.Status == -1)
                                                                        {
                                                                            <td>M/L</td>
                                                                        }
                                                                        else
                                                                        {
                                                                            <td class="@(err.wMarksScored < err.PassMarks ? "fail-mark" : "")">
                                                                                @err.wMarksScored.ToString("0")
                                                                            </td>
                                                                        }
                                                                    }
                                                                    EvalTotalMarks += err.wMarksScored;
                                                                    EvalMaxMarks += err.wMaxMarks;
                                                                    er.TotalMarks += err.wMaxMarks;
                                                                    er.MarksObtained += err.wMarksScored;
                                                                    r.etMarksScored += err.wMarksScored;
                                                                    r.etMaxMarks += err.wMaxMarks;
                                                                    isFound = true;
                                                                }
                                                            }
                                                            if (!isFound)
                                                            {
                                                                <td>NA</td>
                                                            }
                                                        }
                                                    }

                                                    var subEve = SubjectEvaluationFinalStatus.Where(se => se.ID == r.SubjectID && se.Name == er.EvaluationID.ToString()).SingleOrDefault();
                                                    if (subEve == null)
                                                    {
                                                        subEve = new NameIDModel();
                                                        subEve.ID = r.SubjectID;
                                                        subEve.Name = er.EvaluationID.ToString();
                                                        if (EvalMaxMarks > 0)
                                                        {

                                                            subEve.Extra1 = (EvalTotalMarks * 100 / EvalMaxMarks).ToString();
                                                        }
                                                        @* subEve.Extra1 = (EvalTotalMarks * 100 / EvalMaxMarks).ToString();*@
                                                        SubjectEvaluationFinalStatus.Add(subEve);
                                                    }
                                                    else
                                                    {
                                                        subEve.Extra1 = (EvalTotalMarks * 100 / EvalMaxMarks).ToString();
                                                    }

                                                    totalmarksresult += EvalMaxMarks;
                                                    <td>@Math.Round(EvalTotalMarks, 2)</td>
                                                    <td>@AcadmicModel.CalculateGrade(EvalTotalMarks, EvalMaxMarks)</td>
                                                }
                                                @if (Model.EvaluationID == -1)
                                                {
                                                    <td>@r.etMarksScored.ToString("0.00")</td>
                                                    <td>@AcadmicModel.CalculateGrade(r.etMarksScored, r.etMaxMarks)</td>
                                                }
                                            </tr>
                                        }
                                        privSubID = r.SubjectID;
                                    }

                                    <!-- Total Row -->
                                    <tr class="total-row">
                                        <td style="text-align:left!important;"><b>Total</b></td>
                                        @foreach (var me in Model.MainEvaluations)
                                        {
                                            <td colspan="@(me.SubEvals)"><b>Total</b></td>
                                            <td><b>@Math.Round(me.MarksObtained, 2)</b></td>
                                            division = @AcadmicModel.CalculateGradeDivision(me.MarksObtained, me.TotalMarks);
                                            TotalMarksT = @Math.Round(me.TotalMarks, 2);
                                            TotalObtMarksT = @Math.Round(me.MarksObtained, 2);
                                            Grade = @AcadmicModel.CalculateGrade(me.MarksObtained, me.TotalMarks);
                                            <td><b>@Math.Round(me.TotalMarks == 0 ? 0 : me.MarksObtained * 100 / me.TotalMarks, 2)% (@AcadmicModel.CalculateGrade(me.MarksObtained, me.TotalMarks))</b></td>
                                        }
                                        @if (Model.EvaluationID == -1)
                                        {
                                            <td>@Model.Result.Sum(x => x.etMarksScored).ToString("0.00")</td>
                                            totaltotal = Model.Result.Sum(x => x.etMaxMarks);
                                            totalscored = Model.Result.Sum(x => x.etMarksScored);
                                            divisionAll = @AcadmicModel.CalculateGradeDivision(totalscored, totaltotal);
                                            GradeAll = @AcadmicModel.CalculateGrade(totalscored, totaltotal);
                                            <td>@Math.Round(totaltotal == 0 ? 0 : totalscored * 100 / totaltotal, 2)% (@AcadmicModel.CalculateGrade(totalscored, totaltotal))</td>
                                        }
                                    </tr>
                                }
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Overall Summary Bar -->
                <div class="overall-summary" style="margin-bottom:12px;">
                    @if (Model.EvaluationID == -1)
                    {
                        <div>Overall Marks : <span>@totalscored.ToString("0.00") / @totaltotal.ToString("0.00")</span></div>
                        <div>Percentage : <span>@Math.Round(totaltotal == 0 ? 0 : totalscored * 100 / totaltotal, 2).ToString("0.00")%</span></div>
                        <div>Grade : <span>@GradeAll</span></div>
                        <div>Division : <span>@divisionAll</span></div>
                    }
                    else
                    {
                        <div>Overall Marks : <span>@TotalObtMarksT.ToString("0.00") / @TotalMarksT.ToString("0.00")</span></div>
                        <div>Percentage : <span>@Math.Round(TotalMarksT == 0 ? 0 : TotalObtMarksT * 100 / TotalMarksT, 2).ToString("0.00")%</span></div>
                        <div>Grade : <span>@Grade</span></div>
                        <div>Division : <span>@division</span></div>
                    }
                </div>
            }

            <!-- ===== CO-SCHOLASTIC (ParamType 1) ===== -->
            if (c.ParamType == 1)
            {
                <table style="width:100%;border-collapse:collapse;margin-bottom:8px;">
                    <tr>
                        @foreach (EvaluationModel eprop in Model.MainEvaluations)
                        {
                            <td style="width:@(100 / Model.MainEvaluations.Count)%;vertical-align:top;padding:0 4px 0 0;">
                                <table class="param-table">
                                    @if (c.ParamName != "")
                                    {
                                        <tr>
                                            <th colspan="2">
                                                @Html.Raw(c.ParamName.Replace("[EvaluationName]", eprop.EvaluationName))
                                            </th>
                                            <th>Grade</th>
                                        </tr>
                                    }
                                    @if (c.Subs != 0)
                                    {
                                        foreach (PerformanceParameterModel s in Model.PerformanceParameters)
                                        {
                                            if ((s.ParamType == 5) && s.MainParamID == c.ParamID && (s.EvaluationID == eprop.EvaluationID || s.EvaluationID == -1))
                                            {
                                                <tr>
                                                    <td colspan="2">@Html.Raw(s.ParamName.Replace("[EvaluationName]", eprop.EvaluationName))</td>
                                                    <td>
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].ParamKey" value="@s.ParamKey" />
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].ParamID" value="@s.ParamID" />
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].ParamValID" value="@s.ParamValID" />
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].EvaluationID" value="@eprop.EvaluationID" />
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].StudentSessionID" value="@Model.StudentSessionUID" />
                                                        @if (Model.EvaluationID != -1)
                                                        {
                                                            <input type="text" class="form-control noprint" name="PerformanceParameters[@mainCounter].Grade" value="@s.Grade" />
                                                            <span class="print">@s.Grade</span>
                                                        }
                                                        else
                                                        { @s.Grade}
                                                    </td>
                                                </tr>
                                                mainCounter++;
                                            }
                                            if ((s.ParamType == 6) && s.MainParamID == c.ParamID && (s.EvaluationID == eprop.EvaluationID || s.Grade == null))
                                            {
                                                <tr>
                                                    <td style="width:60%"><b>@Html.Raw(s.ParamName.Replace("[EvaluationName]", eprop.EvaluationName))</b></td>
                                                    <td>
                                                        Marks:
                                                        <input type="text" class="form-control noprint" name="PerformanceParameters[@mainCounter].ParamValue" value="@s.ParamValue" />
                                                        <span class="print">@s.ParamValue</span>
                                                    </td>
                                                    <td>
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].ParamKey" value="@s.ParamKey" />
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].ParamID" value="@s.ParamID" />
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].ParamValID" value="@s.ParamValID" />
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].EvaluationID" value="@eprop.EvaluationID" />
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].StudentSessionID" value="@Model.StudentSessionUID" />
                                                        Grade:
                                                        @if (Model.EvaluationID != -1)
                                                        {
                                                            <input type="text" class="form-control noprint" name="PerformanceParameters[@mainCounter].Grade" value="@s.Grade" />
                                                            <span class="print">@s.Grade</span>
                                                        }
                                                        else
                                                        { @s.Grade}
                                                    </td>
                                                </tr>
                                                mainCounter++;
                                            }
                                            if ((s.ParamType == 7) && s.MainParamID == c.ParamID && (s.EvaluationID == eprop.EvaluationID || s.Grade == null))
                                            {
                                                <tr>
                                                    <td colspan="2"><b>@Html.Raw(s.ParamName.Replace("[EvaluationName]", eprop.EvaluationName))</b></td>
                                                    <td>
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].ParamKey" value="@s.ParamKey" />
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].ParamID" value="@s.ParamID" />
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].ParamValID" value="@s.ParamValID" />
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].EvaluationID" value="@eprop.EvaluationID" />
                                                        <input type="hidden" name="PerformanceParameters[@mainCounter].StudentSessionID" value="@Model.StudentSessionUID" />
                                                        @if (Model.EvaluationID != -1)
                                                        {
                                                            <input type="text" class="form-control noprint" name="PerformanceParameters[@mainCounter].Grade" value="@s.Grade" />
                                                            <span class="print">@s.Grade</span>
                                                        }
                                                        else
                                                        { @s.Grade}
                                                    </td>
                                                </tr>
                                                mainCounter++;
                                            }
                                        }
                                    }
                                </table>
                            </td>
                        }
                    </tr>
                </table>
            }

            <!-- ===== ATTENDANCE (ParamType 3 / attendance inputs) ===== -->
            if (c.ParamType == 3)
            {
                <table style="width:100%;border-collapse:collapse;margin-bottom:8px;">
                    <tr>
                        @foreach (EvaluationModel eprop in Model.MainEvaluations)
                        {
                            <td style="width:@(100 / Model.MainEvaluations.Count)%;vertical-align:top;padding:0 4px 0 0;">
                                <table class="attendance-table">
                                    @if (c.ParamName != "")
                                    {
                                        <tr style="background:#2e6db4;color:#fff;">
                                            <td colspan="2"><b>@Html.Raw(c.ParamName.Replace("[EvaluationName]", eprop.EvaluationName))</b></td>
                                        </tr>
                                    }
                                    @foreach (PerformanceParameterModel s in Model.PerformanceParameters)
                                    {
                                        if (s.ParamType == 4 && s.MainParamID == c.ParamID && (s.EvaluationID == eprop.EvaluationID || s.EvaluationID == -1))
                                        {
                                            <tr>
                                                <td><b>@s.ParamName</b></td>
                                                <td>
                                                    Attendance:
                                                    <input type="text" class="form-control noprint" name="PerformanceParameters[@mainCounter].ParamValue" value="@s.ParamValue" />
                                                    <span class="print">@s.ParamValue</span>
                                                    <input type="hidden" name="PerformanceParameters[@mainCounter].ParamKey" value="@s.ParamKey" />
                                                    <input type="hidden" name="PerformanceParameters[@mainCounter].ParamID" value="@s.ParamID" />
                                                    <input type="hidden" name="PerformanceParameters[@mainCounter].ParamValID" value="@s.ParamValID" />
                                                    <input type="hidden" name="PerformanceParameters[@mainCounter].EvaluationID" value="@eprop.EvaluationID" />
                                                    <input type="hidden" name="PerformanceParameters[@mainCounter].StudentSessionID" value="@Model.StudentSessionUID" />
                                                    Working Days:
                                                    <input type="text" class="form-control noprint" name="PerformanceParameters[@mainCounter].Grade" value="@s.Grade" />
                                                    <span class="print">@s.Grade</span>
                                                    mainCounter++;
                                                </td>
                                            </tr>
                                        }
                                    }
                                </table>
                            </td>
                        }
                    </tr>
                </table>
            }

            <!-- ===== TYPE 2 — Theory/Practical table ===== -->
            if (c.ParamType == 2)
            {
                <table style="width:100%;border-collapse:collapse;margin-bottom:8px;">
                    <tr>
                        @foreach (EvaluationModel eprop in Model.MainEvaluations)
                        {
                            <td style="width:@(100 / Model.MainEvaluations.Count)%;vertical-align:top;padding:0 4px 0 0;">
                                <table class="param-table">
                                    @if (c.ParamName != "")
                                    {
                                        <tr><th colspan="3">@Html.Raw(c.ParamName.Replace("[EvaluationName]", eprop.EvaluationName))</th></tr>
                                    }
                                    <tr>
                                        <th>Subject</th>
                                        <th>Theory</th>
                                        <th>Practical</th>
                                    </tr>

                                    var oldParamID = 0;
                                    @foreach (PerformanceParameterModel s in Model.PerformanceParameters)
                                    {
                                        if ((s.ParamType == 8) && s.MainParamID == c.ParamID && (s.EvaluationID == eprop.EvaluationID || s.EvaluationID == -1))
                                        {
                                            <tr>
                                                <td><b>@s.ParamName</b></td>
                                                <td>
                                                    <input type="text" class="form-control noprint" name="PerformanceParameters[@mainCounter].ParamValue" value="@s.ParamValue" />
                                                    <span class="print">@s.ParamValue</span>
                                                </td>
                                                <td>
                                                    <input type="hidden" name="PerformanceParameters[@mainCounter].ParamKey" value="@s.ParamKey" />
                                                    <input type="hidden" name="PerformanceParameters[@mainCounter].ParamID" value="@s.ParamID" />
                                                    <input type="hidden" name="PerformanceParameters[@mainCounter].ParamValID" value="@s.ParamValID" />
                                                    <input type="hidden" name="PerformanceParameters[@mainCounter].EvaluationID" value="@eprop.EvaluationID" />
                                                    <input type="hidden" name="PerformanceParameters[@mainCounter].StudentSessionID" value="@Model.StudentSessionUID" />
                                                    <input type="text" class="form-control noprint" name="PerformanceParameters[@mainCounter].Grade" value="@s.Grade" />
                                                    <span class="print">@s.Grade</span>
                                                </td>
                                            </tr>
                                            mainCounter++;
                                        }
                                    }

                                </table>
                            </td>
                        }
                    </tr>
                </table>
            }
        }


        <!-- ===== RESULT STATUS ===== -->
        if (Model.MainEvaluations.Count > 1)
        {
            var finalStatus = 0;
            foreach (var se in SubjectEvaluationFinalStatus)
            {
                if (Convert.ToDecimal(se.Extra1) < 40)
                {
                    var subsum = SubjectEvaluationFinalStatus.Where(s => s.ID == se.ID).Sum(c2 => Convert.ToDecimal(c2.Extra1));
                    var subsumcount = SubjectEvaluationFinalStatus.Where(s => s.ID == se.ID).Count();
                    if (subsum / subsumcount < 40) { finalStatus = 1; break; }
                    else if (subsum / subsumcount > 40) { finalStatus = 2; break; }
                }
            }
            if (Model.SBranchDetails.SBranchID != 9)
            {
                <div style="border:1.5px solid #1a3a6c;border-radius:4px;padding:6px 12px;margin-bottom:8px;font-size:13px;background:#f8fbff;">
                    <b>Result Status :</b>
                    <b style="color:@(finalStatus == 0 ? "#1a7a1a" : "#c0392b")">
                        @(finalStatus == 0 ? "Pass" : finalStatus == 1 ? "Pass" : "Pass")
                    </b>
                </div>
            }

        }

        <!-- ===== REMARKS ===== -->
        <div class="remarks-section">
            <b>Class Teacher's Remarks :</b>
            <br /><br />
        </div>

        <!-- ===== GRADING SCALE ===== -->
        <div class="grading-scale-box">
            <div class="grade-box">
                <b>Grading Scale &ndash; Scholastic Areas</b><br />
                Grades are awarded on an 8-point scale:<br />
                <b>A1</b> [91-100%] &nbsp; <b>A2</b> [81-90%] &nbsp; <b>B1</b> [71-80%] &nbsp; <b>B2</b> [61-70%]<br />
                <b>C1</b> [51-60%] &nbsp; <b>C2</b> [41-50%] &nbsp; <b>D</b> [33-40%] &nbsp; <b>E</b> [≤32% - Needs Improvement]
            </div>
            <div class="grade-box">
                <b>Grading Scale &ndash; Co-Scholastic Areas</b><br />
                Grades are awarded on a 3-point scale:<br />
                <b>A</b> [Outstanding] &nbsp; <b>B</b> [Very Good] &nbsp; <b>C</b> [Fair] &nbsp; <b>D</b> [Needs Improvement]
            </div>
        </div>

        <!-- ===== SIGNATURES ===== -->
        <table class="signature-table" style="margin-top:20px;">
            <tr>
                <td style="width:25%;text-align:left;vertical-align:bottom;font-size:12px;">
                    Place : <br />
                    Date &nbsp;: @Model.MainEvaluations[Model.MainEvaluations.Count - 1].ResultDate.ToString("dd MMM, yyyy")
                </td>
                <td style="width:25%">
                    @if (Model.SBranchDetails.ClassTeacherSign != null)
                    {
                        <img onerror="return OnImageError(this,2);" class="reportSign" alt="Class Teacher Sign"
                             src="@Url.Content("~/Images/EmployeeDocuments/")@(Model.SBranchDetails.CTeacherID)_Sign_@(Model.SBranchDetails.ClassTeacherSign)" />
                    }
                    <div class="sig-line"></div>
                    @(Model.SBranchDetails.ClassTeacher ?? "") <br />(Class Teacher)
                </td>
                <td style="width:25%">
                    @if (Model.SBranchDetails.TeacherIncharge != null && Model.SBranchDetails.TeacherInchargeSign != null)
                    {
                        <img onerror="return OnImageError(this,2);" class="reportSign" alt="Teacher Incharge Sign"
                             src="@Url.Content("~/Images/EmployeeDocuments/")@(Model.SBranchDetails.InchargeTeacherID)_Sign_@(Model.SBranchDetails.TeacherInchargeSign)" />
                    }
                    <div class="sig-line"></div>
                    @(Model.SBranchDetails.TeacherIncharge ?? "") <br />(Teacher Incharge)
                </td>
                <td style="width:25%">
                    @if (Model.SBranchDetails.PrincipalSignature != null)
                    {
                        <img onerror="return OnImageError(this,2);" class="reportSign" alt="Principal Sign"
                             src="@Url.Content("~/Images/SBranchLogo/")@(Model.SBranchDetails.SBranchID)_P_@(Model.SBranchDetails.PrincipalSignature)" />
                    }
                    <div class="sig-line"></div>
                    Signature of Principal
                </td>
            </tr>
        </table>



        <input type="hidden" id="hdnCounterCount" value="@mainCounter" />
