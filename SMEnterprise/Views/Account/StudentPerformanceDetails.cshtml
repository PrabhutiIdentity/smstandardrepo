        /* ================================================
           SCREEN STYLES — Optimized for Viewing
           ================================================ */

        .report-wrapper {
            max-width: 210mm; /* A4 width */
            margin: 0 auto;
            background: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11pt;
            color: #1a1a1a;
            padding: 10mm;
            box-sizing: border-box;
        }

        /* School Header — Table Layout for Print Compatibility */
        .school-header {
            display: table;
            width: 100%;
            border-bottom: 3px double #1a3a6c;
            padding-bottom: 8px;
            margin-bottom: 6px;
        }

        .school-header-left,
        .school-header-right {
            display: table-cell;
            width: 15%;
            vertical-align: middle;
            text-align: center;
        }

        .school-header-center {
            display: table-cell;
            width: 70%;
            vertical-align: middle;
            text-align: center;
            padding: 0 10px;
        }

        .school-logo {
            width: 100px;
            height: 100px;
            object-fit: contain;
            border: 1px solid #ddd;
        }

        .school-name {
            font-size: 22px;
            font-weight: 700;
            color: #0e0e40;
            margin: 0 0 4px 0;
            line-height: 1.2;
            text-transform: uppercase;
        }

        .school-address {
            font-size: 18px;
            color: #153693;
            margin: 3px 0;
            line-height: 1.3;
        }

        .school-contact {
            font-size: 16px;
            color: #333;
            margin: 3px 0;
        }

        /* Report Card Title */
        .report-title-banner {
            text-align: center;
            padding: 8px 0 4px;
            border-bottom: 2px solid #c8ddf5;
            margin-bottom: 8px;
        }

        .rc-label {
            font-size: 20px;
            font-weight: 800;
            color: #98484b;
            letter-spacing: 4px;
            text-transform: uppercase;
            display: block;
        }

        .session-label {
            font-size: 13px;
            color: #2e8fb5;
            font-weight: 600;
            display: block;
            margin-top: 3px;
        }

        /* Student Info Table */
        .student-info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 5px;
            border: 1.5px solid #b0c4de;
            background: #f8fbff;
        }

            .student-info-table td {
                padding: 4px 8px;
                vertical-align: top;
                font-size: 12px;
                border: none;
            }

        .info-label {
            color: #555;
            font-weight: 500;
        }

        .student-photo {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border: 2px solid #b0c4de;
            background: #fff;
        }

        /* Section Headers */
        .section-header {
            background: linear-gradient(90deg, #1a3a6c 0%, #2e6db4 100%);
            color: #fff !important;
            font-size: 12px;
            font-weight: 700;
            text-align: center;
            padding: 6px 8px;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

            .section-header small {
                font-weight: 400;
                font-size: 10px;
                color: #d0e4ff;
                display: block;
                margin-top: 2px;
            }

        /* Marks Table */
        #tblResult {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            table-layout: fixed;
        }

            #tblResult th, #tblResult td {
                border: 1px solid #b8cfe8;
                padding: 3px 4px;
                text-align: center;
                vertical-align: middle;
                word-wrap: break-word;
            }

            #tblResult > tbody > tr:first-child td {
                background-color: #1a3a6c !important;
                color: #fff;
                font-weight: 700;
                font-size: 12px;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            #tblResult > tbody > tr:nth-child(2) td {
                background-color: #2e6db4 !important;
                color: #fff;
                font-weight: 600;
                font-size: 12px;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            #tblResult > tbody > tr.subject-row:nth-child(odd) td {
                background-color: #f0f6ff;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            #tblResult > tbody > tr.total-row td {
                background-color: #e8f0fb !important;
                font-weight: 700;
                border-top: 2px solid #1a3a6c;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            #tblResult td:first-child {
                text-align: left !important;
                font-weight: 600;
                width: 12%;
            }

        .fail-mark {
            color: #c0392b;
            font-weight: 700;
        }

        /* Overall Summary Bar */
        .overall-summary {
            display: table;
            width: 100%;
            background: #1a3a6c;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 8px;
            border: 1.5px solid #1a3a6c;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

            .overall-summary > div {
                display: table-cell;
                padding: 6px 8px;
                border-right: 1px solid #4a7ab5;
                text-align: center;
                vertical-align: middle;
                width: 25%;
            }

                .overall-summary > div:last-child {
                    border-right: none;
                }

            .overall-summary span {
                color: #ffd700;
                font-size: 12px;
            }

        /* Co-Scholastic & Param Tables */
        .param-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

            .param-table th, .param-table td {
                border: 1px solid #b8cfe8;
                padding: 4px 6px;
                vertical-align: middle;
            }

            .param-table th {
                background: #2e6db4 !important;
                color: #fff;
                font-weight: 700;
                text-align: left;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .param-table tr:nth-child(odd) td {
                background: #f5f9ff;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .param-table tr:nth-child(even) td {
                background: #fff;
            }

        /* Attendance Table */
        .attendance-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

            .attendance-table td {
                border: 1px solid #b8cfe8;
                padding: 4px 6px;
            }


        /* ---------- Grading Scale ---------- */
        /* Grading Scale */
        .grading-scale-box {
            display: table;
            width: 100%;
            margin-top: 6px;
            border: 1px solid #b8cfe8;
        }

        .grade-box {
            display: table-cell;
            width: 50%;
            padding: 6px 8px;
            font-size: 12px;
            background: #f8fbff;
            vertical-align: top;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

            .grade-box:first-child {
                border-right: 1px solid #b8cfe8;
            }

        .grading-scale-box .grade-box b {
            color: #1a3a6c;
        }

        /* ---------- Remarks ---------- */
        .remarks-section {
            margin-top: 6px;
            font-size: 12px;
            border: 1px solid #b8cfe8;
            padding: 5px 10px;
            min-height: 36px;
        }

        /* ---------- Signatures ---------- */
        .signature-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 14px;
        }

            .signature-table td {
                text-align: center;
                padding: 3px 6px;
                vertical-align: bottom;
                font-size: 12px;
                border: none;
            }

        .reportSign {
            max-width: 150px;
            max-height: 60px;
            display: block;
            margin: 0 auto 3px;
        }

        .sig-line {
            border-top: 1px solid #555;
            margin: 4px auto 2px;
            width: 80%;
        }

        /* ---------- Print Button ---------- */
        .print-btn-row {
            margin: 10px 0 4px;
            overflow: hidden;
        }

        /* ================================================
           PRINT  —  A4 one-page optimised
           Uses media print because PrintReport() iframe
           also injects this same CSS block directly.
           ================================================ */
        @@media print {
            @@page {
                size: A4 portrait;
                margin: 8mm 10mm 10mm 10mm;
            }
            /* Hide the entire _AccountLayout shell */
            body > * {
                display: none !important;
            }
            /* Only show the content div that wraps x_panel */
            .right_col {
                display: block !important;
                margin: 0 !important;
                padding: 0 !important;
            }

                .right_col > .page-title,
                .right_col > .top_nav {
                    display: none !important;
                }

            .x_panel {
                display: block !important;
                box-shadow: none !important;
                border: none !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            .x_title {
                display: none !important;
            }

            .x_content {
                display: block !important;
                padding: 0 !important;
            }

            .row, [class*="col-"] {
                display: block !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            /* Show only report-wrapper */
            .report-wrapper {
                display: block !important;
                max-width: 100% !important;
                padding: 0 !important;
                font-size: 11px;
            }
            /* Hide buttons and inputs */
            .print-btn-row, button, a.btn, input[type="text"], select {
                display: none !important;
            }

            input[type="hidden"] {
                display: none !important;
            }

            .print {
                display: inline !important;
            }

            .noprint {
                display: none !important;
            }
            /* Compact sizing for A4 */
            .school-logo {
                width: 80px !important;
                height: 80px !important;
            }

            .school-name {
                font-size: 18px !important;
            }

            .school-address {
                font-size: 10px !important;
            }

            .school-contact {
                font-size: 10px !important;
            }

            .rc-label {
                font-size: 16px !important;
            }

            .session-label {
                font-size: 11px !important;
            }

            .student-info-table td {
                font-size: 11px !important;
                padding: 3px 8px !important;
            }

            .student-photo {
                width: 70px !important;
                height: 70px !important;
            }

            #tblResult, #tblResult td, #tblResult th {
                font-size: 9px !important;
                padding: 2px 3px !important;
            }

            .param-table, .param-table td, .param-table th {
                font-size: 9px !important;
                padding: 2px 4px !important;
            }

            .overall-summary {
                font-size: 10px !important;
            }

                .overall-summary > div {
                    padding: 3px 4px !important;
                }

            .remarks-section {
                min-height: 24px !important;
                font-size: 10px !important;
            }

            .grading-scale-box .grade-box {
                font-size: 9px !important;
                padding: 3px 5px !important;
            }

            .signature-table td {
                font-size: 10px !important;
            }

            .reportSign {
                max-height: 50px !important;
            }

            .section-header {
                padding: 3px 6px !important;
                font-size: 11px !important;
            }
            /* Colour backgrounds must print */
            .section-header,
            #tblResult > tbody > tr:first-child td,
            #tblResult > tbody > tr:nth-child(2) td,
            #tblResult > tbody > tr.total-row td,
            .overall-summary,
            .param-table th {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                color-adjust: exact !important;
            }

            table {
                page-break-inside: auto;
            }

            tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }
        }
    </style>
