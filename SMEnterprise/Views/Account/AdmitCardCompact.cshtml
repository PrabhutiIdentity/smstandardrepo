@{
    ViewBag.Title = "Admit Card Compact";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@section IncludeCss
{
    <title>Admit Card Compact</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/DemandRecipt.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/style.min.css")" rel="stylesheet" />
}
@model SMEnterprise.Models.AdmitCardListModel
<style id="admitCardCompactStyles">
    .admit-sheet {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: flex-start;
        margin-top: 14px;
    }

    .admit-card-item {
        width: calc(50% - 7px);
        min-height: 72mm;
        background: #fff;
        border: 1px solid #d7dee4;
        border-radius: 8px;
        box-shadow: 0 8px 18px rgba(15, 40, 65, 0.08);
        padding: 8px 10px 8px;
        page-break-inside: avoid;
        break-inside: avoid;
    }

    .admit-card-head {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        border-bottom: 1px solid #222;
        padding-bottom: 6px;
        margin-bottom: 8px;
    }

    .admit-school-logo {
        width: 24px;
        height: 24px;
        object-fit: contain;
        flex: 0 0 24px;
    }

    .admit-school-head {
        flex: 1;
        text-align: center;
        min-width: 0;
    }

    .admit-school-name {
        margin: 0;
        font-size: 14px;
        font-weight: 800;
        line-height: 1.1;
        text-transform: uppercase;
        color: #222;
    }

    .admit-school-meta {
        margin-top: 2px;
        font-size: 9px;
        color: #666;
        line-height: 1.3;
    }

    .admit-title {
        margin: 6px 0 2px;
        text-align: center;
        font-weight: 800;
        font-size: 12px;
        text-transform: uppercase;
        color: #222;
    }

    .admit-subtitle {
        text-align: center;
        font-size: 9px;
        color: #444;
        margin-bottom: 6px;
        border-bottom: 1px solid #000;
        padding-bottom: 5px;
    }

    .admit-body {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .admit-info {
        flex: 1;
        min-width: 0;
    }

    .admit-row {
        display: grid;
        grid-template-columns: 104px 1fr;
        gap: 6px;
        font-size: 11px;
        line-height: 1.35;
        padding: 1px 0;
    }

    .admit-label {
        color: #222;
        white-space: nowrap;
    }

    .admit-value {
        color: #222;
        font-weight: 600;
        word-break: break-word;
    }

    .admit-photo-block {
        width: 70px;
        text-align: center;
        flex: 0 0 70px;
    }

    .admit-photo {
        width: 62px;
        height: 72px;
        object-fit: cover;
        border: 1px solid #d6dce3;
        border-radius: 3px;
        background: #fff;
    }

    .admit-signatures {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-top: 10px;
        padding-top: 8px;
        border-top: 1px solid #d8dde3;
    }

    .admit-sign-col {
        flex: 1;
        text-align: center;
        min-height: 42px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }

    .admit-sign-img {
        max-width: 70px;
        max-height: 24px;
        display: block;
        margin: 0 auto 6px;
        object-fit: contain;
    }

    .admit-sign-line {
        width: 92px;
        margin: 0 auto 5px;
        border-top: 1px solid #444;
    }

    .admit-sign-label {
        font-size: 9px;
        color: #333;
    }

    .admit-note {
        margin-top: 6px;
        padding: 5px 7px;
        border: 1px solid #f0df99;
        background: #fff7d7;
        color: #855d00;
        font-size: 9px;
        line-height: 1.35;
        border-radius: 3px;
    }

    .admit-note strong {
        color: #d16b00;
    }

    @@media print {
        .admit-card-item {
            box-shadow: none !important;
            width: calc(50% - 7px) !important;
            min-height: 72mm !important;
        }

        .admit-sheet {
            gap: 10px !important;
        }
    }
</style>
<div class="" style="background-color: white;">
    <div class="row">
        <div class="col-md-12">
            @using (Html.BeginForm("AdmitCardCompact", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
            {
                <div class="row std-mng-head col-md-12">
                    <div class="col-md-12 class-section">
                        <div class="row">
                            <div class="col-md-2 padding">
                                <label class="text-right" style="padding-left: 25px;">@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("MMM, yyyy")</label>
                            </div>
                            <div class="col-md-3 padding">
                                <label class="col-md-4 text-right">Sessions :</label>
                                <div class="col-md-8">
                                    <select name="SessionID" class="form-control" id="ddlSessions" onchange="$('#frmGetStudents').submit();">
                                        <option value="0">--Select Session--</option>
                                        @foreach (var el in Model.Sessions)
                                        {
                                            <option value="@el.SessionID" @(el.SessionID == Model.SessionID ? "selected" : "")>@el.SessionName @(el.SessionStatus == 1 ? "(Active)" : "")</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 padding">
                                <label class="col-md-4 text-right" style="padding-right: 0px;">Class :</label>
                                <div class="col-md-8">
                                    <select class="form-control" name="ClassID" id="ddlClass" onchange="javascript:ClassChanged(this);">
                                        <option value="0">--Select Class--</option>
                                        @foreach (var el in Model.Classes)
                                        {
                                            <option value="@el.ClassID" @(el.ClassID == Model.ClassID ? "selected" : "")>@el.ClassName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 padding">
                                <label class="col-md-4 text-right">Section :</label>
                                <div class="col-md-8">
                                    <select name="SectionID" class="form-control" id="ddlSection" onchange="$('#frmGetStudents').submit();">
                                        <option value="0">--Select Section--</option>
                                        @foreach (var el in Model.Sections)
                                        {
                                            <option value="@el.ID" @(el.ID == Model.SectionID ? "selected" : "")>@el.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 padding">
                                <label class="col-md-4 text-right padding-R">Evaluation : </label>
                                <div class="col-md-8 padding-L" style="padding-left: 10px;">
                                    <select name="EvaluationID" class="form-control" id="ddlEvaluation" onchange="$('#frmGetStudents').submit();">
                                        @foreach (var el in Model.Evaluations)
                                        {
                                            <option value="@el.EvaluationID" @(el.EvaluationID == Model.EvaluationID ? "selected" : "")>@el.EvaluationName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-1 padding">
                                <div class="row">
                                    <div class="col-md-12">
                                        <a href="javascript:void(0);" onclick="$('#frmGetStudents').submit();"><i class="fa fa-search"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <input type="text" class="form-control" id="txtsearch" placeholder="Search Text" onkeyup="Search(this);" />
        </div>
        <div class="col-md-6" style="text-align:right;">
            <button type="button" class="btn btn-primary" onclick="PrintDemantRecipt();"><i class="fa fa-print"></i> Print</button>
        </div>
    </div>
    <div class="row" id="admitcards">
        <div class="admit-sheet">
            @foreach (var d in Model.AdmitCards)
            {
                <div class="admit-card-item listitem">
                    <div class="admit-card-head">
                        @if (!string.IsNullOrWhiteSpace(Model.Branch.Logo))
                        {
                            <img class="admit-school-logo" alt="School Logo" src="@Url.Content("~/Images/SBranchLogo/")@(Model.Branch.SBranchID)_@Model.Branch.Logo" />
                        }
                        <div class="admit-school-head">
                            <div class="admit-school-name">@Model.Branch.BranchSchoolName</div>
                            <div class="admit-school-meta">
                                @if (!string.IsNullOrWhiteSpace(Model.Branch.Address))
                                {
                                    <div>@Html.Raw(Html.Encode(Model.Branch.Address).Replace("\n", "<br />"))</div>
                                }
                                Contact: @Model.Branch.ContactNo
                                @if (!string.IsNullOrWhiteSpace(Model.Branch.EmailID))
                                {
                                    <text> | Email: @Model.Branch.EmailID</text>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="admit-title">Admit Card</div>
                    <div class="admit-subtitle">@d.EvaluationName / @d.SessionName</div>

                    <div class="admit-body">
                        <div class="admit-info">
                            <div class="admit-row">
                                <div class="admit-label">Roll No:</div>
                                <div class="admit-value searchable">@d.RollNo</div>
                            </div>
                            <div class="admit-row">
                                <div class="admit-label">Student Name:</div>
                                <div class="admit-value searchable">@d.Name</div>
                            </div>
                            <div class="admit-row">
                                <div class="admit-label">Father's Name:</div>
                                <div class="admit-value searchable">@d.FatherName</div>
                            </div>
                            <div class="admit-row">
                                <div class="admit-label">Class / Section:</div>
                                <div class="admit-value">@d.ClassName / @d.SectionName</div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(d.SchoolUID))
                            {
                                <div class="admit-row">
                                    <div class="admit-label">Sr. No:</div>
                                    <div class="admit-value">@d.SchoolUID</div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(d.MotherName))
                            {
                                <div class="admit-row">
                                    <div class="admit-label">Mother's Name:</div>
                                    <div class="admit-value searchable">@d.MotherName</div>
                                </div>
                            }
                        </div>
                        <div class="admit-photo-block">
                            <img class="admit-photo" onerror="return OnImageError(this,@(d.Gender));" alt="Student Photo" src="@Url.Content("~/Images/StudentImage/")@(d.StudentID)_@d.Photo" />
                        </div>
                    </div>

                    <div class="admit-signatures">
                        <div class="admit-sign-col">
                            <div class="admit-sign-line"></div>
                            <div class="admit-sign-label">Class Teacher</div>
                        </div>
                        <div class="admit-sign-col">
                            <div class="admit-sign-line"></div>
                            <div class="admit-sign-label">Rechecked By</div>
                        </div>
                        <div class="admit-sign-col">
                            @if (!string.IsNullOrWhiteSpace(Model.Branch.PrincipalSignature))
                            {
                                <img class="admit-sign-img" onerror="return OnImageError(this,2);" alt="Principal Sign" src="@Url.Content("~/Images/SBranchLogo/")@(Model.Branch.SBranchID)_P_@(Model.Branch.PrincipalSignature)" />
                            }
                            <div class="admit-sign-line"></div>
                            <div class="admit-sign-label">Principal Sign</div>
                        </div>
                    </div>

                    <div class="admit-note">
                        <strong>Note:</strong>
                        परीक्षा में सम्मिलित होने के लिए प्रवेश पत्र अपने साथ अवश्य लायें।
                    </div>
                </div>
            }
        </div>
    </div>
</div>
@section scripts
{
    <script>
        function Search(sender) {
            var sText = $(sender).val();
            if (sText == "") {
                $('.listitem').css('display', '');
            }
            else {
                $(".listitem").each(function () {
                    var isExist = false;
                    $(this).find(".searchable").each(function () {
                        if ($(this).html().toLowerCase().includes(sText.toLowerCase()) == true) {
                            isExist = true;
                        }
                    });
                    $(this).css('display', isExist ? '' : 'none');
                });
            }
        }
        function ClassChanged(sender) {
            $('#ddlSection').html('<option value="0">Loading....</option>');
            $.ajax({
                type: "POST",
                url: "/Account/GetSectionOnClass/" + $(sender).val(),
                cache: false,
                processData: false,
                contentType: false,
                success: function (html) {
                    $('#ddlSection').html('');
                    $('#ddlSection').html('<option value="0">--Select Section--</option>');
                    $('#ddlSection').append(html);
                },
                error: function (e) {
                    alert("errorn");
                }
            });
        }
        function PrintDemantRecipt() {
            var contents = $("#admitcards").html();
            var localStyles = document.getElementById("admitCardCompactStyles").outerHTML;
            var frame1 = $('<iframe />');
            frame1[0].name = "frame1";
            frame1.css({ "position": "absolute", "top": "-1000000px" });
            $("body").append(frame1);
            var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
            frameDoc.document.open();
            frameDoc.document.write('<html><head><title></title></head><body>');
            frameDoc.document.write('<link href="@Url.Content("~/css/style.min.css")" rel="stylesheet" type="text/css" />');
            frameDoc.document.write('<link href="@Url.Content("~/css/DemandRecipt.min.css")" rel="stylesheet" type="text/css" />');
            frameDoc.document.write('<link href="@Url.Content("~/css/studentStyle.css")" rel="stylesheet" type="text/css" />');
            frameDoc.document.write(localStyles);
            frameDoc.document.write(contents);
            frameDoc.document.write('</body></html>');
            frameDoc.document.close();
            setTimeout(function () {
                window.frames["frame1"].focus();
                window.frames["frame1"].print();
                frame1.remove();
            }, 1000);
        }
    </script>
}
