            @* ══════════════════════════════════════════════════════
                   TAB 7 — TRANSPORT
                ══════════════════════════════════════════════════════ *@
            @if (!isNew)
            {
                <div id="sdTab-transport" class="sd-panel @(Model.CurrentTab == 7 ? "active" : "")">
                    <div class="sd-toolbar">
                        <span class="sd-toolbar-meta">
                            Transport allocation history
                            @if (Model.THADDetails.Any())
                            {
                                <span style="margin-left:6px">· @Model.THADDetails.Count() record(s)</span>
                            }
                        </span>
                        <button type="button" class="sd-btn sd-btn-outline sd-btn-sm"
                                onclick="sdOpenTransport(@Model.Student.StudentID, 0)">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                <path d="M6 2v8M2 6h8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                            </svg>
                            Add New
                        </button>
                    </div>

                    @if (Model.THADDetails.Any())
                    {
                        @* Table view for transport history *@
                        <table class="sd-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Stop Name</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int tIdx = 1; }
                                @foreach (var t in Model.THADDetails)
                                {
                                    <tr>
                                        <td style="color:var(--gray-400);font-size:12px">@tIdx</td>
                                        <td>
                                            <div style="display:flex;align-items:center;gap:8px">
                                                <div class="sd-transport-bus" style="width:30px;height:30px;flex-shrink:0">
                                                    <svg viewBox="0 0 18 18" fill="none" style="width:16px;height:16px">
                                                        <rect x="1" y="5" width="16" height="9" rx="2" stroke="currentColor" stroke-width="1.3" />
                                                        <circle cx="4.5" cy="14.5" r="1.5" stroke="currentColor" stroke-width="1.3" />
                                                        <circle cx="13.5" cy="14.5" r="1.5" stroke="currentColor" stroke-width="1.3" />
                                                        <path d="M1 9h16M6 5V3M12 5V3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                                                    </svg>
                                                </div>
                                                <span style="font-weight:500">@t.Name</span>
                                            </div>
                                        </td>
                                        <td>@t.StartDate.ToString("dd MMM, yyyy")</td>
                                        <td>
                                            @if (t.EndDate.Year == 1)
                                            {<span class="sd-chip sd-chip-active">Continued</span> }
                                            else
                                            { @t.EndDate.ToString("dd MMM, yyyy")}
                                        </td>
                                        <td>
                                            @if (t.EndDate.Year == 1)
                                            {<span class="sd-chip sd-chip-active">Active</span> }
                                            else
                                            { <span class="sd-chip sd-chip-inactive">Ended</span>}
                                        </td>
                                        <td>
                                            <div class="sd-act-group">
                                                <a class="sd-act sd-act-edit"
                                                   onclick="sdOpenTransport(@Model.Student.StudentID, @t.THChangeID)">Edit</a>
                                                @using (Html.BeginForm("SaveStudentTransport", "Account", FormMethod.Post,
                                                        new { id = "frmTrans_" + t.THChangeID }))
                                                {
                                                    <input type="hidden" name="UserID" value="@Model.Student.StudentID" />
                                                    <input type="hidden" name="THChangeID" value="@t.THChangeID" />
                                                    <input type="hidden" name="OpType" value="-1" />
                                                    <a class="sd-act sd-act-del"
                                                       onclick="sdConfirmDelete(document.getElementById('frmTrans_@t.THChangeID'))">Remove</a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    tIdx++;
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="sd-alert sd-alert-info">
                            <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
                                <circle cx="7.5" cy="7.5" r="6" stroke="currentColor" stroke-width="1.3" />
                                <path d="M7.5 7v4M7.5 5v.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                            </svg>
                            No transport history found. Click "Add New" to assign a stop.
                        </div>
                    }
                </div>
            }

            @* ══════════════════════════════════════════════════════
                   TAB 8 — HOSTEL
                ══════════════════════════════════════════════════════ *@
            @if (!isNew && Model.Hostel.Hostels != null)
            {
                using (Html.BeginForm("SaveStudentHostel", "Account", FormMethod.Post,
                        new { role = "form", enctype = "multipart/form-data", id = "frmHostel" }))
                {
                    <input type="hidden" name="StudentID" value="@Model.Student.StudentID" />

                    <div id="sdTab-hostel" class="sd-panel @(Model.CurrentTab == 8 ? "active" : "")">
                        <div class="sd-grid-3" style="margin-bottom:1.25rem">
                            <div class="sd-field">
                                <label>Hostel</label>
                                <select class="sd-select" id="sdHostelSelect" onchange="sdHostelChanged(this)">
                                    @foreach (var h in Model.Hostel.Hostels)
                                    {
                                        <option value="@h.ID" @(h.ID == Model.Hostel.HostelID ? "selected" : "")>@h.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="sd-field">
                                <label>Floor</label>
                                <select class="sd-select" id="sdHostelFloors" onchange="sdHostelFloorChanged(this)">
                                    @foreach (var f in Model.Hostel.Floors)
                                    {
                                        <option value="@f.ID" @(f.ID == Model.Hostel.FloorID ? "selected" : "")>@f.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="sd-field">
                                <label>Applicable</label>
                                <div class="sd-gender-toggle" style="margin-top:0">
                                    <button type="button"
                                            class="sd-gender-opt @(Model.Hostel.Applicable == 1 ? "male" : "")"
                                            onclick="$('#hdnHostelApplicable').val(1);$(this).addClass('male').siblings().removeClass('male female')">
                                        Yes
                                    </button>
                                    <button type="button"
                                            class="sd-gender-opt @(Model.Hostel.Applicable != 1 ? "female" : "")"
                                            onclick="$('#hdnHostelApplicable').val(0);$(this).addClass('female').siblings().removeClass('male female')">
                                        No
                                    </button>
                                </div>
                                <input type="hidden" id="hdnHostelApplicable" name="Applicable" value="@Model.Hostel.Applicable" />
                            </div>
                        </div>

                        <table class="sd-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Room</th>
                                    <th>Type</th>
                                    <th>Room No.</th>
                                    <th>Capacity</th>
                                    <th>Occupants</th>
                                    <th>Rate</th>
                                    <th>Select</th>
                                </tr>
                            </thead>
                            <tbody id="sdHostelRoomsBody">
                                @Html.Partial("_HostelRoomsPartial", Model.Hostel)
                            </tbody>
                        </table>

                        <div class="sd-form-footer">
                            <button type="submit" class="sd-btn sd-btn-primary" onclick="sdSaveStart(this)">
                                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                    <path d="M2 7l3.5 3.5L12 3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Save Hostel Details
                            </button>
                        </div>
                    </div>
                }
            }

            @* ══════════════════════════════════════════════════════
                   TAB 9 — CUSTOM FEE
                ══════════════════════════════════════════════════════ *@
            @if (!isNew && canEditCustomFee)
            {
                <div id="sdTab-fee" class="sd-panel @(Model.CurrentTab == 9 ? "active" : "")">
                    <div class="sd-grid-2" style="margin-bottom:1.4rem">
                        <div class="sd-field">
                            <label>Student Session</label>
                            <select class="sd-select" id="ddlCFSessions" onchange="sdFeeSessionChange(this)">
                                @foreach (var s in Model.Sessions)
                                {
                                    <option value="@s.StudentSessionUID">
                                        @s.SessionName — @s.ClassName / @s.SectionName
                                        (@s.FromDate.ToString("dd MMM, yyyy") to @s.ToDate.ToString("dd MMM, yyyy"))
                                        (@(s.Status == 0 ? "Inactive" : "Active"))
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    @using (Html.BeginForm("SaveStudentCustomeFee", "Account", FormMethod.Post,
                            new { role = "form", enctype = "multipart/form-data", id = "frmStudentCustomFees" }))
                    {
                        <div id="sdCustomFeeBody">
                            @if (Model.Sessions.Any())
                            {
                                @Html.Partial("_StudentCustomFeeEditPartial", Model)
                            }
                            else
                            {
                                <div class="sd-alert sd-alert-info">
                                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
                                        <circle cx="7.5" cy="7.5" r="6" stroke="currentColor" stroke-width="1.3" />
                                        <path d="M7.5 7v4M7.5 5v.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                                    </svg>
                                    No session assigned to this student.
                                </div>
                            }
                        </div>
                    }
                </div>
            }

        </div>@* /sd-tab-body *@
    </div>@* /sd-card *@
</div>@* /sd-wrap *@


@* ════════════════════════════════════════
       MODALS
    ════════════════════════════════════════ *@
<div id="sdTransportModal" class="modal fade bs-example-modal-lg" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Transport Details</h4>
            </div>
            <div class="modal-body">
                <div class="sd-modal-loader"></div>
                <div class="sd-modal-content"></div>
            </div>
        </div>
    </div>
</div>

@* Keep id="mdlEditSession" so _SessionListPartial can still reference it *@
<div id="mdlEditSession" class="modal fade bs-example-modal-lg" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Session Details</h4>
            </div>
            <div class="modal-body">
                <div class="sd-modal-loader"></div>
                <div class="sd-modal-content container"></div>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <script src="@Url.Content("~/js/moment.min.js")"></script>
    <script src="@Url.Content("~/js/daterangepicker.js")"></script>
    <script src="@Url.Content("~/js/select2.full.min.js")"></script>
    <script src="@Url.Content("~/js/student.js")"></script>
    <script>
        /*  Global student ID — used by AddSession / EditSession
            which are called from _SessionListPartial          */
        var _sdStudentId = @Model.Student.StudentID;
    </script>
}
