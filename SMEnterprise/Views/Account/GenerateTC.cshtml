

@{
    ViewBag.Title = "GenerateTC";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@section IncludeCss
{
    <title>Student List</title>
    <link rel="stylesheet" href="@Url.Content("~/css/custom.css")">
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
}
@model SMEnterprise.Models.TCDetailsModel
<!-- Content Header (Page header) -->
<div class="row std-mng-head">
    <div class="col-md-12 class-section">
        <div class="row">
            <div class="col-md-12">
                Generate TC
                <small>Student panel</small>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<div class="">
    <!-- Small boxes (Stat box) -->
    <div class="x_panel">
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success alert-dismissible">
                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                <h4><i class="icon fa fa-check"></i> Success!</h4>
                TC Details for the Student is updated Successfully.
            </div>
        }
        <div class="x_panel" id="divEditFormDetails">
            <div class="x_title">
                <h3 class="">Student Details</h3>
            </div>
            <div class="x_content">
                <div class="col-md-2">
                    <div class="form-group">
                        <span>Student Name</span><br />
                        <label>@Model.StudentDetails.Name</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <span>Father Name</span><br />
                        <label>@Model.StudentDetails.FatherName</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <span>Mother Name</span><br />
                        <label>@Model.StudentDetails.MotherName</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <span>Nationality</span><br />
                        <label>@Model.StudentDetails.NationalityText</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <span>DOB</span><br />
                        <label>@Model.StudentDetails.DOB.ToString("dd MMM, yyyy")</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <span>Class</span><br />
                        <label>@Model.StudentDetails.ClassName</label>
                    </div>
                </div>
            </div>
        </div>
        @using (Html.BeginForm("GenerateTC", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "UpdateBranch" }))
        {
            <div class="x_panel" id="divEditFormDetails">
                <div class="x_title">
                    <h3 class="box-title">TC Details</h3>
                    <input type="hidden" name="TCDetails.TCID" value="@Model.TCDetails.TCID" />
                    <input type="hidden" name="StudentID" value="@Model.StudentID" />
                    <input type="hidden" name="SessionID" value="@Model.SessionID" />
                    <input type="hidden" name="TCDetails.StudentID" value="@Model.StudentID" />
                    <input type="hidden" name="TCDetails.SessionID" value="@Model.SessionID" />
                </div>
                <div class="x_content">
                    <div class="row">
                        <div class="x_panel" style="border-bottom: 1px solid green;">
                            <div class="x_title">
                                <h3 class="box-title">School/Board Annual Examination Last Taken</h3>
                            </div>
                            <div class="x_content">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Exam Name</label>

                                        <input type="text" name="TCDetails.SCBLastExamName" class="form-control" value="@Model.TCDetails.SCBLastExamName" />

                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Examination Result</label>

                                        <input type="text" name="TCDetails.SCBLastExamResult" class="form-control" value="@Model.TCDetails.SCBLastExamResult" />

                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Failed Count</label>

                                        <input type="number" name="TCDetails.FailedCount" class="form-control" value="@Model.TCDetails.FailedCount" />

                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Is Promotion</label>
                                        <label class="switch switch-green">
                                            @if (Model.TCDetails.IsSCBLastExamPassed == 1)
                                            {
                                                <input type="checkbox" class="switch-input" Checked>
                                            }
                                            else
                                            {
                                                <input type="checkbox" class="switch-input">
                                            }
                                            <span class="switch-label" onclick='$(this).closest("label").find("#hdnExamResultStatus").val($(this).closest("label").find("#hdnExamResultStatus").val() == "0" ? "1" : "0");' data-on="Yes" data-off="No"></span>
                                            <span class="switch-handle" id="shTranding"></span>
                                            <input type="hidden" id="hdnExamResultStatus" name="TCDetails.IsSCBLastExamPassed" value="@Model.TCDetails.IsSCBLastExamPassed" />
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Promoted Class</label>
                                        <select class="form-control" name="TCDetails.PromotedToClass">
                                            @foreach (var c in Model.Classes)
                                            {
                                                <option value="@c.ClassID" @(Model.TCDetails.PromotedToClass == c.ClassID ? "selected" : "")>@c.ClassName</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!-- /.box-body -->
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label>No. of Working Days</label>

                                <input type="number" step="1" name="TCDetails.WorkingDays" class="form-control" value="@Model.TCDetails.WorkingDays" />

                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>No. of Days Present</label>

                                <input type="number" step="1" name="TCDetails.PresentDays" class="form-control" value="@Model.TCDetails.PresentDays" />

                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>Is NCC Cadet</label>

                                <label class="switch switch-green">
                                    @if (Model.TCDetails.IsNCC == 1)
                                    {
                                        <input type="checkbox" class="switch-input" Checked>
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="switch-input">
                                    }
                                    <span class="switch-label" onclick='$(this).closest("label").find("#hdnIsNCC").val($(this).closest("label").find("#hdnIsNCC").val() == "0" ? "1" : "0");' data-on="Yes" data-off="No"></span>
                                    <span class="switch-handle" id="shTranding"></span>
                                    <input type="hidden" id="hdnIsNCC" name="TCDetails.IsNCC" value="@Model.TCDetails.IsNCC" />
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>NCC Details</label>
                                <input type="text" name="TCDetails.NCCDetails" class="form-control" value="@Model.TCDetails.NCCDetails" />

                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Month till school dues paid</label>

                                <input type="text" name="TCDetails.DuePaidMonth" class="form-control" value="@Model.TCDetails.DuePaidMonth" />

                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Nature of availed concession</label>

                                <input type="text" name="TCDetails.Concession" class="form-control" value="@Model.TCDetails.Concession" />

                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Date of application for certificate</label>

                                <input type="date" name="TCDetails.DateOfApplication" class="form-control" value="@Model.TCDetails.DateOfApplication.ToString("yyyy-MM-dd")" />

                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Date of issue of certificate</label>

                                <input type="date" name="TCDetails.DateOfIssue" class="form-control" value="@Model.TCDetails.DateOfIssue.ToString("yyyy-MM-dd")" />

                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Games Played Achievement</label>

                                <input type="text" name="TCDetails.Games" class="form-control" value="@Model.TCDetails.Games" />

                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>General Conduct</label>

                                <input type="text" name="TCDetails.GeneralConduct" class="form-control" value="@Model.TCDetails.GeneralConduct" />

                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Reasons for leaving the school</label>
                                <textarea rows="2" style="resize:none;" name="TCDetails.ReasonForLeaving" class="form-control">@Model.TCDetails.ReasonForLeaving</textarea>

                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Any other remarks</label>
                                <textarea rows="2" style="resize:none;" name="TCDetails.Remarks" class="form-control">@Model.TCDetails.Remarks</textarea>
                            </div>
                        </div>

                        <hr />
                        <div class="">
                            <div class="col-md-12">
                                <button type="submit" class="btn btn-info pull-right">Save</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>
</div>