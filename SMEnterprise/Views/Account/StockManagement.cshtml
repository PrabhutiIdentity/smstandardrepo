        function PrintPaymentReciept(sender, PayID, PaymentReceiptID) {
            if ($(sender).hasClass('ClosedPayment')) {
                $(sender)
                    .closest("tr")
                    .after("<tr><td id='tdDetails' colspan = '999' style='border-left: 3px solid #5a9e6f;font-size: 30px;text-align: -webkit-center;'> Loading.... </td></tr>");
                var ele = document.getElementsByClassName("OpenPayment");
                if (ele.length > 0) {
                    $(ele[0]).click();
                }
                $.ajax(
                    {
                        type: "POST",
                        url: "/Account/GetSaleTransactionPaymentReceiptData/" + PayID + "?paymentId=" + (PaymentReceiptID || 0),
                        cache: false,
                        processData: false,
                        contentType: false,
                        success: function (html) {
                            $(sender).closest("tr").next().remove();
                            $(sender)
                                .closest("tr")
                                .after("<tr><td id='tdDetails' colspan = '999' style='border-left: 3px solid #5a9e6f;background-color: white'>" + html + "</td></tr>");
                            $(sender).text('Close');
                            $(sender).removeClass('ClosedPayment');
                            $(sender).addClass('OpenPayment');
                        },
                        error: function (e) {
                            alert("errorn");
                        }
                    });
            }
            else {
                $(sender).text('Print');
                $(sender).removeClass('OpenPayment');
                $(sender).addClass('ClosedPayment');
                $(sender).closest("tr").next().remove();
            }
        }

