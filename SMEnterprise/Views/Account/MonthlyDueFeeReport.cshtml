
@{

    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    string[] MonthNames = { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
    var feeTypeCount = Model.FeeTypeSummery.Count();
    var studentSessionStartDate = Model.StudentList
        .Where(student => student.SessionStartDate.Year > 1)
        .Select(student => student.SessionStartDate)
        .OrderBy(date => date)
        .FirstOrDefault();
    var effectiveSessionStartDate = Model.SessionStartDate.Year > 1
        ? Model.SessionStartDate
        : studentSessionStartDate;
    var sessionStartMonth = effectiveSessionStartDate.Year > 1
        ? effectiveSessionStartDate.Month
        : 1;
    var reportMonths = Enumerable.Range(0, 12)
        .Select(offset => ((sessionStartMonth - 1 + offset) % 12) + 1)
        .ToList();
}
@section IncludeCss
    {
    <title> Class and Section wise Due Fee Report </title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    <link href="@Url.Content("~/css/DemandRecipt.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/style.min.css")" rel="stylesheet" />
    <style>
        .monthly-due-table-wrap {
            max-height: calc(100vh - 190px);
            overflow: auto;
        }

        #tblCategory thead th {
            position: sticky;
            background: #fff;
            z-index: 3;
        }

        #tblCategory thead tr:first-child th {
            top: 0;
        }

        #tblCategory thead tr:nth-child(2) th {
            top: 37px;
        }

        #tblCategory thead th[rowspan="2"] {
            z-index: 4;
        }

        #tblCategory .sticky-number,
        #tblCategory .sticky-student,
        #tblCategory .sticky-fee-type {
            position: sticky;
            background: #fff;
            background-clip: padding-box;
        }

        #tblCategory .sticky-number {
            left: 0;
            min-width: 44px;
            width: 44px;
            z-index: 5;
        }

        #tblCategory .sticky-student {
            left: 44px;
            min-width: 135px;
            width: 135px;
            z-index: 5;
        }

        #tblCategory .sticky-fee-type {
            left: 179px;
            min-width: 90px;
            width: 90px;
            z-index: 5;
            box-shadow: 2px 0 2px rgba(0, 0, 0, .08);
        }

        #tblCategory thead .sticky-number,
        #tblCategory thead .sticky-student,
        #tblCategory thead .sticky-fee-type {
            z-index: 7;
        }

        @@media print {
            .monthly-due-table-wrap {
                max-height: none;
                overflow: visible;
            }

            #tblCategory thead {
                display: table-header-group;
            }

            #tblCategory thead th {
                position: static;
            }

            #tblCategory .sticky-number,
            #tblCategory .sticky-student,
            #tblCategory .sticky-fee-type {
                position: static;
            }
        }
    </style>
}@using SMEnterprise.Models;
@model SMEnterprise.Models.FeePaymentModel
<div class="" style="background-color: white;">
    <div class="row">
        <div class="col-md-12">
            @using (Html.BeginForm("MonthlyDueFeeReport", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetStudents" }))
            {
                <div class="row std-mng-head col-md-12">

                    <div class="col-md-12 class-section">
                        <div class="row">
                            <div class="col-md-2 padding">
                                <input type="month" value="@Model.DemandMonth.ToString("yyyy-MM")" name="DemandMonth" id="dtDate" class="form-control" />
                                @*<label class="text-right" style="padding-left: 25px;">@SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("MMM, yyyy")</label>*@
                            </div>
                            <div class="col-md-3 padding">
                                <label class="col-md-4 text-right" style="padding-right: 0px;">Class :</label>
                                <div class="col-md-8">
                                    <select class="form-control" name="ClassID" id="ddlClass" onchange="javascript:ClassChanged(this);">
                                        @*<option value="-1">--All Class--</option>*@
                                        <option value="0">--Select Class--</option>
                                        @foreach (SMEnterprise.Models.NameIDModel el in Model.Classes)
                                        {
                                            <option value="@el.ID" @(el.ID == Model.ClassID ? "selected" : "")>@el.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 padding">
                                <label class="col-md-4 text-right">Section :</label>
                                <div class="col-md-8">
                                    <select name="SectionID" class="form-control" id="ddlSection">
                                        <option value="0">--Select Section--</option>
                                        @foreach (SMEnterprise.Models.NameIDModel el in Model.Sections)
                                        {
                                            <option value="@el.ID" @(el.ID == Model.SectionID ? "selected" : "")>@el.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 padding">
                                <label class="col-md-4 text-right">Sessions :</label>
                                <div class="col-md-8">
                                    <select name="SessionID" class="form-control" id="ddlSessions">
                                        <option value="0">--Select Session--</option>
                                        @foreach (SMEnterprise.Models.NameIDModel el in Model.Sessions)
                                        {
                                            <option value="@el.ID" @(el.ID == Model.SessionID ? "selected" : "")>@el.Name @(el.Extra1 == "1" ? "(Active)" : "")</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-1 padding">
                                <div class="row">

                                    <div class="col-md-12">
                                        <a href="javascript:void(0);" onclick="$('#frmGetStudents').submit();"><i class="fa fa-search"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="row">
        <div class="col-md-2"></div>
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-addon"><i class="fa fa-search"></i></span>
                <input type="search"
                       id="txtStudentFeeSearch"
                       class="form-control"
                       placeholder="Search student, SR, roll no, father or mother" />
            </div>
        </div>
        <div class="col-md-5" style="text-align:right;">
            <button type="button" class="export-btn btn-primary" onclick="tableToExcel('tblCategory', 'Monthly Due Fee Report');"><i class="fa fa-file-excel-o"></i> Export To Excel</button>
        </div>
    </div>

    <div class="x_panel monthly-due-table-wrap">
        <table id="tblCategory" class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th rowspan="2" class="sticky-number">#</th>
                    <th rowspan="2" class="sticky-student">Student</th>
                    <th rowspan="2" class="sticky-fee-type">Fee Type</th>
                    @foreach (var monthNumber in reportMonths)
                    {
                        <th colspan="4">
                            @MonthNames[monthNumber - 1]
                        </th>
                    }
                </tr>
                <tr>
                    @foreach (var monthNumber in reportMonths)
                    {
                        <th>Amount </th>
                        <th>Discount</th>
                        <th>Paid</th>
                        <th>Balance</th>
                    }
                </tr>

            </thead>
            <tbody>
                @{
                    var counter = 1;
                    foreach (var student in Model.StudentList)
                    {
                        var studentSearchText = string.Join(" ", new[]
                        {
                            student.Name,
                            student.StudentSID,
                            student.SchoolUID,
                            student.RollNo,
                            student.FatherName,
                            student.MotherName
                        }.Where(value => !string.IsNullOrWhiteSpace(value))).ToLowerInvariant();
                        <tr class="student-fee-group student-fee-summary"
                            data-student-key="@student.StudentID"
                            data-search="@studentSearchText">
                            <td rowspan="@(feeTypeCount + 2)" class="sticky-number">@counter</td>
                            <td rowspan="@(feeTypeCount + 2)" class="sticky-student">
                                @student.Name<br />
                                @student.StudentSID<br />
                               SR: @student.SchoolUID<br />
                              Roll No:  @student.RollNo<br />
                               F: @student.FatherName<br />
                              M:  @student.MotherName
                            </td>
                        </tr>
                        foreach (var ft in Model.FeeTypeSummery)
                        {
                            <tr class="student-fee-group" data-student-key="@student.StudentID">
                                <td class="sticky-fee-type">@ft.FeeTypeName</td>
                                @foreach (var monthNumber in reportMonths)
                                {
                                    var feedetails = Model.FeeListDetail.FirstOrDefault(x => x.FeeTypeID == ft.FeeTypeID && x.StudentID == student.StudentID && x.FeeMonth == monthNumber);
                                    if (feedetails != null)
                                    {
                                        <td>@feedetails.FeeAmount.ToString("N2")</td>
                                        <td>@feedetails.RDiscount.ToString("N2")</td>
                                        <td>@feedetails.PaidAmount.ToString("N2")</td>
                                        <td>@((feedetails.FeeAmount - feedetails.RDiscount - feedetails.PaidAmount).ToString("N2"))</td>
                                    }
                                    else
                                    {
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                    }
                                }
                            </tr>
                        }
                        <tr class="student-fee-group" data-student-key="@student.StudentID" style="font-weight: 800;">
                            <td class="sticky-fee-type">Total</td>
                            @foreach (var monthNumber in reportMonths)
                            {
                                var feedetails = Model.FeeListDetail.Where(x => x.StudentID == student.StudentID && x.FeeMonth == monthNumber).ToList();
                                if (feedetails.Any())
                                {
                                    <td>@feedetails.Sum(x => x.FeeAmount).ToString("N2")</td>
                                    <td>@feedetails.Sum(x => x.RDiscount).ToString("N2")</td>
                                    <td>@feedetails.Sum(x => x.PaidAmount).ToString("N2")</td>
                                    <td>@feedetails.Sum(x => x.FeeAmount - x.RDiscount - x.PaidAmount).ToString("N2")</td>
                                }
                                                        else
                                                        {
                                    <td>-</td>
                                    <td>-</td>
                                    <td>-</td>
                                    <td>-</td>
                                                        }
                                                    }
                        </tr>
                        counter++;
                                                }
                                            }
            </tbody>
        </table>
    </div>

</div>
@section scripts
{
    <script src="@Url.Content("~/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.bootstrap.min.js")"></script>

    <script src="@Url.Content("~/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("~/js/buttons.print.min.js")"></script>

    <script src="@Url.Content("~/js/jszip.min.js")"></script>
    <script src="@Url.Content("~/js/pdfmake.min.js")"></script>
    <script src="@Url.Content("~/js/vfs_fonts.js")"></script>

    <script type="text/javascript">
        var tableToExcel = (function () {
            var uri = 'data:application/vnd.ms-excel;base64,'
                , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--><meta http-equiv="content-type" content="text/plain; charset=UTF-8"/></head><body><table>{table}</table></body></html>'
                , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
                , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
            return function (table, name) {
                                            if (!table.nodeType) table = document.getElementById(table)
                var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
                                        window.location.href = uri + base64(format(template, ctx))
            }
        })()
    </script>
    <script>
        $(document).ready(function () {
            $('#txtStudentFeeSearch').on('input', function () {
                var searchText = ($(this).val() || '').toLowerCase().trim();

                $('.student-fee-summary').each(function () {
                    var studentKey = $(this).attr('data-student-key');
                    var studentText = ($(this).attr('data-search') || '').toLowerCase();
                    var isMatch = searchText === '' || studentText.indexOf(searchText) !== -1;

                    $('.student-fee-group[data-student-key="' + studentKey + '"]')
                        .toggle(isMatch);
                });
            });

                                        var printdate='Print Date: @SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dd/MM/yyyy")';
                                        //var repname =   + ' Class:' + $('#ddlClass option:selected').text() + ' / '+ $('#ddlSection option:selected').text()+' Due Fee Report'
                                        var handleDataTableButtons = function () {
                                            if ($("#tblCategory").length) {
                    $("#tblCategory").DataTable({
                                                    "pageLength": 40,

                        bSort: true,
                        dom: "Bfrtip",
                        buttons: [
                           {
                                                    extend: "copy",
                                className: "btn-sm",
                                text: '<i class="far fa-copy"></i> Copy',
                                message: printdate,
                                title: repname
                            },
                            {
                                                    extend: "csv",
                                 className: "btn-sm",

                                @*className: "btn-sm",*@
                                text: '<i class="fas fa-file-csv"></i> CSV',
                                message: printdate,
                                title: repname
                            },
                            {
                                extend: "excel",
                                className: "btn-sm",
                                text: '<i class=""fa fa-table fainfo" aria-hidden="true""></i> Excel',
                                message: printdate,
                                title: repname
                            },
                            {
                                extend: "pdfHtml5",
                                className: "btn btn-dark rounded-0",
                                text: '<i class="fa fa-file-pdf-o"></i> Pdf',
                                message: printdate,
                                title: repname
                            },
                            {
                                 extend: "print",
                                 className: "btn btn-dark rounded-0",
                                 text: '<i class="fa fa-print"></i> Print',
                                 message: printdate,
                                 title: repname

                            },
                        ],
                        responsive: true
                    });
                }
            };
            TableManageButtons = function () {
                "use strict";
                return {
                    init: function () {
                        handleDataTableButtons();
                    }
                };
            }();
            TableManageButtons.init();

        });
    </script>
    <script>
        //$(function () {
        //    $("#tblCategory").DataTable();
        //    "pageLength": 20
        //});
        function ClassChanged(sender) {
            $('#ddlSection').html('<option value="0">Loading....</option>');
            $.ajax(
    {
        type: "POST",
        url: "/Admin/GetSectionOnClass/" + $(sender).val(),
        cache: false,
        processData: false,
        contentType: false,
        success: function (html) {
            $('#ddlSection').html('');
            $('#ddlSection').html('<option value="0">--Select Section--</option>');
            $('#ddlSection').append(html);
        },
        error: function (e) {
            alert("errorn");
        }
    });
        }
        function PrintDemantRecipt() {
            var contents = $(".x_content").html();
            var frame1 = $('<iframe />');
            frame1[0].name = "frame1";
            frame1.css({ "position": "absolute", "top": "-1000000px" });
            $("body").append(frame1);
            var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
            frameDoc.document.open();
            //Create a new HTML document.
            frameDoc.document.write('<html><head><title></title>');
            frameDoc.document.write('</head><body>');
            frameDoc.document.write('<link href="@Url.Content("~/css/style.min.css")" rel="stylesheet" type="text/css" />');
            frameDoc.document.write('<link href="@Url.Content("~/css/DemandRecipt.min.css")" rel="stylesheet" type="text/css" />');

            //Append the external CSS file.
            //Append the DIV contents.
            frameDoc.document.write(contents);
            frameDoc.document.write('</body></html>');
            frameDoc.document.close();
            setTimeout(function () {
                window.frames["frame1"].focus();
                window.frames["frame1"].print();
                frame1.remove();
            }, 1000);
        }
    </script>
}
