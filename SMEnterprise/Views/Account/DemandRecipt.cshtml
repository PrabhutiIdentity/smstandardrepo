        <div class="dr-wrapper">
            @{
                var receipts = Model.Recipts.ToList();
                int total = receipts.Count;

                for (int r = 0; r < total; r += 2)
                {
                    // Cut line before each row (except first)
                    if (r > 0)
                    {
                        <div class="dr-cut-line">
                            <span class="scissors">&#9986;</span>
                            <div class="dash"></div>
                            <span class="scissors">&#9986;</span>
                        </div>
                    }

                    bool isLastRow = (r + 2 >= total);
                    bool hasSecond = (r + 1 < total);

                    <div class="dr-row @(isLastRow && r % 8 == 0 ? "" : "")">
                        @{
                            // Left card
