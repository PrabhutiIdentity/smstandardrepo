@model SMEnterprise.Models.FeeRefundPrintModel

<div>
    <button class="btn btn-info" onclick="PrintRecipt()">Print</button>
</div>
<div id="divRecipt">
    <div class="wrapper">
        <div class="header-1">
            <div class="col-2">
                <div class="logo-img">
                    <img src="@Url.Content("~/Images/SBranchLogo/")@(Model.SBranchDetails.SBranchID)_@(Model.SBranchDetails.Logo)" />
                </div>
            </div>
            <div class="col-1">
                <h1>@Model.SBranchDetails.BranchSchoolName <br /><ad style="font-size:21px!important;"> @Html.Raw(Model.SBranchDetails.Address == null ? "" : Model.SBranchDetails.Address.Replace("\n", "<br/>"))</ad></h1>
            </div>
        </div>

        <div class="header-1">
            <div class="col-1" style="text-align:center;">
                <div>
                    <b>Fee Refund For Session @Model.RefundDetails.SectionName </b>
                </div>
            </div>
        </div>
        <div class="header-1">
            <div class="col-2" style="text-align:left;">
                <div>
                    Receipt No :  @Model.RefundDetails.RefundID
                </div>
            </div>
            <div class="col-4" style="text-align:right">
                Date : @Model.RefundDetails.RefundDate.ToString("dd/MM/yyyy")
            </div>
        </div>

        <div class="form-name">

            <div class="row form-box name">
                <label class="col-sm-2">Name : </label>
                <div class="col-sm-10">@Model.RefundDetails.RefundName</div>
            </div>

            <div class="row form-box name">
                <label class="col-sm-2">Father : </label>
                <div class="col-sm-10">@Model.RefundDetails.FatherName</div>
            </div>
            <div class="row form-box class">
                <div class="col-sm-4">
                    <div class="row f-sec">
                        <label class="col-sm-6">Class : </label>
                        <div class="col-sm-6">@(Model.RefundDetails.ClassName)</div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="row f-sec">
                        <label class="col-sm-6">Sr. No : </label>
                        <div class="col-sm-6">@Model.RefundDetails.SchoolUID</div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="row f-sec">
                        <label class="col-sm-6">Section : </label>
                        <div class="col-sm-6">@(Model.RefundDetails.SectionName)</div>
                    </div>
                </div>
            </div>
            <div class="row form-box roll">
                <div class="col-sm-6">
                    <div class="row f-sec">
                        <label class="col-sm-4">Reg.No : </label>
                        <div class="col-sm-8">@Model.RefundDetails.StudentSID</div>
                    </div>
                </div>
                @*<div class="col-sm-6">
                        <div class="row f-sec">
                            <label class="col-sm-4">Date : </label>
                            <div class="col-sm-8">@Model.PaymentDate.ToString("dd MMM, yyyy")</div>
                        </div>
                    </div>*@

            </div>
        </div>
        <div class="fee-table">

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Details</th>
                        <th style="width:20%">Amount (Rs.)</th>
                    </tr>
                </thead>
                @{
                    <tbody>
                        <tr>
                            <td>@Model.RefundDetails.Reason</td>
                            <td>@Model.RefundDetails.RefundAmount.ToString("0.00")</td>
                        </tr>
                    </tbody>
                    <tbody>
                        <tr>
                            <td colspan="2">Total Refund : <b>@SMEnterprise.Repository.CommonUsage.ConvertNumbertoWords((long)Model.RefundDetails.RefundAmount)</b> Rupees Only</td>
                        </tr>
                    </tbody>
                }
            </table>
        </div>
        <div class="row bottom-sec">
            <div class="col-sm-5 principle" style="font-size: 16px;">For @Model.SBranchDetails.BranchSchoolName </div>
        </div>
    </div>
</div>