@using SMEnterprise.Models;
@using System.Web.Mvc;
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    TempData["EmployeeSalaryRedirectDate"] = null;
}
@model SMEnterprise.Models.EmployeeSalaryListPageModel
@section IncludeCss
{
    <title>Employee Salary Management</title>
    <link rel="stylesheet" href="@Url.Content("~/css/studentStyle.css")">
    
}
<style>
    .btn {
        padding: 3px 6px;
    }

    .thumbImageGrid {
        max-width: 75px;
        max-height: 75px;
    }


    *html1 .thumbImageGrid {
        width: expression((this.width/this.height)>=1?75:'auto');
        height: expression((this.width/this.height)<1?100:'auto');
    }

    .thumbImageMain {
        max-width: 125px;
        max-height: 125px;
    }


    *html .thumbImageMain {
        width: expression((this.width/this.height)>=1?125:'auto');
        height: expression((this.width/this.height)<1?125:'auto');
    }

    #tblCategory > tbody > tr > td {
        vertical-align: middle;
    }

    #frmGetStudents .row {
        min-height: 10px !important;
    }
</style>
<div class="">

    <div class="clearfix"></div>
    <div class="">

        <div class="clearfix"></div>
        <div class="row">
            @if (TempData["SMPID"] != null)
            {
                <div class="col-md-12">
                    <div class="alert alert-success alert-dismissible " role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                        <strong>Salary Processed</strong> successfully, <a href="javascript:void(0);" onclick='PrintSalarySlipModel(@TempData["SMPID"])'>Click Here</a> to print Salary Slip.
                    </div>
                </div>
                TempData["SMPID"] = null;
            }
            <div class="col-md-12">
                @using (Html.BeginForm("EmployeeSalary", "Account", FormMethod.Post, new { role = "form", enctype = "multipart/form-data", @ID = "frmGetEmployees" }))
                {
                    <div class="row std-mng-head">

                        <div class="col-md-12 class-section">
                            <div class="row">

                                <div class="col-md-6 padding">
                                    <label class="col-md-4 text-right">Employee Type :</label>
                                    <div class="col-md-8">
                                        <select class="form-control" name="EmployeeTypeID" id="ddlClass">
                                            <option value="-1" @(0 == Model.EmployeeTypeID ? "selected" : "")>Please Select Employee</option>
                                            @*<option value="-2" @(-2 == Model.EmployeeTypeID ? "selected" : "")>Conductor</option>*@
                                            @foreach (EmployeeTypeModel el in Model.EmployeeTypes)
                                            {
                                                <option value="@el.EmployeeTypeID" @(el.EmployeeTypeID == Model.EmployeeTypeID ? "selected" : "")>@el.EmployeeTypeName</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-5 padding">
                                    <div class="row">
                                        <label class="col-md-3 text-right padding-R" style="display:none;">Month : </label>
                                        <div class="col-md-7 padding-L" style="padding-left: 10px;">
                                            <input type="month" value="@(Model.Year + "-" + Model.Month.ToString().PadLeft(2,'0'))" name="StartDate" id="dtMonth" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <a href="javascript:void(0);" onclick="$('#frmGetEmployees').submit();"><i class="fa fa-search"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                }
                <div class="x_panel">

                    <div class="x_content">

                        <table id="tblCategory" class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th style="width: 10%">Photo</th>
                                    <th style="width: 13%">Name</th>
                                    <th style="width: 20%">Payment Referance</th>
                                    <th style="width: 25%">Salary Details</th>
                                    <th style="width: 10%">Status</th>
                                    <th style="width: 10%">View</th>
                                </tr>
                            </thead>
                            @{
                                int count = 0;
                                foreach (EmployeeSalaryListModel c in Model.Employees)
                                {
                                    <tr>

                                        <td>
                                            <input type="hidden" id="hdnEmployeeID" value="@c.EmployeeID" />
                                            <input type="hidden" id="hdnEmployeeType" value="@c.EmployeeType" />
                                            <input type="hidden" id="hdnMonth" value="@Model.Month" />
                                            <input type="hidden" id="hdnYear" value="@Model.Year" />
                                            <input type="hidden" id="hdnSBranchID" value="@Model.SBranchID" />

                                            <img id="imgPhoto" onerror="return OnImageError(this,@(c.Gender));" class="thumbImageGrid" alt="Photo" src="@Url.Content(c.Photo)" />
                                        </td>
                                        <td>
                                            @c.EmployeeName
                                            <br />
                                            @c.EmployeeSID
                                        </td>

                                        <td>
                                            @if (c.PaymentID != 0)
                                            {
                                                <ss>@c.PaymentDate.ToString("dd MMM, yyyy")</ss><br />
                                                <ss>@c.ReferanceNumber</ss>
                                            }
                                            @*<ss>@SMEnterprise.Repository.CommonUsage.SpellDecimal(c.LeaveDeduction)</ss>*@
                                        </td>
                                        <td>
                                           Salary Amount : @c.PaymentAmount Paid Days : @c.PresentDays
                                            @*Salary : @c.Amount.ToString("N2")<br />
                                                Leave Deduction : @c.LeaveDeduction.ToString("N2")<br />
                                                @if (c.AdvanceDeduction > 0)
                                                {
                                                    <ss>Advance Payment EMI: @c.AdvanceDeduction.ToString("N2")</ss><br />
                                                }
                                                Net Payble : @((c.Amount - c.LeaveDeduction - c.AdvanceDeduction).ToString("N2"))<br />
                                                Paid Amount : @c.PaymentAmount.ToString("N2")<br />*@
                                        </td>
                                        <td>
                                            @if (c.PaymentID!=0)
                                            {
                                                <label class='badge bg-green'>Paid</label>
                                            }
                                            else
                                            {
                                                <label class='badge bg-red'>Pending</label>
                                            }
                                        </td>
                                        <td>
                                            @if (c.PaymentID > 0)
                                            {
                                                <a href="javascript:void(0);"  class="btn btn-success" onclick="PrintSalarySlipModel(@c.PaymentID)">Salary Slip</a>
                                            }
                                            else
                                            {
                                                <a href="javascript:void(0);" onclick="ViewPaymentDetails(this);" class="btn btn-primary Closed">Pay</a>
                                            }


                                        </td>
                                    </tr>

                                    count++;
                                }

                            }
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <div  id="mdlPrintSlip" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Salary Slip</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Modal body text goes here.</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function PrintSalarySlipModel(ID) {
              $.ajax({
                  url: "/Account/GetSalarySlip/"+ID,
                    type: 'POST',
                  success: function (html) {
                      $('#mdlPrintSlip').find('.modal-body').html(html);
                      $('#mdlPrintSlip').modal('toggle');
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
                },
                async: true,
                processData: false
            });

        }
        function PrintSalarySlip()
        {
            $(".noprint").each(function (index) {
                $(this).closest('ssa').html($(this).val());
            });
            $('.noprint').remove();
            var contents = $('#divSalaryDetails').html();//"<div class='row'><div style='width:50%'>"+ $("#divRecipt").html()+"</div><div style='width:50%'>"+ $("#divRecipt").html()+"</div></div>";
            var frame1 = $('<iframe />');
            frame1[0].name = "frame1";
            frame1.css({ "position": "absolute", "top": "-1000000px" });
            $("body").append(frame1);
            var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
            frameDoc.document.open();
            //Create a new HTML document.
            frameDoc.document.write('<html><head><title></title>');
            frameDoc.document.write('</head><body>');
            //Append the external CSS file.
            frameDoc.document.write('<link href="@Url.Content("~/css/RecieptStyle.css")" rel="stylesheet" type="text/css" />');
            //Append the DIV contents.
            frameDoc.document.write(contents);
            frameDoc.document.write('</body></html>');
            frameDoc.document.close();
            setTimeout(function () {
                window.frames["frame1"].focus();
                window.frames["frame1"].print();
                frame1.remove();
            }, 500);
        }
        $(function () {
            $("#tblCategory").DataTable();
        });
        function ViewPaymentDetails(sender)
        {
            if ($(sender).hasClass('Closed')) {
                $(sender)
                       .closest("tr")
                       .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: rgba(192, 181, 212, 0.47);font-size: 30px;text-align: -webkit-center;'> Loading.... </td></tr>");
                var ele = document.getElementsByClassName("Open");
                if (ele.length > 0) {
                    $(ele[0]).click();

                    //$(ele[0]).text('Edit');
                }


                $.ajax({
                    url: "@Url.Action("EmployeeSalaryDetail", "Account")",
                    type: 'POST',
                data: JSON.stringify({
                    EmployeeID: $(sender).closest('tr').find('#hdnEmployeeID').val(),
                    EmployeeType: $(sender).closest('tr').find('#hdnEmployeeType').val(),
                    SBranchID: $(sender).closest('tr').find('#hdnSBranchID').val(),
                    SalaryMonth: $(sender).closest('tr').find('#hdnMonth').val(),
                    SalaryYear: $(sender).closest('tr').find('#hdnYear').val(),
                    LeaveDeduction: $(sender).closest('tr').find('#hdnLeaveDeduction').val()
                }),
                contentType: 'application/json; charset=utf-8',
                success: function (html) {

                    $(sender).closest("tr").next().remove();
                    $(sender)
                   .closest("tr")
                   .after("<tr><td colspan = '999' style='border-left: 3px solid #7b64a5;background-color: white;'>" + html + "</td></tr>");
                    $(sender).text('Close');
                    $(sender).removeClass('Closed');
                    $(sender).addClass('Open');
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert(XMLHttpRequest + " : " + textStatus + " : " + errorThrown);
                },
                async: true,
                processData: false
            });
        }
        else
        {
                $(sender).text('View Details');
        $(sender).removeClass('Open');
        $(sender).addClass('Closed');
        $(sender).closest("tr").next().remove();
        }
        }
    </script>
}
<!-- /.content -->
