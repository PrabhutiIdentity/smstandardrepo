@model SMEnterprise.Models.OrderModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // use site layout so modal inherits styles/scripts (Bootstrap)
    var amountRupees = (Model.Amount / 100m).ToString("N2");
    var branchId = Model.SBranchID;
    var description = Model.Description ?? "ERP Subscription";
}
@section styles {
    <style>
        /* Small cosmetic tweaks for modal */
        .subscribe-modal .modal-header {
            background: linear-gradient(90deg,#007bff,#6610f2);
            color: #fff;
            border-bottom: none;
        }

        .subscribe-modal .modal-title {
            font-weight: 600;
        }

        .subscribe-amount {
            font-size: 1.6rem;
            font-weight: 700;
            color: #28a745;
        }

        .subscribe-meta {
            color: #6c757d;
        }

        .btn-pay-now {
            background: #ff6f00;
            border-color: #ff6f00;
            color: #fff;
        }

            .btn-pay-now:hover {
                background: #ff7f2a;
                border-color: #ff7f2a;
            }
    </style>
}

<div class="container">
    <!-- Trigger modal immediately on page load -->
    <div class="text-center mt-5">
        <h3>Subscription Checkout</h3>
        <p class="text-muted">Branch ID: <strong>@branchId</strong></p>
        <p class="subscribe-amount">&#8377; @amountRupees</p>
        <p class="subscribe-meta">@description</p>
        <button id="openSubscribeModal" class="btn btn-primary mt-3">Proceed to Payment</button>
    </div>
</div>

<!-- Bootstrap modal -->
<div class="modal fade subscribe-modal" id="subscribeModal" tabindex="-1" role="dialog" aria-labelledby="subscribeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="subscribeModalLabel">Complete Subscription</h5>
            </div>
            <div class="modal-body text-center">
                <p class="mb-1">You are paying for:</p>
                <p class="font-weight-bold">@description</p>
                <p class="subscribe-amount mb-1">&#8377; @amountRupees</p>
                <p class="subscribe-meta mb-3">Branch: <strong>@branchId</strong></p>

                @using (Html.BeginForm("Complete", "Payment", FormMethod.Post, new { id = "paymentResponseForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("rzp_paymentid", "")
                    @Html.Hidden("rzp_orderid", "")
            <div class="d-flex justify-content-center">
                @*<button type="button" id="btnPayNow" class="btn btn-pay-now mr-2">Pay Now</button>*@
                <a href="https://rzp.io/rzp/RT7KSrH" class="btn btn-pay-now mr-2">Pay Now</a>
                
                <a href="@Url.Action("Dashboard","Account")" class="btn btn-secondary">Cancel</a>
            </div>
                }

                <div id="processing" class="mt-3" style="display:none;">
                    <div class="spinner-border text-primary" role="status"><span class="sr-only">Processing...</span></div>
                    <p class="mt-2">Processing payment, please wait...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        (function () {
            var key = "@Model.razorpayKey";
            var orderId = "@Model.OrderID";
            var amount = "@Model.Amount"; // paise

         console.log("Razorpay debug -> key:", key, "orderId:", orderId, "amount(paise):", amount, "SBranchID:", "@Model.SBranchID", "IsSubscription:", "@(Model.IsSubscriptionOrder ? "1":"0")");

 // quick sanity checks
 if (!key || key.trim() === "") {
     alert("Payment key is missing. Use Razorpay test keys for localhost or configure branch gateway credentials.");
     return;
 }
 if (!orderId || orderId.trim() === "") {
     alert("Order id is missing. Server must create Razorpay order and set OrderID before opening checkout.");
     return;
 }
 if (!amount || parseInt(amount) <= 0) {
     alert("Payment amount is zero or invalid. Check order creation logic.");
     return;
 }
            var currency = "@Model.currency";
            var name = "@(Model.Name ?? "ERP Subscription")";
            var description = "@(Model.Description ?? "Subscription")";
            var prefillName = "@(Model.Name ?? "")";
            var prefillEmail = "@(Model.EmailID ?? "")";
            var prefillContact = "@(Model.ContactNumber ?? "")";

            var options = {
                key: key,
                amount: amount,
                currency: currency,
                name: name,
                description: description,
                order_id: orderId,
                prefill: {
                    name: prefillName,
                    email: prefillEmail,
                    contact: prefillContact
                },
                notes: {
                    SBranchID: "@Model.SBranchID",
                    IsSubscription: "@(Model.IsSubscriptionOrder ? "1" : "0")"
                },
                theme: { color: "#007bff" },
                modal: {
                    escape: false
                },
                handler: function (response) {
                    // populate hidden fields and submit
                    document.querySelector('input[name="rzp_paymentid"]').value = response.razorpay_payment_id;
                    document.querySelector('input[name="rzp_orderid"]').value = response.razorpay_order_id;
                    document.getElementById('processing').style.display = 'block';
                    document.getElementById('paymentResponseForm').submit();
                }
            };

            var rzp = new Razorpay(options);

            // log failure details if Razorpay reports failure
            rzp.on('payment.failed', function (response) {
                console.error('Razorpay payment.failed', response);
                var msg = "Payment failed: " + (response.error && response.error.description ? response.error.description : JSON.stringify(response));
                alert(msg);
            });

            // show modal when page button clicked or open automatically
            var openModalBtn = document.getElementById('openSubscribeModal');
            openModalBtn.addEventListener('click', function () {
                $('#subscribeModal').modal({ backdrop: 'static', keyboard: false });
            });

            // pay button opens Razorpay checkout
            document.getElementById('btnPayNow').addEventListener('click', function (e) {
                e.preventDefault();
                try {
                    rzp.open();
                } catch (err) {
                    console.error(err);
                    alert('Unable to open payment window. Try again.');
                }
            });

            // Optionally open modal automatically
            $(document).ready(function () {
                // auto-open modal
                $('#subscribeModal').modal({ backdrop: 'static', keyboard: false, show: true });
            });
        })();
    </script>
}