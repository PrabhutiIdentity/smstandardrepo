@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_ParentLayout.cshtml";
}

@model SMEnterprise.Models.StudentModel

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<section class="teacher-prolile-01">
    <div class="container">
        <div class="row">
            <div class="col-sm-3 t-profile-left">
                <div class="teacher-contact">
                    <img onerror="return OnImageError(this,2);" width="100" class="ImageReportLogo" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(Model.StudentID)_@Model.Photo" style="max-height:100px" />
                </div>
            </div>
            <div class="col-sm-9 t-profile-right">
                <div class="row all-corsess-wapper">
                    <div class="col-sm-12">
                        <div class="all-courses">
                            <h3>Fee Payment Details</h3>
                            <div class="profile__courses__inner">
                                <ul class="profile__courses__list list-unstyled">
                                    <li>Student Name: <b>@Model.Name</b></li>
                                    <li>DOB: <b>@Model.DOB.ToString("dd MMM yyyy")</b></li>
                                    <li>Class: <b>@Model.ClassName</b></li>
                                    <li>Father Name: <b>@Model.FatherName</b></li>
                                    <li>Contact No: <b>@Model.FatherMobileNo</b></li>
                                    <li>Mother Name: <b>@Model.MotherName</b></li>
                                    @*<li>Fee Month: <b>@ViewBag.OrderDetails.FeeMonth  </b></li>
                                        <li>Amount(In Rupees): <b>@ViewBag.OrderDetails.ApplicableFee</b></li>*@
                                    @if (ViewBag.OrderDetails != null)
                                    {
                                        <li>Fee Month: <b>@ViewBag.OrderDetails.FeeMonth</b></li>
                                        <li>Amount(In Rupees): <b>@(Convert.ToDecimal(ViewBag.OrderDetails.ApplicableFee))</b></li>
                                        @* ApplicableFee is already in Rupees *@
                                    }
                                    else
                                    {
                                        <li>Fee details not available. Please select a fee to pay.</li>
                                    }
                                </ul>

                            </div>
                        </div>
                        <div class="form-group register-btn">
                          
                            <button onclick="TakePayment()" class="btn btn-primary btn-lg">Pay Now</button>

                            @*  @using (Html.BeginForm("ProcessPayment", "Payment", FormMethod.Post, new { @id = "payUForm" }))
                                {
                                    <input type="hidden" name="key" value="JVDkAA" />
                                    <input type="hidden" name="txnid" value="@ViewBag.TransactionId" /> <!-- Unique Transaction ID @Guid.NewGuid().ToString()-->
                                    <input type="hidden" name="productinfo" value="Fee Payment" />
                                    <input type="hidden" name="amount" value="@((ViewBag.OrderDetails.ApplicableFee).ToString("0.00"))" />

                                    <input type="hidden" name="email" value="@Model.EmailID ?? " info@prabhutisystems.com"" /> <!-- Ensure you have an email field in your model -->
                                    <input type="hidden" name="firstname" value="@Model.Name" />

                                    <input type="hidden" name="surl" value="https://localhost:44346/Payment/PaymentSuccess" /> <!-- URL on success -->
                                    <input type="hidden" name="furl" value="https://localhost:44346/Payment/PaymentFailure" /> <!-- URL on failure -->


                                    <!-- Add additional UDFs if necessary -->
                                    <input type="hidden" name="hash" value="@ViewBag.PaymentHash" />

                                    <button type="submit" class="btn btn-primary btn-lg">Pay Now</button>
                                }
                            *@
                        </div>
                    </div>
                    <div style="display:none">
                        @using (Html.BeginForm("Complete", "Payment", FormMethod.Post, new { id = "paymentResponseForm" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("rzp_paymentid")
                            @Html.Hidden("rzp_orderid")
                          
                            <button type="submit" id="rzp-paymentresponse" class="btn btn-primary" hidden>Submit</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<script>

            var options = {
                "key": "@ViewBag.OrderDetails.razorpayKey", // Key ID from ViewBag
                "amount": "@ViewBag.OrderDetails.Amount", // Amount in paise from ViewBag
                "currency": "@ViewBag.OrderDetails.currency",
                "name": "@ViewBag.OrderDetails.Name",
                "description": "@ViewBag.OrderDetails.Description",
                "image": "@Url.Content("~/ images / JosephLogo - new.png")",
                "order_id": "@ViewBag.OrderDetails.PGOrderID", // Razorpay Order ID from ViewBag
                "handler": function(response) {
                console.log("Payment response:", response);

                // Set the data in hidden form fields
                document.getElementById('rzp_paymentid').value = response.razorpay_payment_id;
                    document.getElementById('rzp_orderid').value = response.razorpay_order_id;


                // Submit the form automatically
                    document.getElementById('rzp-paymentresponse').click();

            },
                "prefill": {
                "name": "@ViewBag.OrderDetails.Name",
                    "email": "@ViewBag.OrderDetails.EmailID",
                    "contact": "@ViewBag.OrderDetails.ContactNumber"
                },
                "notes": {
                "address": "@ViewBag.OrderDetails.Address",
                    "StudentID ": "@Model.StudentID", // Using Model for student data
                    "fee_month": "@ViewBag.OrderDetails.FeeMonth",
                    "fee_year": "@ViewBag.OrderDetails.FeeYear"
                },
                "theme": {
                "color": "#F37254"
                }
        };
    var rzp1 = new Razorpay(options);
    console.log("Razorpay Options (Index Page):", options);

    function TakePayment(e) {
        rzp1.open();
        e.preventDefault();
    }




</script>
