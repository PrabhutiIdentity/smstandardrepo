@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_ParentLayout.cshtml";
}

@model SMEnterprise.Models.StudentModel

@*<script src="https://checkout.razorpay.com/v1/checkout.js"></script>*@
<section class="teacher-prolile-01">
    <div class="container">
        <div class="row">
            <div class="col-sm-3 t-profile-left">
                <div class="teacher-contact">
                    <img onerror="return OnImageError(this,2);" width="100" class="ImageReportLogo" alt="Photo" src="@Url.Content("~/Images/StudentImage/")@(Model.StudentID)_@Model.Photo" style="max-height:100px" />
                </div>
            </div>
            <div class="col-sm-9 t-profile-right">
                <div class="row all-corsess-wapper">
                    <div class="col-sm-12">
                        <div class="all-courses">
                            <h3>Fee Payment Details</h3>
                            <div class="profile__courses__inner">
                                <ul class="profile__courses__list list-unstyled">
                                    <li>Student Name: <b>@Model.Name</b></li>
                                    <li>DOB: <b>@Model.DOB.ToString("dd MMM yyyy")</b></li>
                                    <li>Class: <b>@Model.ClassName</b></li>
                                    <li>Father Name: <b>@Model.FatherName</b></li>
                                    <li>Contact No: <b>@Model.FatherMobileNo</b></li>
                                    <li>Mother Name: <b>@Model.MotherName</b></li>
                                    @*<li>Fee Month: <b>@ViewBag.OrderDetails.FeeMonth  </b></li>
                                    <li>Amount(In Rupees): <b>@ViewBag.OrderDetails.ApplicableFee</b></li>*@
                                    @{
                                        var order = ViewBag.OrderDetails as SMEnterprise.Models.OrderModel;
                                    }
                                    @if (order != null)
                                    {
                                        <li>Fee Month: <b>@order.FeeMonth</b></li>
                                        <li>Amount: <b>@order.ApplicableFee.ToString("F2")</b></li>


                                    }
                                    @*@if (ViewBag.OrderDetails != null)
                                    {
                                        <li>Fee Month: <b>@ViewBag.OrderDetails.FeeMonth</b></li>
                                        <li>Amount(In Rupees): <b>@(Convert.ToDecimal(ViewBag.OrderDetails.ApplicableFee))</b></li>

                                    }*@

                                </ul>

                            </div>
                        </div>
                        <div class="form-group register-btn">
                            @*Razor pay use without embeded*@
                            @*<button onclick="TakePayment()" class="btn btn-primary btn-lg">Pay Now</button>*@
                            @{
                                var testOrder = ViewBag.OrderDetails;
                            }
                            @if (testOrder == null)
                            {
                                <p style="color:red;">OrderDetails is null!</p>
                            }
                            @if (ViewBag.OrderDetails != null)
                            {
                                <form method="POST" action="https://api.razorpay.com/v1/checkout/embedded">

                                    <input type="hidden" name="key_id" value="@ViewBag.OrderDetails.razorpayKey" />
                                    <input type="hidden" name="order_id" value="@ViewBag.OrderDetails.OrderID" />
                                    @*<input type="hidden" name="amount" value="@ViewBag.OrderDetails.Amount" />*@
                                    <input type="hidden" name="currency" value="INR" />
                                    <input type="hidden" name="name" value="@ViewBag.OrderDetails.Description" />
                                    <input type="hidden" name="description" value="Fee Payment for @ViewBag.OrderDetails.FeeMonth / @ViewBag.OrderDetails.FeeYear" />
                                    <input type="hidden" name="image" value="https://pschool.identityinfo.in/Images/SBranchLogo/41_ChambaSchool-Logo.jpeg" />
                                    <input type="hidden" name="prefill[email]" value="@ViewBag.OrderDetails.EmailID" />

                                    <input type="hidden" name="prefill[contact]" value="@Model.FatherMobileNo" />
                                    <input type="hidden" name="prefill[name]" value="@Model.Name" />
                                    <input type="hidden" name="notes[student_id]" value="@Model.StudentID" />
                                    @*<input type="hidden" name="notes[fee_month]" value="@ViewBag.OrderDetails.FeeMonth" />
                                    <input type="hidden" name="notes[fee_year]" value="@ViewBag.OrderDetails.FeeYear" />*@
                                    <input type="hidden" name="notes[invoice_id]" value="@(ViewBag.OrderDetails.OrderID)" />
                                    <input type="hidden" name="callback_url" value="@Url.Action("PaymentCallback", "Payment", null, Request.Url.Scheme)" />
                                    <button type="submit" class="btn btn-primary" style="color: darkred;">Pay Now</button>
                                </form>
                            }

                            @*PayuMoney*@
                            @*  @using (Html.BeginForm("ProcessPayment", "Payment", FormMethod.Post, new { @id = "payUForm" }))
        {
            <input type="hidden" name="key" value="JVDkAA" />
            <input type="hidden" name="txnid" value="@ViewBag.TransactionId" /> <!-- Unique Transaction ID @Guid.NewGuid().ToString()-->
