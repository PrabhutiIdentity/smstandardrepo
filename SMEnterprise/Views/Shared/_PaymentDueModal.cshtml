
@{

﻿@{

    var show = (Session["ShowPaymentDue"] != null && Convert.ToBoolean(Session["ShowPaymentDue"]));
    var branchId = Convert.ToInt32(Session["PaymentDueBranchID"] ?? 0);
    var amount = Convert.ToDecimal(Session["PaymentDueAmount"] ?? 0m);
    var plan = Convert.ToString(Session["PaymentDuePlanName"] ?? "");

    var dueDate = Session["PaymentDueDate"] as DateTime?;
    var graceDays = Convert.ToInt32(Session["PaymentDueGraceDays"] ?? 0);
    var graceEndDate = Session["PaymentDueGraceEndDate"] as DateTime?;
    var canClosePopup = (Session["PaymentDueCanClose"] != null && Convert.ToBoolean(Session["PaymentDueCanClose"])) || graceDays > 0;


}
@if (show)
{
    <style>

        body.payment-due-open {
            overflow: hidden;
        }

        #paymentDueOverlay {
            position: fixed;
            inset: 0;
            background: rgba(8, 20, 38, 0.70);
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        #paymentDueModalCard {
            width: 100%;
            max-width: 640px;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 18px 40px rgba(0,0,0,0.30);
            background: #fff;
        }

            #paymentDueModalCard .modal-header {
                background: linear-gradient(90deg, #007bff 0%, #0056b3 100%);
                color: #fff;
                padding: 18px 24px;
                position: relative;
            }

            #paymentDueModalCard .modal-title {
                margin: 0;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 26px;
            }

            #paymentDueModalCard .modal-body {
                padding: 22px;
                background-color: #fff;
                color: #333;
                font-size: 14px;
            }

            #paymentDueModalCard .payment-icon {
                width: 56px;
                height: 56px;
                border-radius: 50%;
                background: rgba(255,255,255,0.12);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.35rem;
            }

            #paymentDueModalCard .amount {
                font-size: 1.75rem;
                font-weight: 700;
                color: #e64a19;
                margin-top: 6px;
            }

            #paymentDueModalCard .meta {
                margin-top: 8px;
                color: #666;
                font-size: 14px;
            }

            #paymentDueModalCard .plan-badge {
                display: inline-block;
                background: #f1f5f9;
                color: #333;
                border-radius: 14px;
                padding: 6px 10px;
                font-size: 14px;
                margin-left: 6px;
            }

            #paymentDueModalCard .modal-footer {
                padding: 16px;
                background: linear-gradient(180deg, #f8fafc, #ffffff);
                display: flex;
                justify-content: flex-end;
                flex-wrap: wrap;
                gap: 10px;
            }

            #paymentDueModalCard .btn-pay {
                min-width: 140px;
                font-weight: 600;
            }

            #paymentDueModalCard .btn-later {
                min-width: 140px;
                font-weight: 600;
                background: #6c757d;
                color: #fff;
                border-color: #6c757d;
            }

        #paymentDueCloseButton {
            position: absolute;
            right: 16px;
            top: 12px;
            background: transparent;
            border: none;
            color: #fff;
            font-size: 30px;
            line-height: 1;
            cursor: pointer;
        }

        @@media (max-width: 576px) {
            #paymentDueModalCard .modal-title {
                font-size: 20px;
            }

            #paymentDueModalCard .amount {
                font-size: 1.4rem;
            }
        }
    </style>

    <div id="paymentDueOverlay" role="dialog" aria-labelledby="paymentDueModalLabel" aria-modal="true">
        <div id="paymentDueModalCard">
            <div class="modal-header">
                <h4 class="modal-title" id="paymentDueModalLabel">
                    <span class="payment-icon"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i></span>
                    Subscription Payment Due
                </h4>
                @if (canClosePopup)
                {
                    <button type="button" id="paymentDueCloseButton" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                }
            </div>

            <div class="modal-body">
                <div>
                    <p style="margin:0 0 10px 0;font-size:18px;">Your ERP subscription payment is due. To avoid interruption please complete payment.</p>

                    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;">
                        <div>
                            <div class="meta"><strong>Branch ID:</strong> @branchId</div>
                            <div class="meta" style="margin-top:6px;"><strong>Plan:</strong> <span class="plan-badge">@plan</span></div>
                            <div class="meta" style="margin-top:6px;"><strong>Due Date:</strong> @(dueDate.HasValue ? dueDate.Value.ToString("dd MMM yyyy") : "-")</div>
                            @if (graceDays > 0 && graceEndDate.HasValue)
                            {
                                <div class="meta" style="margin-top:6px;"><strong>Grace Days:</strong> @graceDays day(s), work allowed till @graceEndDate.Value.ToString("dd MMM yyyy")</div>
                            }
                        </div>

                        <div style="text-align:right;margin-top:8px;">
                            <div class="meta">Amount due</div>
                            <div class="amount"><i class="fa fa-inr" aria-hidden="true"></i> @amount.ToString("N2")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                @if (canClosePopup)
                {
                    <button type="button" class="btn btn-later" id="paymentDueWorkNow">Work For Now</button>
                }
                <a href="@Url.Action("Subscribe", "Payment", new { branchId = branchId })" class="btn btn-primary btn-pay" id="btnPayNow">
                    <i class="fa fa-credit-card" aria-hidden="true"></i>&nbsp; Pay Now
                </a>

                @using (Html.BeginForm("logout", "Login", FormMethod.Post, new { id = "logoutForm" }))
                {
                    @Html.AntiForgeryToken()
                    <a href="#" onclick="$('#logoutForm').submit();"><i class="fa fa-sign-out pull-right" style="font-size:16px;"></i> Logout</a>
                }

        /* Inline styles to keep this partial self-contained and visually appealing */
        #paymentDueModal .modal-content {
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0,0,0,0.16);
        }

        #paymentDueModal .modal-header {
            background: linear-gradient(90deg, #007bff 0%, #0056b3 100%);
            color: #fff;
            border-bottom: none;
            padding: 18px 24px;
        }

        #paymentDueModal .modal-title {
            margin: 0;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 2.25rem;
        }

        #paymentDueModal .modal-body {
            padding: 22px;
            background-color: #fff;
            color: #333;
            font-size:12px;
        }

        #paymentDueModal .payment-icon {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: rgba(255,255,255,0.12);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
        }

        #paymentDueModal .amount {
            font-size: 1.75rem;
            font-weight: 700;
            color: #e64a19;
            margin-top: 6px;
        }

        #paymentDueModal .meta {
            margin-top: 8px;
            color: #666;
            font-size: 14px;;
        }

        #paymentDueModal .plan-badge {
            display: inline-block;
            background: #f1f5f9;
            color: #333;
            border-radius: 14px;
            padding: 6px 10px;
            font-size: 14px;
            margin-left: 6px;
        }

        #paymentDueModal .modal-footer {
            border-top: none;
            padding: 16px;
            background: linear-gradient(180deg, #f8fafc, #ffffff);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        #paymentDueModal .btn-pay {
            min-width: 140px;
            font-weight: 600;
        }

        @@media (max-width: 576px) {
            #paymentDueModal .modal-dialog { margin: 20px; }
            #paymentDueModal .modal-title { font-size: 1.05rem; }
            #paymentDueModal .amount { font-size: 1.4rem; }
        }
    </style>

    <div id="paymentDueModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="paymentDueModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="paymentDueModalLabel">
                        <span class="payment-icon"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i></span>
                        Subscription Payment Due
                    </h4>
                </div>

                <div class="modal-body">
                    <div>
                        <p style="margin:0 0 10px 0;font-size:18px;">Your ERP subscription payment is due. To avoid interruption please pay before the due date.</p>

                        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;">
                            <div>
                                <div class="meta"><strong>Branch ID:</strong> @branchId</div>
                                <div class="meta" style="margin-top:6px;"><strong>Plan:</strong> <span class="plan-badge">@plan</span></div>
                            </div>

                            <div style="text-align:right;margin-top:8px;">
                                <div class="meta">Amount due</div>
                                <div class="amount"><i class="fa fa-inr" aria-hidden="true"></i> @amount.ToString("N2")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <a href="@Url.Action("Subscribe", "Payment", new { branchId = branchId })" class="btn btn-primary btn-pay" id="btnPayNow">
                        <i class="fa fa-credit-card" aria-hidden="true"></i>&nbsp; Pay Now
                    </a>


                    @using (Html.BeginForm("logout", "Login", FormMethod.Post, new { id = "logoutForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @*<a href="@Url.Action("logout", "Login")" class="btn btn-link" style="color:#6c757d;">Logout</a>*@
                    }
                   
                </div>

            </div>
        </div>
    </div>

    <script>
        (function () {

            var overlay = document.getElementById('paymentDueOverlay');
            if (!overlay) {
                return;
            }

            document.body.className += (document.body.className ? ' ' : '') + 'payment-due-open';
            var payButton = document.getElementById('btnPayNow');
            if (payButton) {
                payButton.focus();
            }

            function closeOverlay() {
                overlay.style.display = 'none';
                document.body.className = document.body.className.replace(/\bpayment-due-open\b/, '').trim();
            }

            var closeButton = document.getElementById('paymentDueCloseButton');
            if (closeButton) {
                closeButton.onclick = closeOverlay;
            }

            var workNowButton = document.getElementById('paymentDueWorkNow');
            if (workNowButton) {
                workNowButton.onclick = closeOverlay;
            }
        })();
    </script>

    <script>
        (function () {
            var overlay = document.getElementById('paymentDueOverlay');
            if (!overlay) {
                return;
            }

            // Add class to body to indicate popup is active
            document.body.classList.add('payment-due-open');

            var payButton = document.getElementById('btnPayNow');
            if (payButton) {
                payButton.focus();
            }

            // --- LOCK INSPECT & RIGHT CLICK ---
            var disableInspect = function (e) {
                // Check if our overlay is still visible before blocking
                if (overlay.style.display !== 'none') {
                    // Block F12, Ctrl+Shift+I, Ctrl+Shift+J, Ctrl+U
                    if (e.keyCode == 123 ||
                        (e.ctrlKey && e.shiftKey && (e.keyCode == 73 || e.keyCode == 74 || e.keyCode == 67)) ||
                        (e.ctrlKey && e.keyCode == 85)) {
                        e.preventDefault();
                        return false;
                    }
                }
            };

            var disableRightClick = function (e) {
                if (overlay.style.display !== 'none') {
                    e.preventDefault();
                }
            };

            // Attach listeners
            document.addEventListener('keydown', disableInspect);
            document.addEventListener('contextmenu', disableRightClick);
            // ----------------------------------

            function closeOverlay() {
                overlay.style.display = 'none';
                document.body.classList.remove('payment-due-open');

                // Clean up listeners so user can use Inspect again after closing
                document.removeEventListener('keydown', disableInspect);
                document.removeEventListener('contextmenu', disableRightClick);
            }

            var closeButton = document.getElementById('paymentDueCloseButton');
            if (closeButton) {
                closeButton.onclick = closeOverlay;
            }

            var workNowButton = document.getElementById('paymentDueWorkNow');
            if (workNowButton) {
                workNowButton.onclick = closeOverlay;
            }
        })();
    </script>
}

            var $modal = $('#paymentDueModal');
            $modal.modal({ backdrop: 'static', keyboard: false, show: true });

            // Set initial focus to the Pay button for quick keyboard action
            $modal.on('shown.bs.modal', function () {
                $('#btnPayNow').trigger('focus');
            });

            // Optional: close modal after clicking logout to ensure navigation works cleanly in some browsers
            $('#paymentDueModal a[href*="logout"]').on('click', function () {
                $modal.modal('hide');
            });
        })();
    </script>
}

