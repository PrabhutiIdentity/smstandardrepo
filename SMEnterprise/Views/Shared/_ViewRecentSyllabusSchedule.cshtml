<div class="modal-dialog" role="document" style="width:800px;">
    <div class="modal-content">
        <div class="modal-header edit-header">
            <button type="button" class="close edit-close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true"><i class="fa fa-close" style="color:white;"></i></span>
            </button>
            <h4 class="modal-title" id="myModalLabel" style="text-align: center;"> (@Model.ClassName - @Model.SectionName) @Model.SubjectName</h4>
        </div>
        <div class="modal-body edit-body">
            <table id="tblCategory" class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th style="width: 30%">Chapter</th>
                        <th style="width: 35%">Section</th>
                        <th style="width: 15%">Scheduled On</th>
                        <th style="width: 15%">Covered On</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var ctr = 1;
                        foreach (var Subs in Model.Schedule)
                        {
                            <tr>
                                <td>
                                    @Subs.ChapterName
                                </td>
                                <td>
                                    @Subs.TopicName
                                </td>
                                <td>
                                    @Subs.ScheduledDate.ToString("dd MMM, yyyy")
                                </td>
                                <td>
                                    @if (Subs.IsComplete == 1)
                                    {
                                        @Subs.ComplatedDate.ToString("dd MMM, yyyy")
                                    }
                                    else
                                    {
                                        <ss>Not Covered</ss>
                                    }
                                </td>
                            </tr>
                            ctr++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
