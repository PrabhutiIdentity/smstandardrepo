    <script>
        var AlterNativeMaleImg = "@Url.Content("~/Images/MaleNoImage.png")";
        var AlterNativeFemaleImg = "@Url.Content("~/Images/FemaleNoImage.png")";
        var AlterNativeDocImg = "@Url.Content("~/Images/NoDocImage.jpg")";
        function OnImageError(me, Type) {
            if (Type == 1) {
                me.src = AlterNativeFemaleImg;
                return true;
            }
            if (Type == 3) {
                me.src = AlterNativeDocImg;
                return true;
            }
            else {
                me.src = AlterNativeMaleImg;
                return true;
            }
        }

        function EditCopy(sender) {
            if ($(sender).text() == "Edit") {
                $(sender).closest('tr').find('.editCopy').removeClass('hidden');
                $(sender).closest('tr').find('.ViewCopy').addClass('hidden');
                $(sender).text('Cancel');
                $(sender).closest('table').find('.editbtnOpen').click();
                $(sender).addClass('editbtnOpen');
            }
            else {
                $(sender).closest('tr').find('.editCopy').addClass('hidden');
                $(sender).closest('tr').find('.ViewCopy').removeClass('hidden');
                $(sender).text('Edit');
                $(sender).removeClass('editbtnOpen');
            }
        }
        function OpenAddNewCopy(sender) {
            if ($(sender).text() == "Add New") {
                $(sender).closest('table').find('tfoot').css('display', '');
                $(sender).closest('table').find('.editbtnOpen').click();
                $(sender).text('Cancel');
            }
            else {
                $(sender).closest('table').find('tfoot').css('display', 'none');
                $(sender).text('Add New');
            }
            try
            {
                SpecificAddFunctionalities(sender);

            }
            catch(e){}
        }
    </script>
