                                </a>
                                <ul class="dropdown-menu dropdown-usermenu animated fadeInDown pull-right">
                                    <li><a href="/Account/ChangePassword"> Change Password</a></li>
                                    <li>
                                        @using (Html.BeginForm("logout", "Login", FormMethod.Post, new { id = "logoutForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <a href="#" onclick="$('#logoutForm').submit();"><i class="fa fa-sign-out pull-right"></i> Log off</a>
                                        }
                                    </li>
                                </ul>
                            </li>
                            <li>
                                <a style="background-color: #5cb8a0;color: white!important;font-size: 20px;"> @SMEnterprise.Repository.CommonUsage.GetCurrentDate().ToString("dddd dd MMM, yyyy")</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
            <!-- /top navigation -->
            <!-- page content -->
            <div class="right_col" role="main" style="min-height:590px;">
                @RenderBody()

            </div>
            <footer>
                <div class="">
                    <p class="pull-right">
                        School Management System By <a href="http://www.prabhutisystems.com" target="_blank">Prabhuti Systems</a>. |
                        <span class="lead"> <i class="fa fa-graduation-cap"></i> PSchool!</span>
                    </p>
                </div>
                <div class="clearfix"></div>
            </footer>
            <!-- /footer content -->
            <!-- /page content -->
        </div>
    </div>
    <div id="custom_notifications" class="custom-notifications dsp_none">
