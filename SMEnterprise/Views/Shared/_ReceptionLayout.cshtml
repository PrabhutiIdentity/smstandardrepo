<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="@Url.Content("~/favicon.ico")">
    <!-- Bootstrap core CSS -->
    <script src="@Url.Content("~/js/jquery.min.js")"></script>
    <link href="@Url.Content("~/css/Gent/jquery.mCustomScrollbar.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/bootstrap-progressbar-3.3.4.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/bootstrap.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/font-awesome.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/pnotify.buttons.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/pnotify.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/pnotify.nonblock.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/Gent/custom.css")" rel="stylesheet" />
    <script src="@Url.Content("~/js/icheck.min.js")"></script>
    <!-- jQuery 2.2.3 -->
    <script>
        var AlterNativeMaleImg = "@Url.Content("~/Images/MaleNoImage.png")";
        var AlterNativeFemaleImg = "@Url.Content("~/Images/FemaleNoImage.png")";
        var AlterNativeDocImg = "@Url.Content("~/Images/NoDocImage.jpg")";
        function OnImageError(me, Type) {
            if (Type == 1) {
                me.src = AlterNativeFemaleImg;
                return true;
            }
            if (Type == 3) {
                me.src = AlterNativeDocImg;
                return true;
            }
            else {
                me.src = AlterNativeMaleImg;
                return true;
            }
        }

    </script>
    <style>
        .dropdown-menu > li > form > a {
            color: #5A738E;
        }


        .dropdown-menu > li > form > a {
            display: block;
            padding: 3px 20px;
            clear: both;
            font-weight: 400;
            line-height: 1.42857143;
            color: #333;
            white-space: nowrap;
        }

        .ImageReportLogo {
            max-width: 125px;
            max-height: 125px;
        }


        *html .ImageReportLogo {
            width: expression((this.width/this.height)>=1?125:'auto');
            height: expression((this.width/this.height)<1?125:'auto');
        }

        .thumbImage {
            max-width: 185px;
            max-height: 185px;
        }


        *html .thumbImage {
            width: expression((this.width/this.height)>=1?185:'auto');
            height: expression((this.width/this.height)<1?185:'auto');
        }
    </style>
    @RenderSection("IncludeCss", required: false)
