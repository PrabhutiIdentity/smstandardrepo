    <script>
        $(document).ready(function () {
            (function () {
                $.ajax(
                    {
                        type: "POST",
                        url: "/Account/GetSessionState/",
                        cache: false,
                        processData: false,
                        contentType: false,
                        success: function (data) {
                        },
                        error: function (e) {

                        }
                    });
                setTimeout(arguments.callee, 60000);
            })();

        });
    </script>
    <script>
        var AlterNativeMaleImg = "@Url.Content("~/Images/MaleNoImage.png")";
        var AlterNativeFemaleImg = "@Url.Content("~/Images/FemaleNoImage.png")";
        var AlterNativeDocImg = "@Url.Content("~/Images/NoDocImage.jpg")";
        function OnImageError(me, Type) {
            if (Type == 0) {
                me.src = AlterNativeMaleImg;
                return true;
            }
            if (Type == 1) {
                me.src = AlterNativeFemaleImg;
                return true;
            }
            if (Type == 3) {
                me.src = AlterNativeDocImg;
                return true;
            }
            else {
                me.src = AlterNativeMaleImg;
                return true;
            }
        }
        function ChildChanged(val) {
            $.ajax(
    {
        type: "POST",
        url: "/Parent/SChildChanged/" + val,
        cache: false,
        processData: false,
        contentType: false,
        success: function (result) {

        },
        error: function (e) {
            //alert("errorn");
        }
    });

            location.reload();
        }


    </script>
