    <script>
        var AlterNativeMaleImg = "@Url.Content("~/Images/MaleNoImage.png")";
        var AlterNativeFemaleImg = "@Url.Content("~/Images/FemaleNoImage.png")";
        var AlterNativeDocImg = "@Url.Content("~/Images/NoDocImage.jpg")";
        function OnImageError(me, Type) {
            if (Type == 1) {
                me.src = AlterNativeFemaleImg;
                return true;
            }
            if (Type == 3) {
                me.src = AlterNativeDocImg;
                return true;
            }
            else {
                me.src = AlterNativeMaleImg;
                return true;
            }
        }

    </script>
    <style>
        .dropdown-menu > li > form > a {
            color: #5A738E;
        }


        .dropdown-menu > li > form > a {
            display: block;
            padding: 3px 20px;
            clear: both;
            font-weight: 400;
            line-height: 1.42857143;
            color: #333;
            white-space: nowrap;
        }

        .ImageReportLogo {
            max-width: 125px;
            max-height: 125px;
        }


        *html .ImageReportLogo {
            width: expression((this.width/this.height)>=1?125:'auto');
            height: expression((this.width/this.height)<1?125:'auto');
        }

        .thumbImage {
            max-width: 185px;
            max-height: 185px;
        }


        *html .thumbImage {
            width: expression((this.width/this.height)>=1?185:'auto');
            height: expression((this.width/this.height)<1?185:'auto');
        }
    </style>
