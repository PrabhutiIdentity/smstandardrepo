<select class="form-control" Style="background: #1ABB9C; color: #fff; border: 1px solid #148A73;" id="ddlMainChilds" name="ddlMainChilds" onchange="ChildChanged(this);">
    @foreach (var sb in Model)
    {
        if (Session["SChildID"] != null)
        {
            <option  data-description="@sb.ClassName/@sb.SectionName (@sb.RollNo)"  data-imagesrc="@sb.Photo"  value="@sb.StudentID" @(Session["SChildID"].ToString() == Convert.ToString(sb.StudentID) ? "selected" : "")>@sb.Name</option>
        }
        else
        {
            <option data-description="@sb.ClassName/@sb.SectionName (@sb.RollNo)" data-imagesrc="@sb.Photo" value="@sb.StudentID">@sb.Name</option>
        }
    }
</select>
