<select class="form-control" Style="background: #1ABB9C; color: #fff; border: 1px solid #148A73;" onchange="BranchChanged(this);">
    @foreach (var sb in Model)
    {
        if (Session["SBranchID"] != null)
        {
            <option value="@sb.SBranchID" @(Session["SBranchID"].ToString() == Convert.ToString(sb.SBranchID) ? "selected" : "")>@sb.BranchName</option>
        }
        else
        {
            <option value="@sb.SBranchID">@sb.BranchName</option>
        }
    }
</select>
