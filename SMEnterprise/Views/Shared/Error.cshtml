@{
    Layout = null;
    ViewBag.Title = "Service Temporarily Unavailable";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title | P-School</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            color: #24324a;
            font-family: "Segoe UI", Arial, sans-serif;
            background:
                radial-gradient(circle at 15% 15%, rgba(66, 153, 225, .18), transparent 32%),
                radial-gradient(circle at 85% 85%, rgba(72, 187, 120, .14), transparent 30%),
                linear-gradient(135deg, #eef5ff 0%, #f8fbff 52%, #eefcf6 100%);
        }

        .error-card {
            width: 100%;
            max-width: 620px;
            padding: 48px 42px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, .8);
            border-radius: 24px;
            background: rgba(255, 255, 255, .94);
            box-shadow: 0 24px 70px rgba(31, 59, 92, .14);
        }

        .logo {
            max-width: 150px;
            max-height: 64px;
            margin-bottom: 28px;
            object-fit: contain;
        }

        .status-icon {
            width: 92px;
            height: 92px;
            margin: 0 auto 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: #2463a9;
            background: linear-gradient(145deg, #e5f1ff, #f3f8ff);
            box-shadow: inset 0 0 0 1px rgba(36, 99, 169, .08);
        }

        .status-icon svg {
            width: 46px;
            height: 46px;
        }

        .status-code {
            margin-bottom: 8px;
            color: #2463a9;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        h1 {
            margin: 0 0 14px;
            color: #18263b;
            font-size: 32px;
            line-height: 1.2;
        }

        p {
            max-width: 470px;
            margin: 0 auto;
            color: #68758a;
            font-size: 16px;
            line-height: 1.7;
        }

        .actions {
            margin-top: 32px;
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .button {
            min-width: 145px;
            padding: 13px 22px;
            border: 1px solid #d7e1ee;
            border-radius: 11px;
            color: #34445d;
            font-size: 15px;
            font-weight: 600;
            text-decoration: none;
            background: #fff;
            transition: transform .15s ease, box-shadow .15s ease;
        }

        .button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(31, 59, 92, .12);
        }

        .button-primary {
            border-color: #2463a9;
            color: #fff;
            background: linear-gradient(135deg, #2f75bd, #205b9e);
        }

        .help-text {
            margin-top: 28px;
            padding-top: 22px;
            border-top: 1px solid #edf1f6;
            color: #8a95a5;
            font-size: 13px;
        }

        @@media (max-width: 560px) {
            .error-card {
                padding: 36px 22px;
                border-radius: 18px;
            }

            h1 {
                font-size: 27px;
            }

            .button {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <main class="error-card">
        <img class="logo" src="@Url.Content("~/Images/logo.png")" alt="P-School" />

        <div class="status-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 9v4" />
                <path d="M12 17h.01" />
                <path d="M10.3 3.8 2.4 17.5A2 2 0 0 0 4.1 20h15.8a2 2 0 0 0 1.7-2.5L13.7 3.8a2 2 0 0 0-3.4 0Z" />
            </svg>
        </div>

        <div class="status-code">Temporary interruption</div>
        <h1>We couldn't complete your request</h1>
        <p>
            The server is taking longer than expected to respond.
            Please wait a moment and try again. Your data remains safe.
        </p>

        <div class="actions">
            <a class="button button-primary" href="javascript:window.location.reload();">Try Again</a>
            <a class="button" href="@Url.Action("Index", "Home")">Go to Login</a>
        </div>

        <div class="help-text">
            If the problem continues, please contact your school administrator or technical support.
        </div>
    </main>
</body>
</html>
