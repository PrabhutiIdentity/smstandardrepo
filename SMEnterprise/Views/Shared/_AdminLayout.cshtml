    <script>
        function ShowNotification(Title, Text, Type) {

            var notice = new PNotify({
                title: Title,
                text: Text,
                type: Type,
                addclass: 'dark',
                styling: 'bootstrap3',
            });
            notice.get().click(function () {
                notice.remove();
            });
            return notice;

        }
        function ShowClosingNotification(Title, Text, Type) {
            var notice = new PNotify({
                title: Title,
                text: Text,
                type: Type,
                addclass: 'dark',
                styling: 'bootstrap3',
            });
            notice.get().click(function () {
                notice.remove();
            });
        }
    </script>
