    <script>
        var AlterNativeMaleImg = "@Url.Content("~/Images/MaleNoImage.png")";
        var AlterNativeFemaleImg = "@Url.Content("~/Images/FemaleNoImage.png")";
        var AlterNativeDocImg = "@Url.Content("~/Images/NoDocImage.jpg")";
        function OnImageError(me, Type) {
            if (Type == 1) {
                me.src = AlterNativeFemaleImg;
                return true;
            }
            if (Type == 3) {
                me.src = AlterNativeDocImg;
                return true;
            }
            else {
                me.src = AlterNativeMaleImg;
                return true;
            }
        }
        function OnImageErrorReport(me, Type) {
            $(me).css('display', 'none');
        }

    </script>
    <style>
        /* Custom Modern Design System */
        :root {
            --primary-blue: #4e73df;
            --bg-light: #f8f9fc;
            --card-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            --border-color: #e3e6f0;
        }

        body {
            background-color: var(--bg-light);
            font-family: 'Nunito', sans-serif;
        }

        /* Modernized Panel (Card) */
        .x_panel {
            border: none !important;
            border-radius: 0.5rem !important;
            box-shadow: var(--card-shadow);
            margin-bottom: 24px;
            background: #fff;
        }

        .x_title {
            border-bottom: 1px solid var(--border-color) !important;
            padding: 1rem 1.25rem !important;
            margin-bottom: 1rem !important;
        }

            .x_title h2 {
                font-size: 1rem;
                font-weight: 700;
                color: var(--primary-blue);
            }

        /* Custom Tab Styling */
        .nav-tabs.bar_tabs {
            border-bottom: 1px solid var(--border-color);
            background: transparent;
            padding-left: 0;
        }

            .nav-tabs.bar_tabs > li > a {
                border-radius: 0;
                margin-right: 2px;
                border: none;
                color: #858796;
            }

            .nav-tabs.bar_tabs > li.active > a {
                border-bottom: 2px solid var(--primary-blue) !important;
                color: var(--primary-blue);
                font-weight: bold;
            }

        /* Form Controls */
        .form-control {
            border-radius: 0.35rem;
            border: 1px solid #d1d3e2;
            padding: 0.5rem 0.75rem;
        }

            .form-control:focus {
                border-color: #bac8f3;
                box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
            }
    </style>
    <style>
    /* Loader Styles */
    .loader {
      border: 8px solid #f3f3f3; /* Light grey */
      border-top: 8px solid #3498db; /* Blue */
      border-radius: 50%;
      width: 50px;
      height: 50px;
      animation: spin 1s linear infinite;
      margin: auto;
    }

    /* Spin Animation */
    @("@keyframes") spin {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }

    /* Center the loader inside the container */
    .loader-container {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100px; /* Adjust height as needed */
      background-color: #f9f9f9; /* Light background */
    }
    </style>

    <style>


        .pnotify {
            z-index: 1051 !important; /* Ensure this is higher than the modal z-index */
        }
        .ui-pnotify{
            z-index:9999
        }
        .nav-md .container.body .col-md-3.left_col {
            z-index: 1;
