        .dropdown-menu > li > form > a {
            display: block;
            padding: 3px 20px;
            clear: both;
            font-weight: 400;
            line-height: 1.42857143;
            color: #333;
            white-space: nowrap;
        }

        .ImageReportLogo {
            max-width: 125px;
            max-height: 125px;
        }
        *html .ImageReportLogo {
            width: expression((this.width/this.height)>=1?125:'auto');
            height: expression((this.width/this.height)<1?125:'auto');
        }

        .thumbImage {
            max-width: 185px;
            max-height: 185px;
        }


        *html .thumbImage {
            width: expression((this.width/this.height)>=1?185:'auto');
            height: expression((this.width/this.height)<1?185:'auto');
        }

         .reportSign {
            max-width: 200px;
            max-height: 100px;
        }


        *html .reportSign {
            width: expression((this.width/this.height)>=1?200:'auto');
            height: expression((this.width/this.height)<1?100:'auto');
        }
    </style>
