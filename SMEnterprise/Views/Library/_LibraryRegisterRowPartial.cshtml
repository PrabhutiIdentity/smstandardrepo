<tr>
    <td>
        <input type="hidden" id="hdnIssueID" value="@Model.IssueID" />
        @(Model.BorrowerType == 0 ? "Teacher" : "Student")
    </td>
    <td>
        @Model.BorrowerName
    </td>

    <td>
        @Model.IssueDate.ToString("dd MMM, yyyy")
    </td>
    <td>@Model.Remark</td>
    <td>
        @(Model.ReturnedBooks == 0 ? "Issued" : Model.ReturnedBooks < Model.Books ? "Partial" : "Returned")
    </td>
    <td>
        @Model.ReturnedBooks/@Model.Books
    </td>
    <td>
        <div class="row" style="margin-right: 10px;">
            <div class="col-md-6">
                <a href="javascript:void(0);" onclick="ViewBookDetails(this,@Model.IssueID);" class="btn btn-link IssueClosed">View</a>
            </div>

        </div>
    </td>
</tr>