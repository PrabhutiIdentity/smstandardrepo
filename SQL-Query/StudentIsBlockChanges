  MiniAddress            
  from StudentMaster SM   left outer join Parentmaster PM on PM.ParentID=SM.ParentID            
   where  SM.SBranchID=@SBranchID and StudentID not in (select StudentID from Student_Session SS where  SS.StudentID=SM.StudentID ) order by Name           
