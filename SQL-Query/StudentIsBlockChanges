  ,'PAR'+RIGHT(REPLICATE('0',6)+CAST(SM.ParentID AS VARCHAR(6)),6) as [SParentID],PM.FatherMobileNo,PM.MotherMobileNo,AadharCardNo ,PM.ParentID,PM.FatherName,PM.MotherName,SM.SSSID,SM.FamilyID,        
