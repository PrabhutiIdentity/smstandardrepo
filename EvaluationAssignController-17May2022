CREATE Procedure Sp_GetEvaluationClasses   --66,1037  
(    
@EvaluationID int,    
@SessionID int    
)    
AS    
BEGIN    
    
      
Declare @SbranchID int    
Select @SbranchID=SbranchID from SessionMaster where SessionID=@SessionID   
Select CM.ClassID,CM.CLassName,CSD.SchemeID as EvaluationschemeID ,ESM.EvaluationSchemeName,  
(case when CSD.SchemeID is null then 0 when CSD.SchemeID=@EvaluationID then 1 else -1  end) as IsSelected    
from ClassMaster  CM  
left outer join Classsessiondetails CSD on CSD.ClassID=CM.CLassiD and CSD.SessionID=@SessionID  
left outer join EvaluationSchemeMaster ESM on ESM.SessionID=@SessionID and ESM.EvaluationSchemeID=CSD.SchemeID  
where CM.SBranchID=@SbranchID  
  
Select @SessionID  
Select @EvaluationID as EvaluationSchemeID  
Select EvaluationSchemeName from EvaluationSchemeMaster where EvaluationSchemeID=@EvaluationID  
END
go

